    "Since this is your first time enabling JIT, Reynard needs to download and mount the Developer Disk Image. This is required for JIT to work properly." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since this is your first time enabling JIT, Reynard needs to download and mount the Developer Disk Image. This is required for JIT to work properly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puisque c'est la première fois que vous activez le JIT, Reynard doit télécharger et monter l'Image Disque de développeur. Ceci est obligatoire pour le bon fonctionnement du JIT."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于这是你首次启用 JIT，Reynard 需要下载并挂载“开发者磁盘映像”。这对 JIT 正常工作是必需的。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поскольку вы включаете JIT впервые, Reynard необходимо скачать и смонтировать Developer Disk Image. Это требуется для корректной работы JIT.\n"
          }
        }
      }
    },
    "Some websites are available in multiple languages. Choose languages in the order you prefer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some websites are available in multiple languages. Choose languages in the order you prefer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains sites Web sont disponibles en plusieurs langues. Veuillez choisir les langues dans l'ordre de vos préférences"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分网站提供多种语言。请按你偏好的顺序选取语言。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые сайты доступны на нескольких языках. Выберите языки в порядке предпочтения.\n"
