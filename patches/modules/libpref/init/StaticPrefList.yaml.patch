+# Hide window.MediaSource for documents whose UA override impersonates
+# iPhone Safari (override contains "iPhone"). Real iPhone Safari has
+# never exposed classic MSE; players that feature-detect it under that
+# UA select MSE+FairPlay, which this engine cannot serve. Hiding it
+# steers them to native HLS + FairPlay. Consulted by
+# MediaSource::VisibleForCurrentGlobal.
+- name: media.reynard.mediasource.hide-for-iphone-ua
+  type: bool
+  value: true
+  mirror: always
+
+# Install Apple's legacy prefixed EME (WebKitMediaKeys) at
+# document-start on the streaming hosts that use it. Prime Video's HLS
+# path calls video.webkitSetMediaKeys(), which Gecko does not have, and
+# threw four times in one device capture - stopping the licence
+# exchange even though the AVPlayer pipeline underneath it worked. Read
+# by GeckoViewContentChild.maybeInstallWebKitMediaKeysShim, so this
+# turns the injection off without a rebuild.
+- name: media.reynard.eme.webkitmediakeys-shim.enabled
+  type: bool
+  value: true
+  mirror: always
+
+# Expose HTMLMediaElement.getStartDate(), WebKit's HLS extension.
+# Safari-targeted players call it unconditionally - Prime Video threw
+# "getStartDate is not a function" 399 times in one device session,
+# which stopped its player before the licence exchange. Gecko has never
+# implemented it (upstream leaves a TODO for bug 847376). Off restores
+# the old behaviour without a rebuild, for a site that feature-detects
+# on its absence.
+- name: media.reynard.hls.getstartdate.enabled
+  type: bool
+  value: true
+  mirror: always
+
+# Advertise only the `skd` FairPlay init data type - the HLS playlist
+# form, and the only one this pipeline can serve. `cenc` and `sinf` are
+# the fragmented-MP4 forms, which mean MSE+FairPlay: sample-level
+# decryption, which AVFoundation does not permit outside WebKit.
+# Offering them tells a player to take a path this engine has closed -
+# a device capture showed bitmovin's demo granted a cenc/video/mp4
+# configuration and then never calling createMediaKeys, because the
+# MediaSource it then went looking for is hidden. Refusing that
+# configuration lets a player try its next choice, which is the HLS
+# one. Consulted by KeySystemConfig::CreateFairPlayKeySystemConfigs.
+- name: media.reynard.fairplay.hls-only-initdata
+  type: bool
+  value: true
+  mirror: always
+
+# Hand HLS to AVFoundation instead of Gecko, so AVURLAsset owns the URL
+# and FairPlay can attach an AVContentKeySession to it. Off until the
+# pipeline is complete; turning it on changes which decoder claims every
+# HLS stream.
+- name: media.reynard.avplayer.enabled
+  type: RelaxedAtomicBool
+  value: false
+  mirror: always
+
