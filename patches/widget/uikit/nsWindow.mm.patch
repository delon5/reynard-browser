+- (void)setSafeAreaInsetBottom:(CGFloat)inset {
+  const CGFloat scale = [self contentScaleFactor];
+  const LayoutDeviceIntCoord scaled =
+      (LayoutDeviceIntCoord)NSToIntRound(MAX(0.0, (double)inset) * scale);
+  if (scaled == mArtificialBottomInset) {
+    return;
+  }
+  mArtificialBottomInset = scaled;
+  [self updateSafeAreaInsets];
 }
 
+- (void)updateSafeAreaInsets {
+  UIWindow* window = self.window;
+  if (!mGeckoChild || !window || !window.screen) {
+    return;
+  }
+
+  const CGFloat scaleFactor = window.screen.scale;
+
+  // Reynard: this VIEW's insets, not the window's position on the screen.
+  //
+  // Upstream's window-vs-screen arithmetic is right when the rendering
+  // view fills the screen, which is GeckoView's arrangement. This fork
+  // lays its content view out inside the safe area, so the widget's
+  // frame already starts below the status bar - a device capture shows
+  // windowRect=0,186 - and MinY(safeAreaRect) - MinY(screenRect) turns
+  // that 186px ORIGIN into a 186px top inset. The strip is then counted
+  // twice: once by our layout, which moved the view down, and again by
+  // any page that pads itself with env(safe-area-inset-top). That is
+  // why m.twitch.tv's header sat a full inset below the top of the page.
+  //
+  // UIView.safeAreaInsets is already exactly the quantity wanted: the
+  // part of THIS view that the status bar and home indicator actually
+  // cover, which is zero on an edge the layout has cleared, and correct
+  // on one it has not (fullscreen, where the view does span the screen).
+  const UIEdgeInsets viewInsets = self.safeAreaInsets;
+
+  LayoutDeviceIntMargin safeAreaInsets(
+      NSToIntRound(MAX(0.0, viewInsets.top) * scaleFactor),
+      NSToIntRound(MAX(0.0, viewInsets.right) * scaleFactor),
+      NSToIntRound(MAX(0.0, viewInsets.bottom) * scaleFactor),
+      NSToIntRound(MAX(0.0, viewInsets.left) * scaleFactor));
+
+  printf_stderr("safeAreaTrace: insets top=%d right=%d bottom=%d left=%d\n",
+                (int)safeAreaInsets.top, (int)safeAreaInsets.right,
+                (int)safeAreaInsets.bottom, (int)safeAreaInsets.left);
+
+  // Reynard: the embedder decides the bottom inset.
+  //
+  // Upstream forces this to zero, reasoning that Safari's own chrome
+  // has already inset the page. That is true while the toolbar is
+  // opaque and occupies real layout space, but not while this fork's
+  // condensed pill is floating OVER a full-height page: there the page
+  // has to know to keep its own bottom controls clear of the pill, and
+  // env(safe-area-inset-bottom) is the only thing that tells it. It is
+  // also the only mechanism that reaches a bar which is neither
+  // position:fixed nor sticky, where a compositor fixed-layer margin
+  // cannot help.
+  //
+  // Zero unless the embedder sets one, so the upstream behaviour is
+  // what happens by default.
+  safeAreaInsets.bottom = mArtificialBottomInset;
+
+  mGeckoChild->UpdateSafeAreaInsets(safeAreaInsets);
+}
+
+- (void)safeAreaInsetsDidChange {
