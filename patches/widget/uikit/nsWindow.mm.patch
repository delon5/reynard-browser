+  // not reach content, these numbers say whether the window rect is sane
+  // now that WidgetToScreenOffset no longer reads uninitialised memory.
+  const LayoutDeviceIntRect screenBounds = GetScreenBounds();
+  printf_stderr(
+      "safeAreaTrace: nsWindow bottom=%d bounds=%d,%d %dx%d listener=%d\n",
+      (int)aInsets.bottom, screenBounds.x, screenBounds.y, screenBounds.width,
+      screenBounds.height, mWidgetListener ? 1 : 0);
+
+  mSafeAreaInsets = aInsets;
+
+  if (mWidgetListener) {
+    mWidgetListener->SafeAreaInsetsChanged(aInsets);
+  }
+
+  if (mAttachedWidgetListener) {
+    mAttachedWidgetListener->SafeAreaInsetsChanged(aInsets);
+  }
