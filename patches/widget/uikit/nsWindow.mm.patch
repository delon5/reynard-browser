+// reserves that space itself through env(safe-area-inset-bottom) rather
+// than us shortening the viewport or painting over it.
+//
+// PresShellWidgetListener::SafeAreaInsetsChanged forwards to every remote
+// child unconditionally - no docshell filter, unlike the toolbar offset
+// path - so this needs nothing else on the Gecko side.
+void nsWindow::UpdateSafeAreaInsets(const LayoutDeviceIntMargin& aInsets) {
+  if (mSafeAreaInsets == aInsets) {
+    return;
+  }
+
