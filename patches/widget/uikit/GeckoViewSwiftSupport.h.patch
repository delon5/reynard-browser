+// The app's AVPlayer host. FairPlay content is owned by AVFoundation end
+// to end - only AVURLAsset conforms to AVContentKeyRecipient - so
+// AVPlayerDecoder drives a player living in the app rather than decoding
+// anything itself. Reached through GetSwiftRuntime, like every other
+// Gecko-to-app call here; raw C symbols would not link, because libxul
+// cannot leave undefined symbols pointing at the app.
+@protocol GeckoAVPlayerHost <NSObject>
+- (NSUInteger)createPlayerWithUrl:(NSString*)url;
+- (void)play:(NSUInteger)playerId;
+- (void)pause:(NSUInteger)playerId;
+- (void)suspend:(NSUInteger)playerId;
+- (void)resume:(NSUInteger)playerId;
+- (void)destroy:(NSUInteger)playerId;
+- (double)currentTime:(NSUInteger)playerId;
+- (double)duration:(NSUInteger)playerId;
+- (void)seek:(NSUInteger)playerId to:(double)seconds;
+- (void)setVolume:(NSUInteger)playerId to:(double)volume;
+@optional
+// The AVContentKeySession the EME licence exchange is bound to, handed
+// over by FairPlayCDMProxy as soon as it creates one. FairPlay only
+// decrypts an AVURLAsset registered as a recipient of that same session,
+// so the host must use this rather than create its own. Optional so an
+// engine built without the EME patches still links.
+- (void)useContentKeySession:(AVContentKeySession*)session;
+// The paired form: this session's keys belong to THIS player, so its
+// asset is the one to register as a recipient. FairPlay decrypts only
+// an asset registered on the same session the licence arrived on, so
+// with two protected elements the unpaired call above can attach the
+// second one's asset to the first one's session. Optional, like the
+// rest of this protocol, so a host without it keeps the old behaviour.
+- (void)useContentKeySession:(AVContentKeySession*)session
+                   forPlayer:(NSUInteger)playerId;
+
+// FairPlay, once the key session moved to the app process.
+//
+// Both methods above are for the case where FairPlayCDMProxy and the
+// asset are in the SAME process, which they are not: the proxy lives
+// wherever the media element does - a content process - while
+// addContentKeyRecipient takes an AVURLAsset, and the asset is here.
+// So the session is created here, per player, and these three carry
+// the page's half of the licence exchange across.
+//
+// The application certificate. Per player rather than per process at
+// this layer, because the host indexes everything by player; the
+// broker in AVPlayerDecoder.mm is what fans one certificate out to
+// every player the sending content process owns.
+- (void)setAppCertificate:(NSData*)certificate
+                forPlayer:(NSUInteger)playerId;
+// MSE, which has no player at all. Keyed by CHILD id, because the
+// composite broker key arrives with its player half zeroed and its child
+// half intact - and because the certificate above is already fanned out
+// per child, so one parser session per content process is the coarsest
+// scope that path can still serve.
+//
+// The host routes these to AVStreamDataParser, the one API that
+// originates a FairPlay key request from init-segment bytes rather than
+// from an AVURLAsset. Optional like the rest: a host without it simply
+// leaves MSE where it was.
+- (void)parserAppendInitData:(NSUInteger)childId
+                   contentId:(NSString*)contentId
+                    initData:(NSData*)initData;
+// The same certificate setAppCertificate:forPlayer: carries, routed by
+// CHILD instead - an MSE content process owns no player for the
+// per-player fan-out to find, so without this the certificate never
+// reaches the session that needs it and no SPC can be made.
+- (void)parserSetCertificate:(NSUInteger)childId
+                 certificate:(NSData*)certificate;
+// A media segment, and WHICH SourceBuffer it came from. One
+// AVStreamDataParser parses one stream, so a page's audio and video need
+// one each; they share the child's single AVContentKeySession as
+// recipients, which is what lets one licence serve both.
+- (void)parserAppendMediaSegment:(NSUInteger)childId
+                          stream:(NSString*)stream
+                         segment:(NSData*)segment;
+// That SourceBuffer has ended - the page removed it, or dropped the
+// MediaSource it lived on.
+//
+// Everything the app process holds under that stream id is finished
+// with: the AVStreamDataParser, its display layer, its audio renderer
+// and their content-key registrations. Without this the appends simply
+// stop and nothing says why, and a parser with fragments still in it
+// goes on feeding its sinks in real time for as long as they last.
+- (void)parserRetireStream:(NSUInteger)childId
+                    stream:(NSString*)stream;
+// A fragmented-MP4 init segment the page appended to a SourceBuffer.
+//
+// Distinct from parserAppendInitData:contentId:initData: above, which
+// carries EME initialisation data. The parser originates a key request
+// from a PARSED init segment and from nothing else - the session only
+// resolves a requirement a recipient has already raised - so these
+// bytes are appended and nothing else is done with them. Raising a
+// direct key request here would repeat the call that has twice
+// resolved nothing.
+- (void)parserAppendMediaSegment:(NSUInteger)childId
+                         segment:(NSData*)segment;
+// generateRequest(): produce an SPC for this identifier. If the asset
+// already raised a request for it - the usual case, since the page is
+// replying to an 'encrypted' event that came from exactly that
+// request - the held one is used rather than asking for a duplicate.
+- (void)generateKeyRequest:(NSUInteger)playerId
+                 contentId:(NSString*)contentId
+              initDataType:(NSString*)initDataType
+                  initData:(NSData*)initData;
+// update(): the CKC from the page's licence server.
+- (void)provideKeyResponse:(NSUInteger)playerId
+                 contentId:(NSString*)contentId
+                  response:(NSData*)response;
+// The same licence for a parser session, routed by CHILD. The method
+// above looks a player up, and an MSE content process owns none - so
+// without this the CKC arrives in the app process and is dropped one
+// step from the key request that asked for it.
+- (void)parserProvideKeyResponse:(NSUInteger)childId
+                       contentId:(NSString*)contentId
+                        response:(NSData*)response;
+// The element's play state, for a parser session.
+//
+// The MSE route paints and plays through AVFoundation objects of its
+// own, on clocks nothing told about the element - so a paused element
+// kept playing and the "Block Audio and Video" autoplay setting was
+// defeated. Routed by CHILD like everything else on this path; a
+// content process owns no player to route by.
+- (void)parserSetPlaying:(NSUInteger)childId
+                   owner:(uint64_t)owner
+                 playing:(BOOL)playing;
+// Which ELEMENT a SourceBuffer belongs to.
+//
+// The two methods around this one used to carry no element at all - the
+// route's key is (childID << 32) | 0 - so one element's play state and
+// volume were applied to every MSE stream in the process. This is the
+// identity that separates them: MediaSource::GetDecoder() on one side
+// and MediaDecoder's own `this` on the other.
+- (void)parserSetStreamOwner:(NSUInteger)childId
+                      stream:(NSString*)stream
+                       owner:(uint64_t)owner;
+// Where that element is playing.
+//
+// The MSE route paints on a control timebase of its own and had no way
+// to know the page's currentTime, so it inferred one from the order
+// samples arrived in - and MSE has no order. This is the number it was
+// inferring. Sent about four times a second per playing element.
+- (void)parserSetPosition:(NSUInteger)childId
+                    owner:(uint64_t)owner
+                  seconds:(double)seconds;
+// And its volume. "Block Audio Only" is Gecko's Allowed_muted: the
+// play is permitted because the element is believed inaudible, which
+// an audio renderer that never heard the volume made untrue. The twin
+// of setVolume:to: above, which does this for the native HLS route.
+- (void)parserSetVolume:(NSUInteger)childId
+                  owner:(uint64_t)owner
+                 volume:(double)volume;
+
+// The compositor's layer for a protected stream.
+//
+// A FairPlay-decrypted frame lives in memory the CPU may not read, so
+// the IOSurface path that carries clear video cannot carry this one -
+// copyPixelBuffer returns nothing and the plane addresses are offsets.
+// AVFoundation has to own the path to the screen, which means the
+// player is bound to a layer that is really in the view hierarchy.
+// NativeLayerCA builds that layer when the DRM mark arrives and hands
+// it over here.
+//
+// CHANGED - see fix_layer_attach_retries_on_licence.py's docstring.
+// playerId may be 0, and 0 is the ordinary case rather than a caller
+// error: the DRM mark arrives with MediaKeys construction, while
+// -protectedPlayerId only answers once a licence has named a player,
+// a network round trip later.
+//
+// An id that names no player - 0, which can never name one because
+// the host's ids start at 1, or a player torn down since the id was
+// read - means HOLD this layer and bind it when one is named. The
+// compositor offers a layer exactly ONCE per construction, and a
+// republish at the same geometry and mark does not rebuild it, so a
+// layer refused here is a black picture for the rest of the title.
+// The host keeps one such layer, most recent wins.
+- (void)attachLayer:(AVPlayerLayer*)layer to:(NSUInteger)playerId;
+
+// The player the compositor should bind a protected layer to, or 0.
+//
+// The layer arrives from the compositor, which knows only that the
+// surface was marked DRM - one bit, no player id, and no way to carry
+// one: 58fd2b0 established that a global IOSurface id does not resolve
+// across processes on iOS at all. It does not need to. The compositor
+// and this host are in the SAME process, so the host answers which
+// player is protected and the id never crosses a boundary.
+- (NSUInteger)protectedPlayerId;
+@end
+
+// The reverse direction, and the only one there is.
+//
+// Everything above is app-bound: Gecko asks the player to do things.
+// Nothing came back, so AVPlayerDecoder::NotifyMetadata and
+// ::NotifyLoad were defined with no callers at all - and without
+// metadata the element never leaves HAVE_NOTHING and paints nothing,
+// however correct the frame sitting in its VideoFrameContainer is.
+// Device captures showed exactly that: "placeholder PUBLISHED
+// 1920x1080 planes=2" and a blank screen.
+//
+// A C symbol rather than a delegate protocol, because AVPlayerDecoder.h
+// is included from HTMLMediaElement.cpp - plain C++ - and cannot carry
+// an Obj-C member. This is the same shape as MainProcessInit and
+// ChildProcessInit, which Swift already calls: defined in libxul,
+// declared in a header the GeckoView umbrella exports. (The comment
+// above about raw C symbols not linking is about the opposite
+// direction, libxul referencing the app.)
+//
+// aPlayerId is the handle createPlayerWithUrl returned. The decoder
+// that owns it is found by lookup, so a stale id after teardown
+// resolves to nothing and is ignored rather than dereferenced.
+//
+// Main thread only. Declared with the other C entry points below.
+
 @protocol GeckoProcessExtension <NSObject>
 - (void)lockdownSandbox:(NSString*)revision;
 @end
