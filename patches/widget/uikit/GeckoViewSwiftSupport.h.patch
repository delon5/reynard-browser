+// Called from the Swift AVPlayer host once an item reports duration and
+// dimensions - see the GeckoAVPlayerHost comment above for why this is a
+// C symbol rather than a delegate callback.
+MOZ_EXPORT void ReynardAVPlayerNotifyMetadata(uintptr_t aPlayerId,
+                                              double aDurationSeconds,
+                                              int32_t aWidth, int32_t aHeight);
+
+// Called from the Swift AVPlayer host for each decoded frame pulled
+// out of AVPlayerItemVideoOutput. The buffer is retained for the
+// duration of the call only - Gecko takes its own reference on the
+// underlying IOSurface for the hop to its main thread, so the caller
+// may release as soon as this returns.
+//
+// Same C-symbol reasoning as the metadata callback above. The pixel
+// buffer is IOSurface-backed by construction - the video output is
+// created with kCVPixelBufferIOSurfacePropertiesKey - which is what
+// lets the frame reach the compositor without a copy.
+MOZ_EXPORT void ReynardAVPlayerNotifyFrame(uintptr_t aPlayerId,
+                                           CVPixelBufferRef aPixelBuffer);
+
+// Called from the Swift AVPlayer host as the playback position moves:
+// on every display-link frame pull (even when no new pixel buffer is
+// ready - a repeated frame still means the clock ticked), from a 4 Hz
+// periodic time observer that covers the stretches when the pull link
+// is parked, once when the item first reaches readyToPlay, and after
+// every completed seek. Unlike the two callbacks above this one is HOT
+// - up to 120 Hz - and it is cheap by design: callable from ANY
+// thread, the position lands in a lock-protected registry, and a hop
+// to Gecko's main thread is queued only when the media machinery is
+// actually waiting on this position. This is the clock that
+// AVPlayerDemuxer paces its synthetic samples against, i.e. the thing
+// that makes the media element's currentTime advance.
+MOZ_EXPORT void ReynardAVPlayerNotifyTime(uintptr_t aPlayerId,
+                                          double aSeconds);
+
+// Called when AVFoundation reports the item played to its end - the
+// signal that lets the demuxer answer end-of-stream and the media
+// element fire "ended" at the stream's real end. Same threading
+// contract as the position callback above.
+MOZ_EXPORT void ReynardAVPlayerNotifyEnded(uintptr_t aPlayerId);
+
+// Called when the app process concludes this stream is protected: its
+// video output stopped vending pixel buffers while the player kept
+// playing and the clock kept advancing. That is the only announcement a
+// native-HLS FairPlay stream makes - Apple TV+ hands the whole key
+// exchange to AVFoundation and never touches EME - and it can only be
+// observed here, beside the AVPlayer.
+MOZ_EXPORT void ReynardAVPlayerNotifyProtected(uintptr_t aPlayerId);
+
+// FairPlay, app process -> Gecko, the reverse of the three protocol
+// methods above.
+//
+// The asset reached a key it has no licence for. The page has to hear
+// about that as an 'encrypted' event, and only the process holding the
+// media element can fire one - AVPlayerDemuxer never sees this stream,
+// so no ordinary demuxer path produces it. aInitDataType is "skd" for
+// HLS and "sinf" for fragmented MP4.
+MOZ_EXPORT void ReynardFairPlayNotifyEncrypted(uintptr_t aPlayerId,
+                                               const char* aInitDataType,
+                                               const uint8_t* aInitData,
+                                               size_t aInitDataLength);
+
+// The SPC makeStreamingContentKeyRequestDataForApp produced, on its way
+// to becoming the EME session's 'message' event. aContentId is the
+// identifier in the encoding both processes key by: the skd:// URI for
+// HLS, base64 of the raw key id for fragmented MP4.
+//
+// Both are main-thread only, which the key session's delegate queue
+// (DispatchQueue.main) satisfies in this process.
+MOZ_EXPORT void ReynardFairPlayNotifyKeyMessage(uintptr_t aPlayerId,
+                                                const char* aContentId,
+                                                const uint8_t* aSpc,
+                                                size_t aSpcLength);
+
+// The same message from a PARSER session, which has no player to be
+// named by. Keyed by child id, because that is the half of the composite
+// broker key an MSE request still carries - see
+// ReynardAVPlayerBrokerGenerateKeyRequest's id-0 branch.
+MOZ_EXPORT void ReynardFairPlayNotifyParserKeyMessage(
+    uintptr_t aChildId, const char* aContentId, const uint8_t* aSpc,
+    size_t aSpcLength);
+
