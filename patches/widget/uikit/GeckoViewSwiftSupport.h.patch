+
+// The app's AVPlayer host. FairPlay content is owned by AVFoundation end
+// to end - only AVURLAsset conforms to AVContentKeyRecipient - so
+// AVPlayerDecoder drives a player living in the app rather than decoding
+// anything itself. Reached through GetSwiftRuntime, like every other
+// Gecko-to-app call here; raw C symbols would not link, because libxul
+// cannot leave undefined symbols pointing at the app.
+@protocol GeckoAVPlayerHost <NSObject>
+- (NSUInteger)createPlayerWithUrl:(NSString*)url;
+- (void)play:(NSUInteger)playerId;
+- (void)pause:(NSUInteger)playerId;
+- (void)suspend:(NSUInteger)playerId;
+- (void)resume:(NSUInteger)playerId;
+- (void)destroy:(NSUInteger)playerId;
+- (double)currentTime:(NSUInteger)playerId;
+- (double)duration:(NSUInteger)playerId;
+- (void)seek:(NSUInteger)playerId to:(double)seconds;
+@optional
+// The AVContentKeySession the EME licence exchange is bound to, handed
+// over by FairPlayCDMProxy as soon as it creates one. FairPlay only
+// decrypts an AVURLAsset registered as a recipient of that same session,
+// so the host must use this rather than create its own. Optional so an
+// engine built without the EME patches still links.
+- (void)useContentKeySession:(AVContentKeySession*)session;
 @end
 
