+// The app's AVPlayer host. FairPlay content is owned by AVFoundation end
+// to end - only AVURLAsset conforms to AVContentKeyRecipient - so
+// AVPlayerDecoder drives a player living in the app rather than decoding
+// anything itself. Reached through GetSwiftRuntime, like every other
+// Gecko-to-app call here; raw C symbols would not link, because libxul
+// cannot leave undefined symbols pointing at the app.
+@protocol GeckoAVPlayerHost <NSObject>
+- (NSUInteger)createPlayerWithUrl:(NSString*)url;
+- (void)play:(NSUInteger)playerId;
+- (void)pause:(NSUInteger)playerId;
+- (void)suspend:(NSUInteger)playerId;
+- (void)resume:(NSUInteger)playerId;
+- (void)destroy:(NSUInteger)playerId;
+- (double)currentTime:(NSUInteger)playerId;
+- (double)duration:(NSUInteger)playerId;
+- (void)seek:(NSUInteger)playerId to:(double)seconds;
+@optional
+// The AVContentKeySession the EME licence exchange is bound to, handed
+// over by FairPlayCDMProxy as soon as it creates one. FairPlay only
+// decrypts an AVURLAsset registered as a recipient of that same session,
+// so the host must use this rather than create its own. Optional so an
+// engine built without the EME patches still links.
+- (void)useContentKeySession:(AVContentKeySession*)session;
+// The paired form: this session's keys belong to THIS player, so its
+// asset is the one to register as a recipient. FairPlay decrypts only
+// an asset registered on the same session the licence arrived on, so
+// with two protected elements the unpaired call above can attach the
+// second one's asset to the first one's session. Optional, like the
+// rest of this protocol, so a host without it keeps the old behaviour.
+- (void)useContentKeySession:(AVContentKeySession*)session
+                   forPlayer:(NSUInteger)playerId;
+@end
+
+// The reverse direction, and the only one there is.
+//
+// Everything above is app-bound: Gecko asks the player to do things.
+// Nothing came back, so AVPlayerDecoder::NotifyMetadata and
+// ::NotifyLoad were defined with no callers at all - and without
+// metadata the element never leaves HAVE_NOTHING and paints nothing,
+// however correct the frame sitting in its VideoFrameContainer is.
+// Device captures showed exactly that: "placeholder PUBLISHED
+// 1920x1080 planes=2" and a blank screen.
+//
+// A C symbol rather than a delegate protocol, because AVPlayerDecoder.h
+// is included from HTMLMediaElement.cpp - plain C++ - and cannot carry
+// an Obj-C member. This is the same shape as MainProcessInit and
+// ChildProcessInit, which Swift already calls: defined in libxul,
+// declared in a header the GeckoView umbrella exports. (The comment
+// above about raw C symbols not linking is about the opposite
+// direction, libxul referencing the app.)
+//
+// aPlayerId is the handle createPlayerWithUrl returned. The decoder
+// that owns it is found by lookup, so a stale id after teardown
+// resolves to nothing and is ignored rather than dereferenced.
+//
+// Main thread only. Declared with the other C entry points below.
+
 @protocol GeckoProcessExtension <NSObject>
 - (void)lockdownSandbox:(NSString*)revision;
 @end
