+void mozilla::widget::NotifyChildProcessStarted(int32_t aPid,
+                                                const char* aProcessType) {
+  // Forward child process launch notifications to the Swift host so
+  // it can attach the JIT debugger path as soon as the pid is
+  // known in the parent process, while still letting the app distinguish the
+  // Gecko child process type.
+  //
+  // DIAGNOSTIC - NSLog at every branch point below. Both early exits
+  // in this function were previously silent, so when the Swift end of
+  // this chain (GeckoRuntimeImpl.childProcessDidStart) produced zero
+  // output across every capture, there was no way to tell which of
+  // three very different things had happened: this function was never
+  // reached at all, it bailed on a nil gRuntime, or it bailed on a
+  // failed respondsToSelector check. NSLog specifically because it is
+  // demonstrably the exact mechanism every other Reynard log line in
+  // those same captures already came through - logger() in JITUtils.m
+  // is literally NSLog(@"[Reynard] %@", message) - so its output is
+  // known to survive idevicesyslog capture, unlike the fprintf(stderr)
+  // REYNARD_DEBUG line at this function's own call site, which never
+  // appears in any capture and therefore proves nothing either way.
+  NSLog(@"[Reynard] NotifyChildProcessStarted: entered for pid %d, type=%s",
+        aPid, aProcessType ? aProcessType : "(null)");
+
+  if (!gRuntime) {
+    NSLog(@"[Reynard] NotifyChildProcessStarted: gRuntime is nil - bailing "
+          @"for pid %d",
+          aPid);
+    return;
+  }
+
+  NSString* processType = @"invalid";
+  if (aProcessType) {
+    processType = [NSString stringWithUTF8String:aProcessType];
+    if (!processType) {
+      processType = @"invalid";
+    }
+  }
+
+  if ([gRuntime
+          respondsToSelector:@selector(
+                                 childProcessDidStartWithPID:processType:)]) {
+    NSLog(@"[Reynard] NotifyChildProcessStarted: dispatching to Swift for "
+          @"pid %d, type=%@",
+          aPid, processType);
+    [gRuntime childProcessDidStartWithPID:aPid processType:processType];
+  } else {
+    NSLog(@"[Reynard] NotifyChildProcessStarted: gRuntime does NOT respond to "
+          @"childProcessDidStartWithPID:processType: - bailing for pid %d",
+          aPid);
+  }
+}
