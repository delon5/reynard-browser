+// This is actually for content process to access the Documents
+// directory for e.g. opening downloaded files.
+// https://github.com/WebKit/WebKit/blob/main/Source/WTF/wtf/spi/darwin/SandboxSPI.h
+// https://github.com/WebKit/WebKit/blob/main/Source/WebKit/Shared/Cocoa/SandboxExtensionCocoa.mm
+static void ConsumeDocumentsSandboxExtension() {
+  if (!XRE_IsContentProcess()) {
+    return;
+  }
+
+  if (gDocumentsSandboxExtension == -1) {
+    const char* extensionToken = getenv("MOZ_DOCUMENTS_SANDBOX_EXTENSION");
+    if (extensionToken && *extensionToken) {
+      gDocumentsSandboxExtension = sandbox_extension_consume(extensionToken);
+    }
+  }
+}
