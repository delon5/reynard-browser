+// Wait for the parent process to finish the per-pid JIT attach path
+// before allowing the content child to keep SpiderMonkey JIT enabled.
+//
+// REVERTED back to 5000ms - see
+// fix_revert_child_jit_ready_signal_window.py's docstring. Briefly
+// extended to 95000ms, but that only helps once a real attach attempt
+// can actually succeed within the window - the underlying attach hang
+// (still unresolved as of this revert) meant every content process
+// just waited a painful ~95s for a signal that was never going to
+// arrive, instead of the original 5s, with no corresponding benefit.
+static bool WaitForJITReadySignal(mozilla::widget::ChildJITStatus* aStatus) {
+  auto finish = [&](bool ok) {
+    if (gJITReadySignalFd != -1) {
+      close(gJITReadySignalFd);
+      gJITReadySignalFd = -1;
+    }
+    return ok;
+  };
+
+  if (gJITReadySignalFd == -1) {
+    return finish(false);
+  }
+
+  pollfd descriptor = {
+      .fd = gJITReadySignalFd,
+      .events = POLLIN,
+      .revents = 0,
+  };
+
+  const int pollResult = poll(&descriptor, 1, 5000);
+  if (pollResult <= 0) {
+    return finish(false);
+  }
+
+  mozilla::widget::ChildJITStatus status = {0, {0, {0, 0, 0}}};
+  const ssize_t bytesRead = read(gJITReadySignalFd, &status, sizeof(status));
+
+  if (bytesRead != sizeof(status)) {
+    return finish(false);
+  }
+
+  if (aStatus) {
+    *aStatus = status;
+  }
+
+  return finish(status.enabled);
+}
