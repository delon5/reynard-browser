diff --git a/layout/base/PresShellWidgetListener.cpp b/layout/base/PresShellWidgetListener.cpp
index 11d1400b..fedc2351 100644
--- a/layout/base/PresShellWidgetListener.cpp
+++ b/layout/base/PresShellWidgetListener.cpp
@@ -157,16 +157,27 @@ void PresShellWidgetListener::DynamicToolbarOffsetChanged(
     ScreenIntCoord aOffset) {
   MOZ_ASSERT(XRE_IsParentProcess(),
              "Should be only called for the browser parent process");
+  int visited = 0;
+  int delivered = 0;
   CallOnAllRemoteChildren(
-      [aOffset](dom::BrowserParent* aBrowserParent) -> CallState {
-        // Skip background tabs.
+      [aOffset, &visited, &delivered](dom::BrowserParent* aBrowserParent)
+          -> CallState {
+        visited++;
+        // Skip background tabs. Unlike DynamicToolbarMaxHeightChanged,
+        // which calls every remote child unconditionally, this delivers
+        // only to an active docshell - so an inactive browsing context
+        // loses the offset with no trace.
         if (!aBrowserParent->GetDocShellIsActive()) {
           return CallState::Continue;
         }
 
+        delivered++;
         aBrowserParent->DynamicToolbarOffsetChanged(aOffset);
         return CallState::Stop;
       });
+  printf_stderr(
+      "toolbarTrace: PresShellWidgetListener offset=%d visited=%d delivered=%d\n",
+      (int)aOffset, visited, delivered);
 }
 
 void PresShellWidgetListener::KeyboardHeightChanged(ScreenIntCoord aHeight) {
@@ -256,11 +267,25 @@ void PresShellWidgetListener::SafeAreaInsetsChanged(
 
   LayoutDeviceIntMargin windowSafeAreaInsets;
   const LayoutDeviceIntRect windowRect = mWindow->GetScreenBounds();
-  if (nsCOMPtr<nsIScreen> screen = mWindow->GetWidgetScreen()) {
+  // Hoisted out of the if-condition so the trace below can name it.
+  // GetWidgetScreen returns already_AddRefed, which is not contextually
+  // convertible to bool, so it cannot be called inline in a ternary.
+  nsCOMPtr<nsIScreen> screen = mWindow->GetWidgetScreen();
+  if (screen) {
     windowSafeAreaInsets = nsContentUtils::GetWindowSafeAreaInsets(
         screen, aSafeAreaInsets, windowRect);
   }
 
+  // in vs out. GetWindowSafeAreaInsets intersects the deflated screen
+  // rect against the window rect, so a wrong window rect silently yields
+  // an empty margin and the page sees 0px.
+  printf_stderr(
+      "safeAreaTrace: PresShellWidgetListener in=%d windowRect=%d,%d %dx%d "
+      "screen=%d out=%d\n",
+      (int)aSafeAreaInsets.bottom, windowRect.x, windowRect.y, windowRect.width,
+      windowRect.height, screen ? 1 : 0,
+      (int)windowSafeAreaInsets.bottom);
+
   presShell->GetPresContext()->SetSafeAreaInsets(windowSafeAreaInsets);
 
   // https://github.com/w3c/csswg-drafts/issues/4670
