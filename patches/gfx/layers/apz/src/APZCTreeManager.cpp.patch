+#ifdef MOZ_WIDGET_UIKIT
+    // Reynard fat-thumb probe: the visible thumb is only a few points
+    // wide and a device log showed 15 of 16 real grab attempts landing
+    // just beside it. When the direct hit is not an async-draggable
+    // thumb, re-run the hit test at points stepped SIDEWAYS from the
+    // touch, nearest first, and accept only a VERTICAL scrollbar's
+    // thumb. Sideways-only is deliberate, twice over: probing up/down
+    // would let a horizontal thumb - often nearly container-wide -
+    // hijack ordinary vertical pans from a band above and below it,
+    // and a sideways probe at the finger's own y can only find the
+    // vertical thumb while the finger is genuinely alongside it, so
+    // the grab zone grows only laterally, never along the track. The
+    // first thumb within 72 device pixels (24pt at 3x) wins and the
+    // whole hit result is swapped for that probe's, re-running the
+    // same clone/move/flag sequence the direct hit just ran above
+    // (the tree lock is still held), so the drag block, target APZC,
+    // haptic and trace behave exactly as if the finger had landed on
+    // the thumb. Visuals are untouched; only the touch target grows.
+    // The sideways offset cannot skew the drag: SetupScrollbarDrag
+    // uses only the along-axis coordinate, and slider.snapMultiplier
+    // is 0 off Windows so there is no lateral snap-back. Single-touch
+    // only - a second finger means pinch, never a thumb grab.
+    //
+    // HOW WIDE, AND WHY IT SHRANK. This was a flat 72 DEVICE pixels,
+    // described as "24pt at 3x" - which it is only at 3x. On a 2x
+    // device the same constant is 36pt, and the corridor is not a
+    // free target: adopting a thumb commits mInScrollbarTouchDrag, and
+    // upstream's drag path then synthesises a mouse event and does not
+    // send the touch to content. So everything inside the corridor
+    // stops being page content - a tap on a link there buzzes and does
+    // nothing, and an ordinary vertical PAN there becomes a thumb drag,
+    // which scrolls with amplified gain in the opposite direction to
+    // the pan. That is the "wrong buzz while scrolling near the right
+    // edge" complaint this whole arc started from, upgraded to wrong
+    // scrolling.
+    //
+    // So: half the reach, and expressed the way the rest of APZ
+    // expresses its tolerances - in inches against GetDPI(), so it is
+    // the same physical distance on every device instead of the same
+    // pixel count. 0.075in is 12pt at the 160dpi reference APZ uses.
+    //
+    // This NARROWS the pan hijack; it does not close it. Closing it
+    // properly means two-phase adoption - mark the candidate at
+    // touch-down and only commit if the first move looks like a grab
+    // rather than a fling - which is real surgery on the block routing.
+    // Worth doing if it bites; not worth it while the corridor has
+    // never once been seen to fire (capture d4c5dd97: 92 touch starts,
+    // widened=0 on every one).
+    //
+    // Four steps instead of twelve, for the same reason: this ran up to
+    // 24 synchronous hit tests on virtually every touch start.
+    bool widenedThumbHit = false;
+    if (!mInScrollbarTouchDrag && StaticPrefs::apz_drag_enabled() &&
+        StaticPrefs::apz_drag_touch_enabled() &&
+        aInput.mTouches.Length() == 1) {
+      const ScreenIntPoint touchPoint = aInput.mTouches[0].mScreenPoint;
+      const int32_t reach =
+          std::max(4, int32_t(0.075f * GetDPI()));
+      const int32_t step = std::max(1, reach / 4);
+      for (int32_t distance = step; distance <= reach && !widenedThumbHit;
+           distance += step) {
+        const ScreenIntPoint candidates[] = {
+            touchPoint + ScreenIntPoint(distance, 0),
+            touchPoint - ScreenIntPoint(distance, 0)};
+        for (const ScreenIntPoint& candidate : candidates) {
+          HitTestResult probe = GetTargetAPZC(candidate);
+          if (probe.mScrollbarNode &&
+              probe.mScrollbarNode->IsScrollThumbNode() &&
+              probe.mScrollbarNode->GetScrollbarData()
+                  .mThumbIsAsyncDraggable &&
+              probe.mScrollbarNode->GetScrollbarData().mDirection ==
+                  Some(ScrollDirection::eVertical)) {
+            aState.mHit = std::move(probe);
+            mTouchBlockHitResult =
+                mHitTester->CloneHitTestResult(lock, aState.mHit);
+            hitScrollbarNode = std::move(aState.mHit.mScrollbarNode);
+            mInScrollbarTouchDrag = true;
+            widenedThumbHit = true;
+            break;
+          }
+        }
+      }
+    }
+    // scrollbarHaptic trace: one line per touch start showing every
+    // gate of thumb-grab detection, so a device log pinpoints which
+    // link of the haptic chain is dead. Remove once confirmed.
+    printf_stderr("scrollbarHaptic: touchStart drag=%d prefs=%d/%d hit=%d thumb=%d async=%d widened=%d\n",
+                  mInScrollbarTouchDrag ? 1 : 0,
+                  StaticPrefs::apz_drag_enabled() ? 1 : 0,
+                  StaticPrefs::apz_drag_touch_enabled() ? 1 : 0,
+                  hitScrollbarNode ? 1 : 0,
+                  (hitScrollbarNode && hitScrollbarNode->IsScrollThumbNode()) ? 1 : 0,
+                  (hitScrollbarNode && hitScrollbarNode->IsScrollThumbNode() &&
+                   hitScrollbarNode->GetScrollbarData().mThumbIsAsyncDraggable) ? 1 : 0,
+                  widenedThumbHit ? 1 : 0);
+    if (mInScrollbarTouchDrag) {
+      // Reynard: the embedder fires a haptic the moment the user's
+      // finger lands on the scrollbar thumb, and this is the only
+      // place that knows it happened. On iOS APZ runs in the GPU
+      // process (the BrowserEngineKit rendering extension), so
+      // notifying the observer service HERE reaches nobody - the
+      // GeckoViewStartup relay lives in the UI process. A device
+      // trace proved exactly that: six thumb grabs, six notifies,
+      // zero observer callbacks. Route over the
+      // UiCompositorController channel instead - the same channel
+      // the fixed-bottom-offset pill margin already uses in
+      // production - and the UI-process child re-notifies the
+      // observer topic on the main thread, where the relay lives.
+      // 1000 sits far above the Android animator codes in
+      // UiCompositorControllerMessageTypes.h.
+      if (RefPtr<UiCompositorControllerParent> uiController =
+              UiCompositorControllerParent::GetFromRootLayerTreeId(
+                  mRootLayersId)) {
+        uiController->ToolbarAnimatorMessageFromCompositor(1000);
+      } else {
+        printf_stderr("scrollbarHaptic: no UiCompositorControllerParent\n");
+      }
+    }
+#endif
+
     MOZ_ASSERT(touchBehaviors.Length() == aInput.mTouches.Length());
     for (size_t i = 0; i < touchBehaviors.Length(); i++) {
       APZCTM_LOG("Touch point has allowed behaviours 0x%02x\n",
