 bool AsyncPanZoomController::BlocksPullToRefreshForOverflowHidden() const {
+#ifdef MOZ_WIDGET_UIKIT
+  // Reynard: Safari parity, not Chrome parity. Upstream blocks
+  // pull-to-refresh whenever the root document computes
+  // overflow-y:hidden (Bug 1902313) because Chrome behaves that
+  // way. But the app-shell pattern that trips it -
+  // body{overflow:hidden} with one inner overflow-y:auto
+  // scroller, tv.apple.com being the canonical case - is exactly
+  // where iOS users still expect pull-to-refresh, and Safari
+  // grants it. Sites that truly need to opt out keep the
+  // standard, still-honored switches: overscroll-behavior,
+  // touch-action, and preventDefault.
+  return false;
+#else
   return IsRootContent() &&
          GetScrollMetadata().GetOverflow().mOverflowY == StyleOverflow::Hidden;
+#endif
 }
 
