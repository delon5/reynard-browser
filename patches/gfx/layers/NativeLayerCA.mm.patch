+
+// Defined in dom/media/AVPlayerDecoder.mm, in namespace mozilla - which
+// is where the broker entry points live too, despite their comment
+// calling it global scope: what that means is "not nested inside
+// mozilla::dom", where reopening `namespace mozilla {` would produce
+// mozilla::dom::mozilla. Declaring it before this namespace opens gives
+// ::ReynardAVPlayerAttachLayer and does not link.
+//
+// Hands a layer built here to the AVPlayer that owns the protected
+// stream. Declared rather than included because gfx/layers needs no new
+// include path for one function, and both halves live in libxul.
+void ReynardAVPlayerAttachLayer(void* aLayer);
+
+// The same, for the other protected route. Defined in the same file, and
+// hands the layer to FairPlayStreamParser instead of to an AVPlayer,
+// because MSE has no player to hand it to. aElement is the element key
+// read off the frame - see stage1_carry_the_element_key.py's docstring.
+void ReynardMSEAttachLayer(void* aLayer, uint64_t aElement);
+
+// Whether that route is still producing a picture. Defined beside the
+// two above - see mse_fix_177's docstring. Answers from the compositor
+// thread without a hop, and answers false if the parser is not there.
+bool ReynardMSEHasLivePicture();
+
+// Whether the sink it is holding is one this session can still use.
+// Defined beside the others - see mse_fix_185's docstring. A sink that
+// has established content protection for one site cannot be claimed by
+// the next, and only the parser sees that refusal.
+bool ReynardMSEWantsFreshSink();
+
+// The same question for ONE element's sink - see
+// stage2_one_sink_per_element.py's docstring. Defined beside the
+// others. Clears as it is read, like the one above, but only the poll
+// and the sink block acting for that element ever ask it, so no reader
+// can consume another element's request.
+bool ReynardMSEWantsFreshSinkFor(uint64_t aElement);
+
+// COMPOSITOR-SIDE STATE FOR THE REFUSAL POLL - see the poll in
+// NativeLayerCA::ApplyChanges and the sink block in
+// NativeLayerCARepresentation::ApplyChanges. File-scope rather than
+// function-local because the poll that raises them and the block that
+// acts on them are two functions apart. Touched only from commit
+// passes, which is the same exposure every reynard static in this
+// file already accepts.
+//
+// The latch: a refusal has been consumed from the parser and the
+// rebuild it demands has not built the fresh sink yet. The parser's
+// flag clears on read - whoever asks owns the answer - and the asker
+// (the poll) and the actor (the sink block) run a scrap apart, so the
+// consumed answer is parked here in between.
+static bool reynardMSESinkRefused = false;
+
+// Whether the last sink the block handed out was BUILT rather than
+// reused. A refusal against a freshly built sink cannot be an
+// ownership problem - a brand new layer has established no content
+// protection - so the poll leaves the flag alone in that state,
+// exactly as the swap this replaces declined to swap on a fresh one:
+// rebuilding on such a refusal is how a persistent non-ownership
+// failure becomes a rebuild on every commit.
+// REYNARD: consecutive rebuilds forced by a refusal.
+//
+// ADDED - see mse_fix_201's docstring. This replaces
+// reynardMSESinkWasFresh, which was meant to stop a refusal against a
+// brand new sink churning the compositor and instead stopped the poll
+// firing at all: it was written only inside the sink block, the sink
+// block runs only inside a rebuild, and the poll was the thing that
+// forced one. A built sink disabled the poll permanently.
+//
+// Bounded explicitly instead. The budget is restored only on evidence
+// that the route is working - a live picture at a commit where nobody
+// is asking for a fresh sink - so churn cannot reset its own budget.
+static int reynardMSEFreshSinkRebuilds = 0;
+static const int reynardMSEFreshSinkRebuildCap = 3;
+
+// ONE SINK PER ELEMENT - see stage2_one_sink_per_element.py's docstring.
+//
+// The sink used to be one static for the whole app, handed to whichever
+// site built a protected layer next - which is how one site's frames and
+// content protection reached another's picture. WebKit gives each media
+// player its own AVSampleBufferDisplayLayer, and so does this, keyed by
+// the element key ReynardProtectedPlaceholderDecoder stamps on the frame:
+// (content child id << 32) | a serial for the element's ImageContainer,
+// new for every load(). Kept across NativeLayerCA rebuilds exactly as the
+// static was, so the media controls coming up still REUSE the element's
+// own sink - fix 175's reason for making it static at all.
+//
+// A frame with NO key takes the old static in the sink block instead,
+// unchanged: the fallback for a content process built without stage 1.
+//
+// The table holds one reference to each sink. A representation showing
+// one holds its own, so an eviction never pulls a layer out from under
+// the screen; it only means that element builds afresh at its next
+// rebuild. Eight slots, least recently built-or-reused evicted first.
+// Touched only from commit passes, like every reynard static here.
+struct ReynardMSEElementSink {
+  uint64_t element;  // 0: unused
+  AVSampleBufferDisplayLayer* sink;
+  // The front surface last checked against `element`, so the poll reads
+  // a surface's key once, when the surface changes, not every commit.
+  uint32_t surfaceID;
+  // A refusal the poll consumed that the sink block has not acted on
+  // yet - this element's own reynardMSESinkRefused.
+  bool refused;
+  uint64_t usedAt;
+};
+static const size_t reynardMSEElementSinkSlots = 8;
+static ReynardMSEElementSink
+    reynardMSEElementSinks[reynardMSEElementSinkSlots] = {};
+static uint64_t reynardMSEElementSinkClock = 0;
+// Guards the table above. Every NativeLayerCA in the process shares
+// it, and two roots - the phone window and CarPlay - can commit on
+// different threads: the compositor thread through
+// NativeLayerRootRemoteMacParent, the main thread through nsWindow.
+// Held only around the two blocks that touch the table, the
+// per-commit poll and the sink block, never across a
+// representation's ApplyChanges. The parser calls made under it take
+// only FairPlayStreamParser's freshSinkLock, and nothing holding
+// that lock reaches this table, so the order cannot invert.
+static StaticMutex sReynardMSEElementSinkMutex;
+
+// The element key on a placeholder surface, or 0 if it carries none.
+static uint64_t ReynardMSEElementOf(IOSurfaceRef aSurface) {
+  if (!aSurface) {
+    return 0;
+  }
+  uint64_t key = 0;
+  CFTypeRef element =
+      IOSurfaceCopyValue(aSurface, CFSTR("ReynardMSEElement"));
+  if (element && CFGetTypeID(element) == CFNumberGetTypeID()) {
+    int64_t value = 0;
+    if (CFNumberGetValue((CFNumberRef)element, kCFNumberSInt64Type,
+                         &value)) {
+      key = static_cast<uint64_t>(value);
+    }
+  }
+  if (element) {
+    CFRelease(element);
+  }
+  return key;
+}
+
+static ReynardMSEElementSink* ReynardMSEFindElementSink(uint64_t aElement) {
+  if (!aElement) {
+    return nullptr;
+  }
+  for (auto& slot : reynardMSEElementSinks) {
+    if (slot.element == aElement) {
+      return &slot;
+    }
+  }
+  return nullptr;
+}
+
+// Whose sink a layer is, if it is an element's.
+static ReynardMSEElementSink* ReynardMSEFindSinkLayer(CALayer* aLayer) {
+  if (!aLayer) {
+    return nullptr;
+  }
+  for (auto& slot : reynardMSEElementSinks) {
+    if (slot.element && slot.sink && slot.sink == aLayer) {
+      return &slot;
+    }
+  }
+  return nullptr;
+}
+
+// A slot for an element that has none: an unused one, else the least
+// recently used, whose sink loses the table's reference here.
+static ReynardMSEElementSink* ReynardMSEClaimElementSink(uint64_t aElement) {
+  ReynardMSEElementSink* slot = nullptr;
+  for (auto& candidate : reynardMSEElementSinks) {
+    if (!candidate.element) {
+      slot = &candidate;
+      break;
+    }
+    if (!slot || candidate.usedAt < slot->usedAt) {
+      slot = &candidate;
+    }
+  }
+  if (slot->element) {
+    printf_stderr(
+        "NativeLayerCA: making room - element child-%llu#%llu's sink "
+        "leaves the table, and that element builds a fresh one if it is "
+        "shown again\n",
+        (unsigned long long)(slot->element >> 32),
+        (unsigned long long)(slot->element & 0xffffffffULL));
+    [slot->sink release];
+  }
+  *slot = ReynardMSEElementSink{};
+  slot->element = aElement;
+  return slot;
+}
