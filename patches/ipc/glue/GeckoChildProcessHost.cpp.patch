 void GeckoChildProcessHost::SetAlreadyDead() {
+#if defined(XP_IOS)
+  // C4 - declared BEFORE the write lock so that it is destroyed AFTER
+  // it. NSExtensionProcess::Invalidate() dispatch_syncs onto
+  // ExtensionLaunchQueue and kills the extension from there; run under
+  // the lock, every mHandleLock reader waits out that whole round
+  // trip. The member is still cleared under the lock below - it is
+  // MOZ_GUARDED_BY(mHandleLock) and cannot be touched outside it - so
+  // only the ObjC teardown moves, and it still completes before this
+  // function returns. Callers see no ordering change.
+  //
+  // Upstream's lock is function-scoped and the rest of this body is
+  // not ours to reindent, which is why this is a ScopeExit rather than
+  // an inner scope like ForceInvalidateForTermination below.
+  Maybe<NSExtensionProcess> deadExtensionProcess;
+  auto invalidateAfterUnlock = mozilla::MakeScopeExit([&] {
+    if (deadExtensionProcess) {
+      deadExtensionProcess->Invalidate();
+    }
+  });
+#endif
+
   mozilla::AutoWriteLock handleLock(mHandleLock);
+
+#if defined(XP_IOS)
+  // A child known dead still holds its NSExtension registration, and
+  // ExtensionFoundation sync-XPCs every registered extension on scene
+  // transitions - so do the ForceInvalidateForTermination teardown here,
+  // under the same write lock, instead of waiting for
+  // ~GeckoChildProcessHost.
+  if (mForegroundCapabilityGrant) {
+    mForegroundCapabilityGrant.reset();
+  }
+  if (mNSExtensionProcess) {
