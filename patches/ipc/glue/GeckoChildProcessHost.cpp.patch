+#ifdef XP_IOS
+static StaticMutex sChildJITPipeMutex;
+static std::unordered_map<int32_t, UniqueFileHandle> sChildJITPipeWriters;
+
+// ADDED - see fix_gecko_lifetime_and_lock_hold.py's docstring, M21.
+//
+// The readiness pipe's write end is registered in DoLaunch's bootstrap
+// reply and taken back out by exactly one function in this file:
+// widget::ReportJITStatusForChild, just below, which is single-use per
+// pid. Nothing removed an entry when a child died, so every child that
+// was never reported on - every non-content child, and every content
+// child torn down before its report - held one open fd and one map
+// entry for the life of the parent process.
+//
+// erase() on a key that was never inserted is a no-op, so every
+// teardown path can call this unconditionally, including with an
+// already-zeroed process handle and including twice.
+static void ForgetChildJITPipe(int32_t aPid) {
+  StaticMutexAutoLock lock(sChildJITPipeMutex);
+  sChildJITPipeWriters.erase(aPid);
+}
+
+// ADDED - see fix_gecko_lifetime_and_lock_hold.py's docstring, C4.
+//
+// Take the caller's ExtensionProcess and invalidate it from a global
+// queue. Two callers need this, for two different reasons, and both
+// are deadlock avoidance rather than politeness:
+//
+//  * ~GeckoChildProcessHost holds mHandleLock across its whole
+//    teardown block. NSExtensionProcess::Invalidate() dispatch_syncs
+//    onto ExtensionLaunchQueue and kills the extension from there, so
+//    calling it inline parks every mHandleLock reader behind a
+//    cross-queue round trip plus a SIGKILL.
+//  * The bootstrap reply block runs on the child's own libxpc
+//    connection queue, and -invalidate releases the NSXPCConnection
+//    wrapping that same connection. NSExtensionUtils.mm documents that
+//    as unsafe from the connection's own handler queue.
+//
+// The block owns the only remaining reference, so the ExtensionProcess
+// outlives whatever handed it over. Takes a reference and empties it,
+// so callers cannot leave a dangling second owner behind.
+static void InvalidateExtensionProcessOffQueue(
+    Maybe<NSExtensionProcess>& aProcess) {
+  if (!aProcess) {
+    return;
+  }
+
+  auto owned = std::make_shared<NSExtensionProcess>(*aProcess);
+  aProcess.reset();
+  dispatch_async(dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{
+    owned->Invalidate();
+  });
+}
+
+}  // namespace ipc
