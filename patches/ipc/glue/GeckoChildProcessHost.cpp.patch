+#if defined(XP_IOS)
+void GeckoChildProcessHost::ForceInvalidateForTermination() {
+  // C4 - the ObjC teardown must not run under mHandleLock. It
+  // dispatch_syncs onto ExtensionLaunchQueue and SIGKILLs the
+  // extension from there, and nsAppShell's ApplicationWillTerminate
+  // drives this one host at a time, serially, on the main thread,
+  // inside GetAll - which holds the process-list StaticMutex for the
+  // whole loop. Everything the write lock actually protects stays in
+  // the inner scope; the extension is handed to a local and
+  // invalidated once the lock is gone.
+  //
+  // Still SYNCHRONOUS, deliberately. This is the app-termination path
+  // and its entire purpose is that every extension is dead before the
+  // process is; work posted to another queue here would simply never
+  // run.
+  Maybe<NSExtensionProcess> deadExtensionProcess;
+
+  {
+    mozilla::AutoWriteLock handleLock(mHandleLock);
+
+    if (mForegroundCapabilityGrant) {
+      mForegroundCapabilityGrant.reset();
+    }
+    if (mNSExtensionProcess) {
+      deadExtensionProcess.emplace(*mNSExtensionProcess);
+      mNSExtensionProcess.reset();
+    }
+    if (mXPCConnection) {
+      xpc_connection_cancel(mXPCConnection.get());
+      mXPCConnection = nullptr;
+    }
+
+    // M21 - the app is terminating; release the readiness pipe with
+    // everything else.
+    ForgetChildJITPipe(static_cast<int32_t>(mChildProcessHandle));
+
+    if (mChildProcessHandle &&
+        mChildProcessHandle != base::kInvalidProcessHandle) {
+      base::CloseProcessHandle(mChildProcessHandle);
+      mChildProcessHandle = 0;
+    }
+  }
+
+  if (deadExtensionProcess) {
+    deadExtensionProcess->Invalidate();
+  }
+}
+#endif
