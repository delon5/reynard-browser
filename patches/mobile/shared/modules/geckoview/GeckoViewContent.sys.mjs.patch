+  async _getFocusedInputMetrics(aCallback) {
+    try {
+      if (this.window.windowUtils.isMozAfterPaintPending) {
+        // Same reasoning as the child's frame wait: MozAfterPaint never
+        // arrives if nothing repaints, and awaiting it unconditionally
+        // hangs the query - and with it the embedder's await - forever.
+        await new Promise(resolve => {
+          let settled = false;
+          const done = () => {
+            if (!settled) {
+              settled = true;
+              this.window.removeEventListener("MozAfterPaint", done, {
+                capture: true,
+              });
+              resolve();
+            }
+          };
+          this.window.addEventListener("MozAfterPaint", done, {
+            capture: true,
+            once: true,
+          });
+          this.window.setTimeout(done, 200);
+        });
+      }
+      const actor =
+        Services.focus.focusedContentBrowsingContext?.currentWindowGlobal?.getActor(
+          "GeckoViewContent"
+        );
+      aCallback.onSuccess(actor ? await actor.sendQuery("GetFocusedInputMetrics") : null);
+    } catch (error) {
+      aCallback.onError(`Cannot get focused input metrics, error: ${error}`);
+    }
+  }
