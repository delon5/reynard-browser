+  async _fillOneTimeCode(aData, aCallback) {
+    try {
+      const result = await gAutofillManager.fillOneTimeCode(
+        aData.sessionId,
+        aData.fieldUuid,
+        aData.value
+      );
+      aCallback.onSuccess(result ?? false);
+    } catch (error) {
+      aCallback.onError(`Cannot fill one-time code, error: ${error}`);
+    }
+  }
