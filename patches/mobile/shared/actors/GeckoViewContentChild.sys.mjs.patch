+      // fails it, a bottom bar and a corner button both pass.
+      const bottomBand = 8;
+      for (const fraction of [0.15, 0.5, 0.85]) {
+        let element = document.elementFromPoint(width * fraction, height - 2);
+        while (
+          element &&
+          element !== document.documentElement &&
+          element !== document.body
