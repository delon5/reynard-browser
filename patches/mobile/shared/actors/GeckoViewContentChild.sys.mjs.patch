+  WebKitMediaKeySession.prototype.close = function () {
+    if (this._session) {
+      try {
+        // close() returns a PROMISE. The try/catch below only ever
+        // caught a synchronous throw, so a rejection went unhandled
+        // and surfaced in the device log as
+        //
+        //   InvalidStateError: MediaKeySession.Close() called before
+        //   sessionId set by CDM
+        //
+        // which is a symptom of the licence exchange never starting,
+        // not a fault of its own - but one worth not printing.
+        var closing = this._session.close();
+        if (closing && typeof closing.catch === "function") {
+          closing.catch(function () {});
+        }
+      } catch (e) {}
+    }
+  };
+
+  // ---- WebKitMediaKeys ---------------------------------------------------
+
+  function WebKitMediaKeys(keySystem) {
+    if (!(this instanceof WebKitMediaKeys)) {
+      throw new TypeError("WebKitMediaKeys requires 'new'");
+    }
+    debug("new WebKitMediaKeys(" + keySystem + ")");
+    this.keySystem = keySystem;
+    this._keys = null;
+    this._failure = null;
+    this._waiters = [];
+
+    var self = this;
+    var config = [
+      {
+        initDataTypes: ["skd", "sinf", "cenc"],
+        videoCapabilities: [{ contentType: 'video/mp4; codecs="avc1.4d401e"' }],
+        audioCapabilities: [{ contentType: 'audio/mp4; codecs="mp4a.40.2"' }],
