+  // properties would be invisible.
+  runUserScript(script) {
+    const { contentWindow } = this;
+    if (!contentWindow) {
+      return { ok: false, error: "no content window" };
+    }
+
+    if (typeof script !== "string" || !script.length) {
+      return { ok: false, error: "empty script" };
+    }
