+  async getFocusedInputMetrics() {
+    const { contentWindow } = this;
+    if (contentWindow) {
+      // Raced against a timer, deliberately. requestAnimationFrame does
+      // not fire for a document that is not painting - occluded, in a
+      // background tab, or throttled - so awaiting it unconditionally
+      // parked this query forever. On device that meant the focused
+      // input never lifted above the keyboard AND nothing was logged at
+      // either end, because the embedder's await never returned.
+      //
+      // Two frames still give layout a chance to settle when they do
+      // arrive; the timer only decides how long to wait for them.
+      await new contentWindow.Promise(resolve => {
+        let settled = false;
+        const done = () => {
+          if (!settled) {
+            settled = true;
+            resolve();
+          }
+        };
+        contentWindow.requestAnimationFrame(() => {
+          contentWindow.requestAnimationFrame(done);
+        });
+        contentWindow.setTimeout(done, 200);
+      });
+    }
+
+    const focusedElement = Services.focus.focusedElement || contentWindow?.document?.activeElement;
+    if (!this.isFocusedEditableElement(focusedElement)) {
+      // A reason rather than a bare null: the embedder cannot otherwise
+      // tell "nothing is focused" from "focused, but this engine did not
+      // consider it editable", and those need different fixes.
+      return {
+        reason: focusedElement
+          ? `not editable: <${focusedElement.localName}> contentEditable=${focusedElement.isContentEditable}`
+          : "no focused element",
+      };
+    }
+
+    const win = focusedElement.ownerGlobal || focusedElement.documentGlobal;
+    if (!win) {
+      return { reason: "focused element has no window" };
+    }
+
+    const viewportHeight =
+      win.visualViewport?.height || win.innerHeight;
+    if (!viewportHeight || viewportHeight <= 0) {
+      return { reason: "viewport height unavailable" };
+    }
