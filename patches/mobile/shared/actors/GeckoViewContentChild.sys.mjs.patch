+    // different thing from the position on screen, which is what the
+    // embedder applies it to. inSubframe is what distinguishes that case.
+    return {
+      bottomRatio: Math.max(0, Math.min(2, bounds.bottom / viewportHeight)),
+      tag: focusedElement.localName,
+      contentEditable: String(focusedElement.isContentEditable),
+      inSubframe: String(win.top !== win),
+      viewportHeight: String(Math.round(viewportHeight)),
+      boundsBottom: String(Math.round(bounds.bottom)),
+    };
+  }
