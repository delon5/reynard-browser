+  WebKitMediaKeySession.prototype.update = function (response) {
+    var self = this;
+    var bytes =
+      response instanceof Uint8Array
+        ? response
+        : new Uint8Array(response.buffer || response);
+    debug("update() with", bytes.byteLength, "bytes");
+    if (!this._session) {
+      this._fail(new Error("update() before the session was ready"));
+      return;
+    }
+    this._session.update(bytes).then(
+      function () {
+        debug("update resolved");
+        // keystatuseschange usually fires and raises webkitkeyadded; this
+        // is the belt-and-braces path for CDMs that do not report statuses.
+        var hasStatuses = false;
+        try {
+          self._session.keyStatuses.forEach(function () {
+            hasStatuses = true;
+          });
+        } catch (e) {}
+        if (!hasStatuses) {
+          self._dispatch(new Event("webkitkeyadded"));
+        }
+      },
+      function (err) {
+        self._fail(err);
+      }
+    );
+  };
