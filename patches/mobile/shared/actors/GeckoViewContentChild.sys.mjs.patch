+// Reynard: Apple's legacy prefixed EME (WebKitMediaKeys), implemented
+// over standard EME, for the Safari-targeted players that use it.
+//
+// Prime Video's HLS path calls video.webkitSetMediaKeys() and threw
+// "not a function" four times in one device capture. Everything under
+// it already works - the same log shows the AVPlayer pipeline taking a
+// native HLS stream, painting 1280x720 frames, raising the key request
+// and relaying it to the content process - so this one missing API is
+// what stops the licence exchange.
+//
+// Embedded rather than shipped as a resource:// file on purpose: no
+// jar.mn entry, no packaging step, nothing to get out of sync with the
+// actor that uses it.
+// Reynard: who is being denied?
+//
+// A capture carried 131497 "Permission denied to access object" errors -
+// about one per line of the whole log - starting right after the EME
+// shim installed, with Apple's own scripts throwing XHR errors
+// alongside them. That is a page whose JS is failing, not a page whose
+// media is.
+//
+// Gecko prints them with an empty filename and line 0, so nothing in
+// the log says who threw. This listener supplies the missing half:
+// source, line, column and the JS stack, which names the function and
+// the file.
+//
+// Twenty, then it stops. There are 131k; the first few carry the
+// diagnosis and the rest would bury it.
+let gReynardPermDeniedSeen = 0;
+let gReynardPermDeniedListener = null;
+
+function reynardWatchPermissionDenied() {
+  if (gReynardPermDeniedListener) {
+    return;
+  }
+  gReynardPermDeniedListener = {
+    QueryInterface: ChromeUtils.generateQI(["nsIConsoleListener"]),
+    observe(aMessage) {
+      try {
+        if (gReynardPermDeniedSeen >= 20) {
+          return;
+        }
+        if (!(aMessage instanceof Ci.nsIScriptError)) {
+          return;
+        }
+        if (!aMessage.errorMessage.includes("Permission denied")) {
+          return;
+        }
+        gReynardPermDeniedSeen++;
+        const n = gReynardPermDeniedSeen;
+        dump(
+          "permDenied #" +
+            n +
+            " at " +
+            (aMessage.sourceName || "<no source>") +
+            ":" +
+            aMessage.lineNumber +
+            ":" +
+            aMessage.columnNumber +
+            " - " +
+            aMessage.errorMessage +
+            "\n"
+        );
+        // The stack is the answer. nsIScriptError carries a SavedFrame
+        // when the throw had one; without it the error came from a
+        // context with no script, which is itself informative.
+        let frames = [];
+        let frame = aMessage.stack;
+        while (frame && frames.length < 12) {
+          frames.push(
+            (frame.functionDisplayName || "<anon>") +
+              "@" +
+              frame.source +
+              ":" +
+              frame.line
+          );
+          frame = frame.parent || frame.asyncParent;
+        }
+        dump(
+          "permDenied #" +
+            n +
+            " stack: " +
+            (frames.length ? frames.join(" | ") : "<none - no script frame>") +
+            "\n"
+        );
+        if (n === 20) {
+          dump("permDenied: 20 reported, no more will be\n");
+        }
+      } catch (e) {
+        dump("permDenied listener failed: " + e + "\n");
+      }
+    },
+  };
+  try {
+    Services.console.registerListener(gReynardPermDeniedListener);
+    dump("permDenied: listener installed in this content process\n");
+  } catch (e) {
+    gReynardPermDeniedListener = null;
+    dump("permDenied: listener could not be installed: " + e + "\n");
+  }
+}
+
+const WEBKIT_MEDIA_KEYS_SHIM = `
+/*
+ * webkitmediakeys-shim.js - Apple's legacy prefixed EME, implemented on
+ * top of standard EME.
+ *
+ * WHY
+ *   Safari-targeted FairPlay pages - Apple's own FPS sample among them -
+ *   do not use standard EME. They use the prefixed API:
+ *
+ *     video.addEventListener('webkitneedkey', e => {
+ *       if (!video.webkitKeys)
+ *         video.webkitSetMediaKeys(new WebKitMediaKeys('com.apple.fps.1_0'));
+ *       const session = video.webkitKeys.createSession('video/mp4', e.initData);
+ *       session.addEventListener('webkitkeymessage', …);  // SPC
+ *       session.update(ckc);
+ *     });
+ *
+ *   Gecko implements none of it, so those pages fail at feature
+ *   detection - before any of this browser's FairPlay work runs. The
+ *   prefixed API is a thin syntactic layer over standard EME, and the
+ *   standard path is proven working on device (access -> createMediaKeys
+ *   -> setServerCertificate -> generateRequest('skd') -> SPC -> CKC ->
+ *   key status usable), so this bridges the two.
+ *
+ * SCOPE
+ *   This changes WHICH PAGES can reach the pipeline. It does not change
+ *   what the pipeline can decrypt: native-HLS FairPlay works, MSE+
+ *   FairPlay (Netflix's shape) still cannot, because per-sample
+ *   decryption needs AVSampleBufferAttachContentKey, which Apple
+ *   authorizes only for WebKit.
+ *
+ * THE TRANSCODE THAT MATTERS
+ *   Safari's webkitneedkey initData is the skd:// URI in UTF-16 - Apple's
+ *   sample reads it back with 'new Uint16Array(initData.buffer)'. Standard
+ *   EME's 'encrypted' event here carries UTF-8, which is also what
+ *   generateRequest('skd') expects. So this shim transcodes UTF-8 -> UTF-16
+ *   when synthesising webkitneedkey, and UTF-16 -> UTF-8 when createSession
+ *   hands the data back. Get it wrong and the content id is mangled and the
+ *   key server rejects the SPC.
+ *
+ * USAGE
+ *   Load before page scripts (document-start). Idempotent and inert on a
+ *   browser that already has the real thing.
+ */
+(function () {
+  "use strict";
+
+  if (typeof window === "undefined" || window.WebKitMediaKeys) {
+    return;  // real Safari, or already installed
+  }
+  if (!window.MediaKeys || !navigator.requestMediaKeySystemAccess) {
+    return;  // no standard EME to build on
+  }
+
+  var LOG = "webkitEME:";
+  function debug() {
+    var args = [].slice.call(arguments);
+    try {
+      console.debug.apply(console, [LOG].concat(args));
+    } catch (e) {}
+    // console.debug does not reach a device capture, and being blind
+    // here is what made the certificate bug expensive to find: the
+    // log showed the pipeline stalling with no trace of what this
+    // shim had decided. __reynardEmeLog is exported into the sandbox
+    // by the actor and writes to stdout, beside the avPlayer: lines.
+    try {
+      if (typeof __reynardEmeLog === "function") {
+        __reynardEmeLog(args.join(" "));
+      }
+    } catch (e) {}
+  }
+
+  // ---- when did this document become activated -------------------------
+  //
+  // media.autoplay.default is 5 and the element still plays, because
+  // sticky activation is ORed in ahead of the blocking model. Whether
+  // that activation was INHERITED or EARNED decides the fix entirely -
+  // one is a local bug, the other means blocking_policy is the only
+  // lever left and CarPlay has to be considered.
+  //
+  // This script runs at DOMWindowCreated, before any page script and
+  // therefore before any gesture this document could have received, so
+  // the reading here is the document's state at birth. The VIDEO poll
+  // cannot answer it: it runs once a second and reports only on change,
+  // so its first line is already up to a second old and a tap inside
+  // that second is invisible.
+  var reynardActivationInstalledAt = Date.now();
+  var reynardWasActivated = false;
+  try {
+    var ua = navigator.userActivation;
+    reynardWasActivated = !!(ua && ua.hasBeenActive);
+    debug(
+      "activation at install hasBeenActive=" +
+        (ua ? (ua.hasBeenActive ? 1 : 0) : "?") +
+        " isActive=" +
+        (ua ? (ua.isActive ? 1 : 0) : "?") +
+        " readyState=" +
+        document.readyState
+    );
+  } catch (e) {}
+
+  // ---- what the page asked for, and what it was told --------------------
+  //
+  // The engine prints one side of this conversation - "emeAccess:
+  // GRANTED" - and nothing at all when a configuration is turned down.
+  // Netflix probes six hundred times, is granted fifteen distinct
+  // configurations, and then shows Error Code S7001 without ever
+  // requesting a licence, so a refusal is the only thing left it can be
+  // and it is exactly what no log carries.
+  //
+  // Wrapped here rather than in the engine because this is the outcome
+  // the PAGE saw, error name and message included, and because the
+  // engine line summarises away the three terms most likely to be the
+  // refusal: robustness, which it never prints; sessionTypes, of which
+  // it prints only a count; and distinctiveIdentifier/persistentState,
+  // which it does not mention.
+  //
+  // Deduplicated by configuration. Six hundred calls, fifteen distinct
+  // questions, and a log that repeats each one forty times answers
+  // nothing it did not answer the first time.
+  try {
+    var reynardMKSA = navigator.requestMediaKeySystemAccess;
+    if (typeof reynardMKSA === "function") {
+      var reynardMKSASeen = Object.create(null);
+      var reynardCap = function (c) {
+        var out = c && c.contentType ? String(c.contentType) : "?";
+        if (c && c.robustness) {
+          out += " r=" + c.robustness;
+        }
+        return out;
+      };
+      var reynardConfigs = function (configs) {
+        if (!configs || !configs.length) {
+          return "none";
+        }
+        return [].map
+          .call(configs, function (cfg) {
+            var parts = [];
+            if (cfg.initDataTypes) {
+              parts.push("init[" + [].join.call(cfg.initDataTypes, ",") + "]");
+            }
+            if (cfg.videoCapabilities) {
+              parts.push(
+                "v[" + [].map.call(cfg.videoCapabilities, reynardCap).join(" ") + "]"
+              );
+            }
+            if (cfg.audioCapabilities) {
+              parts.push(
+                "a[" + [].map.call(cfg.audioCapabilities, reynardCap).join(" ") + "]"
+              );
+            }
+            if (cfg.sessionTypes) {
+              parts.push("sess[" + [].join.call(cfg.sessionTypes, ",") + "]");
+            }
+            if (cfg.distinctiveIdentifier) {
+              parts.push("di=" + cfg.distinctiveIdentifier);
+            }
+            if (cfg.persistentState) {
+              parts.push("ps=" + cfg.persistentState);
+            }
+            return parts.join(" ");
+          })
+          .join(" | ");
+      };
+      var reynardSay = function (outcome, keySystem, summary, detail) {
+        var key = outcome + " " + keySystem + " " + summary;
+        if (reynardMKSASeen[key]) {
+          return;
+        }
+        reynardMKSASeen[key] = true;
+        debug("MKSA " + outcome, keySystem, summary, detail || "");
+      };
+      navigator.requestMediaKeySystemAccess = function (keySystem, configs) {
+        var summary;
+        try {
+          summary = reynardConfigs(configs);
+        } catch (e) {
+          summary = "<unreadable>";
+        }
+        return reynardMKSA.call(navigator, keySystem, configs).then(
+          function (access) {
+            reynardSay("GRANTED", keySystem, summary, "");
+            return access;
+          },
+          function (error) {
+            reynardSay(
+              "REFUSED",
+              keySystem,
+              summary,
+              "-> " +
+                ((error && error.name) || "?") +
+                ": " +
+                ((error && error.message) || "")
+            );
+            throw error;
+          }
+        );
+      };
+    }
+  } catch (e) {}
+
+  // ---- init-data encoding helpers ---------------------------------------
+
+  function bytesToUtf8(buf) {
+    var view = buf instanceof Uint8Array ? buf : new Uint8Array(buf);
+    try {
+      return new TextDecoder("utf-8").decode(view);
+    } catch (e) {
+      return "";
+    }
+  }
+
+  // Safari hands the URI back as UTF-16 code units; Apple's sample does
+  // String.fromCharCode.apply(null, new Uint16Array(initData.buffer)).
+  function utf16FromString(str) {
+    var units = new Uint16Array(str.length);
+    for (var i = 0; i < str.length; i++) {
+      units[i] = str.charCodeAt(i);
+    }
+    return new Uint8Array(units.buffer);
+  }
+
+  function stringFromUtf16(buf) {
+    var view = buf instanceof Uint8Array ? buf : new Uint8Array(buf);
+    if (view.byteLength % 2 !== 0) {
+      return "";
+    }
+    // The byteOffset may be non-zero, and Uint16Array demands alignment.
+    var copy = new Uint8Array(view);
+    var units = new Uint16Array(copy.buffer);
+    var out = "";
+    for (var i = 0; i < units.length; i++) {
+      out += String.fromCharCode(units[i]);
+    }
+    return out;
+  }
+
+  function utf8FromString(str) {
+    try {
+      return new TextEncoder().encode(str);
+    } catch (e) {
+      var out = new Uint8Array(str.length);
+      for (var i = 0; i < str.length; i++) {
+        out[i] = str.charCodeAt(i) & 0xff;
+      }
+      return out;
+    }
+  }
+
+  // ---- Apple's concatenated init data -----------------------------------
+  //
+  // The prefixed API has NO setServerCertificate - the method does not
+  // exist in it. A Safari-targeted page has exactly one channel for
+  // the FPS application certificate: it concatenates it INTO the init
+  // data handed to createSession.
+  //
+  //   [initData][u32le idLength][id][u32le certLength][cert]
+  //
+  // initData is the skd:// URI as UTF-16 code units, id is the content
+  // id as UTF-16, both lengths little-endian. That is Apple's
+  // concatInitDataIdAndCertificate() from the prefixed FPS sample.
+  //
+  // Reading it back matters twice over. The certificate is what
+  // FairPlayCDMProxy is waiting for - without it every key request
+  // parks at "no app certificate yet", no message is ever produced,
+  // the session never gets a sessionId, and the page's own timeout
+  // closes it. And the URI has to be separated out regardless,
+  // because generateRequest("skd") wants the bare URI, not the blob.
+
+  function readU32LE(bytes, offset) {
+    return (
+      (bytes[offset] |
+        (bytes[offset + 1] << 8) |
+        (bytes[offset + 2] << 16) |
+        (bytes[offset + 3] << 24)) >>>
+      0
+    );
+  }
+
+  function looksLikeDER(bytes) {
+    // An FPS application certificate is DER: SEQUENCE, long-form
+    // length. Not load-bearing - it only decides what gets logged -
+    // but it turns "we found something" into "we found a certificate".
+    return bytes.byteLength > 4 && bytes[0] === 0x30 && bytes[1] === 0x82;
+  }
+
+  function hexOf(bytes, from, count) {
+    var out = "";
+    for (var i = from; i < from + count && i < bytes.byteLength; i++) {
+      var h = bytes[i].toString(16);
+      out += (h.length < 2 ? "0" + h : h) + " ";
+    }
+    return out.replace(/ $/, "");
+  }
+
+  // Recover the three fields by ARITHMETIC, not by scanning.
+  //
+  // Two things rule scanning out. A 36-character content id has
+  // byteLength 72, so the length field after the prefix begins
+  // 0x48 0x00 - and 0x0048 is the perfectly printable UTF-16 unit
+  // 'H', which a printable-run scan would swallow. And the prefix may
+  // be EMPTY, which is the case that actually matters.
+  //
+  // Why empty. Gecko strips the init data from a cross-origin
+  // 'encrypted' event: HTMLMediaElement::DispatchEncrypted checks
+  // IsCORSSameOrigin() - NodePrincipal()->Subsumes(the decoder's
+  // content principal) - and, failing it, constructs the event with
+  // no data at all. Prime Video's HLS is served from a CDN origin
+  // while the document is www.primevideo.com, so it fails, and the
+  // capture reads
+  //
+  //   avPlayer:  dispatching 'encrypted' (skd, 42 bytes)
+  //   webkitEME: encrypted -> webkitneedkey, 0 bytes
+  //
+  // That is the normal case, not a fault: every streaming service
+  // serves media from a separate origin. The page does not need us to
+  // tell it the key URI - it wrote the playlist URL - so it carries
+  // on and concatenates Apple's structure with an empty prefix:
+  //
+  //   0 + 4 + 72 + 4 + 1169 = 1249 bytes, which is what was measured.
+  //
+  // Requiring the prefix to start "skd:" therefore threw away the one
+  // buffer carrying the certificate.
+  //
+  // Still no guessing: a split is accepted only when both declared
+  // lengths land exactly on the end of the buffer, and the id length
+  // is even because the id is UTF-16. Where more than one balances,
+  // the DER-looking certificate wins and the ambiguity is printed.
+  function parseAppleConcat(bytes) {
+    var total = bytes.byteLength;
+    var found = [];
+    for (var prefixLen = 0; prefixLen + 8 <= total; prefixLen += 2) {
+      var idLen = readU32LE(bytes, prefixLen);
+      if (idLen % 2 !== 0) {
+        continue;  // the content id is UTF-16, so its byte length is even
+      }
+      var certOff = prefixLen + 4 + idLen;
+      if (certOff + 4 > total) {
+        continue;
+      }
+      var certLen = readU32LE(bytes, certOff);
+      if (certLen === 0 || certOff + 4 + certLen !== total) {
+        continue;
+      }
+      found.push({
+        prefix: stringFromUtf16(bytes.subarray(0, prefixLen)),
+        id: stringFromUtf16(bytes.subarray(prefixLen + 4, certOff)),
+        certificate: bytes.slice(certOff + 4),
+      });
+    }
+    if (!found.length) {
+      return null;
+    }
+    for (var i = 0; i < found.length; i++) {
+      if (looksLikeDER(found[i].certificate)) {
+        if (found.length > 1) {
+          debug("note:", found.length, "layouts balanced; took the DER one");
+        }
+        return found[i];
+      }
+    }
+    debug("note:", found.length, "layouts balanced, none DER; took the first");
+    return found[0];
+  }
+
+  // What the page hands createSession() may be Apple's concatenation,
+  // or UTF-16 (a Safari-shaped page echoing our webkitneedkey), or
+  // UTF-8 (a page that built it itself). Normalise to what
+  // generateRequest wants, and surface any certificate found.
+  function normaliseInitData(initData) {
+    // ArrayBuffer.isView, not an instanceof Uint8Array test: this
+    // shim is evaluated in its own Cu.Sandbox realm, so a typed array
+    // the PAGE built is never an instance of OUR Uint8Array. That test
+    // always failed and took the .buffer branch, which spans the whole
+    // backing ArrayBuffer and throws away byteOffset/byteLength - a
+    // page passing a subarray view got foreign bytes on both ends and
+    // parseAppleConcat's length balance then rejected the lot.
+    // See fix_cross_realm_typed_array_view.py.
+    var bytes = ArrayBuffer.isView(initData)
+      ? new Uint8Array(initData.buffer, initData.byteOffset, initData.byteLength)
+      : new Uint8Array(initData);
+
+    var concat = parseAppleConcat(bytes);
+    if (concat) {
+      // Apple's sample puts the key URI in the prefix. The prefix is
+      // empty whenever Gecko stripped the init data from a
+      // cross-origin 'encrypted' event, so rebuild it from the
+      // content id - which is exactly the string extractContentId()
+      // took the id out of in the first place.
+      //
+      // This URI has to match the one the app process parked, or
+      // FairPlayCDMProxy will not pair the request with it. Both are
+      // on stdout now, so a mismatch is one line to spot.
+      var uri = concat.prefix;
+      var rebuilt = false;
+      if (uri.indexOf("skd:") !== 0) {
+        uri = "skd://" + concat.id;
+        rebuilt = true;
+      }
+      debug(
+        "createSession initData is Apple's concatenation;",
+        rebuilt ? "uri REBUILT from id:" : "uri from prefix:",
+        uri,
+        "| prefix",
+        concat.prefix.length,
+        "chars | cert",
+        concat.certificate.byteLength,
+        looksLikeDER(concat.certificate) ? "bytes (DER)" : "bytes (NOT DER)"
+      );
+      return {
+        type: "skd",
+        data: utf8FromString(uri),
+        certificate: concat.certificate,
+      };
+    }
+
+    var asUtf16 = stringFromUtf16(bytes);
+    if (asUtf16.indexOf("skd:") === 0 || asUtf16.indexOf("skd://") >= 0) {
+      debug("createSession initData looked UTF-16 skd:", asUtf16);
+      return { type: "skd", data: utf8FromString(asUtf16), certificate: null };
+    }
+    var asUtf8 = bytesToUtf8(bytes);
+    if (asUtf8.indexOf("skd:") === 0 || asUtf8.indexOf("skd://") >= 0) {
+      debug("createSession initData looked UTF-8 skd:", asUtf8);
+      return { type: "skd", data: bytes, certificate: null };
+    }
+    // Not an skd URI and not Apple's concatenation: fMP4 key id /
+    // sinf box. Passed through untouched.
+    //
+    // The hex is here because reaching this branch means every
+    // reading above was wrong, and a capture that shows only a byte
+    // count leaves the next round guessing at the layout again. Head
+    // and tail are enough to decode Apple's structure by hand: the
+    // trailer is the last four bytes' little-endian length plus its
+    // certificate.
+    debug(
+      "createSession initData is binary,",
+      bytes.byteLength,
+      "bytes | head",
+      hexOf(bytes, 0, 24),
+      "| tail",
+      hexOf(bytes, Math.max(0, bytes.byteLength - 8), 8)
+    );
+    return { type: "sinf", data: bytes, certificate: null };
+  }
+
+  // ---- isTypeSupported ---------------------------------------------------
+  //
+  // Prefixed isTypeSupported is SYNCHRONOUS; requestMediaKeySystemAccess is
+  // not. Answer optimistically for FairPlay key systems (this build
+  // supports com.apple.fps and its versioned aliases) and warm a cache in
+  // the background so later calls are truthful. Any other key system is
+  // answered false straight away: that is what Safari does, and it is
+  // where the probe below would land anyway once it rejects.
+
+  var supportCache = Object.create(null);
+
+  // Which key systems earn the optimistic answer. Mirrors
+  // IsFairPlayKeySystem in dom/media/eme/EMEUtils.cpp (added by
+  // patches/dom/media/eme/EMEUtils.cpp.patch): the bare name, or any
+  // versioned alias under it - 1_0, 2_0, 3_0. Duplicated here by hand
+  // because page script has no synchronous way to ask the engine,
+  // which is the reason this cache exists at all. ADDED - see
+  // fix_is_type_supported_checks_key_system.py's docstring.
+  function isFairPlayKeySystem(keySystem) {
+    return (
+      keySystem === "com.apple.fps" ||
+      (typeof keySystem === "string" &&
+        keySystem.indexOf("com.apple.fps.") === 0)
+    );
+  }
+
+  function warmSupport(keySystem, contentType) {
+    var key = keySystem + "|" + (contentType || "");
+    if (key in supportCache) {
+      return;
+    }
+    // CHANGED - the optimistic seed is FairPlay-only now. It used to be
+    // written for every key system before the probe was even fired, so
+    // isTypeSupported("com.widevine.alpha") - or any string at all -
+    // answered true on the first call and stayed wrong until the
+    // rejection landed. Safari says false to those, synchronously,
+    // every time. See fix_is_type_supported_checks_key_system.py.
+    if (!isFairPlayKeySystem(keySystem)) {
+      supportCache[key] = false;
+      return;
+    }
+    supportCache[key] = true;
+    var config = [
+      {
+        initDataTypes: ["skd", "sinf", "cenc"],
+        videoCapabilities: [
+          { contentType: contentType || 'video/mp4; codecs="avc1.4d401e"' },
+        ],
+      },
+    ];
+    navigator.requestMediaKeySystemAccess(keySystem, config).then(
+      function () {
+        supportCache[key] = true;
+      },
+      function (err) {
+        debug("isTypeSupported cache:", keySystem, "unsupported:", err && err.name);
+        supportCache[key] = false;
+      }
+    );
+  }
+
+  // ---- WebKitMediaKeySession --------------------------------------------
+
