+  // out on iOS and the only reinit trigger lives in the input render
+  // path, which a playback-only stream never reaches.
+  //
+  // A route swap changes output latency by an order of magnitude - a few
+  // ms on the built-in speaker against hundreds on CarPlay or Bluetooth.
+  // Holding the stale small value made the audio look further along than
+  // it was, so video ran ahead of the sound actually leaving the
+  // speakers. cubeb_ios_cached_output_latency_frames is a plain atomic
+  // load kept current by an AVAudioSessionRouteChangeNotification
+  // observer, so this is realtime-safe - no Objective-C on this thread.
+  //
+  // unit_latency_frames is the AudioUnit's own contribution, measured
+  // once at setup and constant for the stream, so it is preserved across
+  // the refresh rather than being lost.
+  uint32_t route_latency = cubeb_ios_cached_output_latency_frames();
+  if (route_latency != 0) {
+    stm->current_latency_frames =
+        route_latency + stm->unit_latency_frames.load(memory_order_relaxed);
+  }
