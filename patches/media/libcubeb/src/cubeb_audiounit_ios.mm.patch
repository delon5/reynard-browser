+}  // namespace
+
+// Category/mode/channel configuration WITHOUT activating the session.
+//
+// Split out so device ENUMERATION can set up the category it needs to
+// read port lists without claiming the session. Activating from
+// enumeration meant that a page merely calling enumerateDevices()
+// interrupted whatever the user was listening to - the category is
+// .playback with no .mixWithOthers - without playing a single frame. It
+// also left an active session behind that nothing engine-side ever
+// deactivates, and with the app's "audio" UIBackgroundMode an active
+// session is a standing reason for iOS not to suspend the app.
+extern "C" void cubeb_ios_configure_audio_session_category(
+    bool aRecording, uint32_t aPreferredOutputChannels) {
+  AVAudioSession* session = [AVAudioSession sharedInstance];
+  NSError* error = nil;
+  NSString* category = aRecording ? AVAudioSessionCategoryPlayAndRecord
+                                  : AVAudioSessionCategoryPlayback;
+  NSString* mode =
+      aRecording ? AVAudioSessionModeDefault : AVAudioSessionModeMoviePlayback;
+  AVAudioSessionCategoryOptions options = 0;
+  if (aRecording) {
+    options = AVAudioSessionCategoryOptionDefaultToSpeaker |
+              AVAudioSessionCategoryOptionAllowBluetoothHFP |
+              AVAudioSessionCategoryOptionAllowBluetoothA2DP |
+              AVAudioSessionCategoryOptionAllowAirPlay;
+  }
+
+  [session setCategory:category mode:mode options:options error:&error];
+  if (aPreferredOutputChannels && session.maximumOutputNumberOfChannels > 0) {
+    NSInteger channels = MIN(static_cast<NSInteger>(aPreferredOutputChannels),
+                             session.maximumOutputNumberOfChannels);
+    if (channels > 0) {
+      [session setPreferredOutputNumberOfChannels:channels error:nil];
+    }
+  }
+}
+
+// Enumeration-only session setup: read-only wherever possible.
+//
+// The configurator above still REWRITES the shared session's category,
+// mode and options every time it runs - so a page calling
+// enumerateDevices() during mixing playback dropped .mixWithOthers
+// (options are hard-zero on the !aRecording path), and during a call
+// an output query tore down a live PlayAndRecord route. Enumeration
+// needs none of that: output ports come from currentRoute, readable
+// under any category, and availableInputs only needs a record-capable
+// category - which, if one is already set, must not be replaced.
+extern "C" void cubeb_ios_configure_audio_session_for_enumeration(
+    bool aRecording) {
+  if (!aRecording) {
+    return;
+  }
+  AVAudioSession* session = [AVAudioSession sharedInstance];
+  NSString* category = session.category;
+  if ([category isEqualToString:AVAudioSessionCategoryPlayAndRecord] ||
+      [category isEqualToString:AVAudioSessionCategoryRecord]) {
+    return;
+  }
+  // No record-capable category is set, so availableInputs would come
+  // back empty. Take the same category the stream configurator would,
+  // but keep whatever is already playing mixable alongside it - a
+  // device QUERY must not interrupt anyone's audio.
+  NSError* error = nil;
+  [session setCategory:AVAudioSessionCategoryPlayAndRecord
+                  mode:AVAudioSessionModeDefault
+               options:AVAudioSessionCategoryOptionDefaultToSpeaker |
+                       AVAudioSessionCategoryOptionAllowBluetoothHFP |
+                       AVAudioSessionCategoryOptionAllowBluetoothA2DP |
+                       AVAudioSessionCategoryOptionAllowAirPlay |
+                       AVAudioSessionCategoryOptionMixWithOthers
+                 error:&error];
+}
+
+extern "C" void cubeb_ios_activate_audio_session(
+    bool aRecording, uint32_t aPreferredOutputChannels) {
+  cubeb_ios_configure_audio_session_category(aRecording,
+                                             aPreferredOutputChannels);
+  NSError* error = nil;
+  [[AVAudioSession sharedInstance] setActive:YES error:&error];
+}
+
+extern "C" uint32_t cubeb_ios_session_sample_rate(void) {
+  AVAudioSession* session = [AVAudioSession sharedInstance];
+  return static_cast<uint32_t>(session.sampleRate);
+}
+
+extern "C" uint32_t cubeb_ios_copy_available_inputs(
+    cubeb_device_info** aDevices) {
+  if (!aDevices) {
+    return 0;
+  }
+
+  AVAudioSession* session = [AVAudioSession sharedInstance];
+  NSArray<AVAudioSessionPortDescription*>* availableInputs =
+      session.availableInputs;
+  if (!availableInputs.count) {
+    *aDevices = nullptr;
+    return 0;
+  }
+
+  NSString* preferredUID = session.preferredInput.UID;
+  if (!preferredUID.length) {
+    preferredUID = session.currentRoute.inputs.firstObject.UID;
+  }
+
+  cubeb_device_info* devices = new cubeb_device_info[availableInputs.count];
+  uint32_t sampleRate = cubeb_ios_session_sample_rate();
+  for (NSUInteger index = 0; index < availableInputs.count; ++index) {
+    AVAudioSessionPortDescription* port = availableInputs[index];
+    cubeb_ios_fill_input_device(&devices[index], port, preferredUID,
+                                sampleRate);
+  }
+
+  *aDevices = devices;
+  return static_cast<uint32_t>(availableInputs.count);
+}
+
+extern "C" uint32_t cubeb_ios_copy_available_outputs(
+    cubeb_device_info** aDevices) {
+  if (!aDevices) {
+    return 0;
+  }
+
+  AVAudioSession* session = [AVAudioSession sharedInstance];
+  NSArray<AVAudioSessionPortDescription*>* outputs =
+      session.currentRoute.outputs;
+  if (!outputs.count) {
+    *aDevices = nullptr;
+    return 0;
+  }
+
+  NSString* preferredUID = outputs.firstObject.UID;
+  cubeb_device_info* devices = new cubeb_device_info[outputs.count];
+  uint32_t sampleRate = cubeb_ios_session_sample_rate();
+  for (NSUInteger index = 0; index < outputs.count; ++index) {
+    AVAudioSessionPortDescription* port = outputs[index];
+    cubeb_ios_fill_output_device(&devices[index], port, preferredUID,
+                                 sampleRate, session);
+  }
+
+  *aDevices = devices;
+  return static_cast<uint32_t>(outputs.count);
+}
+
+extern "C" uint32_t cubeb_ios_max_output_channel_count(void) {
+  AVAudioSession* session = [AVAudioSession sharedInstance];
+  if (session.maximumOutputNumberOfChannels > 0) {
+    return static_cast<uint32_t>(session.maximumOutputNumberOfChannels);
+  }
+  return 2;
+}
+
+// Cached so the render callback can read it without touching
+// AVAudioSession, which is Objective-C and may allocate or take locks -
+// neither is legal on a realtime audio thread.
+static std::atomic<uint32_t> sCachedOutputLatencyFrames{0};
+
+static uint32_t cubeb_ios_query_output_latency_frames(void) {
+  AVAudioSession* session = [AVAudioSession sharedInstance];
+  double sampleRate = session.sampleRate;
+  if (sampleRate <= 0) {
+    sampleRate = 44100;
+  }
+  NSTimeInterval latency = session.outputLatency + session.IOBufferDuration;
+  if (latency <= 0) {
+    return 0;
+  }
+  return static_cast<uint32_t>(latency * sampleRate);
+}
+
+// Output latency is a property of the CURRENT ROUTE, and it changes by an
+// order of magnitude when one is swapped underneath a running stream: a
+// built-in speaker is a few milliseconds, CarPlay and Bluetooth are
+// hundreds.
+//
+// It used to be sampled once, during audiounit_setup_stream, and never
+// again. Nothing on iOS updated it: audiounit_install_device_changed_callback
+// is compiled out (#if !TARGET_OS_IPHONE), and the only reinit trigger is
+// in the INPUT render path, which a video playback stream never reaches
+// because it has no input unit.
+//
+// That matters because audiounit_stream_get_position reports
+// `frames_played - current_latency_frames`, and that is the clock the
+// media state machine syncs video to. Holding a stale, too-small latency
+// across a switch to CarPlay makes the audio look further along than it
+// is, so video is driven ahead of the sound actually coming out of the
+// speakers.
+static void cubeb_ios_refresh_output_latency(void) {
+  sCachedOutputLatencyFrames.store(cubeb_ios_query_output_latency_frames(),
+                                   std::memory_order_relaxed);
+}
+
+static void cubeb_ios_install_route_change_observer(void) {
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    [[NSNotificationCenter defaultCenter]
+        addObserverForName:AVAudioSessionRouteChangeNotification
+                    object:[AVAudioSession sharedInstance]
+                     queue:nil
+                usingBlock:^(NSNotification* note) {
+                  // Deliberately unconditional on the reason code. Every
+                  // reason that reaches here - new device available, old
+                  // device unavailable, category or override change - can
+                  // move the latency, and re-reading it is cheap.
+                  cubeb_ios_refresh_output_latency();
+                }];
+  });
+}
+
+extern "C" uint32_t cubeb_ios_output_latency_frames(void) {
+  // Called from stream setup, off the realtime thread, so the live query
+  // is safe here. Also the point where the observer gets installed.
+  cubeb_ios_install_route_change_observer();
+  uint32_t frames = cubeb_ios_query_output_latency_frames();
+  sCachedOutputLatencyFrames.store(frames, std::memory_order_relaxed);
+  return frames;
+}
+
+// Realtime-safe: a plain atomic load, no Objective-C.
+extern "C" uint32_t cubeb_ios_cached_output_latency_frames(void) {
+  return sCachedOutputLatencyFrames.load(std::memory_order_relaxed);
+}
+
+extern "C" bool cubeb_ios_copy_current_device_names(char** aInputName,
+                                                    char** aOutputName) {
+  AVAudioSession* session = [AVAudioSession sharedInstance];
+  if (aInputName) {
+    *aInputName = nullptr;
+    AVAudioSessionPortDescription* input =
+        session.currentRoute.inputs.firstObject;
+    if (input.portName.length) {
+      *aInputName = cubeb_ios_copy_string(input.portName);
+    }
+  }
+  if (aOutputName) {
+    *aOutputName = nullptr;
+    AVAudioSessionPortDescription* output =
+        session.currentRoute.outputs.firstObject;
+    if (output.portName.length) {
+      *aOutputName = cubeb_ios_copy_string(output.portName);
+    }
+  }
+  return true;
+}
+
+extern "C" bool cubeb_ios_set_preferred_input(cubeb_devid aDeviceId) {
+  AVAudioSession* session = [AVAudioSession sharedInstance];
+  uint32_t token =
+      static_cast<uint32_t>(reinterpret_cast<uintptr_t>(aDeviceId));
+  NSString* targetUID = cubeb_ios_uid_for_token(token);
+  AVAudioSessionPortDescription* preferredInput = nil;
+
+  if (targetUID.length) {
+    for (AVAudioSessionPortDescription* input in session.availableInputs) {
+      if ([input.UID isEqualToString:targetUID]) {
+        preferredInput = input;
+        break;
+      }
+    }
+    if (!preferredInput) {
+      return false;
+    }
+  }
+
+  NSError* error = nil;
+  BOOL success = [session setPreferredInput:preferredInput error:&error];
+  if (!success) {
+    return false;
+  }
+  return true;
+}
+#else
+#  import <AudioToolbox/AudioToolbox.h>
+
+static void cubeb_ios_ensure_audio_session_initialized() {
+  static bool sInitialized = false;
+  if (sInitialized) {
+    return;
+  }
+  AudioSessionInitialize(nullptr, nullptr, nullptr, nullptr);
+  sInitialized = true;
+}
+
+extern "C" void cubeb_ios_configure_audio_session_category(bool aRecording,
+                                                          uint32_t) {
+  cubeb_ios_ensure_audio_session_initialized();
+  UInt32 category = aRecording ? kAudioSessionCategory_PlayAndRecord
+                               : kAudioSessionCategory_MediaPlayback;
+  AudioSessionSetProperty(kAudioSessionProperty_AudioCategory, sizeof(category),
+                          &category);
+}
+
+extern "C" void cubeb_ios_configure_audio_session_for_enumeration(
+    bool aRecording) {
+  // Same symbol set as the iOS 14+ branch above - the caller in
+  // cubeb_audiounit.cpp is not conditional on the deployment target,
+  // so omitting this would be a link error on the fallback path. The
+  // old-API category property has no options to preserve, so the
+  // stream configurator's behaviour is the best available here.
+  if (!aRecording) {
+    return;
+  }
+  cubeb_ios_configure_audio_session_category(true, 0);
+}
+
+extern "C" void cubeb_ios_activate_audio_session(bool aRecording,
+                                                 uint32_t aChannels) {
+  // Defined in BOTH branches deliberately - the caller in
+  // cubeb_audiounit.cpp is not conditional on the deployment target, so
+  // omitting the configure-only entry point here is a link error on this
+  // fallback path.
+  cubeb_ios_configure_audio_session_category(aRecording, aChannels);
+  AudioSessionSetActive(true);
+}
+
+extern "C" uint32_t cubeb_ios_session_sample_rate(void) {
+  cubeb_ios_ensure_audio_session_initialized();
+  Float64 sample_rate = 0.0;
+  UInt32 size = sizeof(sample_rate);
+  if (AudioSessionGetProperty(kAudioSessionProperty_CurrentHardwareSampleRate,
+                              &size, &sample_rate) != noErr ||
+      sample_rate <= 0.0) {
+    return 44100;
+  }
+  return static_cast<uint32_t>(sample_rate);
+}
+
+extern "C" uint32_t cubeb_ios_copy_available_inputs(
+    cubeb_device_info** aDevices) {
+  if (aDevices) {
+    *aDevices = nullptr;
+  }
+  return 0;
+}
+
+extern "C" uint32_t cubeb_ios_copy_available_outputs(
+    cubeb_device_info** aDevices) {
+  if (aDevices) {
+    *aDevices = nullptr;
+  }
+  return 0;
+}
+
+extern "C" uint32_t cubeb_ios_max_output_channel_count(void) { return 2; }
+
+extern "C" uint32_t cubeb_ios_output_latency_frames(void) { return 0; }
+// Same symbol set as the iOS 14+ branch above - the caller in
+// cubeb_audiounit.cpp is not conditional on the deployment target,
+// so omitting this would be a link error on the fallback path.
+extern "C" uint32_t cubeb_ios_cached_output_latency_frames(void) {
+  return 0;
+}
+
+extern "C" bool cubeb_ios_copy_current_device_names(char** aInputName,
+                                                    char** aOutputName) {
+  if (aInputName) {
+    *aInputName = nullptr;
+  }
+  if (aOutputName) {
+    *aOutputName = nullptr;
+  }
+  return true;
+}
+
+extern "C" bool cubeb_ios_set_preferred_input(cubeb_devid) { return true; }
+#endif
