diff --git a/dom/media/MediaDecoder.h b/dom/media/MediaDecoder.h
index ae7c0aef711a..1a88c513f14f 100644
--- a/dom/media/MediaDecoder.h
+++ b/dom/media/MediaDecoder.h
@@ -174,7 +174,21 @@ class MediaDecoder : public DecoderDoctorLifeLogger<MediaDecoder> {
   // Pause video playback.
   virtual void Pause();
   // Adjust the speed of the playback, optionally with pitch correction,
-  void SetVolume(double aVolume);
+  // Virtual for AVPlayerDecoder, which forwards the element's volume to
+  // the AVPlayer actually producing the sound. Without that the page's
+  // mute button changed mVolume and nothing else, and the "Block Audio
+  // Only" autoplay setting - which Gecko implements as Allowed_muted,
+  // permitting the play only because it believes the element is
+  // inaudible - was defeated by a player that never heard about the
+  // volume at all.
+  virtual void SetVolume(double aVolume);
+
+  // Virtual for AVPlayerDecoder, the only override: one of the element's
+  // x-webkit-airplay / webkitwirelessvideoplaybackdisabled /
+  // disableremoteplayback attributes changed, and the player it drives
+  // has to hear whether it may still go external. A no-op for every
+  // decoder that renders locally.
+  virtual void NotifyExternalPlaybackPolicyChanged() {}
 
   void SetPlaybackRate(double aPlaybackRate);
   void SetPreservesPitch(bool aPreservesPitch);
@@ -446,7 +460,13 @@ class MediaDecoder : public DecoderDoctorLifeLogger<MediaDecoder> {
 
   AbstractThread* AbstractMainThread() const { return mAbstractMainThread; }
 
-  RefPtr<SetCDMPromise> SetCDMProxy(CDMProxy* aProxy);
+  // Virtual so a decoder that owns its own CDM can learn about the
+  // proxy. AVPlayerDecoder needs it: FairPlay decryption happens inside
+  // AVFoundation against a key session, and the asset must be
+  // registered on the SAME session the keys arrive on - which means the
+  // proxy has to be paired with one player, not published globally and
+  // hoped to be the right one.
+  virtual RefPtr<SetCDMPromise> SetCDMProxy(CDMProxy* aProxy);
 
   void EnsureTelemetryReported();
 
