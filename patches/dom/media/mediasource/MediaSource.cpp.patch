+/* static */
+bool MediaSource::VisibleForCurrentGlobal(JSContext* aCx, JSObject* aGlobal) {
+  // Reynard: hide MediaSource from documents whose UA override
+  // impersonates iPhone Safari. Real iPhone Safari has never exposed
+  // classic MSE, and a player that finds it under that UA selects
+  // MSE+FairPlay - which this engine cannot serve: sample-level
+  // FairPlay needs an authorization Apple does not grant outside
+  // WebKit. Hiding it steers players to native HLS + FairPlay, the
+  // path AVPlayerDecoder owns. The Pref= annotation still gates
+  // media.mediasource.enabled; this only adds UA consistency.
+  if (!StaticPrefs::media_reynard_mediasource_hide_for_iphone_ua()) {
+    return true;
+  }
+  nsGlobalWindowInner* win = xpc::WindowOrNull(aGlobal);
+  if (!win) {
+    // Not a window global. MediaSource is Window-only today, so this
+    // is belt and braces.
+    return true;
+  }
+  nsIDocShell* docShell = win->GetDocShell();
+  if (!docShell) {
+    return true;
+  }
+  nsString customUserAgent;
+  docShell->GetBrowsingContext()->GetCustomUserAgent(customUserAgent);
+  // Every Safari shape, not just the iPhone one.
+  //
+  // The original test was `Find("iPhone")`, which was right when the
+  // only Safari spoof available contained it. iPadOS Safari sends a
+  // MACINTOSH user agent - that is what makes it desktop-class, and
+  // what gets it past a site's mobile-app gate - so it walked straight
+  // through, MSE stayed visible, and max.com's player chose
+  // MSE+FairPlay: a path that ends at FairPlayCDMProxy::Decrypt's
+  // MOZ_ASSERT_UNREACHABLE, because FairPlay never hands out a clear
+  // sample. "Couldn't Play Content" on a page that had otherwise
+  // authenticated, entitled and loaded.
+  //
+  // Chrome is excluded deliberately: its UA also carries "Macintosh"
+  // and "Safari", but a page given a Chrome UA expects Widevine, and
+  // taking MSE away from it breaks the ordinary non-DRM video that
+  // would otherwise work. Firefox desktop spoofs carry "Macintosh"
+  // without "Safari", so they are unaffected either way.
+  //
+  // An empty override is the native UA and is never hidden from - this
+  // only ever applies to a document that was given an override.
+  const bool isSafariSpoof =
+      customUserAgent.Find(u"iPhone"_ns) != kNotFound ||
+      customUserAgent.Find(u"iPad"_ns) != kNotFound ||
+      (customUserAgent.Find(u"Macintosh"_ns) != kNotFound &&
+       customUserAgent.Find(u"Safari"_ns) != kNotFound &&
+       customUserAgent.Find(u"Chrome"_ns) == kNotFound);
+  return !isSafariSpoof;
+}
