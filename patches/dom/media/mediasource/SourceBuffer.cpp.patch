diff --git a/dom/media/mediasource/SourceBuffer.cpp b/dom/media/mediasource/SourceBuffer.cpp
index d79526afbbfa..cb10fad683d0 100644
--- a/dom/media/mediasource/SourceBuffer.cpp
+++ b/dom/media/mediasource/SourceBuffer.cpp
@@ -446,7 +446,35 @@ void SourceBuffer::Detach() {
   if (!mMediaSource) {
     MSE_DEBUG("Already detached");
     return;
   }
+  // Reynard: the page is finished with this SourceBuffer.
+  //
+  // MediaSource::Detach reaches here for every buffer it owns, and so
+  // does cycle-collection unlink. RemoveSourceBuffer does NOT - it
+  // aborts the append and drops the buffer from mSourceBuffers - so
+  // that path has a call of its own; see MediaSource.cpp.
+  //
+  // The app process keeps an AVStreamDataParser, an
+  // AVSampleBufferDisplayLayer and an AVSampleBufferAudioRenderer per
+  // SourceBuffer, keyed on THIS pointer - see AppendData below, which
+  // sends the same value as the stream id. Nothing ever told it they
+  // were finished with. A parser holds what it has been given and
+  // hands it over as the sink asks for it, so an abandoned one kept a
+  // display layer and an audio renderer fed for another thirty
+  // seconds, at a completely different point in the film - two
+  // pictures and two soundtracks from one presentation.
+  //
+  // Before the teardown below, so `this` is still the object the app
+  // process has under that key.
+  //
+  // A block-scope declaration names the ENCLOSING namespace, which
+  // here is mozilla::dom - the same reason AppendData's declaration is
+  // spelled this way rather than with extern "C", which is not
+  // permitted at block scope.
+  {
+    extern void ReynardMSEForwardRetire(uintptr_t aStreamId);
+    ReynardMSEForwardRetire(reinterpret_cast<uintptr_t>(this));
+  }
   AbortBufferAppend();
   if (mTrackBuffersManager) {
     mMediaSource->GetDecoder()->GetDemuxer()->DetachSourceBuffer(
@@ -568,6 +596,181 @@ void SourceBuffer::AppendData(RefPtr<MediaByteBuffer>&& aData,
   MOZ_ASSERT(NS_IsMainThread());
   MSE_DEBUG("AppendData(aLength=%zu)", aData->Length());
 
+  // Reynard: what the page actually appends, for the FairPlay MSE route.
+  //
+  // AVStreamDataParser originates a key request from an INIT SEGMENT -
+  // fragmented MP4, ftyp/moov carrying sinf - proven on device with
+  // Apple's 19996-byte FPS sample. What FairPlayCDMProxy can forward
+  // today is EME init data, which for cenc is a ~104-byte PSSH box, and
+  // the parser produces nothing from it: no key request, no error.
+  //
+  // Before building a tap that forwards these buffers, this says whether
+  // the bytes are the right shape at all - whether tv.apple.com's append
+  // looks like Apple's sample or like something the parser declines. The
+  // top-level box type is the answer, and in an MP4 it is the four bytes
+  // after a big-endian length.
+  //
+  // Every append, not only the first: which one carries the init segment
+  // is exactly what is not known yet, and arrival order is an assumption
+  // rather than a guarantee. One line per append, and appends are per
+  // segment rather than per frame, so the cost is nil.
+  {
+    const size_t mseLength = aData->Length();
+    char mseBox[5] = {'?', '?', '?', '?', '\0'};
+    if (mseLength >= 8) {
+      memcpy(mseBox, aData->Elements() + 4, 4);
+      for (size_t i = 0; i < 4; i++) {
+        if (mseBox[i] < 0x20 || mseBox[i] > 0x7e) {
+          mseBox[i] = '.';
+        }
+      }
+    }
+    printf_stderr("mseAppend: %zu bytes box=%s\n", mseLength, mseBox);
+
+    // And forward it, when it is the thing AVStreamDataParser can
+    // actually use. See fix_forward_init_segment_to_parser.py.
+    //
+    // The parser is not optional after all: the session resolves a
+    // key requirement a recipient has raised, it does not originate
+    // one, so processContentKeyRequest on EME init data produced
+    // nothing across two builds. Only a parsed init segment has ever
+    // made a key request appear on this device.
+    //
+    // ftyp or moov only, and small. Media fragments are moof and run
+    // to megabytes - one append in the capture was 7.1 MB - and
+    // shipping those across IPC would be a real cost for bytes the
+    // parser has no use for. The cap is a belt to the type test.
+    //
+    // Declared here rather than included: this file does not pull in
+    // ContentChild.h and does not need to for one call.
+    //
+    // AND EVERY MEDIA FRAGMENT.
+    //
+    // This used to forward eight and then stop for the life of the
+    // process, and the eight were the whole of it:
+    //
+    //     mseAppend: forwarding media fragment 8/8, 1061772 bytes
+    //                (2525780 total)
+    //     mseAppend: fragment budget spent - no more will be forwarded
+    //                this process
+    //
+    // followed by thirteen more appends the parser never saw. The
+    // display layer drained what it already held, reached sample 428 and
+    // ran out, which is the fifteen seconds of picture that capture got.
+    // Nothing else in it was unhealthy - drift never went positive, no
+    // discontinuity, no decode failure, no refusal.
+    //
+    // The budget was right when it was written, and said so: "this is a
+    // measurement, not a pipeline. If samples come back the pipeline is
+    // worth building and this goes away". Samples come back. They
+    // decode, they go into a layer the compositor places at the
+    // element's position, and there is sound. The condition it set for
+    // its own removal has been met.
+    //
+    // Six of those eight also went to audio: a page appends audio and
+    // video to separate SourceBuffers and these counters are static per
+    // PROCESS, so small audio fragments spent three quarters of the
+    // budget and exactly two video fragments were forwarded. Two is not
+    // a sequence, which is the skipping as well as the stop.
+    //
+    // What stays is the per-append cap. That is a sanity limit on a
+    // single buffer crossing IPC rather than a total, and nothing
+    // legitimate approaches it - the largest fragment in any capture so
+    // far is 1.2 MB. A fragment that DOES exceed it is now said out
+    // loud: on its own it would be a hole in the middle of a stream with
+    // nothing to explain it, and under the old budget that case was
+    // indistinguishable from the budget itself.
+    //
+    // The counters stay too, and now only report. Eight lines at the
+    // start and one every fiftieth after that: this is a per-segment
+    // event on a route that runs for the length of a film, and the point
+    // of the line is to show it is still running.
+    static unsigned sForwardedFragments = 0;
+    static size_t sForwardedBytes = 0;
+    constexpr size_t kMaxFragmentBytes = 16 * 1024 * 1024;
+    const bool mseIsInit = memcmp(mseBox, "ftyp", 4) == 0 ||
+                           memcmp(mseBox, "moov", 4) == 0;
+    const bool mseIsMedia = memcmp(mseBox, "moof", 4) == 0;
+    const bool mseForwardMedia = mseIsMedia && mseLength <= kMaxFragmentBytes;
+    if (mseForwardMedia) {
+      sForwardedFragments++;
+      sForwardedBytes += mseLength;
+      if (sForwardedFragments <= 8 || sForwardedFragments % 50 == 0) {
+        printf_stderr(
+            "mseAppend: forwarding media fragment %u, %zu bytes (%zu "
+            "total)\n",
+            sForwardedFragments, mseLength, sForwardedBytes);
+      }
+    } else if (mseIsMedia) {
+      printf_stderr(
+          "mseAppend: media fragment of %zu bytes is over the per-append "
+          "cap and was NOT forwarded - the parser will have a hole "
+          "here\n",
+          mseLength);
+    }
+    if (mseLength >= 8 &&
+        ((mseIsInit && mseLength <= (256 * 1024)) || mseForwardMedia)) {
+      // A block-scope declaration names the ENCLOSING namespace, which
+      // here is mozilla::dom - so the definition is in mozilla::dom too.
+      // extern "C" would sidestep that, and is not permitted at block
+      // scope; declaring at file scope would mean a second hunk in this
+      // file for one line. See fix_forward_init_segment_to_parser.py.
+      // WHICH SourceBuffer, because one parser cannot hold two.
+      //
+      // A page appends audio and video to separate SourceBuffers, and
+      // both were being forwarded into a single AVStreamDataParser -
+      // which parses ONE stream. The second init segment corrupted it,
+      // the next fragment came back -11853 "Cannot Parse", and every
+      // fragment after that went into an object AVFoundation had already
+      // marked failed.
+      //
+      // `this` is the identity: unique per SourceBuffer, stable for its
+      // life, and needing no IPDL change to carry - see
+      // ReynardMSEForwardInitSegment, which files it in the contentId
+      // field the initseg route leaves empty.
+      extern void ReynardMSEForwardInitSegment(uintptr_t aStreamId,
+                                               const uint8_t* aData,
+                                               size_t aLength);
+      ReynardMSEForwardInitSegment(reinterpret_cast<uintptr_t>(this),
+                                   aData->Elements(), mseLength);
+      // And the same bytes, locally, once: can this route run HERE?
+      //
+      // If it can, the placement problem stops existing rather than
+      // getting solved - clear samples go into Gecko's own decode path
+      // and the element is an ordinary video again. Init segments only;
+      // a media fragment answers nothing the first segment has not.
+      if (mseIsInit) {
+        // WHICH ELEMENT owns this SourceBuffer.
+        //
+        // Reynard: see mse_fix_101. The play state and volume this
+        // route carries had no element on them at all - the key is
+        // (childID << 32) | 0, so one bit served a whole content
+        // process, and tv.apple.com's feature element started the
+        // film's soundtrack while the film was still behind its own
+        // muted pre-roll.
+        //
+        // MediaSource::GetDecoder() is the identity, because
+        // MediaDecoder::Play and SetVolume have the same object as
+        // `this`. Upcast to MediaDecoder* EXPLICITLY: MediaSourceDecoder
+        // has more than one base, and a derived pointer and a
+        // non-primary base pointer are not required to compare equal
+        // once both are integers.
+        //
+        // On init segments only. One per SourceBuffer per
+        // initialisation is plenty, and the app side keeps it.
+        extern void ReynardMSEForwardOwner(uintptr_t aStreamId,
+                                           uintptr_t aOwnerId);
+        MediaDecoder* mseOwner =
+            mMediaSource ? mMediaSource->GetDecoder() : nullptr;
+        ReynardMSEForwardOwner(reinterpret_cast<uintptr_t>(this),
+                               reinterpret_cast<uintptr_t>(mseOwner));
+        extern void ReynardMSEContentProcessProbe(const uint8_t* aData,
+                                                  size_t aLength);
+        ReynardMSEContentProcessProbe(aData->Elements(), mseLength);
+      }
+    }
+  }
+
   StartUpdating();
 
   mTrackBuffersManager->AppendData(aData.forget(), mCurrentAttributes)
