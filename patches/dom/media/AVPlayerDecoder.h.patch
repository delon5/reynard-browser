+
+#ifndef AVPlayerDecoder_h_
+#define AVPlayerDecoder_h_
+
+#include "MediaDecoder.h"
+
+class nsIChannel;
+class nsIURI;
+
+namespace mozilla {
+
+class AVPlayerDemuxer;
+
+// A MediaDecoder for content AVFoundation must own end to end.
+//
+// FairPlay requires it: only AVURLAsset conforms to
+// AVContentKeyRecipient, so AVContentKeySession can never be attached to
+// samples Gecko demuxed. AVFoundation has to hold the URL from the
+// network down, which means Gecko cannot be in the media path at all.
+//
+// Modelled on HLSDecoder, which does the same job for Android. Load()
+// does not consume the channel - it takes the URI, hands the URL to the
+// platform player and keeps the channel only for principal and security
+// bookkeeping. Play/Pause/Suspend/Resume forward to the player, exactly
+// as HLSDecoder forwards to GeckoHLSResourceWrapper.
+//
+// The state machine it creates reads from AVPlayerDemuxer, which never
+// produces a sample. That is deliberate: the state machine base wraps
+// its reader unconditionally and cannot be given a null one, so the
+// reader exists to satisfy the structure while the AVPlayer does the
+// work.
+class AVPlayerDecoder final : public MediaDecoder {
+ public:
+  static RefPtr<AVPlayerDecoder> Create(MediaDecoderInit& aInit);
+
+  // Whether this backend is pref'ed on and the platform can use it.
+  static bool IsEnabled();
+
+  // Whether aContainerType is something AVFoundation should own rather
+  // than Gecko. HLS, which is what FairPlay is delivered over.
+  static bool IsSupportedType(const MediaContainerType& aContainerType);
+
+  nsresult Load(nsIChannel* aChannel);
+
+  // MediaDecoder interface.
+  void Play() override;
+  void Pause() override;
+  void Suspend() override;
+  void Resume() override;
+  void Shutdown() override;
+
+  void AddSizeOfResources(ResourceSizes* aSizes) override;
+  already_AddRefed<nsIPrincipal> GetCurrentPrincipal() override;
+  bool HadCrossOriginRedirects() override;
+  bool IsTransportSeekable() override { return true; }
+
+  // Called by the platform player once the asset has resolved, so the
+  // principal reflects any redirect Gecko never saw. Without this a
+  // redirected stream is treated as cross-origin and taints canvas.
+  // Main thread only.
+  void NotifyLoad(nsCString aMediaUrl);
+
+  // Called as the player buffers, to drive progress events. Main thread
+  // only.
+  void NotifyDataArrived();
+
+  // Called when the player knows the asset's duration and dimensions.
+  // Main thread only.
+  void NotifyMetadata(const media::TimeUnit& aDuration,
+                      const gfx::IntSize& aDisplay);
+
+  // Publishes a blank IOSurface-backed frame so the page has a video
+  // layer of the right geometry. AVPlayerDemuxer never produces a
+  // sample, so without this nothing reaches the compositor and there
+  // is no layer for NativeLayerCA to host an AVPlayerLayer in. The
+  // visible frames come from the AVPlayer, not from this surface.
+  // Main thread only.
+  void PublishPlaceholderFrame(const gfx::IntSize& aDisplay);
+
+  // Hooked purely to report that the pipeline got this far.
+  //
+  // Everything this decoder does was observable except the two things
+  // that decide whether anything paints. A device capture could show
+  // the placeholder published at the asset's real dimensions with
+  // planes=2, the metadata callback delivering duration and size, and
+  // a black screen - with no way to tell whether the element had ever
+  // reached HAVE_METADATA. ShouldComputeStartTime was then changed to
+  // make that promise resolve, and the result was unfalsifiable,
+  // because a header-only change produces no output at all.
+  //
+  // MetadataLoaded is where MediaFormatReader's resolved promise
+  // arrives; FirstFrameLoaded is what advances readyState far enough
+  // for nsVideoFrame to paint. Both delegate straight to MediaDecoder -
+  // this adds a line of output, not behaviour.
+  void MetadataLoaded(UniquePtr<MediaInfo> aInfo,
+                      UniquePtr<MetadataTags> aTags,
+                      MediaDecoderEventVisibility aEventVisibility) override;
+  void FirstFrameLoaded(UniquePtr<MediaInfo> aInfo,
+                        MediaDecoderEventVisibility aEventVisibility) override;
+
+ private:
+  explicit AVPlayerDecoder(MediaDecoderInit& aInit);
+  ~AVPlayerDecoder();
+
+  already_AddRefed<MediaDecoderStateMachineBase> CreateStateMachine(
+      bool aDisableExternalEngine) override;
+
+  bool CanPlayThroughImpl() final {
+    // AVFoundation manages its own buffering and does not report an
+    // estimate Gecko can use. Returning true keeps autoplay working, the
+    // same compromise HLSDecoder makes.
+    return true;
+  }
+
+  void UpdateCurrentPrincipal(nsCString aMediaUrl);
+
+  // Principal for the RESOLVED media url, built from a fresh
+  // channel carrying the element's CORS flags - mirrors
+  // HLSDecoder::GetContentPrincipal. Deriving it from mChannel
+  // instead cannot see AVFoundation's redirects.
+  already_AddRefed<nsIPrincipal> GetContentPrincipal(nsIURI* aMediaUri);
+
+  // NO mReader HERE. MediaDecoder already declares
+  // `RefPtr<MediaFormatReader> mReader` (protected), and re-declaring it
+  // here shadowed it: CreateStateMachine's `mReader = ...` filled THIS
+  // one and left the base class's null.
+  //
+  // MediaDecoder::SetStateMachineParameters, which runs immediately
+  // after, ends with three connects on the base member -
+  // mReader->OnEncrypted(), OnWaitingForKey(), OnDecodeWarning(). On a
+  // null mReader those resolve to a member address a fixed offset from
+  // zero, and Connect() locks that event's mutex, so the process died
+  // in pthread_mutex_lock with x0 = 0xd68 - the exact fault every
+  // capture from 16 onward showed on Gecko's main thread, always
+  // between "mdsmInit: MDSM Init returned" and "parameters set", and
+  // only ever for this decoder. Nothing else here is wrong: the
+  // placeholder, the demuxer and the metadata callback were all doing
+  // their jobs into an element whose decoder was about to die.
+  //
+  // mDemuxer has no counterpart in MediaDecoder, so it stays.
+  RefPtr<AVPlayerDemuxer> mDemuxer;
+
+  // Kept for the principal and for security checks. Never read from.
+  nsCOMPtr<nsIChannel> mChannel;
+  nsCOMPtr<nsIPrincipal> mContentPrincipal;
+
+  // Opaque handle to the Swift-side AVPlayer. Zero until Load succeeds.
+  uintptr_t mPlayerId = 0;
+
+  bool mHadCrossOriginRedirects = false;
+};
+
+}  // namespace mozilla
+
+#endif  // AVPlayerDecoder_h_
