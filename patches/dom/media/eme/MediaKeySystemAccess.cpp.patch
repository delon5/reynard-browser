diff --git a/dom/media/eme/MediaKeySystemAccess.cpp b/dom/media/eme/MediaKeySystemAccess.cpp
index 58158272ebca..f8d1c8715c87 100644
--- a/dom/media/eme/MediaKeySystemAccess.cpp
+++ b/dom/media/eme/MediaKeySystemAccess.cpp
@@ -10,6 +10,7 @@
 #include "MediaContainerType.h"
 #include "WebMDecoder.h"
 #include "mozilla/ClearOnShutdown.h"
+#include "mozilla/Debug.h"  // printf_stderr, for the emeConfig diagnostic
 #include "mozilla/EMEUtils.h"
 #include "mozilla/Preferences.h"
 #include "mozilla/Services.h"
@@ -140,6 +141,17 @@ MediaKeySystemStatus MediaKeySystemAccess::GetKeySystemStatus(
     return EnsureCDMInstalled(keySystem, SecureLevel::Software, aOutMessage);
   }
 
+#ifdef MOZ_WIDGET_UIKIT
+  // FairPlay is part of the OS. There is no CDM to install or download,
+  // so the installation checks below do not apply - availability is
+  // decided entirely by KeySystemConfig::Supports.
+  if (IsFairPlayKeySystem(keySystem)) {
+    return KeySystemConfig::Supports(keySystem)
+               ? MediaKeySystemStatus::Available
+               : MediaKeySystemStatus::Cdm_not_supported;
+  }
+#endif
+
   // This is used to determine if we need to download Widevine L1.
   bool shouldCheckL1Installation = false;
 #ifdef MOZ_WMF_CDM
@@ -349,7 +361,23 @@ GetSupportedKeySystemConfigs(const nsAString& aKeySystem,
   nsTArray<KeySystemConfigRequest> requests;
 
   // Software Widevine and Clearkey
-  if (IsWidevineKeySystem(aKeySystem) || IsClearkeyKeySystem(aKeySystem)) {
+  if (IsWidevineKeySystem(aKeySystem) || IsClearkeyKeySystem(aKeySystem)
+#ifdef MOZ_WIDGET_UIKIT
+      // Without this no request is ever built for FairPlay, so
+      // CreateKeySystemConfigs receives an empty list, produces no
+      // configs, and even a bare {} has nothing to match against.
+      //
+      // This is the fourth gate the key system has to pass, after the
+      // allowlist in MediaKeySystemAccessManager, KeySystemConfig
+      // ::Supports, and GetKeySystemStatus. Each looked like the last
+      // one.
+      //
+      // DecryptionInfo::Software is right despite FairPlay decrypting in
+      // hardware: the flag marks a hardware CDM pipeline that Gecko
+      // drives, and AVFoundation owns this one entirely.
+      || IsFairPlayKeySystem(aKeySystem)
+#endif
+  ) {
     requests.AppendElement(KeySystemConfigRequest{
         aKeySystem, DecryptionInfo::Software, aIsPrivateBrowsing});
   }
@@ -670,8 +698,38 @@ static Sequence<MediaKeySystemMediaCapability> GetSupportedCapabilities(
     // and subtype names are case-insensitive."'. We're using
     // nsContentTypeParser and that is case-insensitive and converts all its
     // parameter outputs to lower case.)
-    const bool supportedInMP4 =
+    bool supportedInMP4 =
         MP4Decoder::IsSupportedType(containerType, aDiagnostics);
+#ifdef MOZ_WIDGET_UIKIT
+    // FairPlay is declared against the PLAYLIST, not the segments.
+    // Safari's pages - and every player written for them - ask for
+    // application/vnd.apple.mpegurl here, because that is the type the
+    // element will be given. Gecko has no HLS demuxer, so neither
+    // MP4Decoder nor WebMDecoder claims it, and the capability was
+    // dropped: the returned configuration then had no video
+    // capabilities at all and requestMediaKeySystemAccess rejected -
+    // after Supports() had already said yes to the key system, which is
+    // why the log shows the probe succeeding and nothing after it.
+    //
+    // The segments behind an HLS playlist are fMP4 or TS carrying H264
+    // and AAC, which is exactly what mMP4 advertises, so the MP4
+    // container support is the right answer for them.
+    //
+    // Named rather than tested inline because the major-type check
+    // further down needs the same answer - see the second half of this
+    // change. Hoisted OUT of the !supportedInMP4 test on purpose: the
+    // flag says what the content type IS, not what MP4Decoder happened
+    // to answer first.
+    const bool isFairPlayHLS =
+        IsFairPlayKeySystem(aKeySystem.mKeySystem) &&
+        (containerType.Type() == MEDIAMIMETYPE("application/vnd.apple.mpegurl") ||
+         containerType.Type() == MEDIAMIMETYPE("application/x-mpegurl") ||
+         containerType.Type() == MEDIAMIMETYPE("audio/mpegurl") ||
+         containerType.Type() == MEDIAMIMETYPE("audio/x-mpegurl"));
+    if (!supportedInMP4 && isFairPlayHLS) {
+      supportedInMP4 = true;
+    }
+#endif
     if (supportedInMP4 && !aKeySystem.mMP4.IsSupported()) {
       EME_LOG(
           "MediaKeySystemConfiguration (label='{}') "
@@ -747,7 +805,32 @@ static Sequence<MediaKeySystemMediaCapability> GetSupportedCapabilities(

     // If container type is not strictly a audio/video type, continue to the
     // next iteration.
-    const auto majorType = GetMajorType(containerType.Type());
+    auto majorType = GetMajorType(containerType.Type());
+#ifdef MOZ_WIDGET_UIKIT
+    // The LAST gate an HLS capability has to pass, and the one still
+    // shut. An HLS playlist is a container, not a track: its MIME major
+    // type is "application", so GetMajorType answers Invalid and the
+    // capability is dropped two lines below - even though the block
+    // above has already decided this is FairPlay-over-HLS and pointed it
+    // at the MP4 container support.
+    //
+    // Apple's own EME sample lists the playlist under videoCapabilities:
+    //
+    //   videoCapabilities: [{ contentType: 'application/vnd.apple.mpegurl',
+    //                         robustness: '' }]
+    //
+    // so the side the CALLER asked on is the answer. That also keeps the
+    // majorType != aCodecType check just below passing, and satisfies
+    // CanDecryptAndDecode's MOZ_ASSERT(aCodecType != Invalid).
+    //
+    // Only two of the four HLS spellings ever got this far without it:
+    // audio/mpegurl and audio/x-mpegurl have an audio major type.
+    // application/vnd.apple.mpegurl - the one Apple's sample and every
+    // Safari-targeted player uses - did not.
+    if (majorType == Invalid && isFairPlayHLS) {
+      majorType = aCodecType;
+    }
+#endif
     if (majorType == Invalid) {
       EME_LOG(
           "MediaKeySystemConfiguration (label='{}') "
@@ -1198,6 +1281,43 @@ MediaKeySystemAccess::GetSupportedConfig(MediaKeySystemAccessRequest* aRequest,
                    }
                  }
                }
+#ifdef MOZ_WIDGET_UIKIT
+               // DIAGNOSTIC. requestMediaKeySystemAccess rejecting is the
+               // whole FairPlay symptom - the key system probe succeeds,
+               // the page never creates MediaKeys, and nothing says why
+               // because every reason lives behind EME_LOG. This prints
+               // what was asked for, so the failing requirement can be
+               // read off a normal capture instead of guessed at.
+               printf_stderr(
+                   "emeConfig: REJECTED %s - %zu implementation(s), %zu "
+                   "candidate(s)\n",
+                   NS_ConvertUTF16toUTF8(aRequest->mKeySystem).get(),
+                   aResult.IsResolve() ? aResult.ResolveValue().Length() : 0,
+                   aRequest->mConfigs.Length());
+               for (const MediaKeySystemConfiguration& candidate :
+                    aRequest->mConfigs) {
+                 nsAutoCString desc;
+                 desc.AppendPrintf("  initDataTypes=%zu video=%zu audio=%zu",
+                                   candidate.mInitDataTypes.Length(),
+                                   candidate.mVideoCapabilities.Length(),
+                                   candidate.mAudioCapabilities.Length());
+                 for (const nsString& t : candidate.mInitDataTypes) {
+                   desc.Append(" initData=");
+                   desc.Append(NS_ConvertUTF16toUTF8(t));
+                 }
+                 for (const MediaKeySystemMediaCapability& c :
+                      candidate.mVideoCapabilities) {
+                   desc.Append(" video=");
+                   desc.Append(NS_ConvertUTF16toUTF8(c.mContentType));
+                 }
+                 for (const MediaKeySystemMediaCapability& c :
+                      candidate.mAudioCapabilities) {
+                   desc.Append(" audio=");
+                   desc.Append(NS_ConvertUTF16toUTF8(c.mContentType));
+                 }
+                 printf_stderr("emeConfig:%s\n", desc.get());
+               }
+#endif
                promise->Reject(false, __func__);
              });
   return promise.forget();
