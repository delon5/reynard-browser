+
+void FairPlayCDMProxy::Shutdown() {
+  MOZ_ASSERT(NS_IsMainThread());
+  EME_LOG("FairPlayCDMProxy::Shutdown({})", fmt::ptr(this));
+
+  if (mDelegate) {
+    [mDelegate detach];
+    [mDelegate release];
+    mDelegate = nullptr;
+  }
+  if (mKeySession) {
+    [mKeySession release];
+    mKeySession = nullptr;
+  }
+  mKeys.Clear();
+}
