+static nsTHashMap<nsUint64HashKey, FairPlayCDMProxy*>& RemoteProxies() {
+  static auto* proxies = new nsTHashMap<nsUint64HashKey, FairPlayCDMProxy*>();
+  return *proxies;
+}
