+
+// CONTENT PROCESS: an fMP4 init segment the page appended, on its way
+// to the app process's parser session.
+//
+// ADDED - see fix_forward_init_segment_to_parser.py's docstring. The
+// parser originates a key request from a parsed init segment and from
+// nothing else; the session only RESOLVES a requirement a recipient
+// has raised, which is why feeding it EME init data produced no
+// request across two builds.
+//
+// Sent on the message the parser route already uses, with player id 0
+// and a type nobody else sends. A new message would mean PContent.ipdl
+// and a 25-35 minute rebuild for a payload the existing one already
+// carries; ContentParent composes the child half of the key from
+// ChildID() itself, so there is nothing here that needs to know it.
+//
+// Free function, not a method: SourceBuffer has no proxy to call
+// through, and on this path there may be no proxy at all yet.
+// mozilla::dom deliberately, and with ordinary C++ linkage. The only
+// caller is SourceBuffer::AppendData, which is itself in mozilla::dom and
+// declares this at block scope - and a block-scope declaration always
+// names the enclosing namespace, so this has to be the namespace it
+// names. extern "C" would remove the question but is not permitted at
+// block scope, which is what the caller has.
+//
+// `namespace dom`, not `namespace mozilla::dom`: this point in the file
+// is already inside the `namespace mozilla` opened above, so the fully
+// spelled form would nest to mozilla::mozilla::dom and the caller's
+// symbol would go on being undefined.
+namespace dom {
+// Does this route work HERE, in the content process?
+//
+// No IPC and no protocol change: the Swift class is already linked by
+// this process, so it is reached by name. One question, one call.
+void ReynardMSEContentProcessProbe(const uint8_t* aData, size_t aLength) {
+  MOZ_ASSERT(NS_IsMainThread());
+  // No early return on empty. The caller that matters most has no
+  // segment to offer: a page can build a CDM, negotiate both keys and
+  // take both licences without ever appending, and that is exactly the
+  // case in which the question needs answering.
+  //
+  // Once. The answer cannot change within a process, and a parser per
+  // init segment would be a leak rather than a measurement.
+  static bool sProbed = false;
+  if (sProbed) {
+    return;
+  }
+  sProbed = true;
+  Class parserClass = NSClassFromString(@"ReynardFairPlayStreamParser");
+  SEL probe = NSSelectorFromString(@"runContentProcessProbe:");
+  if (!parserClass || ![parserClass respondsToSelector:probe]) {
+    printf_stderr(
+        "avPlayer: MSE content-process probe unavailable - the parser class "
+        "is not reachable from this process\n");
+    return;
+  }
+  printf_stderr("avPlayer: MSE content-process probe with %zu bytes\n",
+                aLength);
+  NSData* segment = (aData && aLength)
+                        ? [NSData dataWithBytes:aData length:aLength]
+                        : [NSData data];
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Warc-performSelector-leaks"
+  [parserClass performSelector:probe withObject:segment];
+#pragma clang diagnostic pop
+}
+
+// Which element a SourceBuffer belongs to.
+//
+// ADDED - see mse_fix_101's docstring. Sent once per init segment on
+// the message the segments already ride, so no IPDL changes.
+// Which element a SourceBuffer belongs to, and where the page has put
+// it on that element's timeline.
+//
+// CHANGED - see mse_fix_103's docstring. Sent on every forward now,
+// because timestampOffset moves mid-stream: tv.apple.com walks it from
+// -1.99 to 32.08 to splice the feature onto the end of its own
+// pre-roll. Deduped here so the traffic is one message per CHANGE
+// rather than one per segment.
+void ReynardMSEForwardStream(uintptr_t aStreamId, uintptr_t aOwnerId,
+                             double aTimestampOffset) {
+  MOZ_ASSERT(NS_IsMainThread());
+  ::mozilla::dom::ContentChild* cc =
+      ::mozilla::dom::ContentChild::GetSingleton();
+  if (!cc) {
+    return;
+  }
+  // Eight slots, linear scan, oldest reused - the same shape and the
+  // same reasoning as the element table below. A page with more than
+  // eight live SourceBuffers costs a duplicate message, not a fault.
+  struct StreamState {
+    uintptr_t stream;
+    uintptr_t owner;
+    double offset;
+  };
+  static const size_t kSlots = 8;
+  static StreamState sStreams[kSlots] = {};
+  static size_t sNext = 0;
+  StreamState* slot = nullptr;
+  for (size_t i = 0; i < kSlots && !slot; i++) {
+    if (sStreams[i].stream == aStreamId) {
+      slot = &sStreams[i];
+    }
+  }
+  if (!slot) {
+    for (size_t i = 0; i < kSlots && !slot; i++) {
+      if (sStreams[i].stream == 0) {
+        slot = &sStreams[i];
+      }
+    }
+  }
+  if (!slot) {
+    slot = &sStreams[sNext % kSlots];
+    sNext++;
+    slot->stream = 0;
+  }
+  double moved = slot->offset - aTimestampOffset;
+  if (moved < 0.0) {
+    moved = -moved;
+  }
+  if (slot->stream == aStreamId && slot->owner == aOwnerId &&
+      moved < 0.0005) {
+    return;
+  }
+  slot->stream = aStreamId;
+  slot->owner = aOwnerId;
+  slot->offset = aTimestampOffset;
+  printf_stderr(
+      "avPlayer: MSE stream sb-%llu belongs to element %llu, offset "
+      "%.3f\n",
+      (unsigned long long)aStreamId, (unsigned long long)aOwnerId,
+      aTimestampOffset);
+  nsTArray<uint8_t> empty;
+  cc->SendAVPlayerKeyGenerateRequest(
+      0,
+      nsPrintfCString("sb-%llu:%llu:%.6f", (unsigned long long)aStreamId,
+                      (unsigned long long)aOwnerId, aTimestampOffset),
+      nsCString("owner"), empty);
+}
+
+void ReynardMSEForwardInitSegment(uintptr_t aStreamId, const uint8_t* aData,
+                                  size_t aLength) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!aData || !aLength) {
+    return;
+  }
+  ::mozilla::dom::ContentChild* cc =
+      ::mozilla::dom::ContentChild::GetSingleton();
+  if (!cc) {
+    return;
+  }
+  nsTArray<uint8_t> segment;
+  segment.AppendElements(aData, aLength);
+  // The stream id rides in the contentId field, which this route leaves
+  // empty - so a page's audio and video reach different parsers without
+  // a PContent change and the wide rebuild that comes with it.
+  nsPrintfCString streamId("sb-%llu", (unsigned long long)aStreamId);
+  printf_stderr("avPlayer: MSE forwarding a %zu byte segment for %s\n",
+                aLength, streamId.get());
+  cc->SendAVPlayerKeyGenerateRequest(0, streamId, nsCString("initseg"),
+                                     segment);
+}
+
+// The page removed that SourceBuffer, or dropped the MediaSource it
+// lived on.
+//
+// ADDED - see mse_fix_99's docstring. Called from
+// MediaSource::RemoveSourceBuffer and from SourceBuffer::Detach, which
+// are the two ways a SourceBuffer ends. Until this existed the app
+// process had no way to learn it: appends simply stopped, and a parser
+// with fragments still in it goes on feeding a sink for as long as they
+// last.
+//
+// Same message, same key, no payload. The id rides in the contentId
+// field exactly as the init segments do, and the type string is what
+// the parent switches on - so no IPDL change, and no protocol rebuild.
+void ReynardMSEForwardRetire(uintptr_t aStreamId) {
+  MOZ_ASSERT(NS_IsMainThread());
+  ::mozilla::dom::ContentChild* cc =
+      ::mozilla::dom::ContentChild::GetSingleton();
+  if (!cc) {
+    return;
+  }
+  nsPrintfCString streamId("sb-%llu", (unsigned long long)aStreamId);
+  printf_stderr("avPlayer: MSE retiring %s - the page removed it\n",
+                streamId.get());
+  // Sent for every SourceBuffer that ends, including ones nothing was
+  // ever forwarded for - Netflix builds nine of those to probe codec
+  // support and appends to none of them. The app side finds no stream
+  // under the key and returns, which is cheaper than remembering here
+  // which ids were ever used.
+  nsTArray<uint8_t> empty;
+  cc->SendAVPlayerKeyGenerateRequest(0, streamId, nsCString("retire"),
+                                     empty);
+}
+}  // namespace dom
+
+// The element's play state and volume, for the MSE parser route.
+//
+// In namespace mozilla, NOT mozilla::dom, because MediaDecoder is:
+// these are reached from a block-scope declaration inside
+// MediaDecoder::Pause, and such a declaration names its enclosing
+// namespace. ReynardMSEForwardInitSegment above is in mozilla::dom for
+// exactly the same reason, SourceBuffer being a dom class.
+//
+// The message is the one this route already reuses. Player id 0 marks
+// MSE, the parent composes (childID << 32) | 0 from the actor it
+// received on, so the session is identified without anything being
+// sent - which is also why these need no new IPDL.
+//
+// Sent for EVERY media element in the process, not only protected
+// ones. Gating on an MSE proxy existing would be cheaper and is wrong:
+// a page may call play() before it sets media keys, and the state that
+// would be lost is the one that decides whether anything plays at all.
+// A play or a pause is a user-scale event, and volume is change-gated
+// below, so the traffic is negligible.
+// Are we inside a call the NATIVE HLS route made into MediaDecoder?
+//
+// ADDED - see mse_fix_83_the_trailer_is_not_the_feature.py's docstring.
+// AVPlayerDecoder derives from MediaDecoder and calls up to it, so the
+// trailer on tv.apple.com - native HLS, its own per-player channel -
+// also broadcast its volume and play state down the MSE route, which
+// carries no element identity and therefore applied them to the film.
+// Muting the trailer left the film silent.
+//
+// A counter rather than a bool: Play() and SetVolume() can nest through
+// a state change. Main thread throughout, which both hooks below assert
+// and every call site holds, so no lock is needed.
+//
+// This is NOT the gate the comment above rejects. An element with no
+// media keys yet is still heard; what is excluded is only the route
+// that already has a channel of its own.
+static int sReynardNativeRouteDepth = 0;
+
+void ReynardMSEEnterNativeRoute(bool aEnter) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (aEnter) {
+    ++sReynardNativeRouteDepth;
+  } else if (sReynardNativeRouteDepth > 0) {
+    --sReynardNativeRouteDepth;
+  }
+}
+
+// Said once per kind, because a fading volume control would otherwise
+// say it sixty times a second.
+static bool ReynardMSEFromNativeRoute(const char* aWhat, bool* aSaidSo) {
+  if (sReynardNativeRouteDepth <= 0) {
+    return false;
+  }
+  if (!*aSaidSo) {
+    *aSaidSo = true;
+    printf_stderr(
+        "avPlayer: ignoring %s from the native HLS route - it has a "
+        "per-player channel of its own and this one has no element "
+        "identity\n",
+        aWhat);
+  }
+  return true;
+}
+
+// The last state seen for each element.
+//
+// ADDED - see mse_fix_101's docstring. These used to be two process-wide
+// statics, so a second element reporting the same value as the first was
+// dropped as a repeat when it was nothing of the kind - which is why
+// tv.apple.com's feature element, at volume 0.50, does not appear in the
+// capture at all.
+//
+// A fixed table rather than a map: this file includes no container
+// header, the number of elements playing protected content in one
+// process is one or two, and scanning eight is free. Past eight the
+// oldest slot is reused, which costs a duplicate message and nothing
+// else.
+struct ReynardMSEOwnerState {
+  uintptr_t owner;
+  int playing;
+  double volume;
+  // ADDED - see mse_fix_102's docstring. The last position sent, so a
+  // decoder that updates its clock sixty times a second sends four.
+  double position;
+};
+static const size_t kReynardMSEOwnerSlots = 8;
+static ReynardMSEOwnerState sReynardMSEOwners[kReynardMSEOwnerSlots] = {};
+static size_t sReynardMSEOwnerNext = 0;
+static ReynardMSEOwnerState* ReynardMSEOwnerSlot(uintptr_t aOwner) {
+  for (size_t i = 0; i < kReynardMSEOwnerSlots; i++) {
+    if (sReynardMSEOwners[i].owner == aOwner) {
+      return &sReynardMSEOwners[i];
+    }
+  }
+  for (size_t i = 0; i < kReynardMSEOwnerSlots; i++) {
+    if (sReynardMSEOwners[i].owner == 0) {
+      sReynardMSEOwners[i].owner = aOwner;
+      sReynardMSEOwners[i].playing = -1;
+      sReynardMSEOwners[i].volume = -1.0;
+      sReynardMSEOwners[i].position = -1.0;
+      return &sReynardMSEOwners[i];
+    }
+  }
+  size_t slot = sReynardMSEOwnerNext % kReynardMSEOwnerSlots;
+  sReynardMSEOwnerNext++;
+  sReynardMSEOwners[slot].owner = aOwner;
+  sReynardMSEOwners[slot].playing = -1;
+  sReynardMSEOwners[slot].volume = -1.0;
+  sReynardMSEOwners[slot].position = -1.0;
+  return &sReynardMSEOwners[slot];
+}
+
+void ReynardMSEPlayState(uintptr_t aOwnerId, bool aPlaying) {
+  MOZ_ASSERT(NS_IsMainThread());
+  static bool sSaidPlayState = false;
+  if (ReynardMSEFromNativeRoute("a play state", &sSaidPlayState)) {
+    return;
+  }
+  ReynardMSEOwnerState* slot = ReynardMSEOwnerSlot(aOwnerId);
+  const int state = aPlaying ? 1 : 0;
+  if (slot->playing == state) {
+    return;
+  }
+  ::mozilla::dom::ContentChild* cc =
+      ::mozilla::dom::ContentChild::GetSingleton();
+  if (!cc) {
+    return;
+  }
+  slot->playing = state;
+  printf_stderr("avPlayer: MSE element %llu is %s\n",
+                (unsigned long long)aOwnerId,
+                aPlaying ? "playing" : "paused");
+  nsTArray<uint8_t> empty;
+  cc->SendAVPlayerKeyGenerateRequest(
+      0,
+      nsPrintfCString("%s:%llu", aPlaying ? "playing" : "paused",
+                      (unsigned long long)aOwnerId),
+      nsCString("playstate"), empty);
+}
+
+void ReynardMSEVolume(uintptr_t aOwnerId, double aVolume) {
+  MOZ_ASSERT(NS_IsMainThread());
+  static bool sSaidVolume = false;
+  if (ReynardMSEFromNativeRoute("a volume", &sSaidVolume)) {
+    return;
+  }
+  // Clamped rather than trusted: an element's volume is only guaranteed
+  // finite, and a renderer takes 0...1.
+  //
+  // Spelled with comparisons rather than <cmath>, which this file is
+  // not known to include: !(v >= 0.0) is true for NaN as well as for a
+  // negative, so one test covers both.
+  double volume = aVolume;
+  if (!(volume >= 0.0)) {
+    volume = 0.0;
+  }
+  if (volume > 1.0) {
+    volume = 1.0;
+  }
+  // A fading volume control produces one of these per animation frame.
+  // Per ELEMENT now - see mse_fix_101's docstring.
+  ReynardMSEOwnerState* slot = ReynardMSEOwnerSlot(aOwnerId);
+  double moved = slot->volume - volume;
+  if (moved < 0.0) {
+    moved = -moved;
+  }
+  if (slot->volume >= 0.0 && moved < 0.001) {
+    return;
+  }
+  ::mozilla::dom::ContentChild* cc =
+      ::mozilla::dom::ContentChild::GetSingleton();
+  if (!cc) {
+    return;
+  }
+  slot->volume = volume;
+  printf_stderr("avPlayer: MSE element %llu volume -> %.3f\n",
+                (unsigned long long)aOwnerId, volume);
+  nsTArray<uint8_t> empty;
+  cc->SendAVPlayerKeyGenerateRequest(
+      0,
+      nsPrintfCString("%.6f:%llu", volume, (unsigned long long)aOwnerId),
+      nsCString("volume"), empty);
+}
+
+// Where the element is playing.
+//
+// ADDED - see mse_fix_102's docstring. HERE, beside the play state and
+// the volume, and NOT beside ReynardMSEForwardOwner: these three live in
+// namespace mozilla because MediaDecoder does, and the forward
+// functions live in namespace mozilla::dom because SourceBuffer does. A
+// block-scope extern names its enclosing namespace, so putting this one
+// in dom would declare mozilla::ReynardMSEPosition at the call site and
+// define mozilla::dom::ReynardMSEPosition here - and it would reference
+// the owner table below it, before that table is declared. The first
+// draft of this fix did exactly that and could not compile.
+//
+// Rate limited here rather than at the call site:
+// MediaDecoder::UpdateLogicalPositionInternal runs far more often than
+// four times a second, and a quarter second is finer than any
+// correction this feeds.
+void ReynardMSEPosition(uintptr_t aOwnerId, double aSeconds) {
+  MOZ_ASSERT(NS_IsMainThread());
+  static bool sSaidPosition = false;
+  if (ReynardMSEFromNativeRoute("a position", &sSaidPosition)) {
+    return;
+  }
+  if (!(aSeconds >= 0.0)) {
+    return;
+  }
+  ReynardMSEOwnerState* slot = ReynardMSEOwnerSlot(aOwnerId);
+  double moved = slot->position - aSeconds;
+  if (moved < 0.0) {
+    moved = -moved;
+  }
+  if (slot->position >= 0.0 && moved < 0.25) {
+    return;
+  }
+  ::mozilla::dom::ContentChild* cc =
+      ::mozilla::dom::ContentChild::GetSingleton();
+  if (!cc) {
+    return;
+  }
+  // Once per element. Four a second would bury the log, but a route
+  // that says NOTHING cannot be told from one that is not built - and
+  // the first draft of this fix logged nothing at all, so the capture
+  // that came back could not answer whether it was in the binary.
+  if (slot->position < 0.0) {
+    printf_stderr("avPlayer: MSE position route live - element %llu at "
+                  "%.3f\n", (unsigned long long)aOwnerId, aSeconds);
+  }
+  slot->position = aSeconds;
+  nsTArray<uint8_t> empty;
+  cc->SendAVPlayerKeyGenerateRequest(
+      0,
+      nsPrintfCString("%.6f:%llu", aSeconds, (unsigned long long)aOwnerId),
+      nsCString("position"), empty);
+}
+
+void FairPlayCDMProxy::SendRemoteKeyRequest(
+    const RemoteKeyRequest& aRequest) {
+  MOZ_ASSERT(NS_IsMainThread());
+  dom::ContentChild* cc = dom::ContentChild::GetSingleton();
+  if (!cc) {
+    return;
+  }
+  if (!mBoundPlayerId) {
+    // MSE. No player will ever be bound, so BindToPlayer - the only
+    // place that registers a proxy for the return leg - will never run,
+    // and the SPC would arrive in the right process only to be dropped
+    // as "SPC for unknown player 0".
+    //
+    // Registered under 0, which is the id it comes back addressed to.
+    //
+    // One slot for the whole content process, and that is a real
+    // limitation rather than a scoping choice: the broker discriminates
+    // MSE by exactly (aKey & 0xffffffff) == 0, so a unique id here
+    // would route these requests back down the player path. Two MediaKeys
+    // objects in one process therefore contend for this entry and the
+    // later one wins - the earlier stops receiving messages.
+    //
+    // Said out loud, because that failure is otherwise invisible and
+    // looks exactly like the silence this whole route replaced. The
+    // identity guards in BindToPlayer and Shutdown keep it a misroute
+    // rather than a use-after-free: a displaced proxy can no longer
+    // remove the winner's entry on its way out.
+    StaticMutexAutoLock lock(sRemoteProxiesMutex);
+    if (FairPlayCDMProxy* existing = RemoteProxies().Get(0)) {
+      if (existing != this) {
+        printf_stderr(
+            "avPlayer: FairPlay WARNING second MSE proxy in this process - "
+            "displacing the one registered for SPC delivery; the earlier "
+            "MediaKeys will stop receiving messages\n");
+      }
+    }
+    RemoteProxies().InsertOrUpdate(0, this);
+  }
+  cc->SendAVPlayerKeyGenerateRequest(static_cast<uint64_t>(mBoundPlayerId),
+                                     aRequest.mContentId,
+                                     aRequest.mInitDataType,
+                                     aRequest.mInitData);
+}
+
+void FairPlayCDMProxy::DeliverRemoteKeyMessage(const nsACString& aContentId,
+                                               nsTArray<uint8_t>&& aSpc) {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsCString contentId(aContentId);
+  nsCString sessionId;
+  if (!mRemoteSessionByContentId.Get(contentId, &sessionId)) {
+    // Before parking: a session may already be waiting under a content
+    // id that identifies nothing, because the page never received the
+    // init data to build one from. See
+    // ReynardIsDegenerateFairPlayContentId. This side holds the real
+    // identifier, so this is the moment the two halves can be joined.
+    nsCString degenerateId;
+    for (auto iter = mRemoteSessionByContentId.Iter(); !iter.Done();
+         iter.Next()) {
+      if (ReynardIsDegenerateFairPlayContentId(iter.Key())) {
+        degenerateId = iter.Key();
+        sessionId = iter.Data();
+        break;
+      }
+    }
+    if (!sessionId.IsEmpty()) {
+      printf_stderr(
+          "avPlayer: FairPlay SPC for %s adopted by session %s, which had "
+          "no content id (%zu bytes)\n",
+          contentId.get(), sessionId.get(), (size_t)aSpc.Length());
+      // Record the REVERSE mapping, and consume the degenerate entry
+      // - CHANGED, it used to be left in place. See
+      // fix_degenerate_session_not_reused.py's docstring.
+      //
+      // Re-filing under the real id was the obvious move and it was
+      // wrong: it pinned this session there for the life of the
+      // proxy, so a retry - which builds a new session, again with no
+      // content id - lost every later SPC to the first one. A capture
+      // showed all three attempts delivered to the same session while
+      // two newer ones waited.
+      //
+      // Removing it keeps the adoption one-shot. A retry builds
+      // another session with no content id, and CreateSession files
+      // that one under the same degenerate key, so the NEWEST session
+      // still receives - the property this comment has always wanted.
+      // What no longer happens is an already-served session
+      // intercepting the next SPC, which belongs in the parking
+      // branch below. The session -> id direction is the half
+      // UpdateSession needs, to tag the CKC with something the app
+      // process can match.
+      mRemoteContentIdBySession.InsertOrUpdate(sessionId, contentId);
+      mRemoteSessionByContentId.Remove(degenerateId);
+      OnSessionMessage(NS_ConvertUTF8toUTF16(sessionId),
+                       dom::MediaKeyMessageType::License_request, aSpc);
+      return;
+    }
+
+    // The page has not called generateRequest for this identifier yet
+    // - it is still handling the 'encrypted' event the SAME key
+    // request produced. Held until CreateSession claims it, which is
+    // the ordinary order rather than an edge case.
+    // An SPC the PARSER raised, addressed by key id because no
+    // origination was waiting for it.
+    //
+    // These are the ones worth having: the parser's specifier is the
+    // only object that names the media's real constant IV, and
+    // canonicalSinf's is sixteen zero bytes. Until now such an SPC
+    // arrived with an empty content id and parked forever, so the page
+    // never saw the message and no licence ever came back - which is
+    // every -11800 "no content key present" in the capture.
+    //
+    // The key id in the name is the fkri out of the page's own pssh,
+    // which CreateSession files in mKeyIdBySession, so the session that
+    // asked for this key can simply be looked up.
+    if (contentId.Length() > 14 &&
+        Substring(contentId, 0, 14).EqualsLiteral("reynard-keyid:")) {
+      nsTArray<uint8_t> wanted;
+      const nsDependentCSubstring hex = Substring(contentId, 14);
+      auto nibble = [](char c) -> int {
+        if (c >= '0' && c <= '9') return c - '0';
+        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+        if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+        return -1;
+      };
+      for (uint32_t i = 0; i + 1 < hex.Length(); i += 2) {
+        const int hi = nibble(hex.CharAt(i));
+        const int lo = nibble(hex.CharAt(i + 1));
+        if (hi < 0 || lo < 0) {
+          wanted.Clear();
+          break;
+        }
+        wanted.AppendElement(static_cast<uint8_t>((hi << 4) | lo));
+      }
+      nsCString owner;
+      if (!wanted.IsEmpty()) {
+        for (auto iter = mKeyIdBySession.Iter(); !iter.Done(); iter.Next()) {
+          if (iter.Data() == wanted) {
+            owner = iter.Key();
+            break;
+          }
+        }
+      }
+      if (!owner.IsEmpty()) {
+        printf_stderr(
+            "avPlayer: FairPlay SPC for key %s delivered to session %s "
+            "(%zu bytes)\n",
+            PromiseFlatCString(hex).get(), owner.get(),
+            (size_t)aSpc.Length());
+        OnSessionMessage(NS_ConvertUTF8toUTF16(owner),
+                         dom::MediaKeyMessageType::License_request, aSpc);
+        return;
+      }
+      printf_stderr(
+          "avPlayer: FairPlay SPC for key %s - no session holds that key "
+          "id, parking (%zu bytes)\n",
+          PromiseFlatCString(hex).get(), (size_t)aSpc.Length());
+    }
+    printf_stderr("avPlayer: FairPlay SPC parked for %s (%zu bytes)\n",
+                  contentId.get(), (size_t)aSpc.Length());
+    mRemotePendingSpc.InsertOrUpdate(contentId, std::move(aSpc));
+    return;
+  }
+  printf_stderr("avPlayer: FairPlay SPC -> session %s (%zu bytes)\n",
+                sessionId.get(), (size_t)aSpc.Length());
+  OnSessionMessage(NS_ConvertUTF8toUTF16(sessionId),
+                   dom::MediaKeyMessageType::License_request, aSpc);
+}
+
+// The far end of ContentChild::RecvAVPlayerKeyMessage. A free function
+// because ContentChild.cpp is plain C++ and must not see this file's
+// Objective-C, and because the registry it needs lives here.
+void ReynardFairPlayDeliverKeyMessage(uintptr_t aPlayerId,
+                                      const nsACString& aContentId,
+                                      nsTArray<uint8_t>&& aSpc) {
+  MOZ_ASSERT(NS_IsMainThread());
+  RefPtr<FairPlayCDMProxy> proxy;
+  {
+    StaticMutexAutoLock lock(sRemoteProxiesMutex);
+    proxy = RemoteProxies().Get(static_cast<uint64_t>(aPlayerId));
+  }
+  if (!proxy) {
+    // Teardown race, or a key request for a player whose element has
+    // no MediaKeys - dropped, like every other unknown-id path in this
+    // pipeline.
+    printf_stderr("avPlayer: FairPlay SPC for unknown player %llu\n",
+                  (unsigned long long)aPlayerId);
+    return;
+  }
+  proxy->DeliverRemoteKeyMessage(aContentId, std::move(aSpc));
+}
+
