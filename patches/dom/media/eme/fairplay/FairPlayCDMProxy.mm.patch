+FairPlayCDMProxy::FairPlayCDMProxy(dom::MediaKeys* aKeys,
+                                   const nsAString& aKeySystem,
+                                   bool aDistinctiveIdentifierRequired,
+                                   bool aPersistentStateRequired)
+    : CDMProxy(aKeys, aKeySystem, aDistinctiveIdentifierRequired,
+               aPersistentStateRequired),
+      // Decided by WHERE this proxy is, not by a pref: a proxy in a
+      // content process can never reach the asset, and one in the
+      // parent always can.
+      mRemote(XRE_IsContentProcess()) {
+  MOZ_ASSERT(NS_IsMainThread());
+  EME_LOG("FairPlayCDMProxy::FairPlayCDMProxy({}) remote={}", fmt::ptr(this),
+          mRemote);
+}
+
+FairPlayCDMProxy::~FairPlayCDMProxy() {
+  EME_LOG("FairPlayCDMProxy::~FairPlayCDMProxy({})", fmt::ptr(this));
+}
+
+void FairPlayCDMProxy::Init(PromiseId aPromiseId, const nsAString& aOrigin,
+                            const nsAString& aTopLevelOrigin,
+                            const nsAString& aName) {
+  MOZ_ASSERT(NS_IsMainThread());
+  EME_LOG("FairPlayCDMProxy::Init({})", fmt::ptr(this));
+
+  if (mRemote) {
+    // Nothing to create and nothing to wait for. The session belongs
+    // to the app process, and every byte of the licence exchange
+    // travels over PContent from the entry points below.
+    printf_stderr("avPlayer: FairPlay proxy in REMOTE mode\n");
+    // The content-process probe from Init, because the append-driven
+    // trigger does not run when it matters.
+    //
+    // A capture had this exact page negotiate both keys and take both
+    // licences and then append nothing at all - so the probe hung off
+    // SourceBuffer::AppendData never fired. This branch is remote by
+    // definition, runs once per proxy, and runs before any media.
+    dom::ReynardMSEContentProcessProbe(nullptr, 0);
+    if (!mKeys.IsNull()) {
+      mKeys->OnCDMCreated(aPromiseId, 0);
+    }
+    return;
+  }
+
+  if (@available(iOS 11.0, macOS 10.13, *)) {
+    AVContentKeySession* session = [AVContentKeySession
+        contentKeySessionWithKeySystem:AVContentKeySystemFairPlayStreaming];
+    if (!session) {
+      RejectPromiseWithStateError(
+          aPromiseId, "Could not create an AVContentKeySession"_ns);
+      return;
+    }
+
+    mKeySession = [session retain];
+    mDelegate = [[FairPlayKeyDelegate alloc] initWithProxy:this];
+
+    // A serial queue, so requests and their completions cannot
+    // interleave. Everything is marshalled to main before touching
+    // MediaKeys.
+    // Not released: dispatch objects are ARC-managed by default, so
+    // dispatch_release would not compile. The session holds it for its
+    // lifetime, which is what we want anyway.
+    dispatch_queue_t queue = dispatch_queue_create(
+        "com.minh-ton.Reynard.FairPlayKeys", DISPATCH_QUEUE_SERIAL);
+    [mKeySession setDelegate:mDelegate queue:queue];
+
+    // Hand the session to the embedder.
+    //
+    // FairPlay only decrypts media AVFoundation itself owns, and only
+    // for an AVURLAsset added as a recipient of the SAME session the
+    // licence was negotiated on - a second session holds no keys. So
+    // AVPlayerHost cannot create its own; it has to use this one.
+    //
+    // This is the unpaired publish, kept for the case where nothing
+    // ever binds - the embedder attaches assets to the most recent
+    // session, which is right whenever there is only one protected
+    // element. BindToPlayer supersedes it with an exact pairing as soon
+    // as AVPlayerDecoder::SetCDMProxy names a player.
+    if (id<GeckoAVPlayerHost> host = AVPlayerHostForKeySession()) {
+      [host useContentKeySession:mKeySession];
+    }
+
+    // OnCDMCreated, not ResolvePromise. The latter resolves with
+    // undefined unless the promise carries a session token, and the
+    // create promise has none - so createMediaKeys() handed the page
+    // undefined and every call after it failed. MediaDrmCDMProxy does
+    // the same thing. See fix_fairplay_oncdmcreated.py.
+    //
+    // Plugin id 0 identifies a GMP process, and FairPlay has none -
+    // AVFoundation runs in-process.
+    if (!mKeys.IsNull()) {
+      mKeys->OnCDMCreated(aPromiseId, 0);
+    }
+    return;
+  }
+
+  RejectPromiseWithStateError(
+      aPromiseId, "FairPlay requires iOS 11 or later"_ns);
+}
+
+// A content id that identifies nothing.
+//
+// The page derives its generateRequest identifier from the init data
+// the 'encrypted' event carried, and Gecko deliberately strips that
+// data when the media is cross-origin: HTMLMediaElement::
+// DispatchEncrypted checks IsCORSSameOrigin(), which asks
+// NodePrincipal()->Subsumes(the decoder's content principal). A
+// streaming service serves its HLS from a CDN origin while the
+// document does not, so the check fails and the event arrives empty.
+//
+// Prime Video then concatenates an empty content id perfectly
+// faithfully, and generateRequest comes through as the bare scheme:
+//
+//   avPlayer: FairPlay generateRequest key=... id=skd:// type=skd 6 bytes
+//
+// That is not an identifier, it is the absence of one. The app process
+// is the side that knows the real value, so this shape is what lets
+// the two halves be paired.
+//
+// Narrow on purpose. A well-formed content id still has to match
+// exactly; this never pairs two real ids with each other.
+static bool ReynardIsDegenerateFairPlayContentId(const nsACString& aId) {
+  return aId.IsEmpty() || aId.EqualsLiteral("skd:") ||
+         aId.EqualsLiteral("skd://");
+}
+
+// The cenc key id inside sinf init data, if there is one.
+//
+// Safari's EME hands a page {"sinf":["<base64 of an 89-byte sinf>"]} and
+// HBO Max passes it straight back through generateRequest. Inside is an
+// ordinary ISO box structure - frma, schm, schi > tenc - and tenc
+// carries the 16-byte default_KID that the page will later look up in
+// keyStatuses.
+//
+// Objective-C++ already, so the JSON and the base64 are Foundation's
+// problem rather than this file's. Some pages hand the sinf bytes
+// directly with no JSON around them, so that is accepted too.
+static bool ReynardKeyIdFromSinf(const nsTArray<uint8_t>& aInitData,
+                                 nsTArray<uint8_t>& aKeyIdOut) {
+  if (aInitData.IsEmpty()) {
+    return false;
+  }
+  NSData* raw = [NSData dataWithBytes:aInitData.Elements()
+                               length:aInitData.Length()];
+  NSData* sinf = nil;
+  @try {
+    id json = [NSJSONSerialization JSONObjectWithData:raw options:0 error:nil];
+    if ([json isKindOfClass:[NSDictionary class]]) {
+      id entry = [(NSDictionary*)json objectForKey:@"sinf"];
+      if ([entry isKindOfClass:[NSArray class]] && [(NSArray*)entry count] > 0) {
+        entry = [(NSArray*)entry objectAtIndex:0];
+      }
+      if ([entry isKindOfClass:[NSString class]]) {
+        // Autoreleased: this file is MRR, and the fallback below may
+        // assign the autoreleased `raw` over this variable - both
+        // branches have to be owned the same way.
+        sinf = [[[NSData alloc] initWithBase64EncodedString:(NSString*)entry
+                                                    options:0] autorelease];
+      }
+    }
+  } @catch (NSException* e) {
+    sinf = nil;
+  }
+  if (!sinf) {
+    // Not JSON, or JSON of another shape: try the bytes as a bare sinf.
+    sinf = raw;
+  }
+
+  const uint8_t* bytes = (const uint8_t*)[sinf bytes];
+  const size_t length = (size_t)[sinf length];
+  if (!bytes || length < 32) {
+    return false;
+  }
+  // A bounded scan for the tenc box rather than a full ISO walk. The
+  // structure is 89 bytes with three boxes in it; the size field
+  // immediately before the type is checked so a coincidental "tenc" in
+  // payload bytes cannot be mistaken for the box.
+  for (size_t at = 4; at + 4 <= length; ++at) {
+    if (memcmp(bytes + at, "tenc", 4) != 0) {
+      continue;
+    }
+    const uint32_t boxSize = (uint32_t(bytes[at - 4]) << 24) |
+                             (uint32_t(bytes[at - 3]) << 16) |
+                             (uint32_t(bytes[at - 2]) << 8) |
+                             uint32_t(bytes[at - 1]);
+    if (boxSize < 32 || (at - 4) + boxSize > length) {
+      continue;
+    }
+    // tenc body: version(1) flags(3) reserved(1)
+    //            crypt/skip or reserved(1) isProtected(1) ivSize(1)
+    //            KID(16). Version 0 and version 1 agree on the offset;
+    //            they differ only in what the sixth byte means.
+    const size_t body = at + 4;
+    if (body + 24 > length) {
+      continue;
+    }
+    if (bytes[body + 6] != 1) {
+      // isProtected is 0 - an unencrypted track described by a sinf,
+      // whose KID is meaningless.
+      continue;
+    }
+    aKeyIdOut.Clear();
+    aKeyIdOut.AppendElements(bytes + body + 8, 16);
+    return true;
+  }
+  return false;
+}
+
+// The cenc key id inside FairPlay pssh init data, if there is one.
+//
+// Apple's cenc init data is an ordinary pssh box wrapping an Apple
+// payload: fpsd > { fpsi, fpsk > { fkri, fkvl } }. fkri is a full box -
+// four bytes of version and flags - followed by the 16-byte key id, and
+// that id is exactly what the page hands keyStatuses.get() later:
+//
+//   fpsParser:   fkri key id 00000000000000000000000000000001
+//   webkitEME: EME keyStatuses.get(00000000000000000000000000000001)
+//
+// Built like ReynardKeyIdFromSinf above: a bounded scan for the box
+// rather than a nested ISO walk, with the size field immediately in
+// front of the type checked, so a coincidental "fkri" in payload bytes
+// cannot be mistaken for the box. The first one wins - Apple mints one
+// session per key and each session's init data carries its own.
+static bool ReynardKeyIdFromFairPlayPssh(const nsTArray<uint8_t>& aInitData,
+                                         nsTArray<uint8_t>& aKeyIdOut) {
+  const uint8_t* bytes = aInitData.Elements();
+  const size_t length = aInitData.Length();
+  if (!bytes || length < 32) {
+    return false;
+  }
+  for (size_t at = 4; at + 4 <= length; ++at) {
+    if (memcmp(bytes + at, "fkri", 4) != 0) {
+      continue;
+    }
+    const uint32_t boxSize = (uint32_t(bytes[at - 4]) << 24) |
+                             (uint32_t(bytes[at - 3]) << 16) |
+                             (uint32_t(bytes[at - 2]) << 8) |
+                             uint32_t(bytes[at - 1]);
+    // size(4) type(4) version and flags(4) key id(16) = 28.
+    if (boxSize < 28 || (at - 4) + boxSize > length) {
+      continue;
+    }
+    const size_t keyId = at + 8;
+    if (keyId + 16 > length) {
+      continue;
+    }
+    aKeyIdOut.Clear();
+    aKeyIdOut.AppendElements(bytes + keyId, 16);
+    return true;
+  }
+  return false;
+}
+
+void FairPlayCDMProxy::CreateSession(uint32_t aCreateSessionToken,
+                                     dom::MediaKeySessionType aSessionType,
+                                     PromiseId aPromiseId,
+                                     const nsAString& aInitDataType,
+                                     nsTArray<uint8_t>& aInitData) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  // In remote mode there is no local session to check - the app
+  // process owns it, and this half only mints ids and relays bytes.
+  if (!mRemote && (!mKeySession || !mDelegate)) {
+    RejectPromiseWithStateError(aPromiseId,
+                                "FairPlay session is not initialised"_ns);
+    return;
+  }
+
+  // Refuse an init data type we declined to advertise, instead of
+  // accepting it and parking the request where nothing will ever
+  // collect it.
+  //
+  // Only skd can raise an AVContentKeyRequest, because only an
+  // AVURLAsset AVFoundation owns end to end conforms to
+  // AVContentKeyRecipient. cenc and sinf belong to an MSE element,
+  // which never reaches HTMLMediaElement's AVPlayerDecoder branch - so
+  // SetCDMProxy never runs, BindToPlayer never runs, and the request
+  // sits in mRemoteParkedRequests until teardown with the page hearing
+  // nothing at all. A device capture showed four parked
+  // generateRequests against zero replays, on three different services.
+  //
+  // The set mirrors CreateFairPlayKeySystemConfigs exactly, so the
+  // engine refuses precisely what it declined to offer, and flipping
+  // hls-only-initdata off still opens the MSE path for diagnosis. A
+  // rejection is also what lets a well-written player fall through to
+  // its HLS choice - the fallthrough the pref was added for, which
+  // silence defeats.
+  // The parser route accepts what it advertised. Mirrors
+  // CreateFairPlayKeySystemConfigs exactly, so the engine never refuses
+  // a configuration it offered - the mismatch that produced a granted
+  // config followed by silence.
+  if (StaticPrefs::media_reynard_fairplay_hls_only_initdata() &&
+      !StaticPrefs::media_reynard_fairplay_mse_parser_route() &&
+      !aInitDataType.EqualsLiteral("skd")) {
+    nsCString reason("FairPlay serves skd init data only"_ns);
+    printf_stderr("avPlayer: FairPlay refusing generateRequest, initDataType "
+                  "%s is not served\n",
+                  NS_ConvertUTF16toUTF8(aInitDataType).get());
+    ErrorResult rv;
+    rv.ThrowNotSupportedError(reason);
+    RejectPromise(aPromiseId, std::move(rv), reason);
+    return;
+  }
+
+  // Our own id: AVContentKeySession has no notion of one, and EME needs
+  // a stable handle before any key request comes back.
+  // NSUUID rather than nsID::GenerateUUID - one less Gecko header to
+  // depend on, and we are in Objective-C++ already.
+  NSString* sessionIdNS = [[NSUUID UUID] UUIDString];
+  const char* sessionIdUTF8 = [sessionIdNS UTF8String];
+  nsAutoCString sessionId(sessionIdUTF8);
+
+  nsCString initDataType = NS_ConvertUTF16toUTF8(aInitDataType);
+
+  // sinf and cenc both. The note that used to stand here said cenc was
+  // Apple TV's route and that it appended today on the
+  // session-id-as-key-id behaviour below. It does not, and fix 58's
+  // trace is what settles it - the page asks by key id and is told
+  // nothing:
+  //
+  //   EME keyStatuses.get(00000000000000000000000000000001) -> undefined
+  //   EME session#1 keyStatuses n=1 [33364144333435432d..(36)=usable]
+  //
+  // 33 36 41 44 33 34 35 43 2d is the ASCII of "36AD345C-", the session
+  // id this proxy minted. The page then plays 45 seconds of clear
+  // pre-roll, stalls at the end of it, mints two more sessions, takes
+  // two more licences, and appends nothing.
+  //
+  // The rest of that note still holds, which is why this remains
+  // additive rather than a replacement: the session-id entry in
+  // UpdateSession is untouched, so a page that iterates keyStatuses is
+  // served exactly as it is today and gains one more usable entry.
+  {
+    nsTArray<uint8_t> parsedKeyId;
+    const char* shape = nullptr;
+    bool parsed = false;
+    if (initDataType.EqualsLiteral("sinf")) {
+      shape = "sinf";
+      parsed = ReynardKeyIdFromSinf(aInitData, parsedKeyId);
+    } else if (initDataType.EqualsLiteral("cenc")) {
+      shape = "cenc";
+      parsed = ReynardKeyIdFromFairPlayPssh(aInitData, parsedKeyId);
+    }
+    if (shape && parsed) {
+      nsAutoCString hex;
+      for (size_t i = 0; i < parsedKeyId.Length(); ++i) {
+        hex.AppendPrintf("%02x", parsedKeyId[i]);
+      }
+      printf_stderr("avPlayer: FairPlay key id from %s: %s\n", shape,
+                    hex.get());
+      mKeyIdBySession.InsertOrUpdate(sessionId, std::move(parsedKeyId));
+    } else if (shape) {
+      printf_stderr(
+          "avPlayer: FairPlay key id from %s: none (%zu bytes of init "
+          "data)\n",
+          shape, (size_t)aInitData.Length());
+    }
+  }
+
+  // What this session was created for, so OnSessionMessage can tell a
+  // cenc session from a sinf one - see ReynardJsonKeyMessage.
+  ReynardInitDataTypes().InsertOrUpdate(sessionId, initDataType);
+
+  // The identifier FairPlay expects differs by container. HLS carries an
+  // skd:// URI, which must be passed as a string; fragmented MP4 carries
+  // the key id as bytes.
+  id identifier = nil;
+  NSString* identifierKey = nil;
+  if (initDataType.EqualsLiteral("skd")) {
+    // Autoreleased: this file is MRR, and nothing here owns the string
+    // past this call - the delegate's dictionary retains what it keeps.
+    NSString* skd =
+        [[[NSString alloc] initWithBytes:aInitData.Elements()
+                                  length:aInitData.Length()
+                                encoding:NSUTF8StringEncoding] autorelease];
+    identifier = skd;
+    identifierKey = skd;
+  } else {
+    NSData* keyId = [NSData dataWithBytes:aInitData.Elements()
+                                   length:aInitData.Length()];
+    identifier = keyId;
+    // fMP4 "keyids" init data is raw bytes (typically a 16-byte key id)
+    // that are rarely valid UTF-8, so a UTF-8 decode returns nil and the
+    // session->request mapping never forms - key requests for fragmented
+    // MP4 could then never be answered. base64 round-trips any bytes and
+    // matches sessionIdForRequest, which keys the same way.
+    identifierKey = [keyId base64EncodedStringWithOptions:0];
+  }
+
+  if (mRemote) {
+    if (!identifierKey) {
+      RejectPromiseWithStateError(
+          aPromiseId, "FairPlay init data has no usable identifier"_ns);
+      return;
+    }
+    nsCString contentId([identifierKey UTF8String]);
+    mRemoteSessionByContentId.InsertOrUpdate(contentId, nsCString(sessionId));
+    mRemoteContentIdBySession.InsertOrUpdate(nsCString(sessionId), contentId);
+
+    // Same order as the local path: EME expects the session to exist
+    // immediately, with the licence request following as a message.
+    OnSetSessionId(aCreateSessionToken, NS_ConvertUTF8toUTF16(sessionId));
+    ResolvePromise(aPromiseId);
+
+    // The SPC is often already here. AVFoundation raises its key
+    // request as soon as the playlist reaches EXT-X-KEY, the page
+    // hears that as 'encrypted', and this generateRequest is the
+    // reply - by which time the app process has usually produced the
+    // SPC and sent it down.
+    if (Maybe<nsTArray<uint8_t>> pending =
+            mRemotePendingSpc.Extract(contentId)) {
+      printf_stderr(
+          "avPlayer: FairPlay SPC was already waiting for %s (%zu bytes)\n",
+          contentId.get(), (size_t)pending->Length());
+      OnSessionMessage(NS_ConvertUTF8toUTF16(sessionId),
+                       dom::MediaKeyMessageType::License_request, *pending);
+      return;
+    }
+
+    // The same claim, for a session whose content id identifies
+    // nothing - see ReynardIsDegenerateFairPlayContentId. Only when
+    // there is exactly ONE parked SPC: with several in flight there is
+    // no honest way to say which this session meant, and picking one
+    // would answer the wrong key request silently.
+    if (ReynardIsDegenerateFairPlayContentId(contentId) &&
+        mRemotePendingSpc.Count() == 1) {
+      nsCString realId;
+      for (auto iter = mRemotePendingSpc.Iter(); !iter.Done(); iter.Next()) {
+        realId = iter.Key();
+        break;
+      }
+      if (Maybe<nsTArray<uint8_t>> adopted = mRemotePendingSpc.Extract(realId)) {
+        printf_stderr(
+            "avPlayer: FairPlay SPC parked under %s adopted by a session "
+            "with no content id (%zu bytes)\n",
+            realId.get(), (size_t)adopted->Length());
+        // Reverse mapping only - see DeliverRemoteKeyMessage for why
+        // re-filing under the real id strands every later session.
+        // UpdateSession reads this direction to tag the CKC.
+        mRemoteContentIdBySession.InsertOrUpdate(nsCString(sessionId), realId);
+        OnSessionMessage(NS_ConvertUTF8toUTF16(sessionId),
+                         dom::MediaKeyMessageType::License_request, *adopted);
+        return;
+      }
+    }
+
+    RemoteKeyRequest request;
+    request.mContentId = contentId;
+    request.mInitDataType = initDataType;
+    request.mInitData = aInitData.Clone();
+    if (!mBoundPlayerId) {
+      // Only skd waits for a player. skd is native HLS, where
+      // SetCDMProxy names the player moments later and BindToPlayer
+      // flushes whatever parked here.
+      //
+      // sinf and cenc are MSE, and an MSE element never reaches
+      // HTMLMediaElement's AVPlayerDecoder branch at all - so
+      // SetCDMProxy never runs, BindToPlayer never runs, and parking is
+      // parking forever. A device capture counted four parked against
+      // zero replayed, across three services.
+      //
+      // Sent with the player id still zero, deliberately: the broker
+      // reserves 0 for "no player" and routes it to the stream parser,
+      // which originates a key request from init-segment bytes with no
+      // AVURLAsset anywhere. Measured on device before this was
+      // written - addContentKeyRecipient: accepted the parser, and
+      // Apple's own encrypted init segment raised
+      // streamDataParser:didProvideContentKeySpecifier:forTrackID:.
+      if (initDataType.EqualsLiteral("skd")) {
+        printf_stderr("avPlayer: FairPlay parking generateRequest for %s\n",
+                      contentId.get());
+        mRemoteParkedRequests.AppendElement(std::move(request));
+        return;
+      }
+      printf_stderr(
+          "avPlayer: FairPlay routing %s generateRequest for %s to the "
+          "parser\n",
+          initDataType.get(), contentId.get());
+    }
+    SendRemoteKeyRequest(request);
+    return;
+  }
+
+  [mDelegate rememberSession:sessionIdNS forIdentifier:identifierKey];
+
+  NSData* initData = [NSData dataWithBytes:aInitData.Elements()
+                                    length:aInitData.Length()];
+
+  // Resolved before the key request arrives - EME expects the session to
+  // exist immediately, with the licence request following as a message.
+  OnSetSessionId(aCreateSessionToken, NS_ConvertUTF8toUTF16(sessionId));
+  ResolvePromise(aPromiseId);
+
+  // If the asset already raised this exact key request - the delegate
+  // forwarded it to the page as 'encrypted', and this generateRequest
+  // is the reply - adopt the pending request instead of asking
+  // AVFoundation for a duplicate. rememberSession above has mapped the
+  // identifier, so re-entering the delegate flow now finds the session
+  // and produces the SPC; the session argument is unused there.
+  if (AVContentKeyRequest* pending =
+          [mDelegate takeUnsolicitedForIdentifier:identifierKey]) {
+    EME_LOG("FairPlayCDMProxy::CreateSession({}) adopting pending request",
+            fmt::ptr(this));
+    [mDelegate contentKeySession:mKeySession
+        didProvideContentKeyRequest:pending];
+    return;
+  }
+
+  [mKeySession processContentKeyRequestWithIdentifier:identifier
+                                   initializationData:initData
+                                              options:nil];
+}
+
+void FairPlayCDMProxy::LoadSession(PromiseId aPromiseId,
+                                   dom::MediaKeySessionType aSessionType,
+                                   const nsAString& aSessionId) {
+  MOZ_ASSERT(NS_IsMainThread());
+  // Persistent sessions need AVPersistableContentKeyRequest and on-disk
+  // key storage, which is its own piece of work.
+  RejectPromiseWithStateError(
+      aPromiseId, "FairPlay persistent sessions are not supported"_ns);
+}
+
+void FairPlayCDMProxy::SetServerCertificate(PromiseId aPromiseId,
+                                            nsTArray<uint8_t>& aCert) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  // For FairPlay this is the FPS application certificate, and
+  // makeStreamingContentKeyRequestDataForApp cannot produce an SPC
+  // without it. Stored rather than handed to AVFoundation, which takes
+  // it per request.
+  mAppCertificate = aCert.Clone();
+  EME_LOG("FairPlayCDMProxy::SetServerCertificate({}) {} bytes",
+          fmt::ptr(this), mAppCertificate.Length());
+  if (mRemote) {
+    // The app process is holding every key request it has raised so
+    // far waiting for exactly this - without a certificate there is no
+    // SPC to make - so this send is what unblocks the licence flow.
+    printf_stderr("avPlayer: FairPlay certificate up, %zu bytes\n",
+                  (size_t)mAppCertificate.Length());
+    if (dom::ContentChild* cc = dom::ContentChild::GetSingleton()) {
+      cc->SendAVPlayerSetAppCertificate(mAppCertificate);
+    }
+  }
+  ResolvePromise(aPromiseId);
+}
+
+void FairPlayCDMProxy::UpdateSession(const nsAString& aSessionId,
+                                     PromiseId aPromiseId,
+                                     nsTArray<uint8_t>& aResponse) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  // ADDED - see mse_fix_81's docstring. A page handed the batched key
+  // message answers in kind, and FairPlay wants the CKC rather than the
+  // envelope around it. Bytes that are not JSON are passed through
+  // untouched, which is every response this path has ever seen.
+  {
+    nsTArray<uint8_t> unwrapped;
+    if (ReynardUnwrapJsonLicence(aResponse, unwrapped)) {
+      aResponse = std::move(unwrapped);
+    }
+  }
+
+  if (!mRemote && !mDelegate) {
+    RejectPromiseWithStateError(aPromiseId,
+                                "FairPlay session is not initialised"_ns);
+    return;
+  }
+
+  if (mRemote) {
+    // The AVContentKeyRequest this CKC answers is parked in the app
+    // process, under the content id this session was created for.
+    // NS_ConvertUTF16toUTF8 declared directly, not wrapped in an
+    // nsCString: `nsCString x(NS_ConvertUTF16toUTF8(aSessionId));` is a
+    // most-vexing-parse - the inner parentheses read as a parameter
+    // declaration and x becomes a function. Same idiom the key-status
+    // block further down already uses.
+    NS_ConvertUTF16toUTF8 sessionIdKey(aSessionId);
+    nsCString contentId;
+    if (!mRemoteContentIdBySession.Get(sessionIdKey, &contentId)) {
+      RejectPromiseWithStateError(
+          aPromiseId, "No pending FairPlay key request for this session"_ns);
+      return;
+    }
+    printf_stderr("avPlayer: FairPlay CKC up for %s, %zu bytes\n",
+                  contentId.get(), (size_t)aResponse.Length());
+    if (dom::ContentChild* cc = dom::ContentChild::GetSingleton()) {
+      cc->SendAVPlayerKeyResponse(static_cast<uint64_t>(mBoundPlayerId),
+                                  contentId, aResponse);
+    }
+  } else {
+    NSString* sessionId =
+        [NSString stringWithUTF8String:NS_ConvertUTF16toUTF8(aSessionId).get()];
+    AVContentKeyRequest* request = [mDelegate requestForSession:sessionId];
+    if (!request) {
+      RejectPromiseWithStateError(
+          aPromiseId, "No pending FairPlay key request for this session"_ns);
+      return;
+    }
+
+    NSData* ckc = [NSData dataWithBytes:aResponse.Elements()
+                                 length:aResponse.Length()];
+    AVContentKeyResponse* response = [AVContentKeyResponse
+        contentKeyResponseWithFairPlayStreamingKeyResponseData:ckc];
+    [request processContentKeyResponse:response];
+  }
+
+  // The CKC is handed to AVFoundation synchronously and there is no
+  // callback that says "key now usable", so usability is declared at
+  // delivery: pages gate playback on keyStatuses, and an empty map
+  // reads as "no licence" no matter how well the exchange went. The
+  // session id stands in for the key id - FairPlay identifiers are
+  // opaque skd URIs, and EME pages iterate the map rather than look
+  // up specific ids.
+  {
+    NS_ConvertUTF16toUTF8 sessionIdUtf8(aSessionId);
+    CencKeyId keyId;
+    keyId.AppendElements(
+        reinterpret_cast<const uint8_t*>(sessionIdUtf8.get()),
+        sessionIdUtf8.Length());
+    dom::Optional<dom::MediaKeyStatus> status;
+    status.Construct(dom::MediaKeyStatus::Usable);
+    auto caps = mCapabilites.Lock();
+    caps->SetKeyStatus(keyId, nsString(aSessionId), status);
+
+    // And under the REAL key id, when the init data carried one.
+    //
+    // The entry above is kept rather than replaced: pages that iterate
+    // keyStatuses - Apple TV among them - are served by it today, and
+    // this is additive so that route cannot regress. Pages that hold a
+    // cenc key id and ask for it by name are served by this one. HBO
+    // Max is the second kind: it took three licences and appended
+    // nothing, waiting on a lookup that could not hit.
+    NS_ConvertUTF16toUTF8 sessionKey(aSessionId);
+    if (auto real = mKeyIdBySession.Lookup(sessionKey)) {
+      CencKeyId realKeyId;
+      realKeyId.AppendElements(real->Elements(), real->Length());
+      nsAutoCString hex;
+      for (size_t i = 0; i < realKeyId.Length(); ++i) {
+        hex.AppendPrintf("%02x", realKeyId[i]);
+      }
+      printf_stderr("avPlayer: FairPlay key %s -> usable\n", hex.get());
+      caps->SetKeyStatus(realKeyId, nsString(aSessionId), status);
+    }
+  }
+  OnKeyStatusesChange(aSessionId);
+
+  ResolvePromise(aPromiseId);
+}
+
+void FairPlayCDMProxy::CloseSession(const nsAString& aSessionId,
+                                    PromiseId aPromiseId) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mDelegate) {
+    NSString* sessionId =
+        [NSString stringWithUTF8String:NS_ConvertUTF16toUTF8(aSessionId).get()];
+    [mDelegate forgetSession:sessionId];
+  }
+  // Session ids are NSUUIDs and never reused, so this entry can never
+  // be looked up again - see ReynardInitDataTypes, which is a file
+  // static and outlives the proxy.
+  //
+  // NS_ConvertUTF16toUTF8 declared directly rather than wrapped in an
+  // nsCString, for the most-vexing-parse reason UpdateSession spells
+  // out.
+  {
+    NS_ConvertUTF16toUTF8 sessionKey(aSessionId);
+    ReynardInitDataTypes().Remove(sessionKey);
+  }
+  OnSessionClosed(aSessionId, dom::MediaKeySessionClosedReason::Closed_by_application);
+  ResolvePromise(aPromiseId);
+}
