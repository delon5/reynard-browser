+// The delegate AVContentKeySession calls back on. Owns a strong
+// reference to the proxy, cleared on shutdown so the two do not keep
+// each other alive.
+@interface FairPlayKeyDelegate : NSObject <AVContentKeySessionDelegate> {
+ @private
+  RefPtr<FairPlayCDMProxy> mProxy;
+  // Correlates a key request back to the EME session that asked for it.
+  // AVContentKeySession hands back the request, not our session id.
+  NSMutableDictionary<NSString*, AVContentKeyRequest*>* mRequestsBySession;
+  NSMutableDictionary<NSString*, NSString*>* mSessionsByIdentifier;
+  // Key requests the asset raised before any EME session mapped their
+  // identifier - forwarded to the page as 'encrypted' and held pending
+  // until CreateSession adopts them.
+  NSMutableDictionary<NSString*, AVContentKeyRequest*>* mUnsolicitedByIdentifier;
+}
+- (instancetype)initWithProxy:(FairPlayCDMProxy*)aProxy;
+- (void)detach;
+- (void)rememberSession:(NSString*)aSessionId
+          forIdentifier:(NSString*)aIdentifier;
+- (AVContentKeyRequest*)requestForSession:(NSString*)aSessionId;
+- (void)forgetSession:(NSString*)aSessionId;
+- (AVContentKeyRequest*)takeUnsolicitedForIdentifier:(NSString*)aKey;
+- (void)replayUnsolicitedRequests;
+@end
+
+@implementation FairPlayKeyDelegate
+
+- (instancetype)initWithProxy:(FairPlayCDMProxy*)aProxy {
+  self = [super init];
+  if (self) {
+    mProxy = aProxy;
+    mRequestsBySession = [[NSMutableDictionary alloc] init];
+    mSessionsByIdentifier = [[NSMutableDictionary alloc] init];
+    mUnsolicitedByIdentifier = [[NSMutableDictionary alloc] init];
+  }
+  return self;
+}
+
+- (void)detach {
+  mProxy = nullptr;
+  [mRequestsBySession removeAllObjects];
+  [mSessionsByIdentifier removeAllObjects];
+  [mUnsolicitedByIdentifier removeAllObjects];
+}
+
+- (void)rememberSession:(NSString*)aSessionId
+          forIdentifier:(NSString*)aIdentifier {
+  @synchronized(self) {
+    if (aIdentifier) {
+      mSessionsByIdentifier[aIdentifier] = aSessionId;
+    }
+  }
+}
+
+- (AVContentKeyRequest*)requestForSession:(NSString*)aSessionId {
+  @synchronized(self) {
+    return mRequestsBySession[aSessionId];
+  }
+}
+
+- (void)forgetSession:(NSString*)aSessionId {
+  @synchronized(self) {
+    [mRequestsBySession removeObjectForKey:aSessionId];
+  }
+}
+
+// The map key for a request's identifier - the same encoding
+// CreateSession stores: the skd string itself, or base64 of raw bytes.
+- (NSString*)identifierKeyForRequest:(AVContentKeyRequest*)aRequest {
+  id identifier = aRequest.identifier;
+  if ([identifier isKindOfClass:[NSString class]]) {
+    return (NSString*)identifier;
+  }
+  if ([identifier isKindOfClass:[NSData class]]) {
+    return [(NSData*)identifier base64EncodedStringWithOptions:0];
+  }
+  return nil;
+}
+
+- (void)rememberUnsolicited:(AVContentKeyRequest*)aRequest
+                     forKey:(NSString*)aKey {
+  @synchronized(self) {
+    mUnsolicitedByIdentifier[aKey] = aRequest;
+  }
+}
+
+- (AVContentKeyRequest*)takeUnsolicitedForIdentifier:(NSString*)aKey {
+  if (!aKey) {
+    return nil;
+  }
+  @synchronized(self) {
+    AVContentKeyRequest* request = mUnsolicitedByIdentifier[aKey];
+    if (request) {
+      [mUnsolicitedByIdentifier removeObjectForKey:aKey];
+    }
+    return request;
+  }
+}
+
+// Re-offers every parked request now that something has changed -
+// BindToPlayer naming the player these keys belong to. Each one goes
+// back through didProvideContentKeyRequest, which this time finds
+// either a session mapping or a bound proxy to forward through. The
+// snapshot is taken under the lock and the walk happens outside it,
+// because the re-entry re-parks into the same dictionary.
+- (void)replayUnsolicitedRequests {
+  NSArray<AVContentKeyRequest*>* parked;
+  @synchronized(self) {
+    parked = [mUnsolicitedByIdentifier allValues];
+    [mUnsolicitedByIdentifier removeAllObjects];
+  }
+  for (AVContentKeyRequest* request in parked) {
+    [self contentKeySession:nil didProvideContentKeyRequest:request];
+  }
+}
+
+// Resolves the EME session id for a request, by the identifier it was
+// issued with.
+- (NSString*)sessionIdForRequest:(AVContentKeyRequest*)aRequest {
+  id identifier = aRequest.identifier;
+  NSString* key = nil;
+  if ([identifier isKindOfClass:[NSString class]]) {
+    key = (NSString*)identifier;
+  } else if ([identifier isKindOfClass:[NSData class]]) {
+    // base64 to match the key CreateSession stored: raw key-id bytes are
+    // rarely valid UTF-8, so a UTF-8 decode usually yields nil and the
+    // lookup silently misses.
+    key = [(NSData*)identifier base64EncodedStringWithOptions:0];
+  }
+  if (!key) {
+    return nil;
+  }
+  @synchronized(self) {
+    return mSessionsByIdentifier[key];
+  }
+}
+
+- (void)contentKeySession:(AVContentKeySession*)session
+    didProvideContentKeyRequest:(AVContentKeyRequest*)keyRequest {
+  if (!mProxy) {
+    return;
+  }
+
+  NSString* sessionId = [self sessionIdForRequest:keyRequest];
+  if (!sessionId) {
+    // A key request no EME session has mapped: the asset reached an
+    // EXT-X-KEY before the page called generateRequest for it - the
+    // normal Safari-style order, where the PLAYER learns about
+    // encryption from the 'encrypted' event. This pipeline's demuxer
+    // never sees the stream, so this delegate is the only place that
+    // event can come from: forward the identifier to the page as
+    // 'encrypted', hold the request pending, and let CreateSession
+    // adopt it when generateRequest arrives with the same identifier.
+    NSString* identifierKey = [self identifierKeyForRequest:keyRequest];
+    if (identifierKey) {
+      nsTArray<uint8_t> initData;
+      nsCString initDataType;
+      id identifier = keyRequest.identifier;
+      if ([identifier isKindOfClass:[NSString class]]) {
+        NSData* uri =
+            [(NSString*)identifier dataUsingEncoding:NSUTF8StringEncoding];
+        initData.AppendElements(static_cast<const uint8_t*>([uri bytes]),
+                                [uri length]);
+        initDataType.AssignLiteral("skd");
+      } else {
+        NSData* keyId = (NSData*)identifier;
+        initData.AppendElements(static_cast<const uint8_t*>([keyId bytes]),
+                                [keyId length]);
+        initDataType.AssignLiteral("sinf");
+      }
+      [self rememberUnsolicited:keyRequest forKey:identifierKey];
+      if (mProxy->MaybeForwardUnsolicitedKeyRequest(std::move(initData),
+                                                    initDataType)) {
+        return;
+      }
+    }
+    // Parked, NOT failed. AVFoundation raises the first key request as
+    // soon as the asset reaches its EXT-X-KEY, which can precede
+    // AVPlayerDecoder::SetCDMProxy -> BindToPlayer by milliseconds -
+    // and failing a key request does not decline one key, it fails the
+    // WHOLE ITEM, permanently (itemStatus 2 with
+    // "No EME session for this key request" on the item's error, a
+    // spinner and no EME at all). A pending request only stalls, and
+    // BindToPlayer replays everything parked here the moment the
+    // player id arrives. Requests that nothing can ever satisfy are
+    // failed at detach instead, where that is true.
+    return;
+  }
+
+  @synchronized(self) {
+    mRequestsBySession[sessionId] = keyRequest;
+  }
+
+  // The application certificate is what identifies this app to the key
+  // server. Without it there is no SPC to make, so fail loudly rather
+  // than issuing a request that cannot be satisfied.
+  if (mProxy->mAppCertificate.IsEmpty()) {
+    const char* sid = [sessionId UTF8String];
+    mProxy->OnKeyRequestFailed(
+        nsDependentCString(sid),
+        "setServerCertificate must be called before generateRequest for FairPlay"_ns);
+    // The EME error above tells the page; this tells AVFoundation, so
+    // the request does not sit pending forever inside the player.
+    [keyRequest processContentKeyResponseError:
+        [NSError errorWithDomain:@"ReynardFairPlay"
+                            code:-3
+                        userInfo:@{
+                          NSLocalizedDescriptionKey :
+                              @"FairPlay application certificate not set"
+                        }]];
+    return;
+  }
+
+  NSData* appCert = [NSData dataWithBytes:mProxy->mAppCertificate.Elements()
+                                   length:mProxy->mAppCertificate.Length()];
+
+  id identifier = keyRequest.identifier;
+  NSData* contentId = nil;
+  if ([identifier isKindOfClass:[NSString class]]) {
+    contentId = [(NSString*)identifier dataUsingEncoding:NSUTF8StringEncoding];
+  } else if ([identifier isKindOfClass:[NSData class]]) {
+    contentId = (NSData*)identifier;
+  }
+
+  RefPtr<FairPlayCDMProxy> proxy = mProxy;
+  // Via a local: a message send nested inside a constructor argument
+  // reads as a message to the constructor itself in Objective-C++.
+  const char* sessionIdUTF8 = [sessionId UTF8String];
+  nsCString sessionIdCopy(sessionIdUTF8);
+
+  [keyRequest
+      makeStreamingContentKeyRequestDataForApp:appCert
+                             contentIdentifier:contentId
+                                       options:nil
+                             completionHandler:^(NSData* _Nullable requestData,
+                                                 NSError* _Nullable error) {
+                               if (error || !requestData) {
+                                 nsCString msg("FairPlay key request failed"_ns);
+                                 if (error) {
+                                   msg.Append(": ");
+                                   msg.Append([[error localizedDescription]
+                                       UTF8String]);
+                                 }
+                                 proxy->OnKeyRequestFailed(sessionIdCopy, msg);
+                                 return;
+                               }
+
+                               nsTArray<uint8_t> spc;
+                               spc.AppendElements(
+                                   static_cast<const uint8_t*>(
+                                       [requestData bytes]),
+                                   [requestData length]);
+                               proxy->OnKeyRequestReady(sessionIdCopy,
+                                                        std::move(spc));
+                             }];
+}
+
+- (void)contentKeySession:(AVContentKeySession*)session
+        contentKeyRequest:(AVContentKeyRequest*)keyRequest
+         didFailWithError:(NSError*)err {
+  if (!mProxy) {
+    return;
+  }
+  NSString* sessionId = [self sessionIdForRequest:keyRequest];
+  if (!sessionId) {
+    return;
+  }
+  nsCString msg("FairPlay key request failed"_ns);
+  if (err) {
+    msg.Append(": ");
+    msg.Append([[err localizedDescription] UTF8String]);
+  }
+  const char* sid = [sessionId UTF8String];
+  mProxy->OnKeyRequestFailed(nsDependentCString(sid), msg);
+}
+
+@end
+
+namespace mozilla {
+
+// The embedder's AVPlayer host, or nil. Optional on the runtime
+// protocol, so a build without it simply never publishes a session and
+// FairPlay stays inert.
+static id<GeckoAVPlayerHost> AVPlayerHostForKeySession() {
+  id<SwiftGeckoViewRuntime> runtime = widget::GetSwiftRuntime();
+  if (!runtime || ![runtime respondsToSelector:@selector(avPlayerHost)]) {
+    return nil;
+  }
+  id<GeckoAVPlayerHost> host = [runtime avPlayerHost];
+  if (![host respondsToSelector:@selector(useContentKeySession:)]) {
+    return nil;
+  }
+  return host;
+}
+
+// Remote-mode proxies by the player they are bound to, so an SPC
+// arriving from the app process finds the one waiting on it.
+//
+// Raw pointers, cleared in Shutdown - which CDMProxy guarantees runs,
+// the same contract PlayersById relies on in AVPlayerDecoder.mm. A
+// StaticMutex rather than a main-thread assertion because the IPC path
+// and the bind path are different callers and this costs nothing.
+static StaticMutex sRemoteProxiesMutex;
+// The init data type each session was created for.
+//
+// ADDED - see mse_fix_81_the_keymessage_netflix_parses.py's docstring.
+// A file static rather than a member, so this needs no header change:
+// session ids are NSUUID strings and unique across proxies, and every
+// reader and writer here is already on the main thread.
+static nsTHashMap<nsCStringHashKey, nsCString>& ReynardInitDataTypes() {
+  static auto* types = new nsTHashMap<nsCStringHashKey, nsCString>();
+  return *types;
+}
+
+// The key message a cenc FairPlay page expects.
+//
+// ADDED - see mse_fix_81's docstring. Netflix's own converter, read out
+// of cadmium-playercore, is unambiguous:
+//
+//   convertToMessageEvent(e) {
+//     if (e.messageType === "license-request") {
+//       let n = this.utf8.encode(new Uint8Array(e.message)),
+//           i = JSON.parse(n);
+//       t = i.map(e => e.keyID);
+//       r = i.map(e => e.payload)
+//     }
+//     ...
+//   }
+//
+// It runs JSON.parse over the message bytes. A raw SPC is not JSON, so
+// JSON.parse throws, onMessage's own catch turns the exception into
+// issueGenerateError, and the session closes with the error swallowed -
+// which is why no capture ever showed a JavaScript error. The stack
+// pinned the catch branch exactly: onMessage's two issueGenerateError
+// call sites are at columns 630376 and 630540, and the frame reports
+// 630540.
+//
+// So Safari's form is an array of {keyID, payload}, both base64, one
+// entry per key the initialisation data names - which is also why a
+// FairPlay pssh may carry several fpsk boxes, and why the converter
+// takes keyID out of the MESSAGE rather than out of the init data.
+//
+// Sixteen bytes of key id, not eight: getDrmKeyMapping in the same file
+// does base64.decode(keyIds[n]).subarray(0, 8), and these ids are eight
+// significant bytes followed by eight zeroes, so the fkri value is
+// already the right thing to send.
+static bool ReynardJsonKeyMessage(const nsTArray<uint8_t>& aKeyId,
+                                  const nsTArray<uint8_t>& aSpc,
+                                  nsTArray<uint8_t>& aOut) {
+  @autoreleasepool {
+    if (aSpc.IsEmpty()) {
+      return false;
+    }
+    // CHANGED - see mse_fix_84's docstring. A pssh naming several keys
+    // is answered with one challenge per key, and the parser side
+    // builds that array itself because it is the side holding the key
+    // ids. Wrapping an array in another array would give Netflix a
+    // keyID of undefined and a payload of the whole batch.
+    if (aSpc[0] == '[' || aSpc[0] == '{') {
+      printf_stderr(
+          "avPlayer: FairPlay key message is already batched, %zu bytes - "
+          "passing it through\n",
+          (size_t)aSpc.Length());
+      aOut.Clear();
+      aOut.AppendElements(aSpc.Elements(), aSpc.Length());
+      return true;
+    }
+    NSData* spc = [NSData dataWithBytes:aSpc.Elements() length:aSpc.Length()];
+    NSString* payload = [spc base64EncodedStringWithOptions:0];
+    if (!payload) {
+      return false;
+    }
+    NSString* keyId = @"";
+    if (!aKeyId.IsEmpty()) {
+      NSData* kid = [NSData dataWithBytes:aKeyId.Elements()
+                                   length:aKeyId.Length()];
+      NSString* encoded = [kid base64EncodedStringWithOptions:0];
+      if (encoded) {
+        keyId = encoded;
+      }
+    }
+    NSArray* entries = @[ @{@"keyID" : keyId, @"payload" : payload} ];
+    NSError* error = nil;
+    NSData* json = [NSJSONSerialization dataWithJSONObject:entries
+                                                   options:0
+                                                     error:&error];
+    if (!json || [json length] == 0) {
+      printf_stderr(
+          "avPlayer: FairPlay could not build the JSON key message: %s\n",
+          error ? [[error description] UTF8String] : "unknown");
+      return false;
+    }
+    aOut.Clear();
+    aOut.AppendElements(static_cast<const uint8_t*>([json bytes]),
+                        [json length]);
+    return true;
+  }
+}
+
+// The CKC inside a licence response, when the response is JSON.
+//
+// ADDED - see mse_fix_81's docstring. The REQUEST side above is read
+// off Netflix's source; this side is not, because no capture has ever
+// contained a response. So this recognises the shapes the batch form
+// implies and, when it cannot, prints every key in the object and
+// leaves the bytes alone - a build that cannot unwrap still names the
+// field that would have worked, and nothing is dropped.
+static bool ReynardUnwrapJsonLicence(const nsTArray<uint8_t>& aResponse,
+                                     nsTArray<uint8_t>& aOut) {
+  @autoreleasepool {
+    if (aResponse.IsEmpty()) {
+      return false;
+    }
+    // A CKC is binary and never opens with either of these.
+    if (aResponse[0] != '{' && aResponse[0] != '[') {
+      return false;
+    }
+    NSData* data = [NSData dataWithBytes:aResponse.Elements()
+                                  length:aResponse.Length()];
+    id parsed = [NSJSONSerialization JSONObjectWithData:data
+                                                options:0
+                                                  error:nil];
+    if (!parsed) {
+      return false;
+    }
+    NSArray* entries = nil;
+    if ([parsed isKindOfClass:[NSArray class]]) {
+      entries = (NSArray*)parsed;
+    } else if ([parsed isKindOfClass:[NSDictionary class]]) {
+      for (NSString* name in @[ @"RESPONSES", @"responses", @"CHALLENGES" ]) {
+        id candidate = [(NSDictionary*)parsed objectForKey:name];
+        if ([candidate isKindOfClass:[NSArray class]]) {
+          entries = (NSArray*)candidate;
+          break;
+        }
+      }
+    }
+    if (!entries || [entries count] == 0) {
+      printf_stderr(
+          "avPlayer: FairPlay licence is JSON with no entry array\n");
+      return false;
+    }
+    // CHANGED - see mse_fix_84's docstring. More than one entry is a
+    // batch, and only the parser side knows which challenge each answers
+    // - it is the side that built them and holds the content ids. Passed
+    // through whole, and split there.
+    if ([entries count] > 1) {
+      printf_stderr(
+          "avPlayer: FairPlay licence carries %lu entries - passing the "
+          "batch through for the parser to split\n",
+          (unsigned long)[entries count]);
+      return false;
+    }
+    id entry = [entries objectAtIndex:0];
+    if (![entry isKindOfClass:[NSDictionary class]]) {
+      return false;
+    }
+    NSString* found = nil;
+    for (NSString* name in
+         @[ @"PAYLOAD", @"payload", @"CKC", @"ckc", @"DATA", @"data" ]) {
+      id candidate = [(NSDictionary*)entry objectForKey:name];
+      if ([candidate isKindOfClass:[NSString class]]) {
+        found = (NSString*)candidate;
+        break;
+      }
+    }
+    if (!found) {
+      nsAutoCString names;
+      for (NSString* key in [(NSDictionary*)entry allKeys]) {
+        names.Append(' ');
+        names.Append([key UTF8String]);
+      }
+      printf_stderr(
+          "avPlayer: FairPlay licence JSON has no payload field - keys:%s\n",
+          names.get());
+      return false;
+    }
+    NSData* ckc =
+        [[[NSData alloc] initWithBase64EncodedString:found
+                                             options:0] autorelease];
+    if (!ckc || [ckc length] == 0) {
+      printf_stderr("avPlayer: FairPlay licence payload is not base64\n");
+      return false;
+    }
+    aOut.Clear();
+    aOut.AppendElements(static_cast<const uint8_t*>([ckc bytes]),
+                        [ckc length]);
+    printf_stderr(
+        "avPlayer: FairPlay licence unwrapped - %zu bytes of JSON -> %zu "
+        "bytes of CKC\n",
+        (size_t)aResponse.Length(), (size_t)aOut.Length());
+    return true;
+  }
+}
