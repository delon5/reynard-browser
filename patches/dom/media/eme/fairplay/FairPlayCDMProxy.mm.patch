+
+bool FairPlayCDMProxy::MaybeForwardUnsolicitedKeyRequest(
+    nsTArray<uint8_t>&& aInitData, const nsACString& aInitDataType) {
+  // Delegate queue. mBoundPlayerId is written on the main thread at
+  // bind time, before playback normally starts; a torn read here at
+  // worst declines the forward, which is the pre-bridge behaviour.
+  const uintptr_t playerId = mBoundPlayerId;
+  if (!playerId) {
+    return false;
+  }
+  nsString initDataType = NS_ConvertUTF8toUTF16(aInitDataType);
+  nsCOMPtr<nsIRunnable> task = NS_NewRunnableFunction(
+      "FairPlayCDMProxy::MaybeForwardUnsolicitedKeyRequest",
+      [playerId, initData = std::move(aInitData), initDataType]() mutable {
+        ReynardAVPlayerDispatchEncrypted(playerId, std::move(initData),
+                                         initDataType);
+      });
+  mMainThread->Dispatch(task.forget(), NS_DISPATCH_NORMAL);
+  return true;
+}
+
+void FairPlayCDMProxy::BindToPlayer(uintptr_t aPlayerId) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mBoundPlayerId == aPlayerId) {
+    return;
+  }
+  mBoundPlayerId = aPlayerId;
+  EME_LOG("FairPlayCDMProxy::BindToPlayer({}) player={}", fmt::ptr(this),
+          (unsigned long long)aPlayerId);
+  if (mRemote) {
+    {
+      StaticMutexAutoLock lock(sRemoteProxiesMutex);
+      // Release the unbound registration BEFORE claiming the real id.
+      //
+      // SendRemoteKeyRequest registers an unbound proxy under 0 so an
+      // MSE SPC can be resolved. If this proxy did that and is now
+      // acquiring a player, the key-0 entry becomes unreachable
+      // bookkeeping that Shutdown - which only ever looked at
+      // mBoundPlayerId - could no longer find. It then outlived the
+      // object and the next SPC in this process dereferenced it.
+      //
+      // Identity-tested, because key 0 is shared: another MSE proxy may
+      // legitimately own it, and tearing out its entry here would
+      // silence it for good.
+      if (RemoteProxies().Get(0) == this) {
+        RemoteProxies().Remove(0);
+      }
+      RemoteProxies().InsertOrUpdate(static_cast<uint64_t>(aPlayerId), this);
+    }
+    // Anything the page asked for before this bind had no id to be
+    // addressed to. Moved out first: SendRemoteKeyRequest cannot
+    // re-enter this list, but taking the array by value makes that
+    // true by construction rather than by reading the callee.
+    nsTArray<RemoteKeyRequest> parked = std::move(mRemoteParkedRequests);
+    for (const RemoteKeyRequest& request : parked) {
+      printf_stderr("avPlayer: FairPlay replaying generateRequest for %s\n",
+                    request.mContentId.get());
+      SendRemoteKeyRequest(request);
+    }
+  }
+  PublishKeySessionIfBound();
+  // Anything that arrived before this bind is parked in the delegate,
+  // waiting for exactly this moment - a key request that lost the race
+  // to SetCDMProxy would otherwise sit there until teardown, and the
+  // page would never hear 'encrypted' for it.
+  if (mDelegate) {
+    printf_stderr("avPlayer: replaying parked key requests for player %llu\n",
+                  (unsigned long long)aPlayerId);
+    [mDelegate replayUnsolicitedRequests];
+  }
+}
+
+// Either order: Init may run before the decoder has a player, and the
+// decoder may bind before Init has a session. Whichever arrives second
+// does the publish.
+void FairPlayCDMProxy::PublishKeySessionIfBound() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mKeySession || !mBoundPlayerId) {
+    return;
+  }
+  id<GeckoAVPlayerHost> host = AVPlayerHostForKeySession();
+  if (!host ||
+      ![host respondsToSelector:@selector(useContentKeySession:forPlayer:)]) {
+    return;
+  }
+  EME_LOG("FairPlayCDMProxy::PublishKeySessionIfBound({}) player={}",
+          fmt::ptr(this), (unsigned long long)mBoundPlayerId);
+  [host useContentKeySession:mKeySession forPlayer:mBoundPlayerId];
+}
