+
+void FairPlayCDMProxy::Shutdown() {
+  MOZ_ASSERT(NS_IsMainThread());
+  EME_LOG("FairPlayCDMProxy::Shutdown({})", fmt::ptr(this));
+
+  if (mRemote) {
+    StaticMutexAutoLock lock(sRemoteProxiesMutex);
+    // EVERY key this proxy can occupy, not just the one it is bound to,
+    // because a proxy can occupy TWO keys: 0, from SendRemoteKeyRequest
+    // while it was still unbound, and its real id once BindToPlayer
+    // ran. Removing only mBoundPlayerId left the key-0 entry pointing
+    // at freed memory, and the next MSE SPC in this content process
+    // delivered into it - a use-after-free needing no unusual timing,
+    // just register-unbound, bind, tear down, receive.
+    //
+    // Each removal is identity-tested. Key 0 is shared by every MSE
+    // proxy in the process, and an unbound native-HLS proxy carries id
+    // 0 without ever having registered, so removing by id alone would
+    // tear out a live entry belonging to someone else.
+    const uint64_t key = static_cast<uint64_t>(mBoundPlayerId);
+    if (RemoteProxies().Get(key) == this) {
+      RemoteProxies().Remove(key);
+    }
+    if (key != 0 && RemoteProxies().Get(0) == this) {
+      RemoteProxies().Remove(0);
+    }
+  }
+  if (mDelegate) {
+    [mDelegate detach];
+    [mDelegate release];
+    mDelegate = nullptr;
+  }
+  if (mKeySession) {
+    [mKeySession release];
+    mKeySession = nullptr;
+  }
+  mKeys.Clear();
+}
