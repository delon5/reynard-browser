+// Defined in AVPlayerDecoder.mm; forward-declared here rather than
+// through a header so dom/media/eme/fairplay needs no include-path
+// changes. Both live in libxul.
+void ReynardAVPlayerDispatchEncrypted(uintptr_t aPlayerId,
+                                      nsTArray<uint8_t>&& aInitData,
+                                      const nsAString& aInitDataType);
