+void FairPlayCDMProxy::OnSessionMessage(const nsAString& aSessionId,
+                                        dom::MediaKeyMessageType aMessageType,
+                                        const nsTArray<uint8_t>& aMessage) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mKeys.IsNull()) {
+    return;
+  }
+  // CHANGED - see mse_fix_81's docstring. A cenc page runs JSON.parse
+  // over these bytes; a sinf or skd page takes the SPC as it is. Only
+  // cenc is wrapped, which is what keeps HBO Max - whose init data IS a
+  // sinf, and whose licences are accepted today - on exactly the path
+  // it is on now.
+  nsTArray<uint8_t> wrapped;
+  const nsTArray<uint8_t>* message = &aMessage;
+  if (aMessageType == dom::MediaKeyMessageType::License_request) {
+    NS_ConvertUTF16toUTF8 sessionKey(aSessionId);
+    nsCString initDataType;
+    if (ReynardInitDataTypes().Get(sessionKey, &initDataType) &&
+        initDataType.EqualsLiteral("cenc")) {
+      nsTArray<uint8_t> keyId;
+      if (auto real = mKeyIdBySession.Lookup(sessionKey)) {
+        keyId.AppendElements(real->Elements(), real->Length());
+      }
+      if (ReynardJsonKeyMessage(keyId, aMessage, wrapped)) {
+        printf_stderr(
+            "avPlayer: FairPlay key message wrapped for cenc - %zu bytes "
+            "of SPC -> %zu bytes of JSON, key id %zu bytes\n",
+            (size_t)aMessage.Length(), (size_t)wrapped.Length(),
+            (size_t)keyId.Length());
+        message = &wrapped;
+      }
+    }
+  }
+  RefPtr<dom::MediaKeySession> session = mKeys->GetSession(aSessionId);
+  if (session) {
+    session->DispatchKeyMessage(aMessageType, *message);
+  }
+}
