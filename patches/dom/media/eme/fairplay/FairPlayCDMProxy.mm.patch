+using namespace mozilla;
+
+// The delegate AVContentKeySession calls back on. Owns a strong
+// reference to the proxy, cleared on shutdown so the two do not keep
+// each other alive.
+@interface FairPlayKeyDelegate : NSObject <AVContentKeySessionDelegate> {
+ @private
+  RefPtr<FairPlayCDMProxy> mProxy;
+  // Correlates a key request back to the EME session that asked for it.
+  // AVContentKeySession hands back the request, not our session id.
+  NSMutableDictionary<NSString*, AVContentKeyRequest*>* mRequestsBySession;
+  NSMutableDictionary<NSString*, NSString*>* mSessionsByIdentifier;
+  // Key requests the asset raised before any EME session mapped their
+  // identifier - forwarded to the page as 'encrypted' and held pending
+  // until CreateSession adopts them.
+  NSMutableDictionary<NSString*, AVContentKeyRequest*>* mUnsolicitedByIdentifier;
+}
+- (instancetype)initWithProxy:(FairPlayCDMProxy*)aProxy;
+- (void)detach;
+- (void)rememberSession:(NSString*)aSessionId
+          forIdentifier:(NSString*)aIdentifier;
+- (AVContentKeyRequest*)requestForSession:(NSString*)aSessionId;
+- (void)forgetSession:(NSString*)aSessionId;
+- (AVContentKeyRequest*)takeUnsolicitedForIdentifier:(NSString*)aKey;
+@end
+
+@implementation FairPlayKeyDelegate
+
+- (instancetype)initWithProxy:(FairPlayCDMProxy*)aProxy {
+  self = [super init];
+  if (self) {
+    mProxy = aProxy;
+    mRequestsBySession = [[NSMutableDictionary alloc] init];
+    mSessionsByIdentifier = [[NSMutableDictionary alloc] init];
+    mUnsolicitedByIdentifier = [[NSMutableDictionary alloc] init];
+  }
+  return self;
+}
+
+- (void)detach {
+  mProxy = nullptr;
+  [mRequestsBySession removeAllObjects];
+  [mSessionsByIdentifier removeAllObjects];
+  [mUnsolicitedByIdentifier removeAllObjects];
+}
+
+- (void)rememberSession:(NSString*)aSessionId
+          forIdentifier:(NSString*)aIdentifier {
+  @synchronized(self) {
+    if (aIdentifier) {
+      mSessionsByIdentifier[aIdentifier] = aSessionId;
+    }
+  }
+}
+
+- (AVContentKeyRequest*)requestForSession:(NSString*)aSessionId {
+  @synchronized(self) {
+    return mRequestsBySession[aSessionId];
+  }
+}
+
+- (void)forgetSession:(NSString*)aSessionId {
+  @synchronized(self) {
+    [mRequestsBySession removeObjectForKey:aSessionId];
+  }
+}
+
+// The map key for a request's identifier - the same encoding
+// CreateSession stores: the skd string itself, or base64 of raw bytes.
+- (NSString*)identifierKeyForRequest:(AVContentKeyRequest*)aRequest {
+  id identifier = aRequest.identifier;
+  if ([identifier isKindOfClass:[NSString class]]) {
+    return (NSString*)identifier;
+  }
+  if ([identifier isKindOfClass:[NSData class]]) {
+    return [(NSData*)identifier base64EncodedStringWithOptions:0];
+  }
+  return nil;
+}
+
+- (void)rememberUnsolicited:(AVContentKeyRequest*)aRequest
+                     forKey:(NSString*)aKey {
+  @synchronized(self) {
+    mUnsolicitedByIdentifier[aKey] = aRequest;
+  }
+}
+
+- (AVContentKeyRequest*)takeUnsolicitedForIdentifier:(NSString*)aKey {
+  if (!aKey) {
+    return nil;
+  }
+  @synchronized(self) {
+    AVContentKeyRequest* request = mUnsolicitedByIdentifier[aKey];
+    if (request) {
+      [mUnsolicitedByIdentifier removeObjectForKey:aKey];
+    }
+    return request;
+  }
+}
+
+// Resolves the EME session id for a request, by the identifier it was
+// issued with.
+- (NSString*)sessionIdForRequest:(AVContentKeyRequest*)aRequest {
+  id identifier = aRequest.identifier;
+  NSString* key = nil;
+  if ([identifier isKindOfClass:[NSString class]]) {
+    key = (NSString*)identifier;
+  } else if ([identifier isKindOfClass:[NSData class]]) {
+    // base64 to match the key CreateSession stored: raw key-id bytes are
+    // rarely valid UTF-8, so a UTF-8 decode usually yields nil and the
+    // lookup silently misses.
+    key = [(NSData*)identifier base64EncodedStringWithOptions:0];
+  }
+  if (!key) {
+    return nil;
+  }
+  @synchronized(self) {
+    return mSessionsByIdentifier[key];
+  }
+}
+
+- (void)contentKeySession:(AVContentKeySession*)session
+    didProvideContentKeyRequest:(AVContentKeyRequest*)keyRequest {
+  if (!mProxy) {
+    return;
+  }
+
+  NSString* sessionId = [self sessionIdForRequest:keyRequest];
+  if (!sessionId) {
+    // A key request no EME session has mapped: the asset reached an
+    // EXT-X-KEY before the page called generateRequest for it - the
+    // normal Safari-style order, where the PLAYER learns about
+    // encryption from the 'encrypted' event. This pipeline's demuxer
+    // never sees the stream, so this delegate is the only place that
+    // event can come from: forward the identifier to the page as
+    // 'encrypted', hold the request pending, and let CreateSession
+    // adopt it when generateRequest arrives with the same identifier.
+    NSString* identifierKey = [self identifierKeyForRequest:keyRequest];
+    if (identifierKey) {
+      nsTArray<uint8_t> initData;
+      nsCString initDataType;
+      id identifier = keyRequest.identifier;
+      if ([identifier isKindOfClass:[NSString class]]) {
+        NSData* uri =
+            [(NSString*)identifier dataUsingEncoding:NSUTF8StringEncoding];
+        initData.AppendElements(static_cast<const uint8_t*>([uri bytes]),
+                                [uri length]);
+        initDataType.AssignLiteral("skd");
+      } else {
+        NSData* keyId = (NSData*)identifier;
+        initData.AppendElements(static_cast<const uint8_t*>([keyId bytes]),
+                                [keyId length]);
+        initDataType.AssignLiteral("sinf");
+      }
+      [self rememberUnsolicited:keyRequest forKey:identifierKey];
+      if (mProxy->MaybeForwardUnsolicitedKeyRequest(std::move(initData),
+                                                    initDataType)) {
+        return;
+      }
+      // No bound player to dispatch through - undo the hold and fall
+      // through to the failure below.
+      [self takeUnsolicitedForIdentifier:identifierKey];
+    }
+    // Nothing to tell the page through (unbound proxy, or an identifier
+    // of an unexpected class). Fail it - a bare return left AVFoundation
+    // waiting forever for a response that could not come.
+    [keyRequest processContentKeyResponseError:
+        [NSError errorWithDomain:@"ReynardFairPlay"
+                            code:-2
+                        userInfo:@{
+                          NSLocalizedDescriptionKey :
+                              @"No EME session for this key request"
+                        }]];
+    return;
+  }
+
+  @synchronized(self) {
+    mRequestsBySession[sessionId] = keyRequest;
+  }
+
+  // The application certificate is what identifies this app to the key
+  // server. Without it there is no SPC to make, so fail loudly rather
+  // than issuing a request that cannot be satisfied.
+  if (mProxy->mAppCertificate.IsEmpty()) {
+    const char* sid = [sessionId UTF8String];
+    mProxy->OnKeyRequestFailed(
+        nsDependentCString(sid),
+        "setServerCertificate must be called before generateRequest for FairPlay"_ns);
+    // The EME error above tells the page; this tells AVFoundation, so
+    // the request does not sit pending forever inside the player.
+    [keyRequest processContentKeyResponseError:
+        [NSError errorWithDomain:@"ReynardFairPlay"
+                            code:-3
+                        userInfo:@{
+                          NSLocalizedDescriptionKey :
+                              @"FairPlay application certificate not set"
+                        }]];
+    return;
+  }
+
+  NSData* appCert = [NSData dataWithBytes:mProxy->mAppCertificate.Elements()
+                                   length:mProxy->mAppCertificate.Length()];
+
+  id identifier = keyRequest.identifier;
+  NSData* contentId = nil;
+  if ([identifier isKindOfClass:[NSString class]]) {
+    contentId = [(NSString*)identifier dataUsingEncoding:NSUTF8StringEncoding];
+  } else if ([identifier isKindOfClass:[NSData class]]) {
+    contentId = (NSData*)identifier;
+  }
+
+  RefPtr<FairPlayCDMProxy> proxy = mProxy;
+  // Via a local: a message send nested inside a constructor argument
+  // reads as a message to the constructor itself in Objective-C++.
+  const char* sessionIdUTF8 = [sessionId UTF8String];
+  nsCString sessionIdCopy(sessionIdUTF8);
+
+  [keyRequest
+      makeStreamingContentKeyRequestDataForApp:appCert
+                             contentIdentifier:contentId
+                                       options:nil
+                             completionHandler:^(NSData* _Nullable requestData,
+                                                 NSError* _Nullable error) {
+                               if (error || !requestData) {
+                                 nsCString msg("FairPlay key request failed"_ns);
+                                 if (error) {
+                                   msg.Append(": ");
+                                   msg.Append([[error localizedDescription]
+                                       UTF8String]);
+                                 }
+                                 proxy->OnKeyRequestFailed(sessionIdCopy, msg);
+                                 return;
+                               }
+
+                               nsTArray<uint8_t> spc;
+                               spc.AppendElements(
+                                   static_cast<const uint8_t*>(
+                                       [requestData bytes]),
+                                   [requestData length]);
+                               proxy->OnKeyRequestReady(sessionIdCopy,
+                                                        std::move(spc));
+                             }];
+}
+
+- (void)contentKeySession:(AVContentKeySession*)session
+        contentKeyRequest:(AVContentKeyRequest*)keyRequest
+         didFailWithError:(NSError*)err {
+  if (!mProxy) {
+    return;
+  }
+  NSString* sessionId = [self sessionIdForRequest:keyRequest];
+  if (!sessionId) {
+    return;
+  }
+  nsCString msg("FairPlay key request failed"_ns);
+  if (err) {
+    msg.Append(": ");
+    msg.Append([[err localizedDescription] UTF8String]);
+  }
+  const char* sid = [sessionId UTF8String];
+  mProxy->OnKeyRequestFailed(nsDependentCString(sid), msg);
+}
+
+@end
+
+namespace mozilla {
+
+// The embedder's AVPlayer host, or nil. Optional on the runtime
+// protocol, so a build without it simply never publishes a session and
+// FairPlay stays inert.
+static id<GeckoAVPlayerHost> AVPlayerHostForKeySession() {
+  id<SwiftGeckoViewRuntime> runtime = widget::GetSwiftRuntime();
+  if (!runtime || ![runtime respondsToSelector:@selector(avPlayerHost)]) {
+    return nil;
+  }
+  id<GeckoAVPlayerHost> host = [runtime avPlayerHost];
+  if (![host respondsToSelector:@selector(useContentKeySession:)]) {
+    return nil;
+  }
+  return host;
+}
