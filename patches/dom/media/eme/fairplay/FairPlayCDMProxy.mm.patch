+
+// CONTENT PROCESS: an fMP4 init segment the page appended, on its way
+// to the app process's parser session.
+//
+// ADDED - see fix_forward_init_segment_to_parser.py's docstring. The
+// parser originates a key request from a parsed init segment and from
+// nothing else; the session only RESOLVES a requirement a recipient
+// has raised, which is why feeding it EME init data produced no
+// request across two builds.
+//
+// Sent on the message the parser route already uses, with player id 0
+// and a type nobody else sends. A new message would mean PContent.ipdl
+// and a 25-35 minute rebuild for a payload the existing one already
+// carries; ContentParent composes the child half of the key from
+// ChildID() itself, so there is nothing here that needs to know it.
+//
+// Free function, not a method: SourceBuffer has no proxy to call
+// through, and on this path there may be no proxy at all yet.
+// mozilla::dom deliberately, and with ordinary C++ linkage. The only
+// caller is SourceBuffer::AppendData, which is itself in mozilla::dom and
+// declares this at block scope - and a block-scope declaration always
+// names the enclosing namespace, so this has to be the namespace it
+// names. extern "C" would remove the question but is not permitted at
+// block scope, which is what the caller has.
+//
+// `namespace dom`, not `namespace mozilla::dom`: this point in the file
+// is already inside the `namespace mozilla` opened above, so the fully
+// spelled form would nest to mozilla::mozilla::dom and the caller's
+// symbol would go on being undefined.
+namespace dom {
+void ReynardMSEForwardInitSegment(const uint8_t* aData, size_t aLength) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!aData || !aLength) {
+    return;
+  }
+  ::mozilla::dom::ContentChild* cc =
+      ::mozilla::dom::ContentChild::GetSingleton();
+  if (!cc) {
+    return;
+  }
+  nsTArray<uint8_t> segment;
+  segment.AppendElements(aData, aLength);
+  printf_stderr("avPlayer: MSE forwarding a %zu byte init segment to "
+                "the parser\n", aLength);
+  cc->SendAVPlayerKeyGenerateRequest(0, nsCString(""),
+                                     nsCString("initseg"), segment);
+}
+}  // namespace dom
+
+void FairPlayCDMProxy::SendRemoteKeyRequest(
+    const RemoteKeyRequest& aRequest) {
+  MOZ_ASSERT(NS_IsMainThread());
+  dom::ContentChild* cc = dom::ContentChild::GetSingleton();
+  if (!cc) {
+    return;
+  }
+  if (!mBoundPlayerId) {
+    // MSE. No player will ever be bound, so BindToPlayer - the only
+    // place that registers a proxy for the return leg - will never run,
+    // and the SPC would arrive in the right process only to be dropped
+    // as "SPC for unknown player 0".
+    //
+    // Registered under 0, which is the id it comes back addressed to.
+    //
+    // One slot for the whole content process, and that is a real
+    // limitation rather than a scoping choice: the broker discriminates
+    // MSE by exactly (aKey & 0xffffffff) == 0, so a unique id here
+    // would route these requests back down the player path. Two MediaKeys
+    // objects in one process therefore contend for this entry and the
+    // later one wins - the earlier stops receiving messages.
+    //
+    // Said out loud, because that failure is otherwise invisible and
+    // looks exactly like the silence this whole route replaced. The
+    // identity guards in BindToPlayer and Shutdown keep it a misroute
+    // rather than a use-after-free: a displaced proxy can no longer
+    // remove the winner's entry on its way out.
+    StaticMutexAutoLock lock(sRemoteProxiesMutex);
+    if (FairPlayCDMProxy* existing = RemoteProxies().Get(0)) {
+      if (existing != this) {
+        printf_stderr(
+            "avPlayer: FairPlay WARNING second MSE proxy in this process - "
+            "displacing the one registered for SPC delivery; the earlier "
+            "MediaKeys will stop receiving messages\n");
+      }
+    }
+    RemoteProxies().InsertOrUpdate(0, this);
+  }
+  cc->SendAVPlayerKeyGenerateRequest(static_cast<uint64_t>(mBoundPlayerId),
+                                     aRequest.mContentId,
+                                     aRequest.mInitDataType,
+                                     aRequest.mInitData);
+}
+
+void FairPlayCDMProxy::DeliverRemoteKeyMessage(const nsACString& aContentId,
+                                               nsTArray<uint8_t>&& aSpc) {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsCString contentId(aContentId);
+  nsCString sessionId;
+  if (!mRemoteSessionByContentId.Get(contentId, &sessionId)) {
+    // Before parking: a session may already be waiting under a content
+    // id that identifies nothing, because the page never received the
+    // init data to build one from. See
+    // ReynardIsDegenerateFairPlayContentId. This side holds the real
+    // identifier, so this is the moment the two halves can be joined.
+    nsCString degenerateId;
+    for (auto iter = mRemoteSessionByContentId.Iter(); !iter.Done();
+         iter.Next()) {
+      if (ReynardIsDegenerateFairPlayContentId(iter.Key())) {
+        degenerateId = iter.Key();
+        sessionId = iter.Data();
+        break;
+      }
+    }
+    if (!sessionId.IsEmpty()) {
+      printf_stderr(
+          "avPlayer: FairPlay SPC for %s adopted by session %s, which had "
+          "no content id (%zu bytes)\n",
+          contentId.get(), sessionId.get(), (size_t)aSpc.Length());
+      // Record the REVERSE mapping, and consume the degenerate entry
+      // - CHANGED, it used to be left in place. See
+      // fix_degenerate_session_not_reused.py's docstring.
+      //
+      // Re-filing under the real id was the obvious move and it was
+      // wrong: it pinned this session there for the life of the
+      // proxy, so a retry - which builds a new session, again with no
+      // content id - lost every later SPC to the first one. A capture
+      // showed all three attempts delivered to the same session while
+      // two newer ones waited.
+      //
+      // Removing it keeps the adoption one-shot. A retry builds
+      // another session with no content id, and CreateSession files
+      // that one under the same degenerate key, so the NEWEST session
+      // still receives - the property this comment has always wanted.
+      // What no longer happens is an already-served session
+      // intercepting the next SPC, which belongs in the parking
+      // branch below. The session -> id direction is the half
+      // UpdateSession needs, to tag the CKC with something the app
+      // process can match.
+      mRemoteContentIdBySession.InsertOrUpdate(sessionId, contentId);
+      mRemoteSessionByContentId.Remove(degenerateId);
+      OnSessionMessage(NS_ConvertUTF8toUTF16(sessionId),
+                       dom::MediaKeyMessageType::License_request, aSpc);
+      return;
+    }
+
+    // The page has not called generateRequest for this identifier yet
+    // - it is still handling the 'encrypted' event the SAME key
+    // request produced. Held until CreateSession claims it, which is
+    // the ordinary order rather than an edge case.
+    printf_stderr("avPlayer: FairPlay SPC parked for %s (%zu bytes)\n",
+                  contentId.get(), (size_t)aSpc.Length());
+    mRemotePendingSpc.InsertOrUpdate(contentId, std::move(aSpc));
+    return;
+  }
+  printf_stderr("avPlayer: FairPlay SPC -> session %s (%zu bytes)\n",
+                sessionId.get(), (size_t)aSpc.Length());
+  OnSessionMessage(NS_ConvertUTF8toUTF16(sessionId),
+                   dom::MediaKeyMessageType::License_request, aSpc);
+}
+
+// The far end of ContentChild::RecvAVPlayerKeyMessage. A free function
+// because ContentChild.cpp is plain C++ and must not see this file's
+// Objective-C, and because the registry it needs lives here.
+void ReynardFairPlayDeliverKeyMessage(uintptr_t aPlayerId,
+                                      const nsACString& aContentId,
+                                      nsTArray<uint8_t>&& aSpc) {
+  MOZ_ASSERT(NS_IsMainThread());
+  RefPtr<FairPlayCDMProxy> proxy;
+  {
+    StaticMutexAutoLock lock(sRemoteProxiesMutex);
+    proxy = RemoteProxies().Get(static_cast<uint64_t>(aPlayerId));
+  }
+  if (!proxy) {
+    // Teardown race, or a key request for a player whose element has
+    // no MediaKeys - dropped, like every other unknown-id path in this
+    // pipeline.
+    printf_stderr("avPlayer: FairPlay SPC for unknown player %llu\n",
+                  (unsigned long long)aPlayerId);
+    return;
+  }
+  proxy->DeliverRemoteKeyMessage(aContentId, std::move(aSpc));
+}
