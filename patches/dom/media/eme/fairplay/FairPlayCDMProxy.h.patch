+#ifndef FairPlayCDMProxy_h_
+#define FairPlayCDMProxy_h_
+
+#include "mozilla/CDMProxy.h"
+#include "mozilla/dom/MediaKeys.h"
+#include "nsTHashMap.h"
+
+#ifdef __OBJC__
+@class AVContentKeySession;
+@class FairPlayKeyDelegate;
+#else
+using AVContentKeySession = struct objc_object;
+using FairPlayKeyDelegate = struct objc_object;
+#endif
+
+namespace mozilla {
+
+// FairPlay Streaming, backed by AVContentKeySession.
+//
+// Structurally this follows MediaDrmCDMProxy rather than
+// ChromiumCDMProxy, because Android has the same division of labour:
+// the platform owns decryption, Gecko never sees clear samples, and the
+// proxy handles licence negotiation only.
+//
+// The licence round trip:
+//
+//   CreateSession   -> processContentKeyRequestWithIdentifier:
+//                      initializationData:options:
+//   didProvide      -> makeStreamingContentKeyRequestDataForApp:
+//                      produces the SPC, delivered as a message event
+//   UpdateSession   -> processContentKeyResponse: with the CKC
+//
+// Decrypt is unreachable for the same reason it is on Android, and
+// FairPlay is stricter still: AVSampleBufferAttachContentKey on a
+// buffer the app decodes itself returns "this app is not authorized to
+// play this file", by design rather than by accident.
+class FairPlayCDMProxy final : public CDMProxy {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(FairPlayCDMProxy, override)
+
+  FairPlayCDMProxy(dom::MediaKeys* aKeys, const nsAString& aKeySystem,
+                   bool aDistinctiveIdentifierRequired,
+                   bool aPersistentStateRequired);
+
+  void Init(PromiseId aPromiseId, const nsAString& aOrigin,
+            const nsAString& aTopLevelOrigin,
+            const nsAString& aName) override;
+
+  void CreateSession(uint32_t aCreateSessionToken,
+                     dom::MediaKeySessionType aSessionType,
+                     PromiseId aPromiseId, const nsAString& aInitDataType,
+                     nsTArray<uint8_t>& aInitData) override;
+
+  void LoadSession(PromiseId aPromiseId,
+                   dom::MediaKeySessionType aSessionType,
+                   const nsAString& aSessionId) override;
+
+  void SetServerCertificate(PromiseId aPromiseId,
+                            nsTArray<uint8_t>& aCert) override;
+
+  void UpdateSession(const nsAString& aSessionId, PromiseId aPromiseId,
+                     nsTArray<uint8_t>& aResponse) override;
+
+  void CloseSession(const nsAString& aSessionId,
+                    PromiseId aPromiseId) override;
+
+  void RemoveSession(const nsAString& aSessionId,
+                     PromiseId aPromiseId) override;
+
+  // Pairs this proxy with the AVPlayer its keys are for. FairPlay only
+  // decrypts an asset registered as a recipient of the SAME key
+  // session, so a proxy published to whichever player happened to be
+  // most recent is only correct when there is exactly one. Called by
+  // AVPlayerDecoder::SetCDMProxy; publishes as soon as both the session
+  // and the id are known, in either order.
+  void BindToPlayer(uintptr_t aPlayerId);
+  void PublishKeySessionIfBound();
+
+  void QueryOutputProtectionStatus() override;
+
+  void NotifyOutputProtectionStatus(
+      OutputProtectionCheckStatus aCheckStatus,
+      OutputProtectionCaptureStatus aCaptureStatus) override;
+
+  void Shutdown() override;
+  void Terminated() override;
+
+  void OnSetSessionId(uint32_t aCreateSessionToken,
+                      const nsAString& aSessionId) override;
+  void OnResolveLoadSessionPromise(uint32_t aPromiseId,
+                                   bool aSuccess) override;
+  void OnSessionMessage(const nsAString& aSessionId,
+                        dom::MediaKeyMessageType aMessageType,
+                        const nsTArray<uint8_t>& aMessage) override;
+  void OnExpirationChange(const nsAString& aSessionId,
+                          UnixTime aExpiryTime) override;
+  void OnSessionClosed(const nsAString& aSessionId,
+                       dom::MediaKeySessionClosedReason aReason) override;
+  void OnSessionError(const nsAString& aSessionId, nsresult aException,
+                      uint32_t aSystemCode, const nsAString& aMsg) override;
+  void OnRejectPromise(uint32_t aPromiseId, ErrorResult&& aException,
+                       const nsCString& aMsg) override;
+
+  RefPtr<DecryptPromise> Decrypt(MediaRawData* aSample) override;
+  void OnDecrypted(uint32_t aId, DecryptStatus aResult,
+                   const nsTArray<uint8_t>& aDecryptedData) override;
+
+  void RejectPromise(PromiseId aId, ErrorResult&& aException,
+                     const nsCString& aReason) override;
+  void ResolvePromise(PromiseId aId) override;
+  void OnKeyStatusesChange(const nsAString& aSessionId) override;
+  void GetStatusForPolicy(PromiseId aPromiseId,
+                          const dom::HDCPVersion& aMinHdcpVersion) override;
+#ifdef DEBUG
+  // Only virtual in debug builds, so declaring it unconditionally makes
+  // release builds fail with "only virtual member functions can be
+  // marked 'override'".
+  bool IsOnOwnerThread() override;
+#endif
+
+  // Called from the delegate, on the delegate queue. Both marshal to
+  // main before touching MediaKeys.
+  void OnKeyRequestReady(const nsACString& aSessionId,
+                         nsTArray<uint8_t>&& aRequestData);
+  void OnKeyRequestFailed(const nsACString& aSessionId,
+                          const nsACString& aMessage);
+
+  // Also from the delegate: a key request whose identifier no EME
+  // session has mapped, on a proxy bound to a player. Forwarded to the
+  // page as an 'encrypted' event so a Safari-style player can start
+  // its licence flow - this pipeline's demuxer never sees the stream,
+  // so nothing else can fire that event. Returns false when no player
+  // is bound yet, in which case the delegate fails the request (the
+  // pre-bridge behaviour).
+  bool MaybeForwardUnsolicitedKeyRequest(nsTArray<uint8_t>&& aInitData,
+                                         const nsACString& aInitDataType);
+
+  // REMOTE MODE - true whenever this proxy is in a content process,
+  // which is every proxy a page can create.
+  //
+  // AVContentKeySession decrypts an AVURLAsset registered on it with
+  // addContentKeyRecipient, and that method takes an AVURLAsset and
+  // nothing else. Since the player moved to the app process the asset
+  // is over there, so a session built HERE is attached to nothing: the
+  // licence exchange on it succeeds, keyStatuses says usable, and the
+  // item still fails, because the keys and the asset never met. In
+  // remote mode no session is created here at all and the licence
+  // bytes travel over PContent instead - see the AVPlayerKey* messages
+  // in PContent.ipdl.
+  //
+  // The non-remote path below is unchanged and still runs for a
+  // single-process build, where the publish does reach the host that
+  // owns the asset.
+  const bool mRemote;
+
+  // Remote mode: an SPC arrived from the app process for this content
+  // id. Delivered as the session's 'message' event, or held if the page
+  // has not called generateRequest for that identifier yet.
+  void DeliverRemoteKeyMessage(const nsACString& aContentId,
+                               nsTArray<uint8_t>&& aSpc);
+
+  // The application certificate, supplied by the page through
+  // setServerCertificate. makeStreamingContentKeyRequestDataForApp
+  // cannot produce an SPC without it, so a generateRequest before one
+  // arrives is rejected rather than left hanging.
+  nsTArray<uint8_t> mAppCertificate;
+
+  // The AVPlayer these keys belong to, once AVPlayerDecoder has said so.
+  // Zero until then; the publish waits for it rather than guessing.
+  uintptr_t mBoundPlayerId = 0;
+
+  // The session the EME key exchange is bound to.
+  //
+  // FairPlay only decrypts media AVFoundation itself owns, and only when
+  // that media's AVURLAsset has been added to the SAME
+  // AVContentKeySession the licence was negotiated on - a second session
+  // holds no keys. AVPlayerDecoder therefore reaches in here, through
+  // MediaDecoder::SetCDMProxy, and hands this to the embedder so the
+  // asset can be registered as a recipient.
+  //
+  // Main thread only, matching every other member here, and null until
+  // Init has run.
+  AVContentKeySession* KeySession() const { return mKeySession; }
+
+ private:
+  ~FairPlayCDMProxy();
+
+  void RejectPromiseWithStateError(PromiseId aId, const nsCString& aReason);
+
+  // Remote mode only. Content ids are the shared name between the two
+  // processes - the skd:// URI for HLS, base64 of the raw key id for
+  // fragmented MP4 - because the app process has no notion of an EME
+  // session, and both sides already keyed by exactly that string
+  // before any of this crossed a process boundary.
+  nsTHashMap<nsCStringHashKey, nsCString> mRemoteSessionByContentId;
+  nsTHashMap<nsCStringHashKey, nsCString> mRemoteContentIdBySession;
+  // An SPC that arrived before the page called generateRequest for it,
+  // which is the ORDINARY order: AVFoundation raises its key request
+  // as soon as the playlist reaches EXT-X-KEY, and everything the page
+  // does is a reply to the 'encrypted' event that produced.
+  nsTHashMap<nsCStringHashKey, nsTArray<uint8_t>> mRemotePendingSpc;
+  // The real cenc key id, per session, when the init data carried one.
+  //
+  // UpdateSession otherwise files keyStatuses under the session id - a
+  // 36-byte ASCII UUID - which suits an opaque skd identifier and suits
+  // nothing else. HBO Max hands sinf init data with a genuine 16-byte
+  // KID in its tenc box, takes its licence, and then waits on a
+  // keyStatuses lookup that can never hit. Parsed in CreateSession,
+  // used in UpdateSession, empty whenever there was nothing to parse.
+  nsTHashMap<nsCStringHashKey, nsTArray<uint8_t>> mKeyIdBySession;
+  // When each of those entries was filed, as a monotonic serial.
+  // DeliverRemoteKeyMessage resolves a key id back to a session by
+  // walking the map above, and several live sessions can hold the
+  // same key id when a service reuses KIDs across titles; the SPC
+  // belongs to the newest of them, and hash order cannot say which
+  // that is. Written beside the key id in CreateSession, pruned with
+  // it in CloseSession. Main thread only, like everything here.
+  nsTHashMap<nsCStringHashKey, uint64_t> mKeyIdSerialBySession;
+  uint64_t mNextKeyIdSerial = 0;
+
+  // A generateRequest that arrived before AVPlayerDecoder::SetCDMProxy
+  // named the player, so there was no id to address it to. Flushed by
+  // BindToPlayer. Without this the request is silently dropped when the
+  // page is quick.
+  struct RemoteKeyRequest {
+    nsCString mContentId;
+    nsCString mInitDataType;
+    nsTArray<uint8_t> mInitData;
+  };
+  nsTArray<RemoteKeyRequest> mRemoteParkedRequests;
+  void SendRemoteKeyRequest(const RemoteKeyRequest& aRequest);
+
+  AVContentKeySession* mKeySession = nullptr;
+  FairPlayKeyDelegate* mDelegate = nullptr;
+  nsCOMPtr<nsISerialEventTarget> mOwnerThread;
+};
+
+}  // namespace mozilla
+
+#endif  // FairPlayCDMProxy_h_
