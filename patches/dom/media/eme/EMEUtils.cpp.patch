+bool IsFairPlayKeySystem(const nsAString& aKeySystem) {
+  if (aKeySystem.EqualsLiteral(kFairPlayKeySystemName)) {
+    return true;
+  }
+  // The versioned names, which is what pages actually ask for. Safari
+  // takes com.apple.fps from 12.1, but com.apple.fps.1_0 is still the
+  // common request across the shipping players (hls.js, Shaka, JW,
+  // Bitmovin), with 2_0 and 3_0 in use as well. Matching only the bare
+  // name rejects those at requestMediaKeySystemAccess - before any of
+  // this pipeline is reached, and with nothing in the log to say why.
+  return StringBeginsWith(aKeySystem, u"com.apple.fps."_ns);
+}
