 bool KeySystemConfig::Supports(const nsAString& aKeySystem) {
+#ifdef MOZ_WIDGET_UIKIT
+  // DIAGNOSTIC. A device capture of a FairPlay demo showed EIGHT players
+  // created, every one falling back to the licence-less local session,
+  // with zero FairPlayCDMProxy activity and zero content key requests -
+  // so the licence exchange was never reached, and nothing said why.
+  //
+  // This is the decision point. IsFairPlayKeySystem matches the bare
+  // "com.apple.fps" exactly, while players in the wild commonly ask for
+  // the versioned legacy names ("com.apple.fps.1_0" and friends) that
+  // Safari accepts. If that is what arrives here, EME refuses before any
+  // of the FairPlay stack runs. Logging the string settles it.
+  printf_stderr("emeKeySystem: Supports(%s) -> fairplay=%d\n",
+                NS_ConvertUTF16toUTF8(aKeySystem).get(),
+                IsFairPlayKeySystem(aKeySystem) ? 1 : 0);
+  // FairPlay is part of the OS rather than a downloadable CDM, so there
+  // is nothing to check for having been installed - unlike Widevine and
+  // Clearkey, which are fetched by the GMP downloader.
+  if (IsFairPlayKeySystem(aKeySystem)) {
+    return true;
+  }
+#endif
