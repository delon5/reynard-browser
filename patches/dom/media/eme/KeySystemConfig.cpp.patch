+#ifdef MOZ_WIDGET_UIKIT
+/* static */ void KeySystemConfig::CreateFairPlayKeySystemConfigs(
+    const KeySystemConfigRequest& aRequest,
+    nsTArray<KeySystemConfig>& aOutConfigs) {
+  KeySystemConfig* config = aOutConfigs.AppendElement();
+  config->mKeySystem = aRequest.mKeySystem;
+
+  // skd is the HLS playlist form, and the only one this pipeline can
+  // actually serve: FairPlay decrypts inside AVFoundation, and only for
+  // an AVURLAsset it owns end to end.
+  config->mInitDataTypes.AppendElement(u"skd"_ns);
+
+  // cenc and sinf are the fragmented-MP4 forms, and they mean
+  // MSE+FairPlay - sample-level decryption, which AVFoundation does not
+  // permit outside WebKit. Advertising them is an invitation to a path
+  // this engine has closed: a device capture showed a player granted
+  // `i:cenc v:video/mp4`, then going to look for MediaSource, finding
+  // it hidden by media.reynard.mediasource.hide-for-iphone-ua, and
+  // never calling createMediaKeys at all.
+  //
+  // Refusing the configuration instead lets a well-written player fall
+  // through to its next choice, which is the HLS one. Behind a pref
+  // because it changes what sites are told rather than what the engine
+  // does, and that is worth being able to undo on the device.
+  //
+  // media.reynard.fairplay.mse-parser-route opens the same door
+  // deliberately, for the AVStreamDataParser path. It is its own pref
+  // rather than a reuse of the one above because the two decisions
+  // differ: hls-only-initdata is about what every page is told, and
+  // this is about whether one specific route is armed.
+  if (!StaticPrefs::media_reynard_fairplay_hls_only_initdata() ||
+      StaticPrefs::media_reynard_fairplay_mse_parser_route()) {
+    config->mInitDataTypes.AppendElement(u"cenc"_ns);
+    config->mInitDataTypes.AppendElement(u"sinf"_ns);
+  }
+
+  // Persistent state is required for offline keys, which are the main
+  // reason to use AVContentKeySession over the older resource loader
+  // path. Distinctive identifier is NotAllowed: FairPlay identifies the
+  // device to the key server itself, so the page never needs one.
+  config->mPersistentState = Requirement::Optional;
+  config->mDistinctiveIdentifier = Requirement::NotAllowed;
+  config->mSessionTypes.AppendElement(SessionType::Temporary);
+
+  // HW_SECURE_ALL is honest here in a way it is not for software CDMs:
+  // FairPlay decrypts inside the secure enclave and clear frames never
+  // reach the app.
+  config->mAudioRobustness.AppendElement(u""_ns);
+  config->mVideoRobustness.AppendElement(u""_ns);
+  // And the Widevine-style names, which commercial players ask for on
+  // FairPlay too. EME rejects a configuration whose requested
+  // robustness is not in the advertised list, so a page asking for
+  // HW_SECURE_ALL was refused before any of this ran - with the same
+  // "recognised as FairPlay but never loads" symptom the capability
+  // bug above produced. Advertising them is honest here in a way it is
+  // not for a software CDM: FairPlay decrypts inside the secure
+  // enclave, and clear frames never reach the app.
+  config->mAudioRobustness.AppendElement(u"HW_SECURE_CRYPTO"_ns);
+  config->mAudioRobustness.AppendElement(u"HW_SECURE_ALL"_ns);
+  config->mVideoRobustness.AppendElement(u"HW_SECURE_CRYPTO"_ns);
+  config->mVideoRobustness.AppendElement(u"HW_SECURE_DECODE"_ns);
+  config->mVideoRobustness.AppendElement(u"HW_SECURE_ALL"_ns);
+
+  // Decrypt AND decode, which is what actually happens: AVFoundation
+  // owns the whole path, from the content key through VideoToolbox to
+  // the frames the compositor gets.
+  //
+  // Declaring decrypt-only was what rejected every FairPlay request.
+  // CanDecryptAndDecode tries DecryptsAndDecodes first, and on failing
+  // that falls to Decrypts - which then insists MediaSource
+  // ::IsTypeSupported can handle the type, i.e. that GECKO can decode
+  // it. Gecko has no H264 decoder on iOS; that absence is the reason
+  // this pipeline exists. So the capability was dropped, the
+  // configuration came back with no video capabilities, and
+  // requestMediaKeySystemAccess rejected - after Supports() had already
+  // said yes, which is exactly the "recognised as FairPlay but never
+  // loads" the device showed.
+  //
+  // The comment this replaces said it advertised "what the platform can
+  // decrypt, not what Gecko can currently draw", and was written before
+  // the AVPlayer path existed. It does now.
+  config->mMP4.SetCanDecryptAndDecode(EME_CODEC_H264);
+  config->mMP4.SetCanDecryptAndDecode(EME_CODEC_AAC);
+}
