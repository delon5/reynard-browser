@@ -556,6 +570,43 @@ void MediaKeySystemAccessManager::RequestMediaKeySystemAccess(
 void MediaKeySystemAccessManager::ProvideAccess(
     UniquePtr<PendingRequest> aRequest) {
   MOZ_ASSERT(aRequest);
+#ifdef MOZ_WIDGET_UIKIT
+  // DIAGNOSTIC. emeConfig only prints when GetSupportedConfig REJECTS,
+  // and it never printed - so the configuration was accepted and the
+  // failure is downstream of EME entirely. This is the resolve, the
+  // point where requestMediaKeySystemAccess hands the page an access
+  // object. If this prints and FairPlayCDMProxy still logs nothing,
+  // the page was granted access and chose not to call createMediaKeys,
+  // which is a player/UA question rather than an engine one.
+  // ...and WHAT it was granted. Access resolving while FairPlayCDMProxy
+  // stays silent means the page inspected this configuration and chose
+  // not to call createMediaKeys - so the configuration is the evidence.
+  // An empty videoCapabilities is the shape that would explain it: the
+  // request succeeds, but the player finds nothing it can play.
+  const MediaKeySystemConfiguration& cfg = aRequest->mSupportedConfig.ref();
+  nsAutoCString desc;
+  desc.AppendPrintf("initData=%zu video=%zu audio=%zu sessions=%zu",
+                    cfg.mInitDataTypes.Length(),
+                    cfg.mVideoCapabilities.Length(),
+                    cfg.mAudioCapabilities.Length(),
+                    cfg.mSessionTypes.WasPassed()
+                        ? cfg.mSessionTypes.Value().Length()
+                        : (size_t)0);
+  for (const nsString& t : cfg.mInitDataTypes) {
+    desc.Append(" i:");
+    desc.Append(NS_ConvertUTF16toUTF8(t));
+  }
+  for (const MediaKeySystemMediaCapability& c : cfg.mVideoCapabilities) {
+    desc.Append(" v:");
+    desc.Append(NS_ConvertUTF16toUTF8(c.mContentType));
+  }
+  for (const MediaKeySystemMediaCapability& c : cfg.mAudioCapabilities) {
+    desc.Append(" a:");
+    desc.Append(NS_ConvertUTF16toUTF8(c.mContentType));
+  }
+  printf_stderr("emeAccess: GRANTED %s %s\n",
+                NS_ConvertUTF16toUTF8(aRequest->mKeySystem).get(), desc.get());
+#endif
   MOZ_ASSERT(
       aRequest->mSupportedConfig,
       "The request needs a supported config if we're going to provide access!");
