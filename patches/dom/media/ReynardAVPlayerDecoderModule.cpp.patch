+// Turns each synthetic sample into a timing-only VideoData.
+//
+// The image is null ON PURPOSE. VideoSink skips frames with no image
+// when it pushes pictures to the VideoFrameContainer, but it still
+// consumes them off the video queue and advances the media clock over
+// them - the same trick the tree's NullDecoderModule pulls. Attaching
+// a real image here would be actively wrong: the sink would composite
+// it over the AVPlayer frames the notify path publishes.
+//
+// Everything resolves synchronously on the caller's thread. There is
+// nothing to wait for - no hardware, no reordering, no state - so the
+// module needs no task queue of its own.
+class ReynardAVPlayerVideoDecoder final : public MediaDataDecoder {
+ public:
+  // MediaDataDecoder declares NS_INLINE_DECL_PURE_VIRTUAL_REFCOUNTING, so
+  // every concrete decoder supplies its own AddRef/Release - the same way
+  // DummyMediaDataDecoder does.
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(ReynardAVPlayerVideoDecoder, final);
+
+  explicit ReynardAVPlayerVideoDecoder(const VideoInfo& aInfo)
+      : mDisplay(aInfo.mDisplay) {}
+
+  RefPtr<InitPromise> Init() override {
+    printf_stderr("avPlayer: timing decoder Init %dx%d\n", mDisplay.width,
+                  mDisplay.height);
+    return InitPromise::CreateAndResolve(TrackInfo::kVideoTrack, __func__);
+  }
+
+  RefPtr<DecodePromise> Decode(MediaRawData* aSample) override {
+    RefPtr<VideoData> frame =
+        new VideoData(aSample->mOffset, aSample->mTime, aSample->mDuration,
+                      aSample->mKeyframe, aSample->mTimecode, mDisplay, 0);
+    DecodedData results;
+    results.AppendElement(std::move(frame));
+    return DecodePromise::CreateAndResolve(std::move(results), __func__);
+  }
+
+  RefPtr<DecodePromise> Drain() override {
+    // Stateless: every sample was returned as it arrived, so there is
+    // never anything left to drain.
+    return DecodePromise::CreateAndResolve(DecodedData(), __func__);
+  }
+
+  RefPtr<FlushPromise> Flush() override {
+    return FlushPromise::CreateAndResolve(true, __func__);
+  }
+
+  RefPtr<ShutdownPromise> Shutdown() override {
+    return ShutdownPromise::CreateAndResolve(true, __func__);
+  }
+
+  nsCString GetDescriptionName() const override {
+    return "reynard avplayer timing decoder"_ns;
+  }
+
+  nsCString GetCodecName() const override {
+    return "reynard-avplayer-clock"_ns;
+  }
+
+ private:
+  ~ReynardAVPlayerVideoDecoder() = default;
+
+  const gfx::IntSize mDisplay;
+};
+
+// A black, DRM-marked placeholder frame for protected MSE video.
+//
+// The route needs the element to HAVE a current frame - an image-less one
+// leaves readyState at HAVE_METADATA, which was measured - and it needs
+// that frame to carry the DRM mark so NativeLayerCA builds a video layer
+// where the element is rather than compositing the surface.
+//
+// Both require a MacIOSurfaceImage specifically. MacIOSurfaceImage::
+// GetTextureClient is the only place TextureFlags::DRM_SOURCE is set:
+//
+//     TextureFlags flags =
+//         IsDRM() ? TextureFlags::DRM_SOURCE : TextureFlags::DEFAULT;
+//
+// so marking a PlanarYCbCrImage - which is what BlankDecoderModule makes -
+// sets a bit nothing ever reads. That is why an earlier attempt to mark
+// the blank decoder's frames changed nothing on screen.
+//
+// The surface is built and filled exactly as
+// AVPlayerDecoder::PublishPlaceholderFrame does, including the fill
+// values: a fresh IOSurface is zeroed, and zeroed NV12 in BT.709 limited
+// range decodes to saturated GREEN, not black. Y=0x10 with CbCr=0x80 is
+// black.
+class ReynardProtectedPlaceholderDecoder final : public MediaDataDecoder {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(ReynardProtectedPlaceholderDecoder,
+                                        final);
+
+  explicit ReynardProtectedPlaceholderDecoder(const VideoInfo& aInfo)
+      : mDisplay(aInfo.mDisplay) {}
+
+  RefPtr<InitPromise> Init() override {
+    printf_stderr("mseDecoderRoute: protected placeholder decoder %dx%d\n",
+                  mDisplay.width, mDisplay.height);
+    return InitPromise::CreateAndResolve(TrackInfo::kVideoTrack, __func__);
+  }
+
+  RefPtr<DecodePromise> Decode(MediaRawData* aSample) override {
+    // The image is already marked by the time it gets here, and that
+    // matters: GetTextureClient caches its TextureClient behind
+    // "if (!mTextureClient)", so a mark applied later would be ignored.
+    RefPtr<layers::Image> image = ProtectedImage();
+    if (!image) {
+      return DecodePromise::CreateAndReject(
+          MediaResult(NS_ERROR_OUT_OF_MEMORY, __func__), __func__);
+    }
+    RefPtr<VideoData> frame = VideoData::CreateFromImage(
+        mDisplay, aSample->mOffset, aSample->mTime, aSample->mDuration, image,
+        aSample->mKeyframe, aSample->mTimecode);
+    if (!frame) {
+      return DecodePromise::CreateAndReject(
+          MediaResult(NS_ERROR_OUT_OF_MEMORY, __func__), __func__);
+    }
+    DecodedData results;
+    results.AppendElement(std::move(frame));
+    return DecodePromise::CreateAndResolve(std::move(results), __func__);
+  }
+
+  RefPtr<DecodePromise> Drain() override {
+    // Stateless: every sample was answered as it arrived.
+    return DecodePromise::CreateAndResolve(DecodedData(), __func__);
+  }
+
+  RefPtr<FlushPromise> Flush() override {
+    return FlushPromise::CreateAndResolve(true, __func__);
+  }
+
+  RefPtr<ShutdownPromise> Shutdown() override {
+    return ShutdownPromise::CreateAndResolve(true, __func__);
+  }
+
+  nsCString GetDescriptionName() const override {
+    return "reynard protected placeholder"_ns;
+  }
+
+  nsCString GetCodecName() const override {
+    return "reynard-protected-placeholder"_ns;
+  }
+
+ private:
+  ~ReynardProtectedPlaceholderDecoder() = default;
+
+  // One surface for the life of the decoder. A fresh IOSurface per frame
+  // at 24fps is real cost for a picture that never changes, and nothing
+  // writes to it after the first fill.
+  RefPtr<layers::Image> ProtectedImage() {
+    if (mImage) {
+      return mImage;
+    }
+    const gfx::IntSize chromaSize((mDisplay.width + 1) / 2,
+                                  (mDisplay.height + 1) / 2);
+    RefPtr<MacIOSurface> surface = MacIOSurface::CreateBiPlanarSurface(
+        mDisplay, chromaSize, gfx::ChromaSubsampling::HALF_WIDTH_AND_HEIGHT,
+        gfx::YUVColorSpace::BT709, gfx::TransferFunction::BT709,
+        gfx::ColorRange::LIMITED, gfx::ColorDepth::COLOR_8,
+        MacIOSurface::AllowAlpha::No);
+    if (!surface) {
+      printf_stderr(
+          "mseDecoderRoute: CreateBiPlanarSurface failed for %dx%d\n",
+          mDisplay.width, mDisplay.height);
+      return nullptr;
+    }
+    if (surface->Lock(/* aReadOnly */ false)) {
+      if (void* yPlane = surface->GetBaseAddressOfPlane(0)) {
+        memset(yPlane, 0x10,
+               surface->GetBytesPerRow(0) * surface->GetDevicePixelHeight(0));
+      }
+      if (void* cbcrPlane = surface->GetBaseAddressOfPlane(1)) {
+        memset(cbcrPlane, 0x80,
+               surface->GetBytesPerRow(1) * surface->GetDevicePixelHeight(1));
+      }
+      surface->Unlock(/* aReadOnly */ false);
+    } else {
+      // Not fatal, but an unfilled surface is zeroed, and zeroed NV12
+      // reads as saturated green - so a green rectangle on screen means
+      // exactly this line fired.
+      printf_stderr("mseDecoderRoute: placeholder Lock() failed\n");
+    }
+    RefPtr<layers::Image> image = new layers::MacIOSurfaceImage(surface);
+    image->SetIsDRM(true);
+    printf_stderr(
+        "mseDecoderRoute: protected placeholder image built %dx%d - expect "
+        "NativeLayerCA: mIsDRM -> 1\n",
+        mDisplay.width, mDisplay.height);
+    mImage = image;
+    return mImage;
+  }
+
+  const gfx::IntSize mDisplay;
+  RefPtr<layers::Image> mImage;
+};
+
+}  // namespace
+
+/* static */
+already_AddRefed<PlatformDecoderModule> ReynardAVPlayerDecoderModule::Create() {
+  return MakeAndAddRef<ReynardAVPlayerDecoderModule>();
+}
+
+media::DecodeSupportSet ReynardAVPlayerDecoderModule::SupportsMimeType(
+    const nsACString& aMimeType, DecoderDoctorDiagnostics* aDiagnostics) const {
+  if (!StaticPrefs::media_reynard_avplayer_enabled() ||
+      !aMimeType.EqualsLiteral(REYNARD_AVPLAYER_SYNTHETIC_MIME)) {
+    return media::DecodeSupportSet{};
+  }
+  // "Software" in the sense that no decode happens at all. The claim
+  // is what matters: it is what lets MediaFormatReader accept the
+  // synthetic track's metadata.
+  return media::DecodeSupportSet{media::DecodeSupport::SoftwareDecode};
+}
+
+already_AddRefed<MediaDataDecoder> ReynardAVPlayerDecoderModule::CreateVideoDecoder(
+    const CreateDecoderParams& aParams) {
+  printf_stderr("avPlayer: timing decoder created for %s\n",
+                aParams.VideoConfig().mMimeType.get());
+  return MakeAndAddRef<ReynardAVPlayerVideoDecoder>(aParams.VideoConfig());
+}
+
+already_AddRefed<MediaDataDecoder> ReynardAVPlayerDecoderModule::CreateAudioDecoder(
+    const CreateDecoderParams& aParams) {
+  // The synthetic track is video-only by construction; AVPlayer owns
+  // the audio end to end.
+  return nullptr;
+}
+
+/* static */
+already_AddRefed<MediaDataDecoder>
+ReynardAVPlayerDecoderModule::CreateProtectedPlaceholderDecoder(
+    const CreateDecoderParams& aParams) {
+  return MakeAndAddRef<ReynardProtectedPlaceholderDecoder>(
+      aParams.VideoConfig());
+}
+
+}  // namespace mozilla
