diff --git a/dom/media/MediaFormatReader.cpp b/dom/media/MediaFormatReader.cpp
--- a/dom/media/MediaFormatReader.cpp
+++ b/dom/media/MediaFormatReader.cpp
@@ -362,9 +362,26 @@ void MediaFormatReader::DecoderFactory::DoCreateDecoder(Data& aData) {
   auto& decoder = mOwner->GetDecoderData(aData.mTrack);
 
   RefPtr<PDMFactory> platform = new PDMFactory();
   if (decoder.IsEncrypted()) {
     MOZ_DIAGNOSTIC_ASSERT(mOwner->mCDMProxy);
     platform->SetCDMProxy(mOwner->mCDMProxy);
   }
+  // Reynard: does an MSE protected track reach decoder creation, and is
+  // the CDM proxy attached when it does?
+  //
+  // HBO Max appends about eight seconds of encrypted avc1, the element
+  // reaches HAVE_METADATA at 768x322, and then stops - readyState never
+  // advances and currentTime never moves, so the page's append loop has
+  // no progress to act on. The side-channel display layer renders those
+  // samples fine; the pipeline the page is actually watching is this one.
+  //
+  // Three fields only, all of them from this function's own scope. A
+  // mime type would be worth more and needs DecoderData members this was
+  // not able to verify, and guessing at those has already cost two
+  // rounds on this route.
+  printf_stderr(
+      "mseDecoderRoute: DoCreateDecoder track=%d encrypted=%d cdmProxy=%d\n",
+      static_cast<int>(aData.mTrack), decoder.IsEncrypted() ? 1 : 0,
+      mOwner->mCDMProxy ? 1 : 0);
 
   RefPtr<PlatformDecoderModule::CreateDecoderPromise> p;
@@ -1313,7 +1313,30 @@
   if (videoDuration.IsPositive() || audioDuration.IsPositive()) {
     auto duration = std::max(videoDuration, audioDuration);
     LOG("Determine mMetadataDuration=%" PRId64, duration.ToMicroseconds());
     mInfo.mMetadataDuration = Some(duration);
   }
+  // REYNARD DIAGNOSTIC - which VideoInfo does the reader actually use?
+  //
+  // MediaDecoderStateMachine takes its duration from
+  // MediaInfo::mMetadataDuration, computed right above from THIS mInfo -
+  // not from the VideoInfo the AVPlayer demuxer publishes and not from
+  // the copy AVPlayerTrackDemuxer holds. A capture showed those two
+  // reading invalid and infinite while MDSM completed against 38.855,
+  // so a third copy carries the stale value and this names it.
+  printf_stderr(
+      "avPlayer: reader metadata hasVideo=%d videoDur=%.3f hasAudio=%d "
+      "audioDur=%.3f -> mMetadataDuration=%.3f\n",
+      HasVideo() ? 1 : 0,
+      (HasVideo() && mInfo.mVideo.mDuration.IsValid())
+          ? mInfo.mVideo.mDuration.ToSeconds()
+          : -1.0,
+      HasAudio() ? 1 : 0,
+      (HasAudio() && mInfo.mAudio.mDuration.IsValid())
+          ? mInfo.mAudio.mDuration.ToSeconds()
+          : -1.0,
+      (mInfo.mMetadataDuration.isSome() &&
+       mInfo.mMetadataDuration->IsValid())
+          ? mInfo.mMetadataDuration->ToSeconds()
+          : -1.0);
 
   mInfo.mMediaSeekable = mDemuxer->IsSeekable();
