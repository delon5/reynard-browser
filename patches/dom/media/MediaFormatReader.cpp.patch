diff --git a/dom/media/MediaFormatReader.cpp b/dom/media/MediaFormatReader.cpp
--- a/dom/media/MediaFormatReader.cpp
+++ b/dom/media/MediaFormatReader.cpp
@@ -362,9 +362,26 @@ void MediaFormatReader::DecoderFactory::DoCreateDecoder(Data& aData) {
   auto& decoder = mOwner->GetDecoderData(aData.mTrack);
 
   RefPtr<PDMFactory> platform = new PDMFactory();
   if (decoder.IsEncrypted()) {
     MOZ_DIAGNOSTIC_ASSERT(mOwner->mCDMProxy);
     platform->SetCDMProxy(mOwner->mCDMProxy);
   }
+  // Reynard: does an MSE protected track reach decoder creation, and is
+  // the CDM proxy attached when it does?
+  //
+  // HBO Max appends about eight seconds of encrypted avc1, the element
+  // reaches HAVE_METADATA at 768x322, and then stops - readyState never
+  // advances and currentTime never moves, so the page's append loop has
+  // no progress to act on. The side-channel display layer renders those
+  // samples fine; the pipeline the page is actually watching is this one.
+  //
+  // Three fields only, all of them from this function's own scope. A
+  // mime type would be worth more and needs DecoderData members this was
+  // not able to verify, and guessing at those has already cost two
+  // rounds on this route.
+  printf_stderr(
+      "mseDecoderRoute: DoCreateDecoder track=%d encrypted=%d cdmProxy=%d\n",
+      static_cast<int>(aData.mTrack), decoder.IsEncrypted() ? 1 : 0,
+      mOwner->mCDMProxy ? 1 : 0);
 
   RefPtr<PlatformDecoderModule::CreateDecoderPromise> p;
@@ -1129,6 +1129,21 @@
 RefPtr<SetCDMPromise> MediaFormatReader::SetCDMProxy(CDMProxy* aProxy) {
   MOZ_ASSERT(OnTaskQueue());
   LOGV("SetCDMProxy (%p)", aProxy);
+  // Reynard: WHICH reader is being given a CDM proxy - see
+  // mse_fix_206's docstring. A second playback in one content process
+  // is a second MediaFormatReader, and in capture f15f9d06 the second
+  // one never created a decoder for its encrypted video track. The
+  // gate that would stop it is Update's IsWaitingOnCDMResource, which
+  // is IsEncrypted() && !mCDMProxy - so the question is whether this
+  // function is ever called for that reader at all.
+  //
+  // The reader pointer is the correlation key. Two readers and one
+  // line between them is the answer on its own.
+  printf_stderr(
+      "mseDecoderRoute: SetCDMProxy reader=%p proxy=%p initDone=%d "
+      "audio=%d video=%d encrypted=%d\n",
+      this, aProxy, mInitDone ? 1 : 0, HasAudio() ? 1 : 0,
+      HasVideo() ? 1 : 0, IsEncrypted() ? 1 : 0);
 
   if (mShutdown) {
     return SetCDMPromise::CreateAndReject(
@@ -1313,7 +1313,30 @@
   if (videoDuration.IsPositive() || audioDuration.IsPositive()) {
     auto duration = std::max(videoDuration, audioDuration);
     LOG("Determine mMetadataDuration=%" PRId64, duration.ToMicroseconds());
     mInfo.mMetadataDuration = Some(duration);
   }
+  // REYNARD DIAGNOSTIC - which VideoInfo does the reader actually use?
+  //
+  // MediaDecoderStateMachine takes its duration from
+  // MediaInfo::mMetadataDuration, computed right above from THIS mInfo -
+  // not from the VideoInfo the AVPlayer demuxer publishes and not from
+  // the copy AVPlayerTrackDemuxer holds. A capture showed those two
+  // reading invalid and infinite while MDSM completed against 38.855,
+  // so a third copy carries the stale value and this names it.
+  printf_stderr(
+      "avPlayer: reader metadata hasVideo=%d videoDur=%.3f hasAudio=%d "
+      "audioDur=%.3f -> mMetadataDuration=%.3f\n",
+      HasVideo() ? 1 : 0,
+      (HasVideo() && mInfo.mVideo.mDuration.IsValid())
+          ? mInfo.mVideo.mDuration.ToSeconds()
+          : -1.0,
+      HasAudio() ? 1 : 0,
+      (HasAudio() && mInfo.mAudio.mDuration.IsValid())
+          ? mInfo.mAudio.mDuration.ToSeconds()
+          : -1.0,
+      (mInfo.mMetadataDuration.isSome() &&
+       mInfo.mMetadataDuration->IsValid())
+          ? mInfo.mMetadataDuration->ToSeconds()
+          : -1.0);
 
   mInfo.mMediaSeekable = mDemuxer->IsSeekable();
@@ -2705,5 +2705,35 @@
   if (IsWaitingOnCDMResource() || !ResolveSetCDMPromiseIfDone(aTrack)) {
+    // Reynard: the gate that stops decoder creation - see mse_fix_206's
+    // docstring. The comment below has always said what happens here;
+    // what it has never said is WHICH reader parked, on which track,
+    // and on which half of the condition. In capture f15f9d06 the
+    // second Netflix playback in a content process produced no
+    // DoCreateDecoder at all, and CreateDecoder is three hundred lines
+    // past this return.
+    //
+    // Bounded for the whole process, because Update runs on every tick
+    // and a diagnostic that floods a capture is worse than none.
+    static uint32_t sReynardCDMParkLines = 0;
+    if (sReynardCDMParkLines < 24) {
+      sReynardCDMParkLines++;
+      // PURE READS ONLY. ResolveSetCDMPromiseIfDone is NOT called here,
+      // however tempting: it removes the track from mSetCDMForTracks
+      // and resolves mSetCDMPromise, so calling it a second time - or
+      // at all, on the branch where the || short-circuits before it -
+      // would make this diagnostic change what it is measuring.
+      // mSetCDMPromise.IsEmpty and mSetCDMForTracks.contains say the
+      // same thing and say it without touching anything.
+      printf_stderr(
+          "mseDecoderRoute: reader=%p track=%s parked at the CDM gate - "
+          "waitingOnResource=%d encrypted=%d proxy=%p setCDMPending=%d "
+          "thisTrackWaiting=%d (%u of 24)\n",
+          this, TrackTypeToStr(aTrack), IsWaitingOnCDMResource() ? 1 : 0,
+          IsEncrypted() ? 1 : 0, mCDMProxy.get(),
+          mSetCDMPromise.IsEmpty() ? 0 : 1,
+          mSetCDMForTracks.contains(aTrack) ? 1 : 0,
+          sReynardCDMParkLines);
+    }
     // If the content is encrypted, MFR won't start to create decoder until
     // CDMProxy is set.
     return;
   }
