+#ifndef AVPlayerDemuxer_h_
+#define AVPlayerDemuxer_h_
+
+#include "MediaDataDemuxer.h"
+#include "MediaInfo.h"
+#include "mozilla/Maybe.h"
+
+// The synthetic track's MIME type. Only ReynardAVPlayerDecoderModule
+// claims it, so no real platform decoder is ever offered the
+// extradata-free track this demuxer advertises.
+//
+// FALLBACK B, if the support probe in AVPlayerDecoder::CreateStateMachine
+// logs 0 for this type: some support queries resolve through a fixed
+// codec enum that an invented MIME type can never enter. In that case
+// keep "video/avc" here (the stock Apple module claims H.264, so the
+// metadata gate passes), stamp mExtraData with the magic bytes
+// "RYNAVCLK" in the constructor below, and gate
+// ReynardAVPlayerDecoderModule on that magic instead of on the MIME
+// type - it is registered ahead of the Apple module, and real H.264
+// carries genuine avcC bytes, so nothing else is ever claimed.
+#define REYNARD_AVPLAYER_SYNTHETIC_MIME "video/x-reynard-avplayer"
+
+namespace mozilla {
+
+class AVPlayerTrackDemuxer;
+
+// Playback state pushed from the Swift AVPlayer host and read by the
+// demuxer. The Swift side reports through the exported C symbols
+// ReynardAVPlayerNotifyTime / ReynardAVPlayerNotifyEnded /
+// ReynardAVPlayerNotifyMetadata (see AVPlayerDecoder.mm); the demux
+// task queue reads snapshots while pacing synthetic samples. All
+// methods take one static mutex, so every combination of caller
+// threads is safe.
+class AVPlayerPlaybackRegistry {
+ public:
+  struct Snapshot {
+    media::TimeUnit mPosition = media::TimeUnit::Invalid();
+    media::TimeUnit mDuration = media::TimeUnit::Invalid();
+    gfx::IntSize mDisplay;
+    bool mEnded = false;
+  };
+
+  // Main thread. Registered from Load() right after the Swift host
+  // hands back a player id, unregistered from Shutdown() and the
+  // destructor after the host player is destroyed. Writes to an
+  // unregistered id are dropped, which is what makes the teardown
+  // races benign.
+  static void Register(uintptr_t aPlayerId);
+  static void Unregister(uintptr_t aPlayerId);
+
+  // Any thread; the hot path. Returns true when the caller should wake
+  // the reader: a parked GetSamples armed a resume position this
+  // update crossed, or a second passed since the last wake (which
+  // keeps buffered ranges fresh). The armed position is cleared under
+  // the lock, so one crossing queues exactly one wake.
+  static bool UpdatePosition(uintptr_t aPlayerId, double aSeconds);
+
+  // Any thread. Latches the ended flag. Returns true when the caller
+  // should wake the reader (always, for a known id - a parked request
+  // must wake to hear the end of stream).
+  static bool NotifyEnded(uintptr_t aPlayerId);
+
+  // Any thread. Duration and display size from the metadata callback.
+  // Non-finite durations and degenerate sizes are ignored.
+  static void SetMetadata(uintptr_t aPlayerId, double aDurationSeconds,
+                          const gfx::IntSize& aDisplay);
+
+  // Demux task queue. Arms the position at which a parked GetSamples
+  // wants waking.
+  static void ArmResumeAt(uintptr_t aPlayerId, const media::TimeUnit& aNeeded);
+
+  // Demux task queue. Snaps the position to the seek target and clears
+  // the ended flag, so the first post-seek GetSamples neither waits a
+  // full AVPlayer round-trip nor replays a stale end of stream.
+  static void OnSeek(uintptr_t aPlayerId, const media::TimeUnit& aTarget);
+
+  // Any thread. Nothing() for an unknown id.
+  static Maybe<Snapshot> Get(uintptr_t aPlayerId);
+};
+
+// Forwards a seek to the Swift host's AVPlayer. Defined in
+// AVPlayerDecoder.mm - reaching the host takes Objective-C, and this
+// header is included from plain C++. Main thread only.
+void ReynardAVPlayerRequestHostSeek(uintptr_t aPlayerId, double aSeconds);
+
+// A demuxer that demuxes a clock.
+//
+// MediaDecoderStateMachineBase's constructor wraps its reader
+// unconditionally - mReader(new ReaderProxy(mTaskQueue, aReader)) - and
+// Init() then calls mReader->Init(), CanonicalBuffered(),
+// OnMediaNotSeekable() and SetCanonicalDuration(). A null reader crashes
+// on construction, so a state machine with no reader cannot exist. This
+// gives Gecko something structurally valid to hold while AVFoundation
+// owns the media.
+//
+// It reports exactly one video track and synthesises timing-only
+// samples for it, paced by the position the Swift host pushes into
+// AVPlayerPlaybackRegistry. The samples carry no pixels -
+// ReynardAVPlayerDecoderModule turns them into image-less VideoData -
+// so the state machine's clock advances in step with the AVPlayer
+// while the visible frames keep arriving through
+// ReynardAVPlayerNotifyFrame. This is what lets currentTime progress,
+// timeupdate fire, and "ended" land at the stream's real end instead
+// of at t=0 the way the end-of-stream stub did.
+class AVPlayerDemuxer final : public MediaDataDemuxer {
+ public:
+  AVPlayerDemuxer(uintptr_t aPlayerId, const gfx::IntSize& aFallbackDisplay);
+
+  RefPtr<InitPromise> Init() override;
+
+  uint32_t GetNumberTracks(TrackInfo::TrackType aType) const override;
+
+  already_AddRefed<MediaTrackDemuxer> GetTrackDemuxer(
+      TrackInfo::TrackType aType, uint32_t aTrackNumber) override;
+
+  bool IsSeekable() const override;
+
+  // False, the MSE branch: both tracks get a start time of zero
+  // without waiting for a first sample. The synthetic clock starts at
+  // Zero() and every seek resets it, so zero IS the start time - and
+  // the stub era proved the hard way that the "true" path stalls
+  // metadata forever when the first sample is slow to arrive
+  // (MaybeResolveMetadataPromise returns early until a first demuxed
+  // sample time exists). With samples now paced by an external player
+  // that may buffer indefinitely before reporting a first position,
+  // that hazard is still real, so false it stays.
+  //
+  // Defined out of line so it can log: DemuxerProxy::Init snapshots
+  // this value last, right before it flips mInitDone, so the line
+  // printing is proof the proxy's init lambda ran to completion.
+  bool ShouldComputeStartTime() const override;
+
+ private:
+  ~AVPlayerDemuxer() = default;
+
+  const uintptr_t mPlayerId;
+  VideoInfo mVideoInfo;
+};
+
+class AVPlayerTrackDemuxer final : public MediaTrackDemuxer {
+ public:
+  AVPlayerTrackDemuxer(uintptr_t aPlayerId, const VideoInfo& aInfo);
+
+  UniquePtr<TrackInfo> GetInfo() const override;
+
+  RefPtr<SeekPromise> Seek(const media::TimeUnit& aTime) override;
+
+  RefPtr<SamplesPromise> GetSamples(int32_t aNumSamples) override;
+
+  RefPtr<SkipAccessPointPromise> SkipToNextRandomAccessPoint(
+      const media::TimeUnit& aTimeThreshold) override;
+
+  void Reset() override;
+
+  media::TimeIntervals GetBuffered() override;
+
+ private:
+  ~AVPlayerTrackDemuxer() = default;
+
+  const uintptr_t mPlayerId;
+  const VideoInfo mInfo;
+
+  // The synthetic clock: presentation time of the next sample
+  // GetSamples will emit. Touched on the demux task queue only.
+  media::TimeUnit mNextTime = media::TimeUnit::Zero();
+  // Monotonic sample counter, stamped into MediaRawData::mOffset so
+  // samples stay distinguishable in logs and frame statistics.
+  uint64_t mFrameIndex = 0;
+  // Log latches: park/resume transitions, end of stream and the first
+  // emission are logged once per state change, never per request -
+  // GetSamples runs tens of times a second.
+  bool mWasParked = false;
+  bool mLoggedEos = false;
+  bool mLoggedFirstEmit = false;
+};
+
+}  // namespace mozilla
+
+#endif  // AVPlayerDemuxer_h_
