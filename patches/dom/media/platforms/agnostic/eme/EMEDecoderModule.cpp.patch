+// Silence for a protected MSE audio track.
+//
+// The audio branch below cannot let these samples reach EMEDecryptor -
+// a FairPlay proxy never returns a decrypted sample, so the wait never
+// ends and readyState stays at HAVE_METADATA. It used
+// BlankDecoderModule instead, which unblocked the element and turned
+// out to emit a SINE TONE rather than silence. Audible, and wrong.
+//
+// This returns the same shape of data with the samples zeroed. Frame
+// count comes from the sample's own duration so the timeline is the one
+// the demuxer described, and the clock behaves exactly as it does with
+// the tone.
+//
+// Nothing here renders. Real MSE audio belongs in an
+// AVSampleBufferAudioRenderer beside the display layer that already
+// paints the video; until that exists this makes the element correct
+// and quiet.
+class ReynardSilentAudioDecoder final : public MediaDataDecoder {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(ReynardSilentAudioDecoder, final);
+
+  explicit ReynardSilentAudioDecoder(const AudioInfo& aInfo)
+      : mChannels(aInfo.mChannels), mRate(aInfo.mRate) {}
+
+  RefPtr<InitPromise> Init() override {
+    printf_stderr("mseDecoderRoute: silent audio decoder %u ch @ %u Hz\n",
+                  mChannels, mRate);
+    return InitPromise::CreateAndResolve(TrackInfo::kAudioTrack, __func__);
+  }
+
+  RefPtr<DecodePromise> Decode(MediaRawData* aSample) override {
+    // Shaped after BlankAudioDataCreator::Create, which is the code this
+    // replaces: same frame arithmetic, same guards, same AudioData
+    // construction. Only the fill differs - it writes a 440 Hz sine,
+    // this writes zeroes.
+    //
+    // The +1 microsecond is its rounding guard, kept so the frame counts
+    // match what the element was already being given.
+    if (!mChannels || !mRate) {
+      return DecodePromise::CreateAndReject(
+          MediaResult(NS_ERROR_FAILURE, __func__), __func__);
+    }
+    const int64_t usecs = aSample->mDuration.ToMicroseconds() + 1;
+    const int64_t frames = (usecs * static_cast<int64_t>(mRate)) / 1000000;
+    if (frames < 0 || frames > (UINT32_MAX / mChannels)) {
+      return DecodePromise::CreateAndReject(
+          MediaResult(NS_ERROR_FAILURE, __func__), __func__);
+    }
+    AlignedAudioBuffer samples(frames * mChannels);
+    if (!samples) {
+      return DecodePromise::CreateAndReject(
+          MediaResult(NS_ERROR_OUT_OF_MEMORY, __func__), __func__);
+    }
+    // NOT ZERO, and that is the whole of this change.
+    //
+    // Gecko decides whether an element is audible by looking at the
+    // samples: AudioData::IsAudible walks the buffer and returns true
+    // on the first non-zero value. An all-zero buffer is inaudible by
+    // definition, an inaudible element does not engage media control,
+    // and without media control there is no media session - so no
+    // lock-screen card, no Picture in Picture, and an app that on
+    // backgrounding takes the "no playback" branch, releases the audio
+    // session and sleeps the tab. HBO never once produced a
+    // "mediaSession: ACTIVATED" line in any capture; every site whose
+    // audio Gecko really decodes produces one.
+    //
+    // The element IS making sound - through the
+    // AVSampleBufferAudioRenderer FairPlayStreamParser drives - and
+    // there is no other way to tell Gecko so.
+    //
+    // The smallest non-zero value the sample type can hold: 1 on an
+    // integer build, which is -90 dBFS and below the format's own
+    // dither floor, and the same level as a fraction on a float one.
+    // Silence to a listener, non-zero to IsAudible. The 440 Hz tone fix
+    // 38 removed does not come back - this is a DC offset far below the
+    // quietest representable sound, not an oscillation.
+    //
+    // Which one the build needs is decided without <limits>, which is
+    // not known to be included here and which an unverified include has
+    // already cost this route a build over. AudioDataValue(0.5) is
+    // non-zero only when the type does not truncate.
+    const bool reynardFloatSamples =
+        (AudioDataValue(0.5) != AudioDataValue(0));
+    // LOUDER, because -90 dBFS was under the threshold.
+    //
+    // The corpus settles this. Every capture built with Gecko's blank
+    // audio decoder activated the media session on HBO Max - "ACTIVATED
+    // Don't Worry Darling" - and every build since fixes 37 and 38
+    // replaced it has not, including the one running the 1/32768 floor.
+    // Gecko's blank audio decoder emits an A4 SINE TONE at full scale,
+    // which is why fix 37 removed it; that tone is what media control
+    // was hearing.
+    //
+    // So audibility is the gate and the floor is simply too quiet.
+    // -40 dBFS instead of -90, which clears any plausible silence
+    // threshold with room to spare and is still nowhere near full
+    // scale.
+    //
+    // Inaudible for a better reason than being quiet: this is a
+    // constant DC offset, not an oscillation. It has no alternating
+    // component, so it moves no air at any amplitude - the 440 Hz tone
+    // does not come back at a lower volume, it does not come back at
+    // all.
+    const double reynardFloorLevel = 1.0 / 100.0;
+    const AudioDataValue reynardFloor =
+        reynardFloatSamples
+            ? AudioDataValue(reynardFloorLevel)
+            : AudioDataValue(reynardFloorLevel * 32768.0);
+    // Once per process, because a change with no line of its own cannot
+    // be told apart in a capture from a build that never had it - which
+    // is exactly what happened to the first HBO capture after fix 56,
+    // and to fix 51 before that. The race on this flag is benign: the
+    // worst it can print is the line twice.
+    static bool reynardFloorAnnounced = false;
+    if (!reynardFloorAnnounced) {
+      reynardFloorAnnounced = true;
+      printf_stderr(
+          "mseDecoderRoute: silent audio floor ACTIVE - %s samples, "
+          "value %f, %lld frames x %u ch @ %u Hz\n",
+          reynardFloatSamples ? "float" : "integer",
+          (double)reynardFloor, (long long)frames, mChannels, mRate);
+    }
+    for (int64_t i = 0; i < frames; i++) {
+      for (uint32_t c = 0; c < mChannels; c++) {
+        samples[i * mChannels + c] = reynardFloor;
+      }
+    }
+    RefPtr<AudioData> data(new AudioData(aSample->mOffset, aSample->mTime,
+                                         std::move(samples), mChannels,
+                                         mRate));
+    DecodedData results;
+    results.AppendElement(std::move(data));
+    return DecodePromise::CreateAndResolve(std::move(results), __func__);
+  }
+
+  RefPtr<DecodePromise> Drain() override {
+    // Stateless: every sample was answered as it arrived.
+    return DecodePromise::CreateAndResolve(DecodedData(), __func__);
+  }
+
+  RefPtr<FlushPromise> Flush() override {
+    return FlushPromise::CreateAndResolve(true, __func__);
+  }
+
+  RefPtr<ShutdownPromise> Shutdown() override {
+    return ShutdownPromise::CreateAndResolve(true, __func__);
+  }
+
+  nsCString GetDescriptionName() const override {
+    return "reynard silent audio decoder"_ns;
+  }
+
+  nsCString GetCodecName() const override { return "reynard-silence"_ns; }
+
+ private:
+  ~ReynardSilentAudioDecoder() = default;
+
+  const uint32_t mChannels;
+  const uint32_t mRate;
+};
 
