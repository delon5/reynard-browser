+// Marks the placeholder video frame as protected on its way past.
+//
+// The blank decoder below still makes the frame; this only sets the DRM
+// bit on its image. That bit becomes TextureFlags::DRM_SOURCE and then
+// NativeLayerCA::mIsDRM, whose branch builds a video layer at the
+// element's position instead of compositing the surface - which is both
+// how the picture gets somewhere correct and why the unfilled green
+// bytes stop being drawn.
+class ReynardProtectedFrameDecoder final : public MediaDataDecoder {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(ReynardProtectedFrameDecoder, final);
+
+  explicit ReynardProtectedFrameDecoder(
+      already_AddRefed<MediaDataDecoder> aInner)
+      : mInner(aInner) {}
+
+  RefPtr<InitPromise> Init() override { return mInner->Init(); }
+
+  RefPtr<DecodePromise> Decode(MediaRawData* aSample) override {
+    RefPtr<ReynardProtectedFrameDecoder> self = this;
+    return mInner->Decode(aSample)->Then(
+        GetCurrentSerialEventTarget(), __func__,
+        [self](DecodedData&& aResults) {
+          self->MarkProtected(aResults);
+          return DecodePromise::CreateAndResolve(std::move(aResults),
+                                                 __func__);
+        },
+        [](const MediaResult& aError) {
+          return DecodePromise::CreateAndReject(aError, __func__);
+        });
+  }
+
+  RefPtr<DecodePromise> Drain() override {
+    RefPtr<ReynardProtectedFrameDecoder> self = this;
+    return mInner->Drain()->Then(
+        GetCurrentSerialEventTarget(), __func__,
+        [self](DecodedData&& aResults) {
+          self->MarkProtected(aResults);
+          return DecodePromise::CreateAndResolve(std::move(aResults),
+                                                 __func__);
+        },
+        [](const MediaResult& aError) {
+          return DecodePromise::CreateAndReject(aError, __func__);
+        });
+  }
+
+  RefPtr<FlushPromise> Flush() override { return mInner->Flush(); }
+
+  RefPtr<ShutdownPromise> Shutdown() override { return mInner->Shutdown(); }
+
+  nsCString GetDescriptionName() const override {
+    return "reynard protected placeholder"_ns;
+  }
+
+  nsCString GetCodecName() const override { return "reynard-protected"_ns; }
+
+ private:
+  ~ReynardProtectedFrameDecoder() = default;
+
+  void MarkProtected(DecodedData& aResults) {
+    for (const RefPtr<MediaData>& data : aResults) {
+      if (!data || data->mType != VideoData::sType) {
+        continue;
+      }
+      VideoData* video = static_cast<VideoData*>(data.get());
+      if (!video->mImage) {
+        continue;
+      }
+      video->mImage->SetIsDRM(true);
+      if (!mReported) {
+        mReported = true;
+        printf_stderr(
+            "mseDecoderRoute: placeholder frame marked DRM - expect "
+            "NativeLayerCA: mIsDRM -> 1\n");
+      }
+    }
+  }
+
+  const RefPtr<MediaDataDecoder> mInner;
+  bool mReported = false;
+};
+
+// Silence for a protected MSE audio track.
+//
+// The audio branch below cannot let these samples reach EMEDecryptor -
+// a FairPlay proxy never returns a decrypted sample, so the wait never
+// ends and readyState stays at HAVE_METADATA. It used
+// BlankDecoderModule instead, which unblocked the element and turned
+// out to emit a SINE TONE rather than silence. Audible, and wrong.
+//
+// This returns the same shape of data with the samples zeroed. Frame
+// count comes from the sample's own duration so the timeline is the one
+// the demuxer described, and the clock behaves exactly as it does with
+// the tone.
+//
+// Nothing here renders. Real MSE audio belongs in an
+// AVSampleBufferAudioRenderer beside the display layer that already
+// paints the video; until that exists this makes the element correct
+// and quiet.
+class ReynardSilentAudioDecoder final : public MediaDataDecoder {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(ReynardSilentAudioDecoder, final);
+
+  explicit ReynardSilentAudioDecoder(const AudioInfo& aInfo)
+      : mChannels(aInfo.mChannels), mRate(aInfo.mRate) {}
+
+  RefPtr<InitPromise> Init() override {
+    printf_stderr("mseDecoderRoute: silent audio decoder %u ch @ %u Hz\n",
+                  mChannels, mRate);
+    return InitPromise::CreateAndResolve(TrackInfo::kAudioTrack, __func__);
+  }
+
+  RefPtr<DecodePromise> Decode(MediaRawData* aSample) override {
+    // Shaped after BlankAudioDataCreator::Create, which is the code this
+    // replaces: same frame arithmetic, same guards, same AudioData
+    // construction. Only the fill differs - it writes a 440 Hz sine,
+    // this writes zeroes.
+    //
+    // The +1 microsecond is its rounding guard, kept so the frame counts
+    // match what the element was already being given.
+    if (!mChannels || !mRate) {
+      return DecodePromise::CreateAndReject(
+          MediaResult(NS_ERROR_FAILURE, __func__), __func__);
+    }
+    const int64_t usecs = aSample->mDuration.ToMicroseconds() + 1;
+    const int64_t frames = (usecs * static_cast<int64_t>(mRate)) / 1000000;
+    if (frames < 0 || frames > (UINT32_MAX / mChannels)) {
+      return DecodePromise::CreateAndReject(
+          MediaResult(NS_ERROR_FAILURE, __func__), __func__);
+    }
+    AlignedAudioBuffer samples(frames * mChannels);
+    if (!samples) {
+      return DecodePromise::CreateAndReject(
+          MediaResult(NS_ERROR_OUT_OF_MEMORY, __func__), __func__);
+    }
+    for (int64_t i = 0; i < frames; i++) {
+      for (uint32_t c = 0; c < mChannels; c++) {
+        samples[i * mChannels + c] = AudioDataValue(0);
+      }
+    }
+    RefPtr<AudioData> data(new AudioData(aSample->mOffset, aSample->mTime,
+                                         std::move(samples), mChannels,
+                                         mRate));
+    DecodedData results;
+    results.AppendElement(std::move(data));
+    return DecodePromise::CreateAndResolve(std::move(results), __func__);
+  }
+
+  RefPtr<DecodePromise> Drain() override {
+    // Stateless: every sample was answered as it arrived.
+    return DecodePromise::CreateAndResolve(DecodedData(), __func__);
+  }
+
+  RefPtr<FlushPromise> Flush() override {
+    return FlushPromise::CreateAndResolve(true, __func__);
+  }
+
+  RefPtr<ShutdownPromise> Shutdown() override {
+    return ShutdownPromise::CreateAndResolve(true, __func__);
+  }
+
+  nsCString GetDescriptionName() const override {
+    return "reynard silent audio decoder"_ns;
+  }
+
+  nsCString GetCodecName() const override { return "reynard-silence"_ns; }
+
+ private:
+  ~ReynardSilentAudioDecoder() = default;
+
+  const uint32_t mChannels;
+  const uint32_t mRate;
+};
 
