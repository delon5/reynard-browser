 }
@@ -623,10 +660,21 @@
 void MediaDecoder::Play() {
   MOZ_ASSERT(NS_IsMainThread());
 
   NS_ASSERTION(mDecoderStateMachine != nullptr, "Should have state machine.");
   LOG("Play");
+  // Reynard: see MediaDecoder::Pause.
+  //
+  // At the top rather than beside ChangeState, so the ordinary autoplay
+  // path is covered: a play() taken during PLAY_STATE_LOADING sets
+  // mNextState and returns here, and the element does then play. The
+  // one case this reports wrongly is playbackRate 0, where Play()
+  // returns without playing and no Pause() follows - named rather than
+  // chased, because a page that calls play() at rate zero is not a
+  // thing that has ever been seen on this route.
+  extern void ReynardMSEPlayState(uintptr_t aOwnerId, bool aPlaying);
+  ReynardMSEPlayState(reinterpret_cast<uintptr_t>(this), true);
   if (mPlaybackRate == 0) {
     return;
   }
 
   if (IsEnded()) {
@@ -916,18 +964,26 @@
 void MediaDecoder::PlaybackEnded() {
   MOZ_ASSERT(NS_IsMainThread());
   MOZ_DIAGNOSTIC_ASSERT(!IsShutdown());
+  // REYNARD DIAGNOSTIC - names the pauser. If this prints and a host
+  // pause follows, Gecko ended playback and stopped the AVPlayer.
+  printf_stderr("mediaDecoder: PlaybackEnded entered - state=%s\n",
+                EnumValueToString(mPlayState));
 
   if (mLogicallySeeking || mPlayState == PLAY_STATE_LOADING ||
       mPlayState == PLAY_STATE_ENDED) {
     LOG("MediaDecoder::PlaybackEnded bailed out, "
         "mLogicallySeeking=%d mPlayState=%s",
         mLogicallySeeking.Ref(), EnumValueToString(mPlayState));
+    printf_stderr("mediaDecoder: PlaybackEnded BAILED (state=%s)\n",
+                  EnumValueToString(mPlayState));
     return;
   }
 
   LOG("MediaDecoder::PlaybackEnded");
 
   ChangeState(PLAY_STATE_ENDED);
   InvalidateWithFlags(VideoFrameContainer::INVALIDATE_FORCE);
+  printf_stderr(
+      "mediaDecoder: PlaybackEnded - element will fire 'ended' and Pause()\n");
   GetOwner()->PlaybackEnded();
 }
