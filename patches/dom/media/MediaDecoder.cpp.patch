@@ -129,17 +129,44 @@
 void MediaDecoder::Pause() {
   MOZ_ASSERT(NS_IsMainThread());
   MOZ_DIAGNOSTIC_ASSERT(!IsShutdown());
   LOG("Pause");
+  // Reynard: tell the FairPlay MSE route that the element stopped.
+  //
+  // That route paints and plays through AVFoundation objects of its
+  // own - an AVSampleBufferDisplayLayer and an
+  // AVSampleBufferAudioRenderer, each on a clock at rate 1.0 - and
+  // nothing has ever told them about the element. So a paused element
+  // kept playing, and "Block Audio and Video" was defeated entirely:
+  // Gecko withholds the play, the page buffers anyway, and the side
+  // channel plays what Gecko is holding back.
+  //
+  // Declared at block scope, which is how SourceBuffer.cpp already
+  // reaches ReynardMSEForwardInitSegment, so a core file gains no
+  // include for one call. A block-scope declaration names the
+  // ENCLOSING namespace, and this one is mozilla rather than
+  // mozilla::dom.
+  // WITH THE ELEMENT - see mse_fix_101. Without it this pause stopped
+  // every MSE stream in the process, and the play below started them.
+  extern void ReynardMSEPlayState(uintptr_t aOwnerId, bool aPlaying);
+  ReynardMSEPlayState(reinterpret_cast<uintptr_t>(this), false);
   if (mPlayState == PLAY_STATE_LOADING || IsEnded()) {
     mNextState = PLAY_STATE_PAUSED;
     return;
   }
   ChangeState(PLAY_STATE_PAUSED);
 }
 
 void MediaDecoder::SetVolume(double aVolume) {
   MOZ_ASSERT(NS_IsMainThread());
   mVolume = aVolume;
+  // And the volume, for the same route and the other half of the
+  // setting. "Block Audio Only" is Gecko's Allowed_muted: the play is
+  // permitted precisely because the element is believed inaudible, and
+  // an audio renderer that never heard about the volume made that
+  // belief false. This is the MSE twin of AVPlayerDecoder::SetVolume,
+  // which exists for the identical reason on the native HLS route.
+  extern void ReynardMSEVolume(uintptr_t aOwnerId, double aVolume);
+  ReynardMSEVolume(reinterpret_cast<uintptr_t>(this), aVolume);
 }
 
 RefPtr<GenericPromise> MediaDecoder::SetSink(AudioDeviceInfo* aSinkDevice) {
@@ -546,15 +573,25 @@
