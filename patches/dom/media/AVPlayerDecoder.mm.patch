+double AVPlayerDecoder::GetCurrentTime() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mPlayerId) {
+    const double seconds = [AVPlayerHost() currentTime:mPlayerId];
+    if (seconds >= 0) {
+      return seconds;
+    }
+  }
+  // Not created yet, or the player has no position yet - the base
+  // value is the mirrored MDSM position, which is at least defined.
+  return MediaDecoder::GetCurrentTime();
+}
+
+double AVPlayerDecoder::GetDuration() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mPlayerId) {
+    const double seconds = [AVPlayerHost() duration:mPlayerId];
+    if (seconds > 0) {
+      return seconds;
+    }
+  }
+  // Unknown: fall back to the base class, which reports the MDSM's
+  // notion (infinity until told otherwise) rather than 0 - the element
+  // reads a 0 duration as "ended at the start", and CurrentTime clamps
+  // against this value.
+  return MediaDecoder::GetDuration();
+}
+
+void AVPlayerDecoder::Shutdown() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mPlayerId) {
+    PlayersById().erase(mPlayerId);
+    [AVPlayerHost() destroy:mPlayerId];
+    // Registry teardown ordering: PlayersById first (kills in-flight
+    // main-thread pokes), host destroy second (stops the Swift side's
+    // observers), registry last. A report already in flight finds no
+    // entry and is dropped; a GetSamples still running on the demux
+    // task queue sees "no entry", parks, and the reader's own shutdown
+    // rejects the parked request. Nothing dangles.
+    AVPlayerPlaybackRegistry::Unregister(mPlayerId);
+    mPlayerId = 0;
+  }
+  MediaDecoder::Shutdown();
+}
