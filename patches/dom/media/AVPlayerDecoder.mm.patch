+
+void AVPlayerDecoder::NotifyMetadata(const media::TimeUnit& /* aDuration -
+                                        already in the registry */,
+                                     const gfx::IntSize& aDisplay) {
+  MOZ_ASSERT(NS_IsMainThread());
+  // Duration and size reached AVPlayerPlaybackRegistry before this hop
+  // was even queued - the C callback writes them on its caller's
+  // thread - so the demux task queue never depends on this method
+  // running. The old write-only SetDuration hand-off is gone with it.
+
+  // Now that the asset's real dimensions are known, republish at the
+  // correct size - the initial frame used kInitialDisplay.
+  PublishPlaceholderFrame(aDisplay);
+}
+
+void ReynardAVPlayerRequestHostSeek(uintptr_t aPlayerId, double aSeconds) {
+  MOZ_ASSERT(NS_IsMainThread());
+  // The demuxer's seek lands here through a main-thread hop: reaching
+  // the Swift host takes Objective-C, which AVPlayerDemuxer.cpp cannot
+  // speak. Keyed by player id rather than routed through PlayersById -
+  // the host ignores ids it no longer knows, so a seek racing teardown
+  // is naturally a no-op.
+  printf_stderr("avPlayer: host seek player=%llu to %.3f\n",
+                (unsigned long long)aPlayerId, aSeconds);
+  ControlPlayer(aPlayerId, kAVPlayerSeek, aSeconds);
+}
+
+void ReynardAVPlayerDispatchEncrypted(uintptr_t aPlayerId,
+                                      nsTArray<uint8_t>&& aInitData,
+                                      const nsAString& aInitDataType) {
+  MOZ_ASSERT(NS_IsMainThread());
+  auto& players = PlayersById();
+  auto entry = players.find(aPlayerId);
+  if (entry == players.end()) {
+    // Teardown race, same as the other callbacks: dropped.
+    return;
+  }
+  entry->second->DispatchEncryptedFromKeySession(std::move(aInitData),
+                                                 aInitDataType);
+}
