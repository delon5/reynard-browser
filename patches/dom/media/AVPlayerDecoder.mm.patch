+
+bool AVPlayerDecoder::IsSupportedType(const MediaContainerType& aType) {
+  // DIAGNOSTIC - device testing loaded Apple's bipbop .m3u8 and this
+  // decoder was never invoked at all: navigation committed to the URL
+  // and not one avPlayer line appeared. "Nothing happened" cannot
+  // distinguish the pref never reaching the engine from DecoderTraits
+  // resolving the type before it asks us, so both used to be reported
+  // here. That question is settled - the pipeline is proven end to
+  // end - and DecoderTraits routes every canPlayType/<source> probe
+  // through this function, so only the rare claimed case is logged
+  // now.
+  const bool enabled = IsEnabled();
+  const MediaMIMEType& mimeType = aType.Type();
+  const bool claimed =
+      enabled && (mimeType == MEDIAMIMETYPE("application/vnd.apple.mpegurl") ||
+                  mimeType == MEDIAMIMETYPE("application/x-mpegurl") ||
+                  mimeType == MEDIAMIMETYPE("audio/mpegurl") ||
+                  mimeType == MEDIAMIMETYPE("audio/x-mpegurl"));
+
+  if (claimed) {
+    printf_stderr("avPlayer: IsSupportedType(%s) pref=%d claimed=%d\n",
+                  mimeType.AsString().BeginReading(), enabled ? 1 : 0,
+                  claimed ? 1 : 0);
+  }
+
+  // The HLS family. FairPlay is only ever delivered this way, and it is
+  // also the container Gecko has no demuxer for on this platform - so
+  // handing it to AVFoundation loses nothing.
+  return claimed;
+}
+
+nsresult AVPlayerDecoder::Load(nsIChannel* aChannel) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  // The channel is not consumed. Gecko performs the load decision and the
+  // security setup, then AVFoundation owns the network from here - the
+  // same division HLSDecoder makes with ExoPlayer.
+  nsCOMPtr<nsIURI> uri;
+  nsresult rv = NS_GetFinalChannelURI(aChannel, getter_AddRefs(uri));
+  if (NS_WARN_IF(NS_FAILED(rv))) {
+    return rv;
+  }
+
+  mChannel = aChannel;
+
+  nsCString spec;
+  rv = uri->GetSpec(spec);
+  if (NS_WARN_IF(NS_FAILED(rv))) {
+    return rv;
+  }
+
+  id<GeckoAVPlayerHost> host = AVPlayerHost();
+  if (!host && !XRE_IsContentProcess()) {
+    // A content process reaches the host through IPC and needs no local
+    // one; only the parent-process path requires it here.
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+
+  if (XRE_IsContentProcess()) {
+    // The app process owns the player; this process only names it. iOS
+    // refuses a content extension any playback audio session ('!pla'),
+    // so a player created here reaches .waitingToPlayAtSpecifiedRate,
+    // renders at most one frame and is dropped back to .paused by media
+    // services - which is exactly what every capture showed.
+    //
+    // The id is ours and need only be unique within this process;
+    // ContentParent composes it with our child id before it reaches
+    // the broker.
+    static uintptr_t sNextContentPlayerId = 1;
+    mPlayerId = sNextContentPlayerId++;
+    dom::ContentChild* cc = dom::ContentChild::GetSingleton();
+    if (!cc) {
+      mPlayerId = 0;
+      return NS_ERROR_NOT_AVAILABLE;
+    }
+    cc->SendAVPlayerCreate(static_cast<uint64_t>(mPlayerId), spec);
+    // The child id too: the parent composes it with this player id into
+    // the key every report travels under, so printing both ends of that
+    // arithmetic makes a mismatch visible instead of inferred.
+    printf_stderr(
+        "avPlayer: brokering player %llu to the app process (childID=%llu, "
+        "key=%llu)\n",
+        (unsigned long long)mPlayerId,
+        (unsigned long long)static_cast<uint64_t>(cc->GetID()),
+        (unsigned long long)((static_cast<uint64_t>(cc->GetID()) << 32) |
+                             (static_cast<uint64_t>(mPlayerId) & 0xffffffff)));
+    // Twenty seconds of heartbeat, starting now. Re-armed per load: a
+    // second element restarts the count against its own player rather
+    // than reporting the first one's forever.
+    // The tick counter is NOT reset here any more: the watchdog reads
+    // it to decide whether the main thread is moving, and a reset in
+    // the middle of a run would read as a stall that is not there.
+    sContentAlivePlayerId = mPlayerId;
+    printf_stderr("avPlayer: content watchdog ARMED player=%llu\n",
+                  (unsigned long long)mPlayerId);
+    ReynardStartContentWatchdog();
+  } else {
+    mPlayerId = [host createPlayerWithUrl:[NSString stringWithUTF8String:spec.get()]];
+    if (!mPlayerId) {
+      return NS_ERROR_FAILURE;
+    }
+  }
+
+  // The element's volume, pushed once now that there is a player to
+  // push it to.
+  //
+  // ADDED - see mse_fix_90_tell_the_new_player_its_volume.py's
+  // docstring. SetVolume only runs when the volume CHANGES, and
+  // HTMLMediaElement pushes a change through mDecoder->SetVolume, which
+  // does nothing when there is no decoder yet. A page that mutes before
+  // it sets src does exactly that: the mute lands on nothing, the
+  // decoder is built afterwards, and nothing changes again - so an
+  // AVPlayer at its default 1.0 plays at full volume while Gecko
+  // believes the element is silent. That is tv.apple.com's hero
+  // trailer, whose player has not one "decoder volume" line in the
+  // capture.
+  //
+  // Here for the same shape of reason BindCDMProxyToPlayer is here, and
+  // beside it deliberately: both are state the page set before there
+  // was anything to set it on.
+  //
+  // Through SetVolume rather than around it, so the clamp, the
+  // change-gate and the native-route suppression all apply as they do
+  // to any other change. mLastVolumeSent starts negative, so this first
+  // one is never gated away.
+  printf_stderr("avPlayer: initial volume for player %llu -> %.3f\n",
+                (unsigned long long)mPlayerId, mVolume.Ref());
+  SetVolume(mVolume);
+
+  // The page can set mediaKeys before the element has a src, so the
+  // proxy may already be here waiting for a player to name.
+  BindCDMProxyToPlayer();
+
+  // The playback registry entry, created right after the host player.
+  // The Swift side installs its clock reporting inside
+  // createPlayerWithUrl, so a position report can already have raced
+  // this line - the registry drops writes for unknown ids, and the
+  // periodic observer repeats within 250 ms, so nothing is lost.
+  AVPlayerPlaybackRegistry::Register(mPlayerId);
+
+  // Registered before anything can call back. The Swift host starts
+  // observing the item inside createPlayerWithUrl, so a ready item can
+  // deliver metadata almost immediately.
+  PlayersById()[mPlayerId] = this;
+
+  // A layer has to exist before the first metadata callback, or there is
+  // nothing on screen while the asset resolves.
+  PublishPlaceholderFrame(kInitialDisplay);
+
+  rv = MediaShutdownManager::Instance().Register(this);
+  if (NS_WARN_IF(NS_FAILED(rv))) {
+    printf_stderr("avPlayer: Load ABORTED - shutdown-manager Register rv=0x%08x\n",
+                  static_cast<uint32_t>(rv));
+    return rv;
+  }
+
+  // The last two steps of Load were the only unobserved ones: every line
+  // a capture shows - created, placeholder, metadata - happens above, so
+  // a failure from here on is indistinguishable from success in the log.
+  // A non-zero rv here also means SetupDecoder called Shutdown, which is
+  // the only path that logs "destroyed" right after load.
+  rv = CreateAndInitStateMachine(false);
+  printf_stderr("avPlayer: Load done - CreateAndInitStateMachine rv=0x%08x\n",
+                static_cast<uint32_t>(rv));
+
+  // The content principal, from the URL AVFoundation is about to load.
+  // Without this mContentPrincipal stays null for the decoder's whole
+  // life, and HTMLMediaElement::IsCORSSameOrigin - which asks
+  // NodePrincipal()->Subsumes(GetCurrentPrincipal()) - can never pass.
+  // DispatchEncrypted then fires the REDACTED form of the event,
+  // MediaEncryptedEvent::Constructor(this), with no init data and an
+  // empty type: exactly the "type='' initData=null" every capture
+  // showed, even on same-origin streams where the data should be
+  // exposed. Players call generateRequest with that null and throw.
+  //
+  // NotifyLoad is the intended entry point and still has no caller;
+  // this calls the same work directly, at the one place the resolved
+  // URL is already in hand. AVFoundation's own redirects remain
+  // invisible to us, so a redirected stream is treated as its
+  // pre-redirect origin - the same limitation HLSDecoder has.
+  //
+  // NOT notifying the element here: it has no decoder until
+  // FinishDecoderSetup runs, which is after this returns, and it
+  // notifies itself the moment it does.
+  UpdateCurrentPrincipal(spec, /* aNotifyElement */ false);
+  printf_stderr("avPlayer: content principal set from %s\n", spec.get());
+
+  return rv;
+}
+
+already_AddRefed<MediaDecoderStateMachineBase>
+AVPlayerDecoder::CreateStateMachine(bool aDisableExternalEngine) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  // Held in a RefPtr rather than assigned straight through, because
+  // init.mKnowsCompositor is an already_AddRefed - a pure carrier that
+  // cannot be null-tested once it holds the reference, and the log
+  // below needs to say whether one existed.
+  RefPtr<layers::KnowsCompositor> knowsCompositor = GetCompositor();
+
+  MediaFormatReaderInit init;
+  init.mVideoFrameContainer = GetVideoFrameContainer();
+  init.mCrashHelper = GetOwner()->CreateGMPCrashHelper();
+  init.mFrameStats = mFrameStats;
+  init.mMediaDecoderOwnerID = mOwner;
+
+  // Asked here because MediaFormatReader is about to ask the same
+  // question, and a "no" there is silent in a way that misreads.
+  //
+  // OnDemuxerInitDone rejects the metadata promise outright when
+  // PDMFactorySupport::IsTypeSupported comes back empty for the track's
+  // MIME type - "We have no decoder for this track. Error." That
+  // rejection prints neither MetadataLoaded nor FirstFrameLoaded, which
+  // is indistinguishable from the promise simply never resolving, and
+  // the two want opposite fixes: a rejection means the advertised type
+  // is wrong, while never resolving means the start-time path is.
+  //
+  // AVPlayerDemuxer advertises the synthetic type that only
+  // ReynardAVPlayerDecoderModule claims. A 0 here therefore means the
+  // module is not registered (is the PDMFactory.cpp patch applied?) or
+  // the support query resolves through the fixed codec enum rather
+  // than the live modules - in which case switch to the Fallback-B
+  // wiring described in AVPlayerDemuxer.h.
+  {
+    const bool supported =
+        !PDMFactorySupport::IsTypeSupported(
+             nsLiteralCString(REYNARD_AVPLAYER_SYNTHETIC_MIME))
+             .isEmpty();
+    printf_stderr(
+        "avPlayer: PDM support for " REYNARD_AVPLAYER_SYNTHETIC_MIME
+        " = %d%s\n",
+        supported ? 1 : 0,
+        supported ? "" : " - MediaFormatReader WILL reject metadata for this");
+  }
+
+  // The container feeds MediaFormatReader's "videoActive" gate: a null
+  // one turns OnDemuxerInitDone's video track down and rejects metadata
+  // with "No active audio or video track" - silently, in release. The
+  // placeholder publishing proves the container exists on the decoder;
+  // this proves what the reader was actually handed.
+  printf_stderr("avPlayer: CreateStateMachine container=%d compositor=%d\n",
+                init.mVideoFrameContainer ? 1 : 0, knowsCompositor ? 1 : 0);
+  init.mKnowsCompositor = knowsCompositor.forget();
+
+  mDemuxer = new AVPlayerDemuxer(mPlayerId, kInitialDisplay);
+  mReader = new MediaFormatReader(init, mDemuxer);
+
+  // Capture 16 pinned the crash between the probe above and Load's
+  // return, on Gecko's main thread, before InitializationTask was ever
+  // dispatched. The two lines below split the biggest step in that
+  // window - the state machine's constructor - and pull the MDSM
+  // thread pool's first-in-process creation out of it entirely.
+  // (MediaFormatReader's constructor already created a SUPERVISOR-pool
+  // task queue above, so pool creation per se is proven; this makes the
+  // MDSM pool's creation its own observable step anyway.)
+  RefPtr<SharedThreadPool> mdsmPool =
+      GetMediaThreadPool(MediaThreadType::MDSM);
+  printf_stderr("avPlayer: MDSM thread pool ready=%d\n", mdsmPool ? 1 : 0);
+
+  RefPtr<MediaDecoderStateMachine> stateMachine =
+      new MediaDecoderStateMachine(this, mReader);
+  printf_stderr("avPlayer: MDSM constructed\n");
+  return stateMachine.forget();
+}
+
+void AVPlayerDecoder::Play() {
+  MOZ_ASSERT(NS_IsMainThread());
+  printf_stderr("avPlayer: decoder Play() player=%llu\n",
+                (unsigned long long)mPlayerId);
+  ControlPlayer(mPlayerId, kAVPlayerPlay);
+  // Raised across the base call - see mse_fix_83's docstring. The line
+  // above is this route's own channel; the line below also reaches the
+  // MSE parser route, which is a different element's.
+  //
+  // Block-scope declaration, which is how MediaDecoder.cpp reaches
+  // ReynardMSEPlayState in the first place. It names the enclosing
+  // namespace, and this file is inside namespace mozilla.
+  extern void ReynardMSEEnterNativeRoute(bool aEnter);
+  ReynardMSEEnterNativeRoute(true);
+  MediaDecoder::Play();
+  ReynardMSEEnterNativeRoute(false);
+}
+
+// The element's volume, forwarded to the player actually making the
+// sound.
+//
+// Nothing did this, and two separate faults came out of it. The page's
+// mute button set the element's volume to zero while the AVPlayer
+// carried on at full, so the button visibly did nothing. And the
+// autoplay setting "Block Audio Only" is Gecko's DENY_ACTION, which
+// resolves to Allowed_muted - the play is permitted PRECISELY because
+// Gecko believes the element is inaudible. With the volume never
+// reaching AVFoundation that belief was false, so a site blocked from
+// autoplaying with sound autoplayed with sound. Reported on IGN, whose
+// feed does exactly this.
+//
+// MediaDecoder::SetVolume is virtual for this; the base class still
+// records mVolume, which the rest of Gecko reads.
+void AVPlayerDecoder::SetVolume(double aVolume) {
+  MOZ_ASSERT(NS_IsMainThread());
+  // Clamped rather than trusted: AVPlayer takes 0...1 and anything
+  // outside that is undefined, while an element's volume is only
+  // guaranteed finite.
+  double volume = aVolume;
+  if (!std::isfinite(volume)) {
+    volume = 1.0;
+  }
+  volume = std::max(0.0, std::min(1.0, volume));
+  // Volume changes arrive per animation frame from a fading UI; only a
+  // real change is worth an IPC hop.
+  if (mLastVolumeSent >= 0.0 && std::fabs(mLastVolumeSent - volume) < 0.001) {
+    return;
+  }
+  mLastVolumeSent = volume;
+  printf_stderr("avPlayer: decoder volume player=%llu -> %.3f\n",
+                (unsigned long long)mPlayerId, volume);
+  ControlPlayer(mPlayerId, kAVPlayerVolume, volume);
+  // See AVPlayerDecoder::Play. This is the one that mattered: the
+  // trailer's mute button wrote a zero the film's audio renderer then
+  // started life with.
+  extern void ReynardMSEEnterNativeRoute(bool aEnter);
+  ReynardMSEEnterNativeRoute(true);
+  MediaDecoder::SetVolume(aVolume);
+  ReynardMSEEnterNativeRoute(false);
+}
