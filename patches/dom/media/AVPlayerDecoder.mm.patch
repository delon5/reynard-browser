+// The three forwards below only guarantee the main thread; ContentParent
+// does the actual send, because IPC actors live there.
+static void ForwardMetadataToOwner(uint64_t aKey, double aDurationSeconds,
+                                   int32_t aWidth, int32_t aHeight) {
+  printf_stderr(
+      "avPlayer: forwarding metadata for key %llu (%.3fs %dx%d) to its "
+      "content process\n",
+      (unsigned long long)aKey, aDurationSeconds, aWidth, aHeight);
+  if (NS_IsMainThread()) {
+    ReynardAVPlayerSendMetadata(aKey, aDurationSeconds, aWidth, aHeight);
+    return;
+  }
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "ReynardAVPlayerSendMetadata",
+      [aKey, aDurationSeconds, aWidth, aHeight]() {
+        ReynardAVPlayerSendMetadata(aKey, aDurationSeconds, aWidth, aHeight);
+      }));
+}
