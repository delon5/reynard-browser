+
+// Derives a principal from the RESOLVED url, mirroring
+// HLSDecoder::GetContentPrincipal.
+//
+// The previous version parsed the resolved URI and then never used it,
+// taking the principal from mChannel instead. AVFoundation's redirects
+// are invisible to that channel, so every call produced the identical
+// principal, Equals always passed, and mHadCrossOriginRedirects could
+// never become true - a cross-origin redirected stream was treated as
+// same-origin, which is the unsafe direction for canvas taint.
+already_AddRefed<nsIPrincipal> AVPlayerDecoder::GetContentPrincipal(
+    nsIURI* aMediaUri) {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsCOMPtr<nsIPrincipal> principal = NullPrincipal::Create(OriginAttributes());
+
+  MediaDecoderOwner* owner = GetOwner();
+  RefPtr<dom::HTMLMediaElement> element =
+      owner ? owner->GetMediaElement() : nullptr;
+  if (!element) {
+    return principal.forget();
+  }
+
+  nsSecurityFlags securityFlags =
+      element->ShouldCheckAllowOrigin()
+          ? nsILoadInfo::SEC_REQUIRE_CORS_INHERITS_SEC_CONTEXT
+          : nsILoadInfo::SEC_ALLOW_CROSS_ORIGIN_INHERITS_SEC_CONTEXT;
+  if (element->GetCORSMode() == CORS_USE_CREDENTIALS) {
+    securityFlags |= nsILoadInfo::SEC_COOKIES_INCLUDE;
+  }
+
+  nsCOMPtr<nsIChannel> channel;
+  nsresult rv = NS_NewChannel(
+      getter_AddRefs(channel), aMediaUri, static_cast<dom::Element*>(element),
+      securityFlags, nsIContentPolicy::TYPE_INTERNAL_VIDEO);
+  NS_ENSURE_SUCCESS(rv, principal.forget());
+
+  nsIScriptSecurityManager* secMan = nsContentUtils::GetSecurityManager();
+  if (!secMan) {
+    return principal.forget();
+  }
+  secMan->GetChannelResultPrincipal(channel, getter_AddRefs(principal));
+  return principal.forget();
+}
+
+void AVPlayerDecoder::UpdateCurrentPrincipal(nsCString aMediaUrl,
+                                             bool aNotifyElement) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  nsCOMPtr<nsIURI> finalURI;
+  if (NS_FAILED(NS_NewURI(getter_AddRefs(finalURI), aMediaUrl))) {
+    return;
+  }
+
+  nsCOMPtr<nsIPrincipal> principal = GetContentPrincipal(finalURI);
+  if (!principal) {
+    return;
+  }
+
+  // Subsumption, as HLSDecoder does it: equal or disjoint are the only
+  // sane outcomes, and disjoint collapses to a null principal rather
+  // than silently keeping the more permissive one.
+  if (!mContentPrincipal || principal->GetIsNullPrincipal()) {
+    mContentPrincipal = std::move(principal);
+  } else if (principal->Equals(mContentPrincipal)) {
+    return;
+  } else if (!principal->Subsumes(mContentPrincipal) &&
+             !mContentPrincipal->Subsumes(principal)) {
+    mHadCrossOriginRedirects = true;
+    mContentPrincipal = NullPrincipal::Create(OriginAttributes());
+  } else {
+    mHadCrossOriginRedirects = true;
+    mContentPrincipal = std::move(principal);
+  }
+
+  // Without this the element never learns the principal moved - but
+  // ONLY once it has a decoder to be told about.
+  //
+  // HTMLMediaElement::NotifyDecoderPrincipalChanged does
+  // `mDecoder->UpdateSameOriginStatus(...)` with no null check
+  // (HTMLMediaElement.cpp:7146), and mDecoder is assigned in
+  // FinishDecoderSetup -> SetDecoder, which the element runs only after
+  // decoder->Load() has RETURNED. Calling this from inside Load was a
+  // null dereference at UpdateSameOriginStatus + 0, fault address 0x1bc
+  // - the offset of mSameOriginMedia - killing the content process a
+  // millisecond after "Load done", on every single media load. With a
+  // debugger attached the same fault froze the main thread instead,
+  // which is what the wedge hunt was chasing.
+  //
+  // Nothing is lost by staying quiet during Load: FinishDecoderSetup
+  // calls NotifyDecoderPrincipalChanged() itself immediately after
+  // SetDecoder (HTMLMediaElement.cpp:5774), so the element picks the
+  // principal up a few instructions later from a place where its
+  // decoder exists.
+  if (aNotifyElement) {
+    MediaDecoder::NotifyPrincipalChanged();
+  }
+}
