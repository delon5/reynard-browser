+// The app's player, or nil. Optional on the runtime protocol, so a build
+// without it simply never claims any stream.
+static id<GeckoAVPlayerHost> AVPlayerHost() {
+  id<SwiftGeckoViewRuntime> runtime = widget::GetSwiftRuntime();
+  if (!runtime || ![runtime respondsToSelector:@selector(avPlayerHost)]) {
+    return nil;
+  }
+  return [runtime avPlayerHost];
+}
+
+// Default until the asset reports its real size. The compositor needs
+// something non-degenerate to build a layer from before the first
+// metadata callback arrives.
+static const gfx::IntSize kInitialDisplay(1920, 1080);
+
+AVPlayerDecoder::AVPlayerDecoder(MediaDecoderInit& aInit)
+    : MediaDecoder(aInit) {}
+
+AVPlayerDecoder::~AVPlayerDecoder() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mPlayerId) {
+    [AVPlayerHost() destroy:mPlayerId];
+    mPlayerId = 0;
+  }
+}
+
+RefPtr<AVPlayerDecoder> AVPlayerDecoder::Create(MediaDecoderInit& aInit) {
+  printf_stderr("avPlayer: Create() pref=%d\n", IsEnabled() ? 1 : 0);
+  if (!IsEnabled()) {
+    return nullptr;
+  }
+  return new AVPlayerDecoder(aInit);
+}
+
+bool AVPlayerDecoder::IsEnabled() {
+  return StaticPrefs::media_reynard_avplayer_enabled();
+}
+
+bool AVPlayerDecoder::IsSupportedType(const MediaContainerType& aType) {
+  // DIAGNOSTIC - device testing loaded Apple's bipbop .m3u8 and this
+  // decoder was never invoked at all: navigation committed to the URL
+  // and not one avPlayer line appeared. "Nothing happened" cannot
+  // distinguish the pref never reaching the engine from DecoderTraits
+  // resolving the type before it asks us, so both are reported here.
+  const bool enabled = IsEnabled();
+  const MediaMIMEType& mimeType = aType.Type();
+  const bool claimed =
+      enabled && (mimeType == MEDIAMIMETYPE("application/vnd.apple.mpegurl") ||
+                  mimeType == MEDIAMIMETYPE("application/x-mpegurl") ||
+                  mimeType == MEDIAMIMETYPE("audio/mpegurl") ||
+                  mimeType == MEDIAMIMETYPE("audio/x-mpegurl"));
+
+  printf_stderr("avPlayer: IsSupportedType(%s) pref=%d claimed=%d\n",
+                mimeType.AsString().BeginReading(), enabled ? 1 : 0,
+                claimed ? 1 : 0);
+
+  // The HLS family. FairPlay is only ever delivered this way, and it is
+  // also the container Gecko has no demuxer for on this platform - so
+  // handing it to AVFoundation loses nothing.
+  return claimed;
+}
+
+nsresult AVPlayerDecoder::Load(nsIChannel* aChannel) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  // The channel is not consumed. Gecko performs the load decision and the
+  // security setup, then AVFoundation owns the network from here - the
+  // same division HLSDecoder makes with ExoPlayer.
+  nsCOMPtr<nsIURI> uri;
+  nsresult rv = NS_GetFinalChannelURI(aChannel, getter_AddRefs(uri));
+  if (NS_WARN_IF(NS_FAILED(rv))) {
+    return rv;
+  }
+
+  mChannel = aChannel;
+
+  nsCString spec;
+  rv = uri->GetSpec(spec);
+  if (NS_WARN_IF(NS_FAILED(rv))) {
+    return rv;
+  }
+
+  id<GeckoAVPlayerHost> host = AVPlayerHost();
+  if (!host) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+
+  mPlayerId = [host createPlayerWithUrl:[NSString stringWithUTF8String:spec.get()]];
+  if (!mPlayerId) {
+    return NS_ERROR_FAILURE;
+  }
+
+  // A layer has to exist before the first metadata callback, or there is
+  // nothing on screen while the asset resolves.
+  PublishPlaceholderFrame(kInitialDisplay);
+
+  rv = MediaShutdownManager::Instance().Register(this);
+  if (NS_WARN_IF(NS_FAILED(rv))) {
+    return rv;
+  }
+
+  return CreateAndInitStateMachine(false);
+}
+
+already_AddRefed<MediaDecoderStateMachineBase>
+AVPlayerDecoder::CreateStateMachine(bool aDisableExternalEngine) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  MediaFormatReaderInit init;
+  init.mVideoFrameContainer = GetVideoFrameContainer();
+  init.mKnowsCompositor = GetCompositor();
+  init.mCrashHelper = GetOwner()->CreateGMPCrashHelper();
+  init.mFrameStats = mFrameStats;
+  init.mMediaDecoderOwnerID = mOwner;
+
+  mDemuxer = new AVPlayerDemuxer(kInitialDisplay);
+  mReader = new MediaFormatReader(init, mDemuxer);
+
+  return MakeAndAddRef<MediaDecoderStateMachine>(this, mReader);
+}
