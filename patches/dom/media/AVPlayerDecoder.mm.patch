+}  // namespace mozilla
+
+// Declared in GeckoViewSwiftSupport.h. Defined outside the namespace so
+// the symbol Swift links against is exactly this name.
+//
+// Hops to Gecko's main thread instead of trusting the caller's queue.
+// The Swift host dispatches on DispatchQueue.main, and in the parent
+// process that IS Gecko's main thread - but in a content process Gecko
+// runs its "MainThread" on a spawned thread, and the GCD main queue
+// drains on the extension's principal thread. Capture 16 proved the
+// difference the hard way: this callback ran and republished the
+// placeholder while Gecko's main thread sat frozen on an
+// EXC_BAD_ACCESS, which is only possible if they are different
+// threads. Every MOZ_ASSERT(NS_IsMainThread()) below this had been
+// violated on every callback, silently, in release. The registry
+// lookup, SetDuration, and the frame publish all touch main-thread-only
+// state, so the hop is the fix rather than the assertions.
+extern "C" MOZ_EXPORT void ReynardAVPlayerNotifyMetadata(
+    uintptr_t aPlayerId, double aDurationSeconds, int32_t aWidth,
+    int32_t aHeight) {
+  printf_stderr(
+      "avPlayer: metadata callback player=%llu geckoMain=%d - dispatching\n",
+      (unsigned long long)aPlayerId, NS_IsMainThread() ? 1 : 0);
+
+  // Straight into the playback registry, on the caller's thread: the
+  // demux task queue snapshots the registry in GetTrackDemuxer, and
+  // that read must not depend on the main-thread hop below having run.
+  mozilla::AVPlayerPlaybackRegistry::SetMetadata(
+      aPlayerId, aDurationSeconds, mozilla::gfx::IntSize(aWidth, aHeight));
+
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "ReynardAVPlayerNotifyMetadata",
+      [aPlayerId, aDurationSeconds, aWidth, aHeight]() {
+        MOZ_ASSERT(NS_IsMainThread());
+
+        auto& players = mozilla::PlayersById();
+        auto entry = players.find(aPlayerId);
+        if (entry == players.end()) {
+          // Routine during teardown rather than an error: the decoder
+          // erases itself before the player is destroyed, so a
+          // notification already in flight lands here and is dropped.
+          printf_stderr(
+              "avPlayer: metadata for unknown player %llu - ignored\n",
+              (unsigned long long)aPlayerId);
+          return;
+        }
+
+        // AVFoundation reports an indefinite or NaN duration for a live
+        // stream, and for any item that has not resolved one yet. Zero
+        // rather than a garbage TimeUnit - the element reads that as
+        // unknown, which is the truth.
+        const mozilla::media::TimeUnit duration =
+            (std::isfinite(aDurationSeconds) && aDurationSeconds > 0.0)
+                ? mozilla::media::TimeUnit::FromSeconds(aDurationSeconds)
+                : mozilla::media::TimeUnit::Zero();
+
+        printf_stderr(
+            "avPlayer: metadata player=%llu duration=%.3f size=%dx%d\n",
+            (unsigned long long)aPlayerId, aDurationSeconds, aWidth,
+            aHeight);
+
+        entry->second->NotifyMetadata(duration,
+                                      mozilla::gfx::IntSize(aWidth, aHeight));
+      }));
+}
+
+// Real frames, replacing the magenta placeholder as soon as the first
+// one lands.
+//
+// The placeholder proved the compositor path end to end - container,
+// two-plane surface, layer - but it is a synthetic fill. This publishes
+// what AVFoundation actually decoded, taken straight from the video
+// output's CVPixelBuffer.
+//
+// No pixels are copied. The buffer is IOSurface-backed by construction
+// (the Swift side creates the output with
+// kCVPixelBufferIOSurfacePropertiesKey), and an IOSurface is exactly
+// what MacIOSurfaceImage wraps, so the same surface AVFoundation
+// decoded into is handed to the compositor.
+extern "C" MOZ_EXPORT void ReynardAVPlayerNotifyFrame(
+    uintptr_t aPlayerId, CVPixelBufferRef aPixelBuffer) {
+  if (!aPixelBuffer) {
+    return;
+  }
+
+  IOSurfaceRef ioSurface = CVPixelBufferGetIOSurface(aPixelBuffer);
+  if (!ioSurface) {
+    // Only possible if the output was created without the IOSurface
+    // attribute. Logged once rather than per frame - at 30fps an
+    // unconditional printf here is its own outage.
+    static bool sWarnedNoIOSurface = false;
+    if (!sWarnedNoIOSurface) {
+      sWarnedNoIOSurface = true;
+      printf_stderr(
+          "avPlayer: frame has no IOSurface - dropping every frame\n");
+    }
+    return;
+  }
+
+  // Retained across the thread hop and adopted by the CFTypeRefPtr on
+  // the far side. The caller's buffer may be released the moment this
+  // returns, and the runnable outlives that.
+  CFRetain(ioSurface);
+
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "ReynardAVPlayerNotifyFrame", [aPlayerId, ioSurface]() {
+        MOZ_ASSERT(NS_IsMainThread());
+
+        // WrapUnderCreateRule: takes the reference added above rather
+        // than adding another, so the surface is released when this
+        // runnable finishes even on the early-return paths below.
+        auto surfaceRef =
+            CFTypeRefPtr<IOSurfaceRef>::WrapUnderCreateRule(ioSurface);
+
+        auto& players = mozilla::PlayersById();
+        auto entry = players.find(aPlayerId);
+        if (entry == players.end()) {
+          // Same teardown race as the metadata callback - the decoder
+          // erases itself before the player dies, so frames already in
+          // flight land here and are dropped.
+          return;
+        }
+
+        mozilla::VideoFrameContainer* container =
+            entry->second->GetVideoFrameContainer();
+        if (!container) {
+          return;
+        }
+
+        // BT.709 to match the placeholder and the overwhelming majority
+        // of streamed H.264/HEVC. A real implementation would read the
+        // colour attachments off the pixel buffer; getting that wrong
+        // shifts colour, it does not stop a frame appearing, so it is
+        // deliberately left for after the pipeline is proven.
+        RefPtr<MacIOSurface> macSurface = new MacIOSurface(
+            surfaceRef, mozilla::gfx::YUVColorSpace::BT709,
+            mozilla::gfx::TransferFunction::BT709,
+            MacIOSurface::AllowAlpha::No);
+
+        const mozilla::gfx::IntSize size(
+            static_cast<int32_t>(macSurface->GetDevicePixelWidth()),
+            static_cast<int32_t>(macSurface->GetDevicePixelHeight()));
+        if (size.width <= 0 || size.height <= 0) {
+          return;
+        }
+
+        // Logged once. The interesting question is whether a real frame
+        // ever replaces the placeholder at all; after that it is noise.
+        static bool sReportedFirstFrame = false;
+        if (!sReportedFirstFrame) {
+          sReportedFirstFrame = true;
+          printf_stderr(
+              "avPlayer: FIRST REAL FRAME player=%llu %dx%d planes=%u\n",
+              (unsigned long long)aPlayerId, size.width, size.height,
+              (unsigned)macSurface->GetPlaneCount());
+        }
+
+        // Latched before publishing, so a metadata callback that runs
+        // between this and the next frame cannot slip a placeholder in.
+        entry->second->mHasPublishedRealFrame = true;
+
+        RefPtr<mozilla::layers::Image> image =
+            new mozilla::layers::MacIOSurfaceImage(macSurface);
+        container->SetCurrentFrame(size, image, mozilla::TimeStamp::Now(),
+                                   mozilla::media::TimeUnit::Zero(),
+                                   mozilla::media::TimeUnit::Zero());
+        container->Invalidate();
+      }));
+}
+
+// The playback position, pushed by the Swift host. The HOT callback of
+// the family - the display link calls it at up to 120 Hz - so unlike
+// the metadata and frame callbacks it does NOT unconditionally hop to
+// Gecko's main thread. The write lands in AVPlayerPlaybackRegistry on
+// the caller's thread; UpdatePosition answers whether anything is
+// waiting on this position (a parked demux request, or the
+// once-a-second buffered-ranges refresh), and only then is a
+// main-thread runnable queued to poke the reader.
+extern "C" MOZ_EXPORT void ReynardAVPlayerNotifyTime(uintptr_t aPlayerId,
+                                                     double aSeconds) {
+  if (!mozilla::AVPlayerPlaybackRegistry::UpdatePosition(aPlayerId,
+                                                         aSeconds)) {
+    return;
+  }
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "ReynardAVPlayerNotifyTime", [aPlayerId]() {
+        MOZ_ASSERT(NS_IsMainThread());
+        auto& players = mozilla::PlayersById();
+        auto entry = players.find(aPlayerId);
+        if (entry == players.end()) {
+          // Teardown race, same as the other callbacks: dropped.
+          return;
+        }
+        entry->second->NotifyPlaybackPoke();
+      }));
+}
+
+// Played to the end. Sets the registry's ended flag so the demuxer's
+// next sample request answers END_OF_STREAM - which is how the state
+// machine completes and the element fires "ended" at the stream's real
+// end, rather than at t=0 the way the end-of-stream stub did.
+extern "C" MOZ_EXPORT void ReynardAVPlayerNotifyEnded(uintptr_t aPlayerId) {
+  printf_stderr("avPlayer: ended callback player=%llu\n",
+                (unsigned long long)aPlayerId);
+  if (!mozilla::AVPlayerPlaybackRegistry::NotifyEnded(aPlayerId)) {
+    return;
+  }
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "ReynardAVPlayerNotifyEnded", [aPlayerId]() {
+        MOZ_ASSERT(NS_IsMainThread());
+        auto& players = mozilla::PlayersById();
+        auto entry = players.find(aPlayerId);
+        if (entry == players.end()) {
+          return;
+        }
+        entry->second->NotifyPlaybackPoke();
+      }));
+}
