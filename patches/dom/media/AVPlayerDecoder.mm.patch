+
+void ReynardAVPlayerDispatchEncrypted(uintptr_t aPlayerId,
+                                      nsTArray<uint8_t>&& aInitData,
+                                      const nsAString& aInitDataType) {
+  MOZ_ASSERT(NS_IsMainThread());
+  auto& players = PlayersById();
+  auto entry = players.find(aPlayerId);
+  if (entry == players.end()) {
+    // Teardown race, same as the other callbacks: dropped.
+    return;
+  }
+  entry->second->DispatchEncryptedFromKeySession(std::move(aInitData),
+                                                 aInitDataType);
+}
