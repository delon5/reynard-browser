+// Pairs this decoder's proxy with this decoder's player, so the keys
+// land on the session the asset is registered against. Safe to call
+// twice and in either order - the proxy publishes only once both halves
+// are known, and BindToPlayer ignores a repeat of the same id.
+void AVPlayerDecoder::BindCDMProxyToPlayer() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mCDMProxy || !mPlayerId) {
+    return;
+  }
+  // Only FairPlay reaches AVFoundation, and MediaKeys creates exactly
+  // one proxy type for that key system, so the key system is a sound
+  // discriminator - CDMProxy has no As* hook to use instead.
+  if (!IsFairPlayKeySystem(mCDMProxy->KeySystem())) {
+    return;
+  }
+  static_cast<FairPlayCDMProxy*>(mCDMProxy.get())->BindToPlayer(mPlayerId);
+}
+
+void AVPlayerDecoder::NotifyPlaybackPoke() {
+  MOZ_ASSERT(NS_IsMainThread());
+  // The poke runnable can land between Shutdown() and destruction - it
+  // was already in flight when the registry entry died - and
+  // NotifyReaderDataArrived diagnostic-asserts on a shut-down decoder.
+  if (IsShutdown()) {
+    return;
+  }
+  // Re-issues any demux request a WAITING_FOR_DATA rejection parked,
+  // and refreshes the reader's buffered ranges - the same call
+  // MediaSourceDecoder::NotifyDataArrived makes when a SourceBuffer
+  // gains data. The demuxer is what was waiting; the reader owns the
+  // machinery for asking it again.
+  NotifyReaderDataArrived();
+}
