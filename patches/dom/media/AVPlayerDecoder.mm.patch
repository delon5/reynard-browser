+nsresult AVPlayerDecoder::Load(nsIChannel* aChannel) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  // The channel is not consumed. Gecko performs the load decision and the
+  // security setup, then AVFoundation owns the network from here - the
+  // same division HLSDecoder makes with ExoPlayer.
+  nsCOMPtr<nsIURI> uri;
+  nsresult rv = NS_GetFinalChannelURI(aChannel, getter_AddRefs(uri));
+  if (NS_WARN_IF(NS_FAILED(rv))) {
+    return rv;
+  }
+
+  mChannel = aChannel;
+
+  nsCString spec;
+  rv = uri->GetSpec(spec);
+  if (NS_WARN_IF(NS_FAILED(rv))) {
+    return rv;
+  }
+
+  id<GeckoAVPlayerHost> host = AVPlayerHost();
+  if (!host) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+
+  mPlayerId = [host createPlayerWithUrl:[NSString stringWithUTF8String:spec.get()]];
+  if (!mPlayerId) {
+    return NS_ERROR_FAILURE;
+  }
+
+  // Registered before anything can call back. The Swift host starts
+  // observing the item inside createPlayerWithUrl, so a ready item can
+  // deliver metadata almost immediately.
+  PlayersById()[mPlayerId] = this;
+
+  // A layer has to exist before the first metadata callback, or there is
+  // nothing on screen while the asset resolves.
+  PublishPlaceholderFrame(kInitialDisplay);
+
+  rv = MediaShutdownManager::Instance().Register(this);
+  if (NS_WARN_IF(NS_FAILED(rv))) {
+    printf_stderr("avPlayer: Load ABORTED - shutdown-manager Register rv=0x%08x\n",
+                  static_cast<uint32_t>(rv));
+    return rv;
+  }
+
+  // The last two steps of Load were the only unobserved ones: every line
+  // a capture shows - created, placeholder, metadata - happens above, so
+  // a failure from here on is indistinguishable from success in the log.
+  // A non-zero rv here also means SetupDecoder called Shutdown, which is
+  // the only path that logs "destroyed" right after load.
+  rv = CreateAndInitStateMachine(false);
+  printf_stderr("avPlayer: Load done - CreateAndInitStateMachine rv=0x%08x\n",
+                static_cast<uint32_t>(rv));
+  return rv;
+}
