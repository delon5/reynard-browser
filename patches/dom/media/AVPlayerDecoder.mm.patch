+  if (NS_IsMainThread()) {
+    ReynardAVPlayerSendMetadata(aKey, aDurationSeconds, aWidth, aHeight);
+    return;
+  }
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "ReynardAVPlayerSendMetadata",
+      [aKey, aDurationSeconds, aWidth, aHeight]() {
+        ReynardAVPlayerSendMetadata(aKey, aDurationSeconds, aWidth, aHeight);
+      }));
+}
