+already_AddRefed<MediaDecoderStateMachineBase>
+AVPlayerDecoder::CreateStateMachine(bool aDisableExternalEngine) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  MediaFormatReaderInit init;
+  init.mVideoFrameContainer = GetVideoFrameContainer();
+  init.mKnowsCompositor = GetCompositor();
+  init.mCrashHelper = GetOwner()->CreateGMPCrashHelper();
+  init.mFrameStats = mFrameStats;
+  init.mMediaDecoderOwnerID = mOwner;
+
+  // Asked here because MediaFormatReader is about to ask the same
+  // question, and a "no" there is silent in a way that misreads.
+  //
+  // OnDemuxerInitDone rejects the metadata promise outright when
+  // PDMFactorySupport::IsTypeSupported comes back empty for the track's
+  // MIME type - "We have no decoder for this track. Error." That
+  // rejection prints neither MetadataLoaded nor FirstFrameLoaded, which
+  // is indistinguishable from the promise simply never resolving, and
+  // the two want opposite fixes: a rejection means the advertised type
+  // is wrong, while never resolving means the start-time path is.
+  //
+  // AVPlayerDemuxer advertises video/avc, and nothing decodes through
+  // Gecko here at all - the frames come from the AVPlayer - so this
+  // check existing at all is incidental to how the pipeline works. It
+  // still has to pass.
+  {
+    const bool avcSupported =
+        !PDMFactorySupport::IsTypeSupported("video/avc"_ns).isEmpty();
+    printf_stderr(
+        "avPlayer: PDM support for video/avc = %d%s\n", avcSupported ? 1 : 0,
+        avcSupported ? ""
+                     : " - MediaFormatReader WILL reject metadata for this");
+  }
+
+  mDemuxer = new AVPlayerDemuxer(kInitialDisplay);
+  mReader = new MediaFormatReader(init, mDemuxer);
+
+  // Both pointers feed MediaFormatReader's "videoActive" gate: a null
+  // container would turn OnDemuxerInitDone's video track down and reject
+  // metadata with "No active audio or video track" - silently, in
+  // release. The placeholder publishing proves the container exists on
+  // the decoder; this proves what the reader was actually handed.
+  printf_stderr("avPlayer: CreateStateMachine container=%d compositor=%d\n",
+                init.mVideoFrameContainer ? 1 : 0,
+                init.mKnowsCompositor ? 1 : 0);
+
+  return MakeAndAddRef<MediaDecoderStateMachine>(this, mReader);
+}
