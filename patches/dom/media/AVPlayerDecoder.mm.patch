+}  // namespace mozilla
+
+// Declared in GeckoViewSwiftSupport.h. Defined outside the namespace so
+// the symbol Swift links against is exactly this name.
+//
+// Hops to Gecko's main thread instead of trusting the caller's queue.
+// The Swift host dispatches on DispatchQueue.main, and in the parent
+// process that IS Gecko's main thread - but in a content process Gecko
+// runs its "MainThread" on a spawned thread, and the GCD main queue
+// drains on the extension's principal thread. Capture 16 proved the
+// difference the hard way: this callback ran and republished the
+// placeholder while Gecko's main thread sat frozen on an
+// EXC_BAD_ACCESS, which is only possible if they are different
+// threads. Every MOZ_ASSERT(NS_IsMainThread()) below this had been
+// violated on every callback, silently, in release. The registry
+// lookup, SetDuration, and the frame publish all touch main-thread-only
+// state, so the hop is the fix rather than the assertions.
+extern "C" MOZ_EXPORT void ReynardAVPlayerNotifyMetadata(
+    uintptr_t aPlayerId, double aDurationSeconds, int32_t aWidth,
+    int32_t aHeight) {
+  printf_stderr(
+      "avPlayer: metadata callback player=%llu geckoMain=%d - dispatching\n",
+      (unsigned long long)aPlayerId, NS_IsMainThread() ? 1 : 0);
+
+  // In a content process this can only have come from
+  // ContentChild::RecvAVPlayerMetadata; in the parent it is the Swift
+  // host, which the counter is not about.
+  if (XRE_IsContentProcess()) {
+    mozilla::sContentRecvMetadata++;
+  }
+
+  // A player some content process asked for. Everything below this
+  // point looks the decoder up in PlayersById, which in the parent is
+  // empty for a brokered player - that lookup failing is precisely why
+  // the app-process player played to nobody.
+  if (const uint64_t key = mozilla::BrokeredKeyFor(aPlayerId)) {
+    mozilla::ForwardMetadataToOwner(key, aDurationSeconds, aWidth, aHeight);
+    return;
+  }
+
+  // Straight into the playback registry, on the caller's thread: the
+  // demux task queue snapshots the registry in GetTrackDemuxer, and
+  // that read must not depend on the main-thread hop below having run.
+  mozilla::AVPlayerPlaybackRegistry::SetMetadata(
+      aPlayerId, aDurationSeconds, mozilla::gfx::IntSize(aWidth, aHeight));
+
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "ReynardAVPlayerNotifyMetadata",
+      [aPlayerId, aDurationSeconds, aWidth, aHeight]() {
+        MOZ_ASSERT(NS_IsMainThread());
+
+        auto& players = mozilla::PlayersById();
+        auto entry = players.find(aPlayerId);
+        if (entry == players.end()) {
+          // Routine during teardown rather than an error: the decoder
+          // erases itself before the player is destroyed, so a
+          // notification already in flight lands here and is dropped.
+          printf_stderr(
+              "avPlayer: metadata for unknown player %llu - ignored\n",
+              (unsigned long long)aPlayerId);
+          return;
+        }
+
+        // AVFoundation reports an indefinite or NaN duration for a live
+        // stream, and for any item that has not resolved one yet. Zero
+        // rather than a garbage TimeUnit - the element reads that as
+        // unknown, which is the truth.
+        const mozilla::media::TimeUnit duration =
+            (std::isfinite(aDurationSeconds) && aDurationSeconds > 0.0)
+                ? mozilla::media::TimeUnit::FromSeconds(aDurationSeconds)
+                : mozilla::media::TimeUnit::Zero();
+
+        printf_stderr(
+            "avPlayer: metadata player=%llu duration=%.3f size=%dx%d\n",
+            (unsigned long long)aPlayerId, aDurationSeconds, aWidth,
+            aHeight);
+
+        entry->second->NotifyMetadata(duration,
+                                      mozilla::gfx::IntSize(aWidth, aHeight));
+      }));
+}
+
+// Real frames, replacing the magenta placeholder as soon as the first
+// one lands.
+//
+// The placeholder proved the compositor path end to end - container,
+// two-plane surface, layer - but it is a synthetic fill. This publishes
+// what AVFoundation actually decoded, taken straight from the video
+// output's CVPixelBuffer.
+//
+// No pixels are copied. The buffer is IOSurface-backed by construction
+// (the Swift side creates the output with
+// kCVPixelBufferIOSurfacePropertiesKey), and an IOSurface is exactly
+// what MacIOSurfaceImage wraps, so the same surface AVFoundation
+// decoded into is handed to the compositor.
+extern "C" MOZ_EXPORT void ReynardAVPlayerNotifyFrame(
+    uintptr_t aPlayerId, CVPixelBufferRef aPixelBuffer) {
+  if (!aPixelBuffer) {
+    return;
+  }
+
+  IOSurfaceRef ioSurface = CVPixelBufferGetIOSurface(aPixelBuffer);
+  if (!ioSurface) {
+    // Only possible if the output was created without the IOSurface
+    // attribute. Logged once rather than per frame - at 30fps an
+    // unconditional printf here is its own outage.
+    static bool sWarnedNoIOSurface = false;
+    if (!sWarnedNoIOSurface) {
+      sWarnedNoIOSurface = true;
+      printf_stderr(
+          "avPlayer: frame has no IOSurface - dropping every frame\n");
+    }
+    return;
+  }
+
+  // A player some content process owns. The pixels stay in this
+  // process's address space and only the surface's id crosses - every
+  // one of these frames was decoded, handed over and dropped for want
+  // of a decoder until this line existed.
+  if (const uint64_t key = mozilla::BrokeredKeyFor(aPlayerId)) {
+    mozilla::ForwardFrameToOwner(key, aPlayerId, ioSurface);
+    return;
+  }
+
+  // Retained across the thread hop and adopted by the CFTypeRefPtr on
+  // the far side. The caller's buffer may be released the moment this
+  // returns, and the runnable outlives that.
+  CFRetain(ioSurface);
+
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "ReynardAVPlayerNotifyFrame", [aPlayerId, ioSurface]() {
+        MOZ_ASSERT(NS_IsMainThread());
+
+        // WrapUnderCreateRule: takes the reference added above rather
+        // than adding another, so the surface is released when this
+        // runnable finishes even on the early-return paths below.
+        auto surfaceRef =
+            CFTypeRefPtr<IOSurfaceRef>::WrapUnderCreateRule(ioSurface);
+
+        auto& players = mozilla::PlayersById();
+        auto entry = players.find(aPlayerId);
+        if (entry == players.end()) {
+          // Same teardown race as the metadata callback - the decoder
+          // erases itself before the player dies, so frames already in
+          // flight land here and are dropped.
+          return;
+        }
+
+        mozilla::VideoFrameContainer* container =
+            entry->second->GetVideoFrameContainer();
+        if (!container) {
+          return;
+        }
+
+        // BT.709 to match the placeholder and the overwhelming majority
+        // of streamed H.264/HEVC. A real implementation would read the
+        // colour attachments off the pixel buffer; getting that wrong
+        // shifts colour, it does not stop a frame appearing, so it is
+        // deliberately left for after the pipeline is proven.
+        RefPtr<MacIOSurface> macSurface = new MacIOSurface(
+            surfaceRef, mozilla::gfx::YUVColorSpace::BT709,
+            mozilla::gfx::TransferFunction::BT709,
+            MacIOSurface::AllowAlpha::No);
+
+        const mozilla::gfx::IntSize size(
+            static_cast<int32_t>(macSurface->GetDevicePixelWidth()),
+            static_cast<int32_t>(macSurface->GetDevicePixelHeight()));
+        if (size.width <= 0 || size.height <= 0) {
+          return;
+        }
+
+        // Logged once. The interesting question is whether a real frame
+        // ever replaces the placeholder at all; after that it is noise.
+        static bool sReportedFirstFrame = false;
+        if (!sReportedFirstFrame) {
+          sReportedFirstFrame = true;
+          printf_stderr(
+              "avPlayer: FIRST REAL FRAME player=%llu %dx%d planes=%u\n",
+              (unsigned long long)aPlayerId, size.width, size.height,
+              (unsigned)macSurface->GetPlaneCount());
+        }
+
+        // Latched before publishing, so a metadata callback that runs
+        // between this and the next frame cannot slip a placeholder in.
+        entry->second->mHasPublishedRealFrame = true;
+        entry->second->mSawRealFrameSincePoke = true;
+
+        RefPtr<mozilla::layers::Image> image =
+            new mozilla::layers::MacIOSurfaceImage(macSurface);
+        container->SetCurrentFrame(size, image, mozilla::TimeStamp::Now(),
+                                   mozilla::media::TimeUnit::Zero(),
+                                   mozilla::media::TimeUnit::Zero());
+        container->Invalidate();
+      }));
+}
+
+// The playback position, pushed by the Swift host. The HOT callback of
+// the family - the display link calls it at up to 120 Hz - so unlike
+// the metadata and frame callbacks it does NOT unconditionally hop to
+// Gecko's main thread. The write lands in AVPlayerPlaybackRegistry on
+// the caller's thread; UpdatePosition answers whether anything is
+// waiting on this position (a parked demux request, or the
+// once-a-second buffered-ranges refresh), and only then is a
+// main-thread runnable queued to poke the reader.
+extern "C" MOZ_EXPORT void ReynardAVPlayerNotifyTime(uintptr_t aPlayerId,
+                                                     double aSeconds) {
+  if (XRE_IsContentProcess()) {
+    mozilla::sContentRecvTime++;
+  }
+  if (const uint64_t key = mozilla::BrokeredKeyFor(aPlayerId)) {
+    // Bounded on the Swift side: pushTime drops anything within 10 ms
+    // of the last report, so this is at most ~100 async messages a
+    // second for a playing element, not one per display-link tick.
+    mozilla::ForwardTimeToOwner(key, aSeconds);
+    return;
+  }
+  if (!mozilla::AVPlayerPlaybackRegistry::UpdatePosition(aPlayerId,
+                                                         aSeconds)) {
+    return;
+  }
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "ReynardAVPlayerNotifyTime", [aPlayerId]() {
+        MOZ_ASSERT(NS_IsMainThread());
+        auto& players = mozilla::PlayersById();
+        auto entry = players.find(aPlayerId);
+        if (entry == players.end()) {
+          // Teardown race, same as the other callbacks: dropped.
+          return;
+        }
+        entry->second->NotifyPlaybackPoke();
+      }));
+}
+
+// Played to the end. Sets the registry's ended flag so the demuxer's
+// next sample request answers END_OF_STREAM - which is how the state
+// machine completes and the element fires "ended" at the stream's real
+// end, rather than at t=0 the way the end-of-stream stub did.
+// The app process watched its own video output go quiet while the clock
+// kept running, which is the only thing a native-HLS FairPlay stream
+// ever does to announce itself - Apple TV+ hands its key exchange to
+// AVFoundation and never touches EME, so mCDMProxy stays null while the
+// content is protected.
+//
+// The observation can only be made where the AVPlayer is, and the
+// decoder that has to act on it lives in the content process, so this
+// crosses exactly as the other player callbacks do.
+extern "C" MOZ_EXPORT void ReynardAVPlayerNotifyProtected(
+    uintptr_t aPlayerId) {
+  printf_stderr("avPlayer: protected callback player=%llu\n",
+                (unsigned long long)aPlayerId);
+  if (const uint64_t key = mozilla::BrokeredKeyFor(aPlayerId)) {
+    mozilla::ForwardProtectedToOwner(key);
+    return;
+  }
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "ReynardAVPlayerNotifyProtected", [aPlayerId]() {
+        MOZ_ASSERT(NS_IsMainThread());
+        auto& players = mozilla::PlayersById();
+        auto entry = players.find(aPlayerId);
+        if (entry == players.end()) {
+          // Teardown race, same as the other callbacks: dropped.
+          return;
+        }
+        entry->second->MarkProtectedByOutputStall();
+      }));
+}
+
+extern "C" MOZ_EXPORT void ReynardAVPlayerNotifyEnded(uintptr_t aPlayerId) {
+  printf_stderr("avPlayer: ended callback player=%llu\n",
+                (unsigned long long)aPlayerId);
+  if (const uint64_t key = mozilla::BrokeredKeyFor(aPlayerId)) {
+    mozilla::ForwardEndedToOwner(key);
+    return;
+  }
+  if (!mozilla::AVPlayerPlaybackRegistry::NotifyEnded(aPlayerId)) {
+    return;
+  }
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "ReynardAVPlayerNotifyEnded", [aPlayerId]() {
+        MOZ_ASSERT(NS_IsMainThread());
+        auto& players = mozilla::PlayersById();
+        auto entry = players.find(aPlayerId);
+        if (entry == players.end()) {
+          return;
+        }
+        entry->second->NotifyPlaybackPoke();
+      }));
+}
+
+// APP PROCESS: the asset wants a key nothing has claimed yet.
+//
+// AVFoundation raises this the moment the playlist reaches its
+// EXT-X-KEY, long before the page has built any EME object. It has to
+// reach the page as an 'encrypted' event, and only the content process
+// can fire one, so this crosses back.
+//
+// Main thread, unlike the position callback: the key session's
+// delegate queue is DispatchQueue.main, and in the APP process that is
+// Gecko's main thread. (In a content process it would not be - see
+// ReynardAVPlayerNotifyMetadata - but the key session is never in a
+// content process any more, which is the whole point of this round.)
+// Visibility written out rather than through MOZ_EXPORT. That macro is
+// defined to NOTHING by GeckoViewSwiftSupport.h's #else branch when
+// MOZILLA_CLIENT is unset, and a definition that silently loses its
+// visibility attribute under -fvisibility=hidden links as a LOCAL
+// symbol - `t`, not `T` - which is exactly what the device showed. An
+// attribute spelled out cannot expand to nothing.
+extern "C" __attribute__((visibility("default")))
+__attribute__((used)) void
+ReynardFairPlayNotifyEncrypted(
+    uintptr_t aPlayerId, const char* aInitDataType, const uint8_t* aInitData,
+    size_t aInitDataLength) {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsTArray<uint8_t> initData;
+  if (aInitData && aInitDataLength) {
+    initData.AppendElements(aInitData, aInitDataLength);
+  }
+  nsCString initDataType(aInitDataType ? aInitDataType : "");
+  printf_stderr("avPlayer: FairPlay encrypted player=%llu type=%s %zu bytes\n",
+                (unsigned long long)aPlayerId, initDataType.get(),
+                (size_t)initData.Length());
+  if (const uint64_t key = mozilla::BrokeredKeyFor(aPlayerId)) {
+    mozilla::ReynardFairPlaySendEncrypted(key, initDataType, initData);
+    return;
+  }
+  // Single process: the decoder is right here.
+  mozilla::ReynardAVPlayerDispatchEncrypted(
+      aPlayerId, std::move(initData), NS_ConvertUTF8toUTF16(initDataType));
+}
+
+// APP PROCESS: the SPC AVFoundation produced for a content id. Becomes
+// the EME session's 'message' event over in the content process, which
+// is what the page posts to its licence server.
+// Same reasoning as ReynardFairPlayNotifyEncrypted above.
+extern "C" __attribute__((visibility("default")))
+__attribute__((used)) void
+ReynardFairPlayNotifyKeyMessage(
+    uintptr_t aPlayerId, const char* aContentId, const uint8_t* aSpc,
+    size_t aSpcLength) {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsTArray<uint8_t> spc;
+  if (aSpc && aSpcLength) {
+    spc.AppendElements(aSpc, aSpcLength);
+  }
+  nsCString contentId(aContentId ? aContentId : "");
+  printf_stderr("avPlayer: FairPlay SPC player=%llu id=%s %zu bytes\n",
+                (unsigned long long)aPlayerId, contentId.get(),
+                (size_t)spc.Length());
+  if (const uint64_t key = mozilla::BrokeredKeyFor(aPlayerId)) {
+    mozilla::ReynardFairPlaySendKeyMessage(key, contentId, spc);
+    return;
+  }
+  mozilla::ReynardFairPlayDeliverKeyMessage(aPlayerId, contentId,
+                                            std::move(spc));
+}
+
+// APP PROCESS: the SPC a PARSER session produced, for a content process
+// that owns no player.
+//
+// ReynardFairPlayNotifyKeyMessage above cannot serve this one. It routes
+// by BrokeredKeyFor(aPlayerId), and the MSE route deliberately registers
+// no brokered player - "there is deliberately no entry" - so that lookup
+// answers 0 and the SPC has nowhere to go. This composes the same
+// composite key the REQUEST arrived under, (childID << 32) | 0, which is
+// the whole reason player id 0 is reserved for "no player".
+//
+// No single-process branch, unlike its sibling: a parser session only
+// exists because a content process asked for one, so there is always a
+// far end to send to.
+extern "C" __attribute__((visibility("default")))
+__attribute__((used)) void
+ReynardFairPlayNotifyParserKeyMessage(
+    uintptr_t aChildId, const char* aContentId, const uint8_t* aSpc,
+    size_t aSpcLength) {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsTArray<uint8_t> spc;
+  if (aSpc && aSpcLength) {
+    spc.AppendElements(aSpc, aSpcLength);
+  }
+  nsCString contentId(aContentId ? aContentId : "");
+  printf_stderr("avPlayer: FairPlay parser SPC child=%llu id=%s %zu bytes\n",
+                (unsigned long long)aChildId, contentId.get(),
+                (size_t)spc.Length());
+  mozilla::ReynardFairPlaySendKeyMessage(
+      static_cast<uint64_t>(aChildId) << 32, contentId, spc);
+}
+
+// The two functions above are called ONLY from Swift, and that is the
+// whole reason this array has to exist.
+//
+// libxul is linked and dead-stripped BEFORE AVPlayerHost.o is linked
+// against it. A symbol with no reference from inside libxul is not a
+// dead-strip root, so it does not survive to the point where Swift
+// asks for it. MOZ_EXPORT does not save it either: default visibility
+// marks a symbol exportable, not reachable.
+//
+// Every other Reynard* entry point in this file escapes by accident -
+// each is called by a ContentChild Recv* handler, which is a reference
+// from inside libxul. Grep those and you find two apiece; grep these
+// two and you find none. Without this array the app link fails with
+//
+//   Undefined symbols for architecture arm64:
+//     "_ReynardFairPlayNotifyEncrypted", referenced from:
+//         GeckoView.ContentKeyDelegate.contentKeySession(...)
+//             in AVPlayerHost.o
+//
+// which names the Swift caller and says nothing about the cause. It
+// compiles cleanly and nm finds the symbol in AVPlayerDecoder.o, so
+// every obvious check says the code is fine.
+//
+// __attribute__((used)) makes THIS array a dead-strip root - clang
+// emits .no_dead_strip for it on Mach-O - and the array references
+// both functions, so they become reachable and are kept. Local and
+// inert: no linker flag, no export list, nothing else in libxul
+// affected. Both functions share the signature (uintptr_t, const
+// char*, const uint8_t*, size_t), so one array type holds them with
+// no casts.
+//
+// ADD ANY FUTURE SWIFT-ONLY ENTRY POINT HERE.
+__attribute__((used)) static void (*const kReynardFairPlayLinkAnchor[])(
+    uintptr_t, const char*, const uint8_t*, size_t) = {
+    &ReynardFairPlayNotifyEncrypted,
+    &ReynardFairPlayNotifyKeyMessage,
+    &ReynardFairPlayNotifyParserKeyMessage,
+};
+
+// CONTENT PROCESS: the far end of ReynardAVPlayerSendFrame. A frame the
+// app process decoded, named by the global id of the surface holding
+// its pixels.
+//
+// The surface is turned back into a CVPixelBuffer and handed to the
+// ordinary frame path above rather than duplicating its colour,
+// container and first-frame handling: the two differ only in how the
+// surface was found, and BrokeredKeyFor answers 0 here, so that path
+// runs to completion instead of forwarding again.
+extern "C" MOZ_EXPORT void ReynardAVPlayerNotifyFrameSurface(
+    uintptr_t aPlayerId, uint32_t aSurfaceId) {
+  MOZ_ASSERT(NS_IsMainThread());
+  // Content-side by construction: nothing in the app process calls this.
+  mozilla::sContentRecvFrame++;
+  auto surface = CFTypeRefPtr<IOSurfaceRef>::WrapUnderCreateRule(
+      ::IOSurfaceLookup(static_cast<IOSurfaceID>(aSurfaceId)));
+  if (!surface) {
+    // The app process published a surface this process cannot reach,
+    // which means AVFoundation's pool did not honour IOSurfaceIsGlobal.
+    // Ask for copies into surfaces Gecko created, which always resolve.
+    //
+    // Bounded rather than sent per frame: if the copies cannot be found
+    // either then nothing can, and sixty messages a second would only
+    // make the log unreadable.
+    static uint32_t sFallbackRequests = 0;
+    if (sFallbackRequests < 8) {
+      sFallbackRequests++;
+      printf_stderr(
+          "avPlayer: IOSurfaceLookup FAILED for surface %u - asking the app "
+          "process to copy frames\n",
+          aSurfaceId);
+      if (mozilla::dom::ContentChild* cc =
+              mozilla::dom::ContentChild::GetSingleton()) {
+        cc->SendAVPlayerFrameFallback(static_cast<uint64_t>(aPlayerId));
+      }
+    }
+    return;
+  }
+
+  CVPixelBufferRef pixelBuffer = nullptr;
+  if (::CVPixelBufferCreateWithIOSurface(kCFAllocatorDefault, surface.get(),
+                                         nullptr, &pixelBuffer) !=
+          kCVReturnSuccess ||
+      !pixelBuffer) {
+    static bool sWarnedNoPixelBuffer = false;
+    if (!sWarnedNoPixelBuffer) {
+      sWarnedNoPixelBuffer = true;
+      printf_stderr(
+          "avPlayer: CVPixelBufferCreateWithIOSurface failed for surface %u\n",
+          aSurfaceId);
+    }
+    return;
+  }
+  ReynardAVPlayerNotifyFrame(aPlayerId, pixelBuffer);
+  ::CFRelease(pixelBuffer);
+}
+
+// CONTENT PROCESS: a frame that arrived as bytes.
+//
+// The surface is built HERE, with CreateBiPlanarSurface - the same call
+// the placeholder uses, and the placeholder is on screen, so this is a
+// compositor path already proven on the device. That is the whole point
+// of moving pixels instead of ids: a surface this process created needs
+// no lookup.
+//
+// Called straight from ContentChild::RecvAVPlayerFrameData with the
+// Shmem still mapped, so the copy must finish before returning.
+extern "C" MOZ_EXPORT void ReynardAVPlayerNotifyFrameData(
+    uintptr_t aPlayerId, const uint8_t* aY, uint32_t aYStride,
+    const uint8_t* aCbCr, uint32_t aCbCrStride, int32_t aWidth,
+    int32_t aHeight) {
+  MOZ_ASSERT(NS_IsMainThread());
+  mozilla::sContentRecvFrame++;
+
+  if (!aY || !aCbCr || aWidth <= 0 || aHeight <= 0) {
+    return;
+  }
+
+  auto& players = mozilla::PlayersById();
+  auto entry = players.find(aPlayerId);
+  if (entry == players.end()) {
+    // Teardown race, as everywhere else in this file: dropped.
+    return;
+  }
+  mozilla::VideoFrameContainer* container =
+      entry->second->GetVideoFrameContainer();
+  if (!container) {
+    return;
+  }
+
+  const mozilla::gfx::IntSize ySize(aWidth, aHeight);
+  const mozilla::gfx::IntSize cbcrSize((aWidth + 1) / 2, (aHeight + 1) / 2);
+  RefPtr<MacIOSurface> surface = MacIOSurface::CreateBiPlanarSurface(
+      ySize, cbcrSize, mozilla::gfx::ChromaSubsampling::HALF_WIDTH_AND_HEIGHT,
+      mozilla::gfx::YUVColorSpace::BT709,
+      mozilla::gfx::TransferFunction::BT709, mozilla::gfx::ColorRange::LIMITED,
+      mozilla::gfx::ColorDepth::COLOR_8, MacIOSurface::AllowAlpha::No);
+  if (!surface) {
+    static bool sWarnedCreate = false;
+    if (!sWarnedCreate) {
+      sWarnedCreate = true;
+      printf_stderr("avPlayer: CreateBiPlanarSurface failed for %dx%d\n",
+                    aWidth, aHeight);
+    }
+    return;
+  }
+  if (!surface->Lock(/* aReadOnly */ false)) {
+    return;
+  }
+
+  // Row by row again: the sender's strides and this surface's are set
+  // by different allocators.
+  const uint8_t* from[2] = {aY, aCbCr};
+  const uint32_t fromStride[2] = {aYStride, aCbCrStride};
+  for (size_t plane = 0; plane < 2; plane++) {
+    uint8_t* to = static_cast<uint8_t*>(surface->GetBaseAddressOfPlane(plane));
+    if (!to) {
+      continue;
+    }
+    const size_t toStride = surface->GetBytesPerRow(plane);
+    const size_t rowBytes =
+        fromStride[plane] < toStride ? fromStride[plane] : toStride;
+    const size_t rows = surface->GetDevicePixelHeight(plane);
+    for (size_t row = 0; row < rows; row++) {
+      memcpy(to + row * toStride, from[plane] + row * fromStride[plane],
+             rowBytes);
+    }
+  }
+  surface->Unlock(/* aReadOnly */ false);
+
+  static bool sReportedFirstFrame = false;
+  if (!sReportedFirstFrame) {
+    sReportedFirstFrame = true;
+    printf_stderr("avPlayer: FIRST REAL FRAME player=%llu %dx%d planes=%u\n",
+                  (unsigned long long)aPlayerId, aWidth, aHeight,
+                  (unsigned)surface->GetPlaneCount());
+  }
+
+  // Latched before publishing, so a metadata callback cannot slip a
+  // placeholder in over live video.
+  entry->second->mHasPublishedRealFrame = true;
+  entry->second->mSawRealFrameSincePoke = true;
+
+  RefPtr<mozilla::layers::Image> image =
+      new mozilla::layers::MacIOSurfaceImage(surface);
+  container->SetCurrentFrame(ySize, image, mozilla::TimeStamp::Now(),
+                             mozilla::media::TimeUnit::Zero(),
+                             mozilla::media::TimeUnit::Zero());
+  container->Invalidate();
+}
