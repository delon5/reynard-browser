+// Puts a layer on screen for AVFoundation's video.
+//
+// Nothing reaches the compositor otherwise: AVPlayerDemuxer answers
+// end-of-stream for every sample request, deliberately, so no VideoData
+// is ever produced and the page has no video layer at all. The frames
+// the user eventually sees come from the AVPlayer, not from here - this
+// only establishes a layer of the right size, in the right place in the
+// page, for NativeLayerCA to later host an AVPlayerLayer in.
+//
+// Pushed straight into the VideoFrameContainer rather than through the
+// demuxer/decoder pipeline. That pipeline expects real encoded samples
+// and a platform decoder to turn them into frames; there is no encoded
+// data here, because AVFoundation owns the decode end to end.
+//
+// The surface is deliberately blank NV12 - the same bi-planar format
+// IsEligiblePictureInPictureSurface already accepts - so the compositor
+// path handling it is the one video normally takes.
+void AVPlayerDecoder::PublishPlaceholderFrame(const gfx::IntSize& aDisplay) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  // Split out of one combined guard so a log line names the actual
+  // cause. Every return in this function used to be bare, which is why
+  // a device capture could show "avPlayer: created 1" followed by a
+  // blank screen with nothing in between to explain it - the Swift side
+  // proved the AVPlayer existed and said nothing about whether a frame
+  // was ever built.
+  VideoFrameContainer* container = GetVideoFrameContainer();
+  if (!container) {
+    printf_stderr(
+        "avPlayer: placeholder ABORTED - no VideoFrameContainer\n");
+    return;
+  }
+  if (aDisplay.width <= 0 || aDisplay.height <= 0) {
+    printf_stderr("avPlayer: placeholder ABORTED - display is %dx%d\n",
+                  aDisplay.width, aDisplay.height);
+    return;
+  }
+  printf_stderr("avPlayer: placeholder building %dx%d\n", aDisplay.width,
+                aDisplay.height);
+
+  // CreateBiPlanarSurface, not a hand-rolled IOSurfaceCreate.
+  //
+  // A surface built from width/height/format alone is NON-PLANAR:
+  // IOSurfaceGetPlaneCount returns 0. But MacIOSurfaceTextureHostOGL
+  // derives NV12 from the pixel format and then hard-requires exactly
+  // two planes - both PushResourceUpdates and PushDisplayItems bail on
+  // "mSurface->GetPlaneCount() != 2". NumSubTextures() says 2 from the
+  // format while the plane count is 0, so that branch always fires: no
+  // layer is pushed in release, and the GPU process asserts in debug.
+  // The whole point of this frame is to make a layer exist, so without
+  // the plane info it achieves nothing.
+  //
+  // This helper builds the plane dictionaries, offsets and alloc size,
+  // and takes the colour parameters directly - so the separate
+  // SetYUVColorSpace call afterwards is redundant and gone.
+  const gfx::IntSize chromaSize((aDisplay.width + 1) / 2,
+                                (aDisplay.height + 1) / 2);
+  RefPtr<MacIOSurface> macSurface = MacIOSurface::CreateBiPlanarSurface(
+      aDisplay, chromaSize, gfx::ChromaSubsampling::HALF_WIDTH_AND_HEIGHT,
+      gfx::YUVColorSpace::BT709, gfx::TransferFunction::BT709,
+      gfx::ColorRange::LIMITED, gfx::ColorDepth::COLOR_8,
+      MacIOSurface::AllowAlpha::No);
+  if (!macSurface) {
+    printf_stderr(
+        "avPlayer: placeholder ABORTED - CreateBiPlanarSurface failed\n");
+    return;
+  }
+
+  // Fresh IOSurface pages are zero-filled, and zeroed NV12 in
+  // video-range BT.709 (Y=0, CbCr=0) decodes to saturated GREEN, not
+  // black - which would be visible until an AVPlayerLayer replaces it.
+  // Black in 420v is Y=0x10, CbCr=0x80.
+  if (macSurface->Lock(/* aReadOnly */ false)) {
+    if (void* yPlane = macSurface->GetBaseAddressOfPlane(0)) {
+      memset(yPlane, 0x10,
+             macSurface->GetBytesPerRow(0) * macSurface->GetDevicePixelHeight(0));
+    }
+    if (void* cbcrPlane = macSurface->GetBaseAddressOfPlane(1)) {
+      memset(cbcrPlane, 0x80,
+             macSurface->GetBytesPerRow(1) * macSurface->GetDevicePixelHeight(1));
+    }
+    macSurface->Unlock(false);
+  } else {
+    // Not fatal - the frame is still published. But an unfilled
+    // surface is zeroed, and zeroed NV12 reads as saturated green, so
+    // a green rectangle on screen means exactly this line fired.
+    printf_stderr(
+        "avPlayer: placeholder Lock() FAILED - surface left unfilled\n");
+  }
+
+  RefPtr<layers::Image> image = new layers::MacIOSurfaceImage(macSurface);
+  // Five arguments: the trailing processing duration and media time
+  // are required by this signature. Zero for both - nothing was
+  // decoded to measure, and the AVPlayer owns the timeline.
+  container->SetCurrentFrame(aDisplay, image, TimeStamp::Now(),
+                             media::TimeUnit::Zero(),
+                             media::TimeUnit::Zero());
+  container->Invalidate();
+
+  // Plane count is the diagnostic that matters. MacIOSurfaceTextureHostOGL
+  // derives NV12 from the pixel format and then hard-requires exactly two
+  // planes; anything else and both PushResourceUpdates and
+  // PushDisplayItems bail, so no layer is pushed and the frame published
+  // here reaches nothing. A surface built without plane info reports 0,
+  // which is the bug this function was already fixed for once.
+  printf_stderr("avPlayer: placeholder PUBLISHED %dx%d planes=%u\n",
+                aDisplay.width, aDisplay.height,
+                (unsigned)macSurface->GetPlaneCount());
+}
+
+void AVPlayerDecoder::NotifyMetadata(const media::TimeUnit& aDuration,
+                                     const gfx::IntSize& aDisplay) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mDemuxer) {
+    mDemuxer->SetDuration(aDuration);
+  }
+
+  // Now that the asset's real dimensions are known, republish at the
+  // correct size - the initial frame used kInitialDisplay.
+  PublishPlaceholderFrame(aDisplay);
+}
