+// PARENT PROCESS: what this process is holding on behalf of one
+// brokered player's frames.
+//
+// mInFlight is the reason this exists at all. The Swift host releases
+// its CVPixelBuffer the moment the callback returns, and the message
+// naming the surface is asynchronous - so with nothing holding a
+// reference here, AVFoundation's pool can recycle the surface before
+// the content process has looked it up, and the element would show a
+// frame that is already being overwritten. Four deep is ~65 ms at 60
+// fps: far longer than an IPC hop, short enough that a paused player
+// is not sitting on the pool's whole allocation.
+//
+// mCopy is set when the content process reports a surface id it could
+// not resolve. See ReynardAVPlayerBrokerFrameFallback.
+static const size_t kFramesInFlight = 4;
+
+struct BrokeredFrames {
+  bool mCopy = false;
+  size_t mNext = 0;
+  RefPtr<MacIOSurface> mInFlight[kFramesInFlight];
+};
+
+// Callers hold sBrokeredKeysMutex.
+static std::unordered_map<uintptr_t, BrokeredFrames>& BrokeredFrameStates() {
+  static std::unordered_map<uintptr_t, BrokeredFrames> sBrokeredFrameStates;
+  return sBrokeredFrameStates;
+}
+
+// Called from dom/ipc/ContentParent.cpp when the content process could
+// not find a surface this one published. From here on that player's
+// frames are copied into surfaces Gecko created, which carry
+// kIOSurfaceIsGlobal by construction and therefore always resolve.
+void ReynardAVPlayerBrokerFrameFallback(uint64_t aKey) {
+  MOZ_ASSERT(NS_IsMainThread());
+  auto& players = BrokeredPlayers();
+  auto entry = players.find(aKey);
+  if (entry == players.end()) {
+    return;
+  }
+  StaticMutexAutoLock lock(sBrokeredKeysMutex);
+  BrokeredFrames& state = BrokeredFrameStates()[entry->second];
+  if (!state.mCopy) {
+    state.mCopy = true;
+    printf_stderr(
+        "avPlayer: content cannot look up our surfaces - copying frames for "
+        "host player %llu from here on\n",
+        (unsigned long long)entry->second);
+  }
+}
+
+// A copy of aSource into a surface THIS process created, which is what
+// makes it findable elsewhere: CreateBiPlanarSurface sets
+// kIOSurfaceIsGlobal, AVFoundation's pool only does so if asked and
+// might one day stop.
+//
+// NV12 only - two planes, which is what the video output is configured
+// for and what MacIOSurfaceTextureHostOGL requires at the other end.
+static already_AddRefed<MacIOSurface> CopyToGlobalSurface(
+    MacIOSurface* aSource) {
+  if (aSource->GetPlaneCount() != 2) {
+    return nullptr;
+  }
+  const gfx::IntSize ySize(
+      static_cast<int32_t>(aSource->GetDevicePixelWidth(0)),
+      static_cast<int32_t>(aSource->GetDevicePixelHeight(0)));
+  const gfx::IntSize cbcrSize(
+      static_cast<int32_t>(aSource->GetDevicePixelWidth(1)),
+      static_cast<int32_t>(aSource->GetDevicePixelHeight(1)));
+  RefPtr<MacIOSurface> copy = MacIOSurface::CreateBiPlanarSurface(
+      ySize, cbcrSize, gfx::ChromaSubsampling::HALF_WIDTH_AND_HEIGHT,
+      gfx::YUVColorSpace::BT709, gfx::TransferFunction::BT709,
+      gfx::ColorRange::LIMITED, gfx::ColorDepth::COLOR_8,
+      MacIOSurface::AllowAlpha::No);
+  if (!copy) {
+    return nullptr;
+  }
+  if (!aSource->Lock(/* aReadOnly */ true)) {
+    return nullptr;
+  }
+  if (!copy->Lock(/* aReadOnly */ false)) {
+    aSource->Unlock(/* aReadOnly */ true);
+    return nullptr;
+  }
+  for (size_t plane = 0; plane < 2; ++plane) {
+    const uint8_t* from =
+        static_cast<const uint8_t*>(aSource->GetBaseAddressOfPlane(plane));
+    uint8_t* to = static_cast<uint8_t*>(copy->GetBaseAddressOfPlane(plane));
+    if (!from || !to) {
+      continue;
+    }
+    // Row by row: the two allocators pad rows differently, so the
+    // strides are not the same number and a single memcpy would shear
+    // the picture.
+    const size_t fromStride = aSource->GetBytesPerRow(plane);
+    const size_t toStride = copy->GetBytesPerRow(plane);
+    const size_t rowBytes = fromStride < toStride ? fromStride : toStride;
+    const size_t fromRows = aSource->GetDevicePixelHeight(plane);
+    const size_t toRows = copy->GetDevicePixelHeight(plane);
+    const size_t rows = fromRows < toRows ? fromRows : toRows;
+    for (size_t row = 0; row < rows; ++row) {
+      memcpy(to + row * toStride, from + row * fromStride, rowBytes);
+    }
+  }
+  copy->Unlock(/* aReadOnly */ false);
+  aSource->Unlock(/* aReadOnly */ true);
+  return copy.forget();
+}
+
+// A decoded frame on its way to the content process that owns the
+// player. Only the surface's global id crosses; the pixels stay where
+// AVFoundation decoded them, or - in copy mode - where the copy above
+// put them.
+static void ForwardFrameToOwner(uint64_t aKey, uintptr_t aHostId,
+                                IOSurfaceRef aSurface) {
+  RefPtr<MacIOSurface> surface = new MacIOSurface(
+      CFTypeRefPtr<IOSurfaceRef>::WrapUnderGetRule(aSurface),
+      gfx::YUVColorSpace::BT709, gfx::TransferFunction::BT709,
+      MacIOSurface::AllowAlpha::No);
+
+  bool copyMode;
+  {
+    StaticMutexAutoLock lock(sBrokeredKeysMutex);
+    copyMode = BrokeredFrameStates()[aHostId].mCopy;
+  }
+  if (copyMode) {
+    RefPtr<MacIOSurface> copy = CopyToGlobalSurface(surface);
+    if (!copy) {
+      static bool sWarnedCopyFailed = false;
+      if (!sWarnedCopyFailed) {
+        sWarnedCopyFailed = true;
+        printf_stderr("avPlayer: frame copy FAILED - no video will appear\n");
+      }
+      return;
+    }
+    surface = std::move(copy);
+  }
+
+  const uint32_t surfaceId = static_cast<uint32_t>(surface->GetIOSurfaceID());
+  {
+    StaticMutexAutoLock lock(sBrokeredKeysMutex);
+    BrokeredFrames& state = BrokeredFrameStates()[aHostId];
+    state.mInFlight[state.mNext] = surface;
+    state.mNext = (state.mNext + 1) % kFramesInFlight;
+  }
+
+  // Once. This runs per frame.
+  static bool sReportedFirstFrameForward = false;
+  if (!sReportedFirstFrameForward) {
+    sReportedFirstFrameForward = true;
+    printf_stderr(
+        "avPlayer: forwarding frames for key %llu (first surface %u, copy=%d)\n",
+        (unsigned long long)aKey, surfaceId, copyMode ? 1 : 0);
+  }
+
+  // The pixels, not the id. IOSurfaceLookup resolves nothing across
+  // processes on iOS - not even the global copies above - so the far
+  // side cannot find a surface however it is named. The planes are read
+  // here and copied into a Shmem by ContentParent.
+  //
+  // The RefPtr rides the dispatch, so AVFoundation's pool cannot
+  // recycle the buffer while it is in flight; the lock and the read
+  // happen on the main thread, where the send has to be anyway.
+  auto sendPixels = [aKey, surface]() {
+    if (surface->GetPlaneCount() != 2) {
+      static bool sWarnedPlanes = false;
+      if (!sWarnedPlanes) {
+        sWarnedPlanes = true;
+        printf_stderr("avPlayer: frame is not two-plane NV12 - not sent\n");
+      }
+      return;
+    }
+    if (!surface->Lock(/* aReadOnly */ true)) {
+      return;
+    }
+    const uint8_t* y =
+        static_cast<const uint8_t*>(surface->GetBaseAddressOfPlane(0));
+    const uint8_t* cbcr =
+        static_cast<const uint8_t*>(surface->GetBaseAddressOfPlane(1));
+    // A null check is not enough, and a device crash proved it. On the
+    // first frame ever decoded here from PROTECTED content the base
+    // address came back as 0x200 - a plane offset where an address
+    // should be - and memcpy read from 512:
+    //
+    //   x1 = 0x200 (source)  x2 = 0x7e900 (518400 = 960 x 540)
+    //   far = 0x200  esr = byte READ translation fault
+    //
+    // A FairPlay-decrypted frame lives in memory the CPU may not read;
+    // that is what the protection IS. IOSurfaceLock still succeeds,
+    // there is simply no mapping, and the plane address is meaningless.
+    // Every clear frame this path has copied worked - including the
+    // same player at the same 960x540 before the stream was encrypted -
+    // so protection is the variable, not geometry.
+    //
+    // Nothing here can make such a frame copyable. AVFoundation has to
+    // own the whole path to the screen for protected content, which is
+    // what the AVPlayerLayer and its placeholder are for. This just
+    // declines to read memory that is not ours.
+    const uintptr_t kFirstPage = 0x1000;
+    const bool readable = reinterpret_cast<uintptr_t>(y) >= kFirstPage &&
+                          reinterpret_cast<uintptr_t>(cbcr) >= kFirstPage;
+    if (!readable) {
+      static bool sWarnedProtected = false;
+      if (!sWarnedProtected) {
+        sWarnedProtected = true;
+        printf_stderr(
+            "avPlayer: frame planes are not CPU-readable (y=%p cbcr=%p) - "
+            "protected content, leaving it to AVFoundation\n",
+            (void*)y, (void*)cbcr);
+      }
+      surface->Unlock(/* aReadOnly */ true);
+      return;
+    }
+    if (y && cbcr) {
+      ReynardAVPlayerSendFrameData(
+          aKey, y, (uint32_t)surface->GetBytesPerRow(0), cbcr,
+          (uint32_t)surface->GetBytesPerRow(1),
+          (int32_t)surface->GetDevicePixelWidth(0),
+          (int32_t)surface->GetDevicePixelHeight(0));
+    }
+    surface->Unlock(/* aReadOnly */ true);
+  };
+
+  if (NS_IsMainThread()) {
+    sendPixels();
+    return;
+  }
+  NS_DispatchToMainThread(
+      NS_NewRunnableFunction("ReynardAVPlayerSendFrameData", sendPixels));
+}
+
+// CONTENT PROCESS diagnostics.
+//
+// Counted in the notify functions when they run in a content process,
+// which is only ever from ContentChild's Recv handlers - in the parent
+// those same functions serve the Swift host instead. Written on the
+// main thread; read from the watchdog thread below, which is why they
+// are atomic. Relaxed is right: nothing is published through them, they
+// are only ever read as a number in a log line.
+static Atomic<uint32_t, Relaxed> sContentRecvMetadata(0);
+static Atomic<uint32_t, Relaxed> sContentRecvTime(0);
+static Atomic<uint32_t, Relaxed> sContentRecvFrame(0);
+
+static uintptr_t sContentAlivePlayerId = 0;
+static Atomic<uint32_t, Relaxed> sContentAliveTicks(0);
+static const uint32_t kContentAliveTicks = 60;
+
+// THE POINT OF THIS BUILD. A raw pthread: no event loop, no XPCOM, no
+// timer, no dispatch queue - nothing a wedged main thread or a stalled
+// Gecko queue can hold up. Every previous instrument was downstream of
+// the thing under test, which is why B3's silence was unreadable.
+//
+//   t advances, main stays 0 -> the process is alive and its MAIN
+//                               THREAD is wedged.
+//   nothing prints at all    -> the WHOLE PROCESS is frozen, which
+//                               Gecko cannot cause: that is the OS
+//                               suspending the extension.
+//   both advance             -> the main thread is fine and the
+//                               messages genuinely are not arriving.
+//
+// Twenty seconds and then it exits, so a long session is not spammed.
+// Recorded on Gecko's main thread, read from the watchdog thread. Set
+// once, before the watchdog exists, so no synchronisation is needed
+// beyond the ordering pthread_create itself provides.
+static pthread_t sContentMainThread;
+static bool sContentMainThreadKnown = false;
+
+static void ScheduleContentAliveTick();
+
+// Walks the MAIN thread's stack from this one.
+//
+// This is the only question left. If the thread is parked in
+// mach_msg / CFRunLoop / nsAppShell::Run then nothing is blocking it
+// and the wakeup that should follow a cross-thread dispatch is not
+// arriving - an event-loop bug in the port, not media. If it is sitting
+// in a lock, a sync IPC send, or an audio or graphics call, that frame
+// names the owner and the fix follows from it.
+//
+// Safe by construction: the thread is suspended for the walk, and every
+// frame is bounds-checked against the thread's real stack before it is
+// read, so a garbage frame pointer ends the walk instead of faulting.
+#if defined(__aarch64__)
+// One address, named as precisely as this process can name it.
+//
+// The OFFSET is the point. dladdr answers with the nearest EXPORTED
+// symbol at or below the address, and most of libxul is not exported -
+// so a small offset means the symbol really is the function, while a
+// large one means the pc is in some hidden function after it and the
+// name is only a signpost. The previous dump printed the name without
+// the offset, which is why "MediaDecoder::UpdateSameOriginStatus" could
+// not be taken at face value.
+static void DescribeAddress(const char* aLabel, uint64_t aAddr) {
+  const char* symbol = "?";
+  const char* image = "?";
+  uint64_t offset = 0;
+  Dl_info info;
+  if (aAddr && dladdr((const void*)aAddr, &info)) {
+    if (info.dli_sname) {
+      symbol = info.dli_sname;
+    }
+    if (info.dli_saddr) {
+      offset = aAddr - (uint64_t)info.dli_saddr;
+    }
+    if (info.dli_fname) {
+      const char* slash = strrchr(info.dli_fname, '/');
+      image = slash ? slash + 1 : info.dli_fname;
+    }
+  }
+  printf_stderr("avPlayer:   %-4s 0x%016llx  %s + %llu  (%s)\n", aLabel,
+                (unsigned long long)aAddr, symbol,
+                (unsigned long long)offset, image);
+}
+
+// Walks a frame-pointer chain and SAYS WHY IT STOPPED. The last dump
+// printed one frame and fell silent, which reads the same as "there is
+// nothing above" and as "the chain was unusable" - two very different
+// facts.
+static uint32_t WalkFrames(uint64_t aFp, const uint8_t* aStackBottom,
+                           const uint8_t* aStackTop, uint32_t aFirstIndex) {
+  uint64_t fp = aFp;
+  uint32_t printed = 0;
+  for (uint32_t frame = 0; frame < 24; frame++) {
+    const uint8_t* frameAddr = (const uint8_t*)fp;
+    if (!fp) {
+      printf_stderr("avPlayer:   (walk stopped: fp is null)\n");
+      break;
+    }
+    if (fp & 0xf) {
+      printf_stderr("avPlayer:   (walk stopped: fp 0x%016llx is misaligned)\n",
+                    (unsigned long long)fp);
+      break;
+    }
+    if (frameAddr < aStackBottom || frameAddr + 16 > aStackTop) {
+      printf_stderr(
+          "avPlayer:   (walk stopped: fp 0x%016llx is outside the stack "
+          "0x%016llx-0x%016llx)\n",
+          (unsigned long long)fp, (unsigned long long)(uintptr_t)aStackBottom,
+          (unsigned long long)(uintptr_t)aStackTop);
+      break;
+    }
+
+    // arm64 frame record: [fp] = caller's fp, [fp+8] = return address.
+    uint64_t record[2] = {0, 0};
+    memcpy(record, frameAddr, sizeof(record));
+
+    char label[8];
+    snprintf(label, sizeof(label), "#%02u", aFirstIndex + frame);
+    DescribeAddress(label, record[1]);
+    printed++;
+
+    if (record[0] <= fp) {
+      printf_stderr(
+          "avPlayer:   (walk stopped: fp did not increase: 0x%016llx -> "
+          "0x%016llx)\n",
+          (unsigned long long)fp, (unsigned long long)record[0]);
+      break;
+    }
+    fp = record[0];
+  }
+  return printed;
+}
+#endif
+
+static void DumpMainThreadStack() {
+#if defined(__aarch64__)
+  if (!sContentMainThreadKnown) {
+    printf_stderr("avPlayer: no main thread recorded - cannot unwind\n");
+    return;
+  }
+
+  const uint8_t* stackTop =
+      (const uint8_t*)pthread_get_stackaddr_np(sContentMainThread);
+  const size_t stackSize = pthread_get_stacksize_np(sContentMainThread);
+  const uint8_t* stackBottom = stackTop - stackSize;
+
+  mach_port_t machThread = pthread_mach_thread_np(sContentMainThread);
+  if (machThread == MACH_PORT_NULL) {
+    printf_stderr("avPlayer: no mach port for the main thread\n");
+    return;
+  }
+  if (thread_suspend(machThread) != KERN_SUCCESS) {
+    printf_stderr("avPlayer: thread_suspend failed - cannot unwind\n");
+    return;
+  }
+
+  arm_thread_state64_t state;
+  mach_msg_type_number_t stateCount = ARM_THREAD_STATE64_COUNT;
+  kern_return_t kr = thread_get_state(machThread, ARM_THREAD_STATE64,
+                                      (thread_state_t)&state, &stateCount);
+  if (kr != KERN_SUCCESS) {
+    printf_stderr("avPlayer: thread_get_state failed (%d)\n", (int)kr);
+    thread_resume(machThread);
+    return;
+  }
+
+  const uint64_t pc = (uint64_t)arm_thread_state64_get_pc(state);
+  const uint64_t lr = (uint64_t)arm_thread_state64_get_lr(state);
+  const uint64_t sp = (uint64_t)arm_thread_state64_get_sp(state);
+  const uint64_t fp = (uint64_t)arm_thread_state64_get_fp(state);
+
+  DescribeAddress("pc", pc);
+  DescribeAddress("lr", lr);
+  printf_stderr(
+      "avPlayer:   sp=0x%016llx fp=0x%016llx x0=0x%llx x1=0x%llx x2=0x%llx "
+      "x3=0x%llx\n",
+      (unsigned long long)sp, (unsigned long long)fp,
+      (unsigned long long)state.__x[0], (unsigned long long)state.__x[1],
+      (unsigned long long)state.__x[2], (unsigned long long)state.__x[3]);
+
+  // THE QUESTION. If the instruction under the pc is a brk then this
+  // thread trapped - an assertion or MOZ_CRASH - and something is
+  // holding it stopped rather than letting the process die, which is
+  // exactly what an attached debugger does. Anything else means the
+  // thread is genuinely executing, and lr says what called it.
+  //
+  // Read only after dladdr has confirmed the pc is inside a mapped
+  // image: a wedged process must not be turned into a crashed one by
+  // the thing measuring it.
+  Dl_info pcInfo;
+  if (pc && dladdr((const void*)pc, &pcInfo)) {
+    uint32_t insn = 0;
+    memcpy(&insn, (const void*)pc, sizeof(insn));
+    const bool isBrk = (insn & 0xffe0001f) == 0xd4200000;
+    printf_stderr("avPlayer:   insn@pc = 0x%08x%s\n", insn,
+                  isBrk ? "  <-- BRK: this thread TRAPPED (assertion or "
+                          "MOZ_CRASH) and is being held stopped"
+                        : "");
+  }
+
+  const uint32_t walked = WalkFrames(fp, stackBottom, stackTop, 1);
+  if (!walked) {
+    // No usable frame record - a trap, or a prologue that has not set
+    // fp up yet. lr is then the best caller we have, and it was printed
+    // above.
+    printf_stderr(
+        "avPlayer:   (no frames from fp; lr above is the likely caller)\n");
+  }
+
+  thread_resume(machThread);
+#else
+  printf_stderr("avPlayer: stack walk is arm64-only\n");
+#endif
+}
+
+static void* ContentWatchdogThread(void*) {
+  uint32_t lastMain = (uint32_t)sContentAliveTicks;
+  uint32_t stuckSeconds = 0;
+
+  for (uint32_t t = 1; t <= kContentAliveTicks; t++) {
+    sleep(1);
+    const uint32_t mainTicks = (uint32_t)sContentAliveTicks;
+    printf_stderr(
+        "avPlayer: content watchdog t=%u main=%u recv(meta=%u time=%u "
+        "frame=%u)\n",
+        t, mainTicks, (uint32_t)sContentRecvMetadata,
+        (uint32_t)sContentRecvTime, (uint32_t)sContentRecvFrame);
+
+    if (mainTicks == lastMain) {
+      stuckSeconds++;
+    } else {
+      stuckSeconds = 0;
+      lastMain = mainTicks;
+    }
+
+    // Twice: a stack that has not moved between 5 s and 30 s is stuck,
+    // one that has moved is making progress too slowly to tick.
+    if (stuckSeconds == 5 || stuckSeconds == 30) {
+      printf_stderr(
+          "avPlayer: MAIN THREAD WEDGED - no events for %us, unwinding it\n",
+          stuckSeconds);
+      DumpMainThreadStack();
+      printf_stderr("avPlayer: end of main thread stack\n");
+    }
+  }
+  printf_stderr("avPlayer: content watchdog finished\n");
+  return nullptr;
+}
+
+static void StartContentWatchdog() {
+  // Once per process. The question it answers is about the process, not
+  // the player, so a second load does not need a second thread.
+  static bool sWatchdogStarted = false;
+  if (sWatchdogStarted) {
+    return;
+  }
+  sWatchdogStarted = true;
+
+  pthread_t thread;
+  if (pthread_create(&thread, nullptr, ContentWatchdogThread, nullptr) != 0) {
+    printf_stderr("avPlayer: content watchdog FAILED to start\n");
+    return;
+  }
+  // Detached: nothing joins it, and it must not keep anything alive.
+  pthread_detach(thread);
+}
+
+// Called from ContentChild as the process comes up, and again from
+// Load(). Every content process reports, not only one that loaded a
+// video - if a plain page's main thread stops too, then media was only
+// the messenger and the bug is somewhere much more general.
+void ReynardStartContentWatchdog() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!XRE_IsContentProcess()) {
+    return;
+  }
+  static bool sArmed = false;
+  if (sArmed) {
+    return;
+  }
+  sArmed = true;
+
+  sContentMainThread = pthread_self();
+  sContentMainThreadKnown = true;
+  ScheduleContentAliveTick();
+  StartContentWatchdog();
+}
+
+static void ScheduleContentAliveTick();
+
+// Defined further down, after the broker; declared here because the
+// tick reports whether the decoder is still registered and this block
+// sits above it.
+static std::unordered_map<uintptr_t, AVPlayerDecoder*>& PlayersById();
+
+// The heartbeat. The app process is provably sending (B2c: owner=1
+// sent=1) and nothing arrives, which is either a content main thread
+// that stopped running its event queue or a delivery path that stopped
+// delivering. A line a second from inside that process separates the
+// two: if it keeps printing, the thread is fine and the messages are
+// not arriving; if it stops, the tick number says when the thread went.
+//
+// The registry values are printed beside the counters because they are
+// what the messages fill - so one line covers both "is anything
+// running" and "did anything arrive".
+static void ContentAliveTick() {
+  MOZ_ASSERT(NS_IsMainThread());
+  sContentAliveTicks++;
+
+  double position = -1.0;
+  double duration = -1.0;
+  if (Maybe<AVPlayerPlaybackRegistry::Snapshot> snapshot =
+          AVPlayerPlaybackRegistry::Get(sContentAlivePlayerId)) {
+    if (snapshot->mPosition.IsValid()) {
+      position = snapshot->mPosition.ToSeconds();
+    }
+    if (snapshot->mDuration.IsValid()) {
+      duration = snapshot->mDuration.ToSeconds();
+    }
+  }
+
+  printf_stderr(
+      "avPlayer: content alive tick=%u player=%llu recv(meta=%u time=%u "
+      "frame=%u) pos=%.3f dur=%.3f decoder=%d\n",
+      (uint32_t)sContentAliveTicks, (unsigned long long)sContentAlivePlayerId,
+      (uint32_t)sContentRecvMetadata, (uint32_t)sContentRecvTime,
+      (uint32_t)sContentRecvFrame, position, duration,
+      PlayersById().count(sContentAlivePlayerId) ? 1 : 0);
+
+  if (sContentAliveTicks < kContentAliveTicks) {
+    ScheduleContentAliveTick();
+  }
+}
+
+// Reschedules itself rather than holding an nsITimer: nsThreadUtils.h is
+// already here, there is no timer to keep alive or cancel, and it
+// disarms by simply not scheduling again.
+//
+// &ContentAliveTick, not ContentAliveTick. NS_NewRunnableFunction
+// deduces through a forwarding reference and stores
+// std::remove_reference_t<Function> as a data member, so a function
+// NAME - an lvalue of function type - deduces to void(&)(), strips to
+// void(), and a data member cannot have function type
+// ("data member instantiated with function type" out of
+// nsThreadUtils.h). The address is a plain void(*)(), which stores and
+// calls fine.
+static void ScheduleContentAliveTick() {
+  NS_DelayedDispatchToCurrentThread(
+      NS_NewRunnableFunction("ReynardAVPlayerContentAlive", &ContentAliveTick),
+      1000);
+}
+
+static void PushStoredAppCertificate(uint64_t aKey, NSUInteger aPlayerId);
+
+// Called by NativeLayerCA when it builds a layer for a DRM-marked
+// surface. Protected frames cannot be copied, so AVFoundation must own
+// the path to the screen and the player has to be bound to a layer that
+// is really in the view hierarchy.
+//
+// The compositor knows only that the surface was marked DRM - one bit,
+// no player id. It does not need one: this runs in the same process as
+// the host, so the host is asked which player is protected and the id
+// never crosses a boundary. That matters because 58fd2b0 established a
+// global IOSurface id does not resolve across processes on iOS at all.
+//
+// Hops to main because the compositor thread is where this is called
+// from, and both the host's state and a CALayer's player binding belong
+// on main. The layer is retained across the hop.
+void ReynardAVPlayerAttachLayer(void* aLayer) {
+  if (!aLayer) {
+    return;
+  }
+  id retained = [(id)aLayer retain];
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "ReynardAVPlayerAttachLayer", [retained]() {
+        id<GeckoAVPlayerHost> host = AVPlayerHost();
+        if (!host ||
+            ![host respondsToSelector:@selector(protectedPlayerId)] ||
+            ![host respondsToSelector:@selector(attachLayer:to:)]) {
+          printf_stderr("avPlayer: attachLayer - host cannot take a layer\n");
+          [retained release];
+          return;
+        }
+        // CHANGED - see fix_layer_attach_retries_on_licence.py's
+        // docstring. A 0 here used to end the story: the layer was
+        // released and no other was ever offered, because a republish
+        // at the same geometry and DRM mark does not rebuild one. But 0
+        // is the NORMAL answer at this point - the layer is built when
+        // the surface is first marked, which is MediaKeys construction,
+        // while the host learns which player is protected when the CKC
+        // lands, a licence round trip later.
+        //
+        // So hand the layer over either way. An id that names no player
+        // - 0 included; the host's ids start at 1 - means "hold this
+        // until a licence names one", which is what the host does with
+        // it. -protectedPlayerId's contract is unchanged; only what
+        // this side does with a 0 is.
+        NSUInteger playerId = [host protectedPlayerId];
+        [host attachLayer:(AVPlayerLayer*)retained to:playerId];
+        if (playerId) {
+          printf_stderr("avPlayer: attachLayer - bound layer to player %lu\n",
+                        (unsigned long)playerId);
+        } else {
+          printf_stderr("avPlayer: attachLayer - no protected player yet, "
+                        "layer left with the host to bind on licence\n");
+        }
+        // Balances the retain taken before the hop, on every path and
+        // exactly once, as it did before. Nothing extra is retained for
+        // the stash: -attachLayer:to: is synchronous and the host's own
+        // strong reference is in place before it returns, so ownership
+        // is continuous. A second retain here would leak one layer per
+        // title - nothing tells this side when the stash is drained.
+        [retained release];
+      }));
+}
+
+// The MSE counterpart of ReynardAVPlayerAttachLayer.
+//
+// Called by NativeLayerCA when the DRM-marked surface carries the tag
+// ReynardProtectedPlaceholderDecoder puts on it. There is no player on
+// this route and nothing for AVPlayerHost to bind: the picture is
+// produced by FairPlayStreamParser, which has been feeding an
+// AVSampleBufferDisplayLayer of its own in a hardcoded rectangle over
+// the page. This hands it the layer the compositor placed at the
+// element's own position instead.
+//
+// Reached by class name rather than through GeckoAVPlayerHost. The
+// parser is an @objc class in the same framework the host lives in and
+// is certainly loaded by the time a protected frame exists - it produced
+// the samples that made one - so one entry point costs a selector check
+// instead of a protocol, a header and an IPDL change. Failures are
+// reported rather than trapped, which is this route's rule everywhere
+// else it resolves something by name.
+//
+// Hops to main for the reason the player version does: a CALayer's tree
+// belongs there and the compositor thread is where this is called from.
+// The layer is retained across the hop.
+void ReynardMSEAttachLayer(void* aLayer) {
+  if (!aLayer) {
+    return;
+  }
+  id retained = [(id)aLayer retain];
+  NS_DispatchToMainThread(
+      NS_NewRunnableFunction("ReynardMSEAttachLayer", [retained]() {
+        id parser = (id)NSClassFromString(@"ReynardFairPlayStreamParser");
+        SEL selector = NSSelectorFromString(@"adoptCompositorLayer:");
+        bool takes = parser && [parser respondsToSelector:selector];
+        if (!takes) {
+          printf_stderr(
+              "mseLayer: cannot hand over the layer - class=%d selector=%d\n",
+              parser ? 1 : 0, takes ? 1 : 0);
+          [retained release];
+          return;
+        }
+        [parser performSelector:selector withObject:retained];
+        printf_stderr(
+            "mseLayer: handed the compositor's layer to the stream parser\n");
+        [retained release];
+      }));
+}
+
+void ReynardAVPlayerBrokerCreate(uint64_t aKey, const nsCString& aUrl) {
+  MOZ_ASSERT(NS_IsMainThread());
+  id<GeckoAVPlayerHost> host = AVPlayerHost();
+  if (!host) {
+    printf_stderr("avPlayer: broker has no host - cannot create key %llu\n",
+                  (unsigned long long)aKey);
+    return;
+  }
+  NSUInteger playerId = [host
+      createPlayerWithUrl:[NSString stringWithUTF8String:aUrl.get()]];
+  if (!playerId) {
+    printf_stderr("avPlayer: broker createPlayer FAILED for key %llu\n",
+                  (unsigned long long)aKey);
+    return;
+  }
+  BrokeredPlayers()[aKey] = static_cast<uintptr_t>(playerId);
+  {
+    // The reverse entry, written before the first callback can fire:
+    // the Swift side starts observing inside createPlayerWithUrl, so a
+    // metadata or position report can already be on its way.
+    StaticMutexAutoLock lock(sBrokeredKeysMutex);
+    BrokeredKeys()[static_cast<uintptr_t>(playerId)] = aKey;
+  }
+  printf_stderr(
+      "avPlayer: broker created host player %llu for key %llu (%s)\n",
+      (unsigned long long)playerId, (unsigned long long)aKey, aUrl.get());
+  // If this child already handed over a FairPlay certificate, the new
+  // player needs it before its asset reaches an EXT-X-KEY. Nothing
+  // orders createPlayer against setServerCertificate: a second
+  // protected element on a page that has already negotiated once
+  // arrives in exactly this order.
+  //
+  // Forward-declared: the definition sits below with the rest of the
+  // certificate store, and this is the only call above it.
+  PushStoredAppCertificate(aKey, playerId);
+}
+
+// The FairPlay application certificate, per CONTENT PROCESS.
+//
+// setServerCertificate lands on MediaKeys, which exists before any
+// element has a src, so there is no player to hang it on when it
+// arrives. Stored against the child id and pushed into every player
+// that child owns - including ones created later, which is why
+// ReynardAVPlayerBrokerCreate consults this too.
+//
+// Leaked deliberately, like BrokeredPlayers beside it: main-thread
+// only, and a static destructor running during shutdown would race
+// teardown for no benefit.
+static std::unordered_map<uint64_t, nsTArray<uint8_t>>& AppCertificates() {
+  static auto* certificates =
+      new std::unordered_map<uint64_t, nsTArray<uint8_t>>();
+  return *certificates;
+}
+
+static void PushAppCertificate(id<GeckoAVPlayerHost> aHost,
+                               NSUInteger aPlayerId,
+                               const nsTArray<uint8_t>& aCert) {
+  if (aCert.IsEmpty() ||
+      ![aHost respondsToSelector:@selector(setAppCertificate:forPlayer:)]) {
+    return;
+  }
+  [aHost setAppCertificate:[NSData dataWithBytes:aCert.Elements()
+                                          length:aCert.Length()]
+                 forPlayer:aPlayerId];
+}
+
+// Called from ReynardAVPlayerBrokerCreate, so a player created after
+// the page has already handed over its certificate starts with it.
+static void PushStoredAppCertificate(uint64_t aKey, NSUInteger aPlayerId) {
+  auto entry = AppCertificates().find(aKey >> 32);
+  if (entry == AppCertificates().end()) {
+    return;
+  }
+  id<GeckoAVPlayerHost> host = AVPlayerHost();
+  if (host) {
+    PushAppCertificate(host, aPlayerId, entry->second);
+  }
+}
+
+void ReynardAVPlayerBrokerSetAppCertificate(uint64_t aChildID,
+                                            const nsTArray<uint8_t>& aCert) {
+  MOZ_ASSERT(NS_IsMainThread());
+  AppCertificates()[aChildID] = aCert.Clone();
+  printf_stderr("avPlayer: FairPlay app certificate for child %llu, %zu bytes\n",
+                (unsigned long long)aChildID,
+                (size_t)aCert.Length());
+  id<GeckoAVPlayerHost> host = AVPlayerHost();
+  if (!host) {
+    return;
+  }
+  // Every player this child already owns. The certificate normally
+  // arrives after the first key request - the page cannot call
+  // setServerCertificate until it has handled the 'encrypted' event
+  // that request produced - and the host is holding those requests
+  // waiting for exactly this.
+  for (const auto& player : BrokeredPlayers()) {
+    if ((player.first >> 32) == aChildID) {
+      PushAppCertificate(host, static_cast<NSUInteger>(player.second),
+                         aCert);
+    }
+  }
+
+  // And this child's parser session, which owns no player and so
+  // matches nothing in the loop above. That omission is why MSE could
+  // never make an SPC: the certificate arrived, was stored, and was
+  // then offered only to players that do not exist on this path.
+  //
+  // Sent unconditionally rather than after checking for a session. The
+  // host holds it per child and applies it when the session is built,
+  // so arriving before the init data is as valid as arriving after -
+  // and the page is entitled to either order.
+  if ([host respondsToSelector:@selector(parserSetCertificate:certificate:)]) {
+    [host parserSetCertificate:static_cast<NSUInteger>(aChildID)
+                   certificate:[NSData dataWithBytes:aCert.Elements()
+                                              length:aCert.Length()]];
+  }
+}
+
+void ReynardAVPlayerBrokerGenerateKeyRequest(
+    uint64_t aKey, const nsCString& aContentId, const nsCString& aInitDataType,
+    const nsTArray<uint8_t>& aInitData) {
+  MOZ_ASSERT(NS_IsMainThread());
+  auto& players = BrokeredPlayers();
+  auto entry = players.find(aKey);
+  id<GeckoAVPlayerHost> host = AVPlayerHost();
+
+  // Player id 0 means "no player", and only MSE arrives that way:
+  // FairPlayCDMProxy sends sinf and cenc with the id still zero rather
+  // than parking them, because an MSE element never reaches
+  // AVPlayerDecoder and so nothing would ever flush the park.
+  //
+  // The child half of the composite key survives - AVPlayerBrokerKey is
+  // (childID << 32) | playerId - and that is the scope the parser
+  // session uses, matching how the app certificate is already delivered
+  // per child. No players.find here: there is deliberately no entry.
+  if ((aKey & 0xffffffff) == 0) {
+    // An fMP4 init segment the page appended, rather than EME init
+    // data. See fix_forward_init_segment_to_parser.py. Distinct
+    // because the two want opposite things of the host: this one is
+    // parsed and must NOT raise a direct key request, since the
+    // parser raising a specifier is the entire point of sending it.
+    if (aInitDataType.EqualsLiteral("initseg")) {
+      SEL parserSegment =
+          @selector(parserAppendMediaSegment:stream:segment:);
+      if (!host || ![host respondsToSelector:parserSegment]) {
+        printf_stderr(
+            "avPlayer: MSE init segment route unavailable for child "
+            "%llu\n", (unsigned long long)(aKey >> 32));
+        return;
+      }
+      printf_stderr(
+          "avPlayer: MSE segment child=%llu stream=%s %zu bytes\n",
+          (unsigned long long)(aKey >> 32), aContentId.get(),
+          (size_t)aInitData.Length());
+      [host parserAppendMediaSegment:static_cast<NSUInteger>(aKey >> 32)
+                              stream:[NSString
+                                         stringWithUTF8String:aContentId.get()]
+                             segment:[NSData
+                                         dataWithBytes:aInitData.Elements()
+                                                length:aInitData.Length()]];
+      return;
+    }
+    // The page removed that SourceBuffer, or dropped the MediaSource it
+    // lived on. Nothing will ever be appended to it again, and whatever
+    // the parser is still holding must stop being rendered.
+    //
+    // ADDED - see mse_fix_99's docstring. No session is built for a
+    // retire and none is looked up: if there is nothing under the key
+    // there is nothing to retire, which is the ordinary case for the
+    // capability-probe SourceBuffers a page never appends to.
+    if (aInitDataType.EqualsLiteral("retire")) {
+      SEL parserRetire = @selector(parserRetireStream:stream:);
+      if (!host || ![host respondsToSelector:parserRetire]) {
+        printf_stderr(
+            "avPlayer: MSE retire route unavailable for child %llu\n",
+            (unsigned long long)(aKey >> 32));
+        return;
+      }
+      printf_stderr("avPlayer: MSE retire child=%llu stream=%s\n",
+                    (unsigned long long)(aKey >> 32), aContentId.get());
+      [host parserRetireStream:static_cast<NSUInteger>(aKey >> 32)
+                        stream:[NSString
+                                   stringWithUTF8String:aContentId.get()]];
+      return;
+    }
+    // The element's play state, and its volume. Neither is key
+    // material; they ride this message because it is already routed
+    // per child and adding an IPDL message for two scalars would be a
+    // protocol change and a wide rebuild for nothing.
+    // The element the state belongs to, appended by the sender as
+    // ":<owner>". See mse_fix_101's docstring: this route carried one
+    // play state and one volume per CONTENT PROCESS, so tv.apple.com's
+    // feature element started the film's soundtrack while the film was
+    // still behind its own muted pre-roll.
+    //
+    // Absent on an older content process, which reads as owner 0 and
+    // falls back to the session-wide behaviour this had before.
+    nsCString mseValue(aContentId);
+    uint64_t mseOwner = 0;
+    int32_t mseColon = mseValue.FindChar(':');
+    if (mseColon >= 0) {
+      mseOwner = strtoull(mseValue.get() + mseColon + 1, nullptr, 10);
+      mseValue.Truncate(mseColon);
+    }
+    // Which element a SourceBuffer belongs to - "sb-<stream>:<owner>".
+    if (aInitDataType.EqualsLiteral("owner")) {
+      // FOUR PARTS, matching the call below.
+      //
+      // CHANGED - see mse_fix_104's docstring. Fix 103 added offset: to
+      // the call, the protocol and the Swift method and left this at
+      // three, so the host answered NO to a selector that no longer
+      // exists and every owner message took the branch below and
+      // returned. Eight sent, eight refused, none delivered - and with
+      // no owner the whole of 101, 102 and 103 fell back to behaviour
+      // they were written to replace.
+      SEL setOwner =
+          @selector(parserSetStreamOwner:stream:owner:offset:);
+      if (!host || ![host respondsToSelector:setOwner]) {
+        printf_stderr(
+            "avPlayer: MSE owner route unavailable for child %llu\n",
+            (unsigned long long)(aKey >> 32));
+        return;
+      }
+      printf_stderr("avPlayer: MSE owner child=%llu stream=%s -> %llu\n",
+                    (unsigned long long)(aKey >> 32), mseValue.get(),
+                    (unsigned long long)mseOwner);
+      // "sb-<stream>:<owner>:<offset>". mseValue/mseOwner above split
+      // at the FIRST colon, so mseOwner still carries the offset behind
+      // it and has to be split again - see mse_fix_103's docstring.
+      double mseOffset = 0.0;
+      nsCString mseTail(aContentId);
+      int32_t mseSecond = mseTail.RFindChar(':');
+      if (mseSecond > mseColon) {
+        mseOffset = strtod(mseTail.get() + mseSecond + 1, nullptr);
+        mseTail.Truncate(mseSecond);
+        mseOwner = strtoull(mseTail.get() + mseColon + 1, nullptr, 10);
+      }
+      [host parserSetStreamOwner:static_cast<NSUInteger>(aKey >> 32)
+                          stream:[NSString
+                                     stringWithUTF8String:mseValue.get()]
+                           owner:mseOwner
+                          offset:mseOffset];
+      return;
+    }
+    // Where the element is playing - see mse_fix_102's docstring.
+    if (aInitDataType.EqualsLiteral("position")) {
+      SEL setPosition = @selector(parserSetPosition:owner:seconds:);
+      if (!host || ![host respondsToSelector:setPosition]) {
+        return;
+      }
+      [host parserSetPosition:static_cast<NSUInteger>(aKey >> 32)
+                        owner:mseOwner
+                      seconds:strtod(mseValue.get(), nullptr)];
+      return;
+    }
+    if (aInitDataType.EqualsLiteral("playstate")) {
+      SEL setPlaying = @selector(parserSetPlaying:owner:playing:);
+      if (!host || ![host respondsToSelector:setPlaying]) {
+        printf_stderr(
+            "avPlayer: MSE play state route unavailable for child %llu\n",
+            (unsigned long long)(aKey >> 32));
+        return;
+      }
+      const bool playing = mseValue.EqualsLiteral("playing");
+      printf_stderr("avPlayer: MSE play state child=%llu element=%llu "
+                    "-> %s\n",
+                    (unsigned long long)(aKey >> 32),
+                    (unsigned long long)mseOwner,
+                    playing ? "playing" : "paused");
+      [host parserSetPlaying:static_cast<NSUInteger>(aKey >> 32)
+                       owner:mseOwner
+                     playing:playing];
+      return;
+    }
+    if (aInitDataType.EqualsLiteral("volume")) {
+      SEL setVolume = @selector(parserSetVolume:owner:volume:);
+      if (!host || ![host respondsToSelector:setVolume]) {
+        printf_stderr(
+            "avPlayer: MSE volume route unavailable for child %llu\n",
+            (unsigned long long)(aKey >> 32));
+        return;
+      }
+      const double volume = strtod(mseValue.get(), nullptr);
+      printf_stderr("avPlayer: MSE volume child=%llu element=%llu "
+                    "-> %.3f\n",
+                    (unsigned long long)(aKey >> 32),
+                    (unsigned long long)mseOwner, volume);
+      [host parserSetVolume:static_cast<NSUInteger>(aKey >> 32)
+                      owner:mseOwner
+                     volume:volume];
+      return;
+    }
+    SEL parserAppend = @selector(parserAppendInitData:contentId:initData:);
+    if (!host || ![host respondsToSelector:parserAppend]) {
+      printf_stderr(
+          "avPlayer: FairPlay parser route unavailable for child %llu\n",
+          (unsigned long long)(aKey >> 32));
+      return;
+    }
+    printf_stderr(
+        "avPlayer: FairPlay parser route child=%llu id=%s type=%s %zu bytes\n",
+        (unsigned long long)(aKey >> 32), aContentId.get(), aInitDataType.get(),
+        (size_t)aInitData.Length());
+    [host parserAppendInitData:static_cast<NSUInteger>(aKey >> 32)
+                     contentId:[NSString stringWithUTF8String:aContentId.get()]
+                      initData:[NSData dataWithBytes:aInitData.Elements()
+                                              length:aInitData.Length()]];
+    return;
+  }
+
+  if (entry == players.end() || !host ||
+      ![host respondsToSelector:@selector(generateKeyRequest:contentId:initDataType:initData:)]) {
+    return;
+  }
+  printf_stderr(
+      "avPlayer: FairPlay generateRequest key=%llu id=%s type=%s %zu bytes\n",
+      (unsigned long long)aKey, aContentId.get(), aInitDataType.get(),
+      (size_t)aInitData.Length());
+  [host generateKeyRequest:static_cast<NSUInteger>(entry->second)
+                 contentId:[NSString stringWithUTF8String:aContentId.get()]
+              initDataType:[NSString stringWithUTF8String:aInitDataType.get()]
+                  initData:[NSData dataWithBytes:aInitData.Elements()
+                                          length:aInitData.Length()]];
+}
+
+void ReynardAVPlayerBrokerKeyResponse(uint64_t aKey,
+                                      const nsCString& aContentId,
+                                      const nsTArray<uint8_t>& aResponse) {
+  MOZ_ASSERT(NS_IsMainThread());
+  auto& players = BrokeredPlayers();
+  auto entry = players.find(aKey);
+  id<GeckoAVPlayerHost> host = AVPlayerHost();
+
+  // Player id 0 is MSE, exactly as in GenerateKeyRequest above - and
+  // this is the counterpart that was never written. Without it
+  // players.find misses every time (a child's player ids start at 1, so
+  // a key whose low half is zero can never be registered), the function
+  // returns with no log at all, and the licence the page went and
+  // fetched is dropped on the floor one step from being applied.
+  if ((aKey & 0xffffffff) == 0) {
+    SEL parserResponse =
+        @selector(parserProvideKeyResponse:contentId:response:);
+    if (!host || ![host respondsToSelector:parserResponse]) {
+      printf_stderr(
+          "avPlayer: FairPlay parser CKC route unavailable for child %llu\n",
+          (unsigned long long)(aKey >> 32));
+      return;
+    }
+    printf_stderr(
+        "avPlayer: FairPlay parser CKC child=%llu id=%s %zu bytes\n",
+        (unsigned long long)(aKey >> 32), aContentId.get(),
+        (size_t)aResponse.Length());
+    [host parserProvideKeyResponse:static_cast<NSUInteger>(aKey >> 32)
+                         contentId:[NSString stringWithUTF8String:aContentId
+                                                                      .get()]
+                          response:[NSData dataWithBytes:aResponse.Elements()
+                                                  length:aResponse.Length()]];
+    return;
+  }
+
+  if (entry == players.end() || !host ||
+      ![host respondsToSelector:@selector(provideKeyResponse:contentId:response:)]) {
+    return;
+  }
+  printf_stderr("avPlayer: FairPlay CKC key=%llu id=%s %zu bytes\n",
+                (unsigned long long)aKey, aContentId.get(),
+                (size_t)aResponse.Length());
+  [host provideKeyResponse:static_cast<NSUInteger>(entry->second)
+                 contentId:[NSString stringWithUTF8String:aContentId.get()]
+                  response:[NSData dataWithBytes:aResponse.Elements()
+                                          length:aResponse.Length()]];
+}
+
+void ReynardAVPlayerBrokerControl(uint64_t aKey, uint32_t aOp, double aArg) {
+  MOZ_ASSERT(NS_IsMainThread());
+  auto& players = BrokeredPlayers();
+  auto entry = players.find(aKey);
+  if (entry == players.end()) {
+    // Create failed, or the control raced teardown. Dropped, like every
+    // other unknown-id path here.
+    return;
+  }
+  const NSUInteger playerId = static_cast<NSUInteger>(entry->second);
+  id<GeckoAVPlayerHost> host = AVPlayerHost();
+  if (!host) {
+    return;
+  }
+  printf_stderr("avPlayer: broker op=%u player=%llu\n", aOp,
+                (unsigned long long)playerId);
+  switch (aOp) {
+    case kAVPlayerPlay:
+      [host play:playerId];
+      break;
+    case kAVPlayerPause:
+      [host pause:playerId];
+      break;
+    case kAVPlayerSuspend:
+      [host suspend:playerId];
+      break;
+    case kAVPlayerResume:
+      [host resume:playerId];
+      break;
+    case kAVPlayerSeek:
+      [host seek:playerId to:aArg];
+      break;
+    case kAVPlayerVolume:
+      [host setVolume:playerId to:aArg];
+      break;
+    case kAVPlayerDestroy:
+      [host destroy:playerId];
+      players.erase(entry);
+      {
+        StaticMutexAutoLock lock(sBrokeredKeysMutex);
+        BrokeredKeys().erase(playerId);
+        // Releases whatever frames were still held for the far side.
+        BrokeredFrameStates().erase(playerId);
+      }
+      break;
+    default:
+      break;
+  }
+}
+
+// Every control the decoder issues, routed to whichever process owns
+// the player: straight to the host in the parent, over PContent from a
+// content process.
+static void ControlPlayer(uintptr_t aPlayerId, uint32_t aOp,
+                          double aArg = 0.0) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!aPlayerId) {
+    return;
+  }
+  if (XRE_IsContentProcess()) {
+    if (dom::ContentChild* cc = dom::ContentChild::GetSingleton()) {
+      cc->SendAVPlayerControl(static_cast<uint64_t>(aPlayerId), aOp, aArg);
+    }
+    return;
+  }
+  id<GeckoAVPlayerHost> host = AVPlayerHost();
+  if (!host) {
+    return;
+  }
+  const NSUInteger playerId = static_cast<NSUInteger>(aPlayerId);
+  switch (aOp) {
+    case kAVPlayerPlay:
+      [host play:playerId];
+      break;
+    case kAVPlayerPause:
+      [host pause:playerId];
+      break;
+    case kAVPlayerSuspend:
+      [host suspend:playerId];
+      break;
+    case kAVPlayerResume:
+      [host resume:playerId];
+      break;
+    case kAVPlayerSeek:
+      [host seek:playerId to:aArg];
+      break;
+    case kAVPlayerVolume:
+      [host setVolume:playerId to:aArg];
+      break;
+    case kAVPlayerDestroy:
+      [host destroy:playerId];
+      break;
+    default:
+      break;
+  }
+}
+
+// Live decoders by the player handle the Swift host handed back.
+//
+// The metadata callback arrives as a C symbol carrying only that handle
+// (AVPlayerDecoder.h is included from plain C++ and cannot hold an
+// Obj-C delegate), so it is resolved here rather than by passing a raw
+// decoder pointer through Swift and hoping it is still alive. An entry
+// is removed before the player is destroyed, so a KVO notification
+// already queued on the main thread finds nothing and is dropped
+// instead of dereferencing a freed decoder.
+//
+// Main thread only, which is what makes it safe without a lock: Load,
+// Shutdown, the destructor and the callback all run there.
+static std::unordered_map<uintptr_t, AVPlayerDecoder*>& PlayersById() {
+  MOZ_ASSERT(NS_IsMainThread());
+  static std::unordered_map<uintptr_t, AVPlayerDecoder*> sPlayersById;
+  return sPlayersById;
+}
+
+AVPlayerDecoder::AVPlayerDecoder(MediaDecoderInit& aInit)
+    : MediaDecoder(aInit) {}
+
+AVPlayerDecoder::~AVPlayerDecoder() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mPlayerId) {
+    // Erased first: destroy tears down the KVO observations, but one
+    // may already be queued on this thread, and it must not find us.
+    PlayersById().erase(mPlayerId);
+    ControlPlayer(mPlayerId, kAVPlayerDestroy);
+    // Registry last - see Shutdown for the ordering argument.
+    AVPlayerPlaybackRegistry::Unregister(mPlayerId);
+    mPlayerId = 0;
+  }
+}
