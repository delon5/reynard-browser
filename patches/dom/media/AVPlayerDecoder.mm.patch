+}
+
+// Pairs this decoder's proxy with this decoder's player, so the keys
+// land on the session the asset is registered against. Safe to call
+// twice and in either order - the proxy publishes only once both halves
+// are known, and BindToPlayer ignores a repeat of the same id.
+void AVPlayerDecoder::BindCDMProxyToPlayer() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mCDMProxy || !mPlayerId) {
+    return;
+  }
+  // Only FairPlay reaches AVFoundation, and MediaKeys creates exactly
+  // one proxy type for that key system, so the key system is a sound
+  // discriminator - CDMProxy has no As* hook to use instead.
+  if (!IsFairPlayKeySystem(mCDMProxy->KeySystem())) {
+    return;
+  }
+  static_cast<FairPlayCDMProxy*>(mCDMProxy.get())->BindToPlayer(mPlayerId);
+}
+
+void AVPlayerDecoder::NotifyPlaybackPoke() {
+  MOZ_ASSERT(NS_IsMainThread());
+  // The poke runnable can land between Shutdown() and destruction - it
+  // was already in flight when the registry entry died - and
+  // NotifyReaderDataArrived diagnostic-asserts on a shut-down decoder.
+  if (IsShutdown()) {
+    return;
+  }
+  // Re-issues any demux request a WAITING_FOR_DATA rejection parked,
+  // and refreshes the reader's buffered ranges - the same call
+  // MediaSourceDecoder::NotifyDataArrived makes when a SourceBuffer
+  // gains data. The demuxer is what was waiting; the reader owns the
+  // machinery for asking it again.
+  NotifyReaderDataArrived();
+}
+
+// Native HLS FairPlay never touches EME. Apple TV+ hands the whole key
+// exchange to AVFoundation through its AVContentKeySession, so a capture
+// shows "emeAccess: GRANTED" and then no setMediaKeys, no key request
+// and no SPC at all - mCDMProxy stays null, and the one signal this
+// pipeline used to decide a stream was protected never fires.
+//
+// The stream is protected all the same, and AVPlayerItemVideoOutput
+// will not vend pixel buffers for it. The observable state is exactly
+// that: the player is playing and its position keeps advancing, while
+// no frame arrives. Prime announces itself through EME and never gets
+// here; a site that decrypts inside AVFoundation only ever says so by
+// going quiet.
+//
+// Measured in stream position rather than wall clock deliberately. A
+// paused or rebuffering player does not advance its position, so
+// neither can produce this, and no timer is needed to tell them apart.
+void AVPlayerDecoder::MarkProtectedByOutputStall() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mOutputStallProtected || IsShutdown()) {
+    return;
+  }
+  mOutputStallProtected = true;
+  printf_stderr("avPlayer: marking player %llu protected - output stalled\n",
+                (unsigned long long)mPlayerId);
+  // Nothing to republish if no placeholder was ever built; the next
+  // publish carries the mark instead.
+  if (!mLastPlaceholderSize.IsEmpty()) {
+    PublishPlaceholderFrame(mLastPlaceholderSize);
+  }
+}
+
+void AVPlayerDecoder::DispatchEncryptedFromKeySession(
+    nsTArray<uint8_t>&& aInitData, const nsAString& aInitDataType) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (IsShutdown()) {
+    return;
+  }
+  MediaDecoderOwner* owner = GetOwner();
+  if (!owner) {
+    return;
+  }
+  printf_stderr("avPlayer: dispatching 'encrypted' (%s, %zu bytes)\n",
+                NS_ConvertUTF16toUTF8(aInitDataType).get(),
+                (size_t)aInitData.Length());
+  // Queued by the element itself until HAVE_METADATA if it lands early.
+  owner->DispatchEncrypted(aInitData, aInitDataType);
+}
+
+// Puts a layer on screen for AVFoundation's video.
+//
+// Nothing reaches the compositor through the decode pipeline: the
+// samples AVPlayerDemuxer produces carry timing only, and
+// ReynardAVPlayerDecoderModule turns them into image-less VideoData,
+// so the video sink advances the clock without ever publishing a
+// picture. The frames the user eventually sees come from the AVPlayer,
+// not from here - this only establishes a layer of the right size, in
+// the right place in the page, for NativeLayerCA to later host an
+// AVPlayerLayer in.
+//
+// Pushed straight into the VideoFrameContainer rather than through the
+// demuxer/decoder pipeline, which by design carries no pixels here -
+// AVFoundation owns the decode end to end.
+//
+// The surface is deliberately blank NV12 - the same bi-planar format
+// IsEligiblePictureInPictureSurface already accepts - so the compositor
+// path handling it is the one video normally takes.
+void AVPlayerDecoder::PublishPlaceholderFrame(const gfx::IntSize& aDisplay) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  // Split out of one combined guard so a log line names the actual
+  // cause. Every return in this function used to be bare, which is why
+  // a device capture could show "avPlayer: created 1" followed by a
+  // blank screen with nothing in between to explain it - the Swift side
+  // proved the AVPlayer existed and said nothing about whether a frame
+  // was ever built.
+  // Never paint over real video. NotifyMetadata republishes the
+  // placeholder once the asset's true size is known, and on a stream
+  // whose metadata resolves after playback has begun that landed on top
+  // of frames already being decoded - a flash of picture, then magenta.
+  //
+  // Unless the output has since stalled in the way only protected
+  // content stalls. Apple TV+ delivers ONE copyable frame from a clear
+  // lead-in segment and then nothing, which set this latch and
+  // suppressed the very republish that carries the DRM mark - so the
+  // compositor kept an AVSampleBufferDisplayLayer waiting for frames
+  // that can never arrive. Audio played over a black picture.
+  //
+  // Allowed through once, and only towards protected: clear video never
+  // sets mOutputStallProtected, so the flash-then-magenta case this
+  // guard exists for cannot come back, and
+  // mHasPublishedProtectedPlaceholder caps it at one republish.
+  const bool republishForProtection =
+      mOutputStallProtected && !mHasPublishedProtectedPlaceholder;
+  if (mHasPublishedRealFrame && !republishForProtection) {
+    printf_stderr(
+        "avPlayer: placeholder SKIPPED - real frames are already flowing\n");
+    return;
+  }
+  if (republishForProtection) {
+    printf_stderr(
+        "avPlayer: placeholder republished to mark a stalled output DRM\n");
+  }
+
+  // Protected content never sets mHasPublishedRealFrame, because the
+  // frames cannot be copied - so that latch above never fires here and
+  // every metadata callback republished, rebuilding the layer each time.
+  //
+  // Each publish carries the DRM mark, and NativeLayerCA rebuilds the
+  // content layer whenever that mark changes. A capture showed the cost:
+  // five layer constructions across one session, each tearing down the
+  // AVPlayerLayer and rebinding the player, which is visible as the
+  // picture dropping back to loading.
+  //
+  // Two guards. Once this decoder has published a protected placeholder
+  // it must never publish an unprotected one again - that direction is
+  // always a regression, and it is what turns a settled AVPlayerLayer
+  // back into an AVSampleBufferDisplayLayer. And a republish at the same
+  // geometry and the same mark changes nothing the compositor needs, so
+  // it only costs a rebuild.
+  const bool isProtectedNow = !!mCDMProxy || mOutputStallProtected;
+  if (mHasPublishedProtectedPlaceholder && !isProtectedNow) {
+    printf_stderr(
+        "avPlayer: placeholder SKIPPED - would unmark a protected layer\n");
+    return;
+  }
+  if (mLastPlaceholderSize == aDisplay &&
+      mLastPlaceholderWasProtected == isProtectedNow) {
+    printf_stderr(
+        "avPlayer: placeholder SKIPPED - same %dx%d and same DRM=%d\n",
+        aDisplay.width, aDisplay.height, isProtectedNow ? 1 : 0);
+    return;
+  }
+
+  VideoFrameContainer* container = GetVideoFrameContainer();
+  if (!container) {
+    printf_stderr(
+        "avPlayer: placeholder ABORTED - no VideoFrameContainer\n");
+    return;
+  }
+  if (aDisplay.width <= 0 || aDisplay.height <= 0) {
+    printf_stderr("avPlayer: placeholder ABORTED - display is %dx%d\n",
+                  aDisplay.width, aDisplay.height);
+    return;
+  }
+  printf_stderr("avPlayer: placeholder building %dx%d\n", aDisplay.width,
+                aDisplay.height);
+
+  // CreateBiPlanarSurface, not a hand-rolled IOSurfaceCreate.
+  //
+  // A surface built from width/height/format alone is NON-PLANAR:
+  // IOSurfaceGetPlaneCount returns 0. But MacIOSurfaceTextureHostOGL
+  // derives NV12 from the pixel format and then hard-requires exactly
+  // two planes - both PushResourceUpdates and PushDisplayItems bail on
+  // "mSurface->GetPlaneCount() != 2". NumSubTextures() says 2 from the
+  // format while the plane count is 0, so that branch always fires: no
+  // layer is pushed in release, and the GPU process asserts in debug.
+  // The whole point of this frame is to make a layer exist, so without
+  // the plane info it achieves nothing.
+  //
+  // This helper builds the plane dictionaries, offsets and alloc size,
+  // and takes the colour parameters directly - so the separate
+  // SetYUVColorSpace call afterwards is redundant and gone.
+  const gfx::IntSize chromaSize((aDisplay.width + 1) / 2,
+                                (aDisplay.height + 1) / 2);
+  RefPtr<MacIOSurface> macSurface = MacIOSurface::CreateBiPlanarSurface(
+      aDisplay, chromaSize, gfx::ChromaSubsampling::HALF_WIDTH_AND_HEIGHT,
+      gfx::YUVColorSpace::BT709, gfx::TransferFunction::BT709,
+      gfx::ColorRange::LIMITED, gfx::ColorDepth::COLOR_8,
+      MacIOSurface::AllowAlpha::No);
+  if (!macSurface) {
+    printf_stderr(
+        "avPlayer: placeholder ABORTED - CreateBiPlanarSurface failed\n");
+    return;
+  }
+
+  // Fresh IOSurface pages are zero-filled, and zeroed NV12 in
+  // video-range BT.709 (Y=0, CbCr=0) decodes to saturated GREEN, not
+  // black - so the surface is filled to true black: Y=0x10 with
+  // CbCr=0x80 in 420v limited range. Both planes are uniform, so two
+  // memsets do it. (The magenta diagnostic fill this replaces served
+  // its purpose - the compositor path is proven end to end. Green on
+  // screen still means the Lock() failure below: an unfilled surface.)
+  if (macSurface->Lock(/* aReadOnly */ false)) {
+    if (void* yPlane = macSurface->GetBaseAddressOfPlane(0)) {
+      memset(yPlane, 0x10,
+             macSurface->GetBytesPerRow(0) * macSurface->GetDevicePixelHeight(0));
+    }
+    if (void* cbcrPlane = macSurface->GetBaseAddressOfPlane(1)) {
+      memset(cbcrPlane, 0x80,
+             macSurface->GetBytesPerRow(1) * macSurface->GetDevicePixelHeight(1));
+    }
+    macSurface->Unlock(false);
+  } else {
+    // Not fatal - the frame is still published. But an unfilled
+    // surface is zeroed, and zeroed NV12 reads as saturated green, so
+    // a green rectangle on screen means exactly this line fired.
+    printf_stderr(
+        "avPlayer: placeholder Lock() FAILED - surface left unfilled\n");
+  }
+
+  RefPtr<layers::Image> image = new layers::MacIOSurfaceImage(macSurface);
+
+  // STEP 1 of the AVPlayerLayer plan - prove the content->compositor
+  // channel before any layer code exists.
+  //
+  // For protected content the parent declines the pixel copy (the
+  // planes are not CPU-readable), so no AVPlayerFrameData is sent and
+  // THIS placeholder is the layer on screen. Marking it DRM travels a
+  // route that already exists end to end and needs no protocol change:
+  //
+  //   Image::SetIsDRM          ImageContainer.h
+  //   -> TextureFlags::DRM_SOURCE   MacIOSurfaceImage.cpp
+  //   -> NativeLayerCA::mIsDRM      NativeLayerCA.mm
+  //   -> forwarded remotely         NativeLayerRootRemoteMacParent.mm
+  //
+  // Gated on the CDM proxy so clear video keeps today's path entirely -
+  // mIsDRM forces a specialized video layer, and forcing that for every
+  // video would be a large change disguised as a diagnostic.
+  const bool isProtected = !!mCDMProxy || mOutputStallProtected;
+  image->SetIsDRM(isProtected);
+  mHasPublishedProtectedPlaceholder |= isProtected;
+  mLastPlaceholderSize = aDisplay;
+  mLastPlaceholderWasProtected = isProtected;
+  printf_stderr("avPlayer: placeholder image DRM=%d (cdmProxy=%d stall=%d)\n",
+                isProtected ? 1 : 0, mCDMProxy ? 1 : 0,
+                mOutputStallProtected ? 1 : 0);
+  // Five arguments: the trailing processing duration and media time
+  // are required by this signature. Zero for both - nothing was
+  // decoded to measure, and the AVPlayer owns the timeline.
+  container->SetCurrentFrame(aDisplay, image, TimeStamp::Now(),
+                             media::TimeUnit::Zero(),
+                             media::TimeUnit::Zero());
+  container->Invalidate();
+
+  // Plane count is the diagnostic that matters. MacIOSurfaceTextureHostOGL
+  // derives NV12 from the pixel format and then hard-requires exactly two
+  // planes; anything else and both PushResourceUpdates and
+  // PushDisplayItems bail, so no layer is pushed and the frame published
+  // here reaches nothing. A surface built without plane info reports 0,
+  // which is the bug this function was already fixed for once.
+  printf_stderr("avPlayer: placeholder PUBLISHED %dx%d planes=%u\n",
+                aDisplay.width, aDisplay.height,
+                (unsigned)macSurface->GetPlaneCount());
+}
