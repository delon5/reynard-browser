+// PARENT PROCESS ONLY: BrokeredPlayers read backwards - the host id the
+// Swift side reports against, mapped to the composite key that names
+// the owning content process and its own id for the player.
+//
+// Unlike BrokeredPlayers this cannot be main-thread-only. The callbacks
+// that read it are documented any-thread (ReynardAVPlayerNotifyTime is
+// called straight off the display link at up to 120 Hz), so a lock is
+// the only honest guard.
+static StaticMutex sBrokeredKeysMutex MOZ_UNANNOTATED;
+
+// Callers hold sBrokeredKeysMutex.
+static std::unordered_map<uintptr_t, uint64_t>& BrokeredKeys() {
+  static std::unordered_map<uintptr_t, uint64_t> sBrokeredKeys;
+  return sBrokeredKeys;
+}
+
+// The composite key for a host player, or 0 when this player is not
+// brokered - a parent-process player of our own, or any id at all in a
+// content process, where the map is empty by construction.
+static uint64_t BrokeredKeyFor(uintptr_t aHostId) {
+  if (!XRE_IsParentProcess()) {
+    return 0;
+  }
+  StaticMutexAutoLock lock(sBrokeredKeysMutex);
+  auto& keys = BrokeredKeys();
+  auto entry = keys.find(aHostId);
+  return entry == keys.end() ? 0 : entry->second;
+}
