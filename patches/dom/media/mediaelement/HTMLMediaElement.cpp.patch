 #include "CrossGraphPort.h"
 #include "DOMMediaStream.h"
 #include "DecoderDoctorDiagnostics.h"
@@ -5747,6 +5750,29 @@ nsresult HTMLMediaElement::InitializeDecoderForChannel(
   }
 #endif
 
+#ifdef MOZ_WIDGET_UIKIT
+  // The missing half of the AVPlayer pipeline. DecoderTraits only
+  // answers "can this be played" - it never builds anything - so
+  // AVPlayerDecoder::IsSupportedType returned true for
+  // application/vnd.apple.mpegurl while Create() was never called, and
+  // the stream fell through to ChannelMediaDecoder as if the decoder
+  // did not exist. Confirmed on device: ten "pref=1 claimed=1" lines
+  // and not one Create().
+  //
+  // Mirrors the Android HLS block above deliberately, including
+  // SetupDecoder, which is what calls Load(aChannel) and hands the URL
+  // to AVFoundation.
+  if (AVPlayerDecoder::IsSupportedType(*containerType)) {
+    RefPtr<AVPlayerDecoder> decoder = AVPlayerDecoder::Create(decoderInit);
+    if (!decoder) {
+      reportCanPlay(false);
+      return NS_ERROR_OUT_OF_MEMORY;
+    }
+    reportCanPlay(true);
+    return SetupDecoder(decoder.get(), aChannel);
+  }
+#endif
+
   RefPtr<ChannelMediaDecoder> decoder =
       ChannelMediaDecoder::Create(decoderInit, &diagnostics);
   if (!decoder) {
@@ -7875,4 +7901,24 @@
   if (MozAudioCaptured()) {
+#ifdef MOZ_WIDGET_UIKIT
+    // Reynard: FairPlay decrypts inside AVFoundation and Gecko never
+    // holds a decrypted sample, so a capture stream can only carry
+    // silence - the leak this check guards against cannot happen.
+    // Device captures show fresh, src-less elements arriving here
+    // already marked captured, which rejected setMediaKeys with a
+    // bare NotSupportedError and killed every FairPlay page before
+    // the CDM stack ran at all.
+    nsAutoString keySystem;
+    if (aMediaKeys) {
+      aMediaKeys->GetKeySystem(keySystem);
+    }
+    const bool fairPlayExempt = IsFairPlayKeySystem(keySystem);
+    printf_stderr(
+        "emeKeys: SetMediaKeys with audio captured, keySystem=%s exempt=%d\n",
+        NS_ConvertUTF16toUTF8(keySystem).get(), fairPlayExempt ? 1 : 0);
+    if (!fairPlayExempt)
+#endif
+    {
     aRv.Throw(NS_ERROR_DOM_NOT_SUPPORTED_ERR);
     return nullptr;
+    }
   }
