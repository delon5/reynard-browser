+// WebKit's HLS extension: the stream's EXT-X-PROGRAM-DATE-TIME as a
+// Date, or an INVALID Date when the stream has none.
+//
+// Not a stub. VOD carries no program date time - which is every stream
+// this pipeline serves - and an invalid Date is exactly what Safari
+// returns for one. What matters to a page is that the method EXISTS:
+// Prime Video calls it unconditionally on its HLS path and threw
+// "getStartDate is not a function" 399 times in a single device
+// session, which is what stopped its player before it ever reached the
+// licence exchange.
+void HTMLMediaElement::GetStartDate(JSContext* aCx,
+                                    JS::MutableHandle<JS::Value> aRetval) {
+  JS::Rooted<JSObject*> date(
+      aCx, JS::NewDateObject(
+               aCx, JS::TimeClip(std::numeric_limits<double>::quiet_NaN())));
+  if (!date) {
+    aRetval.setNull();
+    return;
+  }
+  aRetval.setObject(*date);
+}
