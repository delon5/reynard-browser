+#if defined(MOZ_WIDGET_UIKIT)
+// The app process owns the AVPlayer this process asked for, so every
+// report the Swift host produces arrives here instead of on the
+// decoder's own callbacks.
+//
+// Each one is handed straight to the C entry point the host would have
+// called in a single-process build - which is the path that already
+// works in a content process: it writes AVPlayerPlaybackRegistry, which
+// is what paces AVPlayerDemuxer's synthetic samples, and then pokes the
+// decoder through PlayersById. aPlayerId is this process's own id, so
+// there is nothing to translate.
+// Each of the four logs once ON ENTRY, before calling into the C entry
+// point. A message that arrives and then fails inside still proves it
+// arrived, which is the question the app-process log cannot answer.
+mozilla::ipc::IPCResult ContentChild::RecvAVPlayerMetadata(
+    const uint64_t& aPlayerId, const double& aDurationSeconds,
+    const int32_t& aWidth, const int32_t& aHeight) {
+  static bool sReportedMetadata = false;
+  if (!sReportedMetadata) {
+    sReportedMetadata = true;
+    printf_stderr("avPlayer: recv metadata player=%llu %.3fs %dx%d\n",
+                  static_cast<unsigned long long>(aPlayerId), aDurationSeconds,
+                  aWidth, aHeight);
+  }
+  ReynardAVPlayerNotifyMetadata(static_cast<uintptr_t>(aPlayerId),
+                                aDurationSeconds, aWidth, aHeight);
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult ContentChild::RecvAVPlayerTime(
+    const uint64_t& aPlayerId, const double& aSeconds) {
+  static bool sReportedTime = false;
+  if (!sReportedTime) {
+    sReportedTime = true;
+    printf_stderr("avPlayer: recv time player=%llu %.3f\n",
+                  static_cast<unsigned long long>(aPlayerId), aSeconds);
+  }
+  ReynardAVPlayerNotifyTime(static_cast<uintptr_t>(aPlayerId), aSeconds);
+  return IPC_OK();
+}
+
+// FairPlay: rare enough that both of these log every time. The pair of
+// them IS the licence conversation as the page sees it - an
+// 'encrypted' event, then a 'message' event - so if a DRM stream
+// stalls, the absence of one of these lines says which half stopped.
+mozilla::ipc::IPCResult ContentChild::RecvAVPlayerKeyEncrypted(
+    const uint64_t& aPlayerId, const nsCString& aInitDataType,
+    nsTArray<uint8_t>&& aInitData) {
+  printf_stderr("avPlayer: recv encrypted player=%llu type=%s %zu bytes\n",
+                static_cast<unsigned long long>(aPlayerId),
+                aInitDataType.get(),
+                static_cast<size_t>(aInitData.Length()));
+  mozilla::ReynardAVPlayerDispatchEncrypted(
+      static_cast<uintptr_t>(aPlayerId), std::move(aInitData),
+      NS_ConvertUTF8toUTF16(aInitDataType));
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult ContentChild::RecvAVPlayerKeyMessage(
+    const uint64_t& aPlayerId, const nsCString& aContentId,
+    nsTArray<uint8_t>&& aSpc) {
+  printf_stderr("avPlayer: recv key message player=%llu id=%s %zu bytes\n",
+                static_cast<unsigned long long>(aPlayerId), aContentId.get(),
+                static_cast<size_t>(aSpc.Length()));
+  mozilla::ReynardFairPlayDeliverKeyMessage(static_cast<uintptr_t>(aPlayerId),
+                                            aContentId, std::move(aSpc));
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult ContentChild::RecvAVPlayerProtected(
+    const uint64_t& aPlayerId) {
+  printf_stderr("avPlayer: recv protected player=%llu\n",
+                static_cast<unsigned long long>(aPlayerId));
+  ReynardAVPlayerNotifyProtected(static_cast<uintptr_t>(aPlayerId));
+  return IPC_OK();
+}
+
+// AirPlay. Rare - a route change, a Siri Remote press - so it logs
+// every time. This call is also what keeps ReynardAVPlayerNotifyHostState
+// alive through the dead-strip: a Recv* caller inside libxul makes the
+// symbol reachable, so it needs no entry in AVPlayerDecoder.mm's anchor
+// array.
+mozilla::ipc::IPCResult ContentChild::RecvAVPlayerHostState(
+    const uint64_t& aPlayerId, const uint32_t& aKind, const bool& aValue) {
+  printf_stderr("avPlayer: recv hostState player=%llu kind=%u value=%d\n",
+                static_cast<unsigned long long>(aPlayerId), aKind,
+                aValue ? 1 : 0);
+  ReynardAVPlayerNotifyHostState(static_cast<uintptr_t>(aPlayerId), aKind,
+                                 aValue);
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult ContentChild::RecvAVPlayerEnded(
+    const uint64_t& aPlayerId) {
+  printf_stderr("avPlayer: recv ended player=%llu\n",
+                static_cast<unsigned long long>(aPlayerId));
+  ReynardAVPlayerNotifyEnded(static_cast<uintptr_t>(aPlayerId));
+  return IPC_OK();
+}
+
+// Terminal, like ended, and just as rare - it logs every time. This
+// line is the only proof in a content-process capture that the app
+// process refused or lost the player; without it a create failure
+// over there reads as a load that never finished over here.
+mozilla::ipc::IPCResult ContentChild::RecvAVPlayerError(
+    const uint64_t& aPlayerId) {
+  printf_stderr("avPlayer: recv error player=%llu\n",
+                static_cast<unsigned long long>(aPlayerId));
+  ReynardAVPlayerNotifyError(static_cast<uintptr_t>(aPlayerId));
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult ContentChild::RecvAVPlayerFrame(
+    const uint64_t& aPlayerId, const uint32_t& aSurfaceId) {
+  static bool sReportedFrame = false;
+  if (!sReportedFrame) {
+    sReportedFrame = true;
+    printf_stderr("avPlayer: recv frame player=%llu surface=%u\n",
+                  static_cast<unsigned long long>(aPlayerId), aSurfaceId);
+  }
+  ReynardAVPlayerNotifyFrameSurface(static_cast<uintptr_t>(aPlayerId),
+                                    aSurfaceId);
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult ContentChild::RecvAVPlayerFrameData(
+    const uint64_t& aPlayerId, mozilla::ipc::Shmem&& aPixels,
+    const int32_t& aWidth, const int32_t& aHeight, const uint32_t& aYStride,
+    const uint32_t& aCbCrStride) {
+  // The planes are consumed HERE, synchronously, and the Shmem is
+  // handed back at the end of this function - so the decoder copies out
+  // of memory that is still mapped, and nothing downstream holds a
+  // pointer into it.
+  const size_t yBytes = size_t(aYStride) * size_t(aHeight);
+  const size_t cbcrBytes = size_t(aCbCrStride) * size_t((aHeight + 1) / 2);
+
+  static bool sReportedFrameData = false;
+  if (!sReportedFrameData) {
+    sReportedFrameData = true;
+    printf_stderr(
+        "avPlayer: recv frame data player=%llu %dx%d yStride=%u "
+        "cbcrStride=%u bytes=%zu\n",
+        static_cast<unsigned long long>(aPlayerId), aWidth, aHeight, aYStride,
+        aCbCrStride, aPixels.Size<uint8_t>());
+  }
+
+  if (aPixels.IsReadable() && aPixels.Size<uint8_t>() >= yBytes + cbcrBytes) {
+    const uint8_t* base = aPixels.get<uint8_t>();
+    ReynardAVPlayerNotifyFrameData(static_cast<uintptr_t>(aPlayerId), base,
+                                   aYStride, base + yBytes, aCbCrStride,
+                                   aWidth, aHeight);
+  }
+
+  DeallocShmem(aPixels);
+  return IPC_OK();
+}
+#endif
