+#if defined(MOZ_WIDGET_UIKIT)
+// The content process's player id is only unique within that process,
+// so it is composed with the child id before reaching the broker.
+static uint64_t AVPlayerBrokerKey(uint64_t aChildID, uint64_t aPlayerId) {
+  return (aChildID << 32) | (aPlayerId & 0xffffffff);
+}
+
+IPCResult ContentParent::RecvAVPlayerCreate(const uint64_t& aPlayerId,
+                                            const nsCString& aUrl) {
+  const uint64_t key =
+      AVPlayerBrokerKey(static_cast<uint64_t>(ChildID()), aPlayerId);
+  // Recorded rather than looked up later: THIS actor is the owner by
+  // definition - it is the one asking for the player - so the reports
+  // travelling back need no id lookup that could answer nullptr.
+  ReynardAVPlayerNoteOwner(key, this);
+  ReynardAVPlayerBrokerCreate(key, aUrl);
+  return IPC_OK();
+}
+
+IPCResult ContentParent::RecvAVPlayerControl(const uint64_t& aPlayerId,
+                                             const uint32_t& aOp,
+                                             const double& aArg) {
+  ReynardAVPlayerBrokerControl(
+      AVPlayerBrokerKey(static_cast<uint64_t>(ChildID()), aPlayerId), aOp,
+      aArg);
+  return IPC_OK();
+}
+
+IPCResult ContentParent::RecvAVPlayerFrameFallback(const uint64_t& aPlayerId) {
+  ReynardAVPlayerBrokerFrameFallback(
+      AVPlayerBrokerKey(static_cast<uint64_t>(ChildID()), aPlayerId));
+  return IPC_OK();
+}
+#endif
