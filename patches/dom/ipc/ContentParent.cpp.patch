+#if defined(MOZ_WIDGET_UIKIT)
+namespace mozilla {
+
+// Called from dom/media/AVPlayerDecoder.mm when a report arrives for a
+// player some content process asked this one to own. Main thread only:
+// IPC actors are.
+//
+// AT GLOBAL SCOPE, after the file's namespaces close, and not beside
+// the Recv bodies above - those are inside mozilla::dom, where
+// `namespace mozilla {` reopens as mozilla::dom::mozilla and the
+// definitions would never match AVPlayerDecoder.mm's declarations.
+// That is the failure commit 121a177d fixed; this is the same trap.
+//
+// aKey is the composite (childID << 32 | playerId) AVPlayerBrokerKey
+// built on the way in, so the owning process and the id it chose both
+// fall straight out of it. A process that has since gone away answers
+// nullptr, which is an ordinary teardown race and not an error.
+// Leaked deliberately, like the maps in AVPlayerDecoder.mm and
+// AVPlayerDemuxer.cpp: a late report racing shutdown must find an empty
+// map, never a destroyed one. Main thread only, like every actor.
+static nsTHashMap<nsUint64HashKey, dom::ContentParent*>& AVPlayerOwners() {
+  static auto* sOwners = new nsTHashMap<nsUint64HashKey, dom::ContentParent*>();
+  return *sOwners;
+}
+
+void ReynardAVPlayerNoteOwner(uint64_t aKey, dom::ContentParent* aOwner) {
+  MOZ_ASSERT(NS_IsMainThread());
+  AVPlayerOwners().InsertOrUpdate(aKey, aOwner);
+}
+
+// kAVPlayerDestroy from the AVPlayerOp enum in
+// dom/media/AVPlayerDecoder.mm, which documents its numbering as
+// shared by value with this file and pledges to keep it stable.
+// Redeclared as a lone constant for the same reason the prototypes at
+// the top of this file are declared inline - neither directory should
+// grow an include path for it.
+static const uint32_t kAVPlayerDestroyOp = 4;
+
+void ReynardAVPlayerForgetOwner(uint64_t aChildID) {
+  MOZ_ASSERT(NS_IsMainThread());
+  // Every key a process owns carries its child id in the high half, so
+  // one pass drops all of that process's players. The keys are set
+  // aside first: the destroys below call into the Swift host, and
+  // nothing that can run arbitrary code belongs inside this map's
+  // iterator. Removing before destroying also means a report the host
+  // raises while tearing down finds no recorded owner - the ordinary
+  // teardown race the registry already documents, not a send to a
+  // half-dead actor.
+  AutoTArray<uint64_t, 4> orphaned;
+  for (auto iter = AVPlayerOwners().Iter(); !iter.Done(); iter.Next()) {
+    if ((iter.Key() >> 32) == aChildID) {
+      orphaned.AppendElement(iter.Key());
+      iter.Remove();
+    }
+  }
+  // A process that dies without sending kAVPlayerDestroy - a crash, or
+  // iOS reclaiming it cleanly in the unrequested-NormalShutdown flow
+  // ActorDestroy logs - used to leave its app-process players alive
+  // forever: the Swift host kept streaming and pulling frames, and the
+  // broker kept up to kFramesInFlight IOSurfaces pinned per player.
+  // Issue the destroy the child never got to send. Routing it through
+  // BrokerControl rather than calling the host directly is what also
+  // clears the player's BrokeredKeys and BrokeredFrameStates entries,
+  // exactly as the explicit path does. A player the child DID destroy
+  // is already out of BrokeredPlayers, and BrokerControl drops unknown
+  // keys before reaching the host, so a second destroy here is a
+  // no-op rather than a double teardown.
+  for (uint64_t key : orphaned) {
+    ReynardAVPlayerBrokerControl(key, kAVPlayerDestroyOp, 0.0);
+  }
+}
+
+static dom::ContentParent* AVPlayerOwner(uint64_t aKey) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  dom::ContentParent* recorded = AVPlayerOwners().Get(aKey);
+
+  // The id lookup this used to rely on, kept as a fallback and reported
+  // once beside the registry's answer. If GetContentProcessById is the
+  // reason nothing was arriving, this line is where it says so.
+  dom::ContentParent* lookedUp = nullptr;
+  if (dom::ContentProcessManager* cpm =
+          dom::ContentProcessManager::GetSingleton()) {
+    lookedUp = cpm->GetContentProcessById(dom::ContentParentId(aKey >> 32));
+  }
+
+  static bool sReportedOwner = false;
+  if (!sReportedOwner) {
+    sReportedOwner = true;
+    printf_stderr(
+        "avPlayer: owner for key %llu childID=%llu recorded=%d lookup=%d "
+        "same=%d\n",
+        static_cast<unsigned long long>(aKey),
+        static_cast<unsigned long long>(aKey >> 32), recorded ? 1 : 0,
+        lookedUp ? 1 : 0, (recorded && recorded == lookedUp) ? 1 : 0);
+  }
+
+  return recorded ? recorded : lookedUp;
+}
+
+void ReynardAVPlayerSendMetadata(uint64_t aKey, double aDurationSeconds,
+                                 int32_t aWidth, int32_t aHeight) {
+  dom::ContentParent* cp = AVPlayerOwner(aKey);
+  const bool sent = cp && cp->SendAVPlayerMetadata(aKey & 0xffffffff,
+                                                   aDurationSeconds, aWidth,
+                                                   aHeight);
+  // Once per kind. These four lines are the whole point of this
+  // change: owner=0 means the parent had nobody to send to, sent=0
+  // means the channel refused, and owner=1 sent=1 with no matching
+  // "recv" line in the content process means the child is not draining
+  // its queue - which is a different bug in a different place.
+  static bool sReportedMetadata = false;
+  if (!sReportedMetadata) {
+    sReportedMetadata = true;
+    printf_stderr("avPlayer: send metadata key=%llu owner=%d sent=%d\n",
+                  static_cast<unsigned long long>(aKey), cp ? 1 : 0,
+                  sent ? 1 : 0);
+  }
+}
+
+void ReynardAVPlayerSendTime(uint64_t aKey, double aSeconds) {
+  dom::ContentParent* cp = AVPlayerOwner(aKey);
+  const bool sent = cp && cp->SendAVPlayerTime(aKey & 0xffffffff, aSeconds);
+  static bool sReportedTime = false;
+  if (!sReportedTime) {
+    sReportedTime = true;
+    printf_stderr("avPlayer: send time key=%llu owner=%d sent=%d\n",
+                  static_cast<unsigned long long>(aKey), cp ? 1 : 0,
+                  sent ? 1 : 0);
+  }
+}
+
+void ReynardAVPlayerSendProtected(uint64_t aKey) {
+  dom::ContentParent* cp = AVPlayerOwner(aKey);
+  const bool sent = cp && cp->SendAVPlayerProtected(aKey & 0xffffffff);
+  printf_stderr("avPlayer: send protected key=%llu owner=%d sent=%d\n",
+                static_cast<unsigned long long>(aKey), cp ? 1 : 0,
+                sent ? 1 : 0);
+}
+
+void ReynardAVPlayerSendEnded(uint64_t aKey) {
+  dom::ContentParent* cp = AVPlayerOwner(aKey);
+  const bool sent = cp && cp->SendAVPlayerEnded(aKey & 0xffffffff);
+  printf_stderr("avPlayer: send ended key=%llu owner=%d sent=%d\n",
+                static_cast<unsigned long long>(aKey), cp ? 1 : 0,
+                sent ? 1 : 0);
+}
+
+// The player could not be built, or broke. Rare and terminal, so it
+// logs every time like the FairPlay sends below; owner=0 here means
+// the requesting process died first, which makes the error moot.
+void ReynardAVPlayerSendError(uint64_t aKey) {
+  dom::ContentParent* cp = AVPlayerOwner(aKey);
+  const bool sent = cp && cp->SendAVPlayerError(aKey & 0xffffffff);
+  printf_stderr("avPlayer: send error key=%llu owner=%d sent=%d\n",
+                static_cast<unsigned long long>(aKey), cp ? 1 : 0,
+                sent ? 1 : 0);
+}
+
+// FairPlay, app process -> content process. Both of these are RARE -
+// a handful per stream, not per frame - so each one logs.
+//
+// The asset wants a key nobody has claimed. Becomes the element's
+// 'encrypted' event over there, which is what starts the page's whole
+// EME flow: this pipeline's demuxer never sees the stream, so nothing
+// else can raise that event.
+void ReynardFairPlaySendEncrypted(uint64_t aKey,
+                                  const nsCString& aInitDataType,
+                                  const nsTArray<uint8_t>& aInitData) {
+  dom::ContentParent* cp = AVPlayerOwner(aKey);
+  const bool sent = cp && cp->SendAVPlayerKeyEncrypted(
+                              aKey & 0xffffffff, aInitDataType, aInitData);
+  printf_stderr(
+      "avPlayer: send encrypted key=%llu type=%s bytes=%zu owner=%d sent=%d\n",
+      static_cast<unsigned long long>(aKey), aInitDataType.get(),
+      static_cast<size_t>(aInitData.Length()), cp ? 1 : 0, sent ? 1 : 0);
+}
+
+// The SPC. Becomes the EME session's 'message' event, which the page
+// posts to its licence server.
+void ReynardFairPlaySendKeyMessage(uint64_t aKey, const nsCString& aContentId,
+                                   const nsTArray<uint8_t>& aSpc) {
+  dom::ContentParent* cp = AVPlayerOwner(aKey);
+  const bool sent = cp && cp->SendAVPlayerKeyMessage(aKey & 0xffffffff,
+                                                     aContentId, aSpc);
+  printf_stderr(
+      "avPlayer: send key message key=%llu id=%s bytes=%zu owner=%d sent=%d\n",
+      static_cast<unsigned long long>(aKey), aContentId.get(),
+      static_cast<size_t>(aSpc.Length()), cp ? 1 : 0, sent ? 1 : 0);
+}
+
+void ReynardAVPlayerSendFrame(uint64_t aKey, uint32_t aSurfaceId) {
+  dom::ContentParent* cp = AVPlayerOwner(aKey);
+  const bool sent = cp && cp->SendAVPlayerFrame(aKey & 0xffffffff, aSurfaceId);
+  static bool sReportedFrame = false;
+  if (!sReportedFrame) {
+    sReportedFrame = true;
+    printf_stderr(
+        "avPlayer: send frame key=%llu surface=%u owner=%d sent=%d\n",
+        static_cast<unsigned long long>(aKey), aSurfaceId, cp ? 1 : 0,
+        sent ? 1 : 0);
+  }
+}
+
+// The frame itself, one Shmem per frame, because naming the surface
+// does not work on iOS: IOSurfaceLookup resolves nothing across
+// processes there, so the pixels have to move.
+//
+// Row by row, not one memcpy: the strides come from two different
+// allocators and are not the same number, and a straight copy would
+// shear the picture.
+//
+// A Shmem per frame is not free - allocation plus a copy here and
+// another on the far side. The cheap version is a pool the child hands
+// back, the way PCameras does with ReleaseFrame; this is the version
+// that makes a picture appear.
+void ReynardAVPlayerSendFrameData(uint64_t aKey, const uint8_t* aY,
+                                  uint32_t aYStride, const uint8_t* aCbCr,
+                                  uint32_t aCbCrStride, int32_t aWidth,
+                                  int32_t aHeight) {
+  MOZ_ASSERT(NS_IsMainThread());
+  dom::ContentParent* cp = AVPlayerOwner(aKey);
+  if (!cp || !aY || !aCbCr || aWidth <= 0 || aHeight <= 0) {
+    return;
+  }
+  // The caller checks this too. Repeated here because this is a public
+  // entry point that trusts its arguments, and the crash it is guarding
+  // against got past a null check: a protected frame reports a plane
+  // OFFSET, 0x200, where an address belongs. Nothing legitimate lives
+  // in the first page.
+  if (reinterpret_cast<uintptr_t>(aY) < 0x1000 ||
+      reinterpret_cast<uintptr_t>(aCbCr) < 0x1000) {
+    static bool sWarnedUnmapped = false;
+    if (!sWarnedUnmapped) {
+      sWarnedUnmapped = true;
+      printf_stderr(
+          "avPlayer: refusing to copy from unmapped planes (y=%p cbcr=%p)\n",
+          (const void*)aY, (const void*)aCbCr);
+    }
+    return;
+  }
+
+  const size_t yRows = size_t(aHeight);
+  const size_t cbcrRows = size_t((aHeight + 1) / 2);
+  const size_t yBytes = size_t(aYStride) * yRows;
+  const size_t cbcrBytes = size_t(aCbCrStride) * cbcrRows;
+
+  mozilla::ipc::Shmem shmem;
+  if (!cp->AllocShmem(yBytes + cbcrBytes, &shmem)) {
+    static bool sWarnedAlloc = false;
+    if (!sWarnedAlloc) {
+      sWarnedAlloc = true;
+      printf_stderr("avPlayer: AllocShmem failed for a %zu byte frame\n",
+                    yBytes + cbcrBytes);
+    }
+    return;
+  }
+
+  uint8_t* out = shmem.get<uint8_t>();
+  memcpy(out, aY, yBytes);
+  memcpy(out + yBytes, aCbCr, cbcrBytes);
+
+  const bool sent = cp->SendAVPlayerFrameData(aKey & 0xffffffff,
+                                              std::move(shmem), aWidth,
+                                              aHeight, aYStride, aCbCrStride);
+  static bool sReportedFrameData = false;
+  if (!sReportedFrameData) {
+    sReportedFrameData = true;
+    printf_stderr(
+        "avPlayer: send frame data key=%llu %dx%d bytes=%zu sent=%d\n",
+        static_cast<unsigned long long>(aKey), aWidth, aHeight,
+        yBytes + cbcrBytes, sent ? 1 : 0);
+  }
+}
