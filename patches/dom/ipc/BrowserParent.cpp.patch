--- a/dom/ipc/BrowserParent.cpp
+++ b/dom/ipc/BrowserParent.cpp
@@ -793,6 +793,21 @@ mozilla::ipc::IPCResult BrowserParent::RecvEnsureLayersConnected(
     Maybe<CompositorOptions>* aCompositorOptions) {
   if (mRemoteLayerTreeOwner.IsInitialized()) {
     mRemoteLayerTreeOwner.EnsureLayersConnected(*aCompositorOptions);
+
+#if defined(MOZ_WIDGET_UIKIT)
+    // After compositor recovery, invalidate the embedding subdocument
+    // frame so the root WR bridge rebuilds its first display list with the
+    // reattached remote tab.
+    if (aCompositorOptions->isSome()) {
+      RefPtr<nsFrameLoader> frameLoader = GetFrameLoader();
+      if (frameLoader) {
+        nsIFrame* frame = frameLoader->GetPrimaryFrameOfOwningContent();
+        if (frame) {
+          frame->InvalidateFrame();
+        }
+      }
+    }
+#endif
   }
   return IPC_OK();
 }
@@ -860,6 +875,27 @@ void BrowserParent::ActorDestroy(ActorDestroyReason why) {
   // Tell our embedder that the tab is now going away unless we're an
   // out-of-process iframe.
   RefPtr<nsFrameLoader> frameLoader = GetFrameLoader(true);
+
+#if defined(MOZ_WIDGET_UIKIT)
+  // Diagnostic for silent content-process death - the "press Go twice"
+  // investigation. This is the decision point that turns a
+  // content-process exit into crash events: only AbnormalShutdown (4)
+  // and ManagedEndpointDropped (5) reach MaybeNotifyCrashed below,
+  // which fires "oop-frameloader-crashed" and becomes
+  // GeckoView:ContentKill / ContentCrash in the app. A clean exit the
+  // parent never requested (why=3, NormalShutdown) fires nothing - the
+  // session lives on around a dead process and its next LoadUri is
+  // swallowed. This line records what iOS process reclamation actually
+  // looks like here, which decides the real fix.
+  printf_stderr(
+      "processExitTrace: BrowserParent::ActorDestroy why=%d isTop=%d "
+      "hasFrameLoader=%d childID=%llu\n",
+      static_cast<int>(why), mBrowsingContext->IsTop() ? 1 : 0,
+      frameLoader ? 1 : 0,
+      static_cast<unsigned long long>(
+          static_cast<uint64_t>(Manager()->ChildID())));
+#endif
+
   if (frameLoader) {
     if (mBrowsingContext->IsTop()) {
       // If this is a top-level BrowsingContext, tell the frameloader it's time
@@ -1020,7 +1056,7 @@ void BrowserParent::InitRendering() {
         widget->SupportsUnadjustedMovement());
   }
 
-#if defined(MOZ_WIDGET_ANDROID)
+#if defined(MOZ_WIDGET_ANDROID) || defined(MOZ_WIDGET_UIKIT)
   MOZ_ASSERT(widget);
 
   if (GetBrowsingContext()->IsTopContent()) {
@@ -2554,14 +2590,22 @@ mozilla::ipc::IPCResult BrowserParent::RecvNotifyIMEPositionChange(
     const ContentCache& aContentCache,
     const IMENotification& aIMENotification) {
   nsCOMPtr<nsIWidget> widget = GetTextInputHandlingWidget();
-  if (!widget || !IMEStateManager::DoesBrowserParentHaveIMEFocus(this)) {
+  if (!widget) {
     return IPC_OK();
   }
   if (NS_WARN_IF(!aContentCache.IsValid())) {
     return IPC_FAIL(this, "Invalid content cache data");
   }
-  mContentCache.AssignContent(aContentCache, widget, &aIMENotification);
-  mContentCache.MaybeNotifyIME(widget, aIMENotification);
+  if (IMEStateManager::DoesBrowserParentHaveIMEFocus(this)) {
+    mContentCache.AssignContent(aContentCache, widget, &aIMENotification);
+    mContentCache.MaybeNotifyIME(widget, aIMENotification);
+  } else {
+    // During APZ scroll, BrowserParent temporarily loses IME focus.
+    // Still update the cache and notify the widget directly so that
+    // UIKit gets updated caret/selection geometry during scrolling.
+    mContentCache.AssignContent(aContentCache, widget);
+    widget->NotifyIME(aIMENotification);
+  }
   return IPC_OK();
 }
 
@@ -3223,18 +3267,31 @@ bool BrowserParent::HandleQueryContentEvent(WidgetQueryContentEvent& aEvent) {
       NS_WARN_IF(aEvent.Failed())) {
     return true;
   }
+  nsCOMPtr<nsIWidget> browserWidget = GetWidget();
+  const LayoutDeviceIntPoint textInputWidgetOffset =
+      browserWidget != textInputHandlingWidget
+          ? nsLayoutUtils::WidgetToWidgetOffset(browserWidget,
+                                                textInputHandlingWidget)
+          : LayoutDeviceIntPoint();
   switch (aEvent.mMessage) {
     case eQueryTextRect:
     case eQueryCaretRect:
     case eQueryEditorRect: {
-      nsCOMPtr<nsIWidget> browserWidget = GetWidget();
       if (browserWidget != textInputHandlingWidget) {
-        aEvent.mReply->mRect += nsLayoutUtils::WidgetToWidgetOffset(
-            browserWidget, textInputHandlingWidget);
+        aEvent.mReply->mRect += textInputWidgetOffset;
       }
       aEvent.mReply->mRect = TransformChildToParent(aEvent.mReply->mRect);
       break;
     }
+    case eQueryTextRectArray: {
+      for (LayoutDeviceIntRect& rect : aEvent.mReply->mRectArray) {
+        if (browserWidget != textInputHandlingWidget) {
+          rect += textInputWidgetOffset;
+        }
+        rect = TransformChildToParent(rect);
+      }
+      break;
+    }
     default:
       break;
   }
