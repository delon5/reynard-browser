     async UpdateRemotePrintSettings(MaybeDiscardedBrowsingContext aBc,
                                     PrintData aPrintData);
 
+    // Allow content process to report compositor bridge abnormal
+    // shutdown with the active GPU process token.
+    [Priority=control] async NotifyGPUProcessLost(uint64_t aProcessToken);
+
+    // Reynard: the AVPlayer lives in the APP process. iOS refuses a
+    // playback audio session to a content extension - every category
+    // returns '!pla' - so a player created here never sustains
+    // playback. AVPlayerDecoder therefore drives one over these two
+    // messages instead. aOp is AVPlayerDecoder's control opcode
+    // (play/pause/suspend/resume/destroy/seek); aArg carries the seek
+    // target and is ignored otherwise.
+    async AVPlayerCreate(uint64_t aPlayerId, nsCString aUrl);
+    async AVPlayerControl(uint64_t aPlayerId, uint32_t aOp, double aArg);
+
+    // A frame's surface id could not be resolved in this process, so
+    // the app process must copy into a surface Gecko created - which
+    // carries kIOSurfaceIsGlobal - rather than publishing
+    // AVFoundation's own. Sent at most a handful of times per process.
+    async AVPlayerFrameFallback(uint64_t aPlayerId);
+
+    // Reynard FairPlay: the AVContentKeySession lives in the APP process
+    // too, and for the same kind of reason the player does.
+    // addContentKeyRecipient accepts an AVURLAsset and nothing else,
+    // and since AVPlayerCreate the asset is over there - so a session
+    // built here is attached to nothing, however correct the licence
+    // exchange on it. Only the EME objects stay in this process, and
+    // the page's half of the round trip travels over these three.
+    //
+    // The application certificate is per-PROCESS rather than
+    // per-player: setServerCertificate lands on MediaKeys, which
+    // exists well before any element has a src, so there is no player
+    // to hang it on yet.
+    async AVPlayerSetAppCertificate(uint8_t[] aCert);
+
+    // generateRequest(): ask AVFoundation for an SPC covering this
+    // identifier. aContentId is that identifier in the encoding BOTH
+    // sides key by - the skd:// URI for HLS, base64 of the raw key id
+    // for fragmented MP4 - which is what lets these messages carry no
+    // invented request id to echo back.
+    async AVPlayerKeyGenerateRequest(uint64_t aPlayerId,
+                                     nsCString aContentId,
+                                     nsCString aInitDataType,
+                                     uint8_t[] aInitData);
+
+    // update(): the CKC the page got back from its licence server.
+    async AVPlayerKeyResponse(uint64_t aPlayerId, nsCString aContentId,
+                              uint8_t[] aResponse);
+
     async PExtensions();
 
 child:
+    // Reynard: the return path for the brokered player. The app process
+    // owns the AVPlayer (AVPlayerCreate, above), so every report it
+    // produces - metadata, position, end of stream - is raised in a
+    // process that has no decoder to hand it to. These carry it back to
+    // the process that asked for the player.
+    //
+    // aPlayerId is the CONTENT-side id, unchanged: ContentParent strips
+    // its own child id off the composite key before sending, so the
+    // child looks the player up exactly as it named it.
+    async AVPlayerMetadata(uint64_t aPlayerId, double aDurationSeconds,
+                           int32_t aWidth, int32_t aHeight);
+    async AVPlayerTime(uint64_t aPlayerId, double aSeconds);
+    async AVPlayerEnded(uint64_t aPlayerId);
+    // The app process worked out this stream is protected by watching
+    // its own video output go quiet while the clock kept running. Only
+    // it can see that, so only it can say so. See
+    // AVPlayerDecoder::MaybeMarkProtectedOutputStall.
+    async AVPlayerProtected(uint64_t aPlayerId);
+
+    // Reynard FairPlay, the other direction.
+    //
+    // The asset reached an EXT-X-KEY nothing has claimed yet. The page
+    // has to hear about that as an 'encrypted' event, and only this
+    // process can raise one - AVPlayerDemuxer never sees the stream,
+    // so no ordinary demuxer path can produce it.
+    async AVPlayerKeyEncrypted(uint64_t aPlayerId, nsCString aInitDataType,
+                               uint8_t[] aInitData);
+
+    // The SPC AVFoundation produced, which becomes the EME session's
+    // 'message' event. Keyed by content id, not by session: the app
+    // process has no notion of an EME session, and the identifier is
+    // the one name both sides already agree on.
+    async AVPlayerKeyMessage(uint64_t aPlayerId, nsCString aContentId,
+                             uint8_t[] aSpc);
+
+    // A decoded frame, named by the global IOSurface id its pixels
+    // live in. Nothing is copied and nothing large crosses: both
+    // processes end up addressing the same surface, which is how
+    // Gecko already hands video to the compositor.
+    async AVPlayerFrame(uint64_t aPlayerId, uint32_t aSurfaceId);
+
+    // The pixels themselves, because that id cannot be resolved:
+    // IOSurfaceLookup finds nothing across processes on iOS, not even a
+    // surface Gecko created with kIOSurfaceIsGlobal, so the message
+    // above is dead on this platform and kept only for the day it is
+    // not. The two NV12 planes travel in a Shmem with their strides,
+    // and the content process copies them into a surface IT creates -
+    // which does reach the compositor, since that is how the
+    // placeholder is displayed today.
+    async AVPlayerFrameData(uint64_t aPlayerId, Shmem aPixels,
+                            int32_t aWidth, int32_t aHeight,
+                            uint32_t aYStride, uint32_t aCbCrStride);
+
     async ConstructBrowser(ManagedEndpoint<PBrowserChild> browserEp,
                            ManagedEndpoint<PWindowGlobalChild> windowEp,
                            TabId tabId,
