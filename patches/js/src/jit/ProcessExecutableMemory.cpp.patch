+// separate because they mean different things: no debugger is expected
+// and harmless, a debugger that stopped listening is a tunnel problem,
+// and chunk overflow is a sizing problem.
+static mozilla::Atomic<uint64_t, mozilla::Relaxed> sPrepareCalls(0);
+static mozilla::Atomic<uint64_t, mozilla::Relaxed> sPrepareNoTXM(0);
+static mozilla::Atomic<uint64_t, mozilla::Relaxed> sPrepareNoDebugger(0);
+static mozilla::Atomic<uint64_t, mozilla::Relaxed> sPrepareNotListening(0);
+static mozilla::Atomic<uint64_t, mozilla::Relaxed> sPrepareCachedChunk(0);
+static mozilla::Atomic<uint64_t, mozilla::Relaxed> sPrepareRequested(0);
+
+// Reported on a schedule rather than per call: this is a hot path and a
+// line per region would be its own outage. Powers of two keep early
+// behaviour visible without ever becoming noise.
+static void ReportPrepareCountersIfDue() {
+  const uint64_t calls = ++sPrepareCalls;
+  if (calls & (calls - 1)) {
+    return;
+  }
+  printf_stderr(
+      "jitPrepare: calls=%llu requested=%llu cached=%llu "
+      "skipped(noTXM=%llu noDebugger=%llu notListening=%llu) busSkips=%llu\n",
+      (unsigned long long)calls, (unsigned long long)sPrepareRequested,
+      (unsigned long long)sPrepareCachedChunk,
+      (unsigned long long)sPrepareNoTXM,
+      (unsigned long long)sPrepareNoDebugger,
+      (unsigned long long)sPrepareNotListening,
+      (unsigned long long)sSkippedBusFaults);
+}
