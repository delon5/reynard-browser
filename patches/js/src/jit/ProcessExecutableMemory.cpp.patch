+// Set the first time a W^X fault is skipped, so the skip is reported
+// once rather than never or constantly.
+static mozilla::Atomic<bool, mozilla::Relaxed> sReportedWXFaultSkip(false);
+
+// Hand a fault to whoever held the signal before this file installed its
+// own handler, WITHOUT changing the disposition.
+//
+// The foreign-fault paths used to do `sigaction(SIG, &sPrevious, nullptr)`
+// and return. That does deliver the fault to the previous handler, but it
+// also uninstalls ours - and sInstalledBusHandler/sInstalledTrapHandler
+// are latched while ReserveProcessExecutableMemory runs once, so nothing
+// ever puts it back. One foreign fault permanently removed W^X mediation
+// or the brk #0xf00d backstop for the rest of the process's life. The
+// backstop has to survive the first foreign fault to be worth having: the
+// race it covers - the debug session dying between DebuggerIsListening()
+// and the brk three instructions later - can happen at any point
+// afterwards.
+static void ForwardToPreviousHandler(int aSignal,
+                                     const struct sigaction* aPrevious,
+                                     siginfo_t* aInfo, void* aContext) {
+  if (aPrevious->sa_flags & SA_SIGINFO) {
+    if (aPrevious->sa_sigaction) {
+      aPrevious->sa_sigaction(aSignal, aInfo, aContext);
+      return;
+    }
+  } else if (aPrevious->sa_handler != SIG_DFL &&
+             aPrevious->sa_handler != SIG_IGN) {
+    aPrevious->sa_handler(aSignal);
+    return;
+  }
+
+  if (aPrevious->sa_handler == SIG_IGN) {
+    return;
+  }
+
+  // Nothing was there. Restore the default and return so the faulting
+  // instruction re-executes into it. The disposition is left at SIG_DFL,
+  // but only on the path that was always going to terminate the process -
+  // there is no handler left to lose.
+  struct sigaction dfl;
+  memset(&dfl, 0, sizeof(dfl));
+  dfl.sa_handler = SIG_DFL;
+  sigemptyset(&dfl.sa_mask);
+  sigaction(aSignal, &dfl, nullptr);
+}
+
+static void PrepareExecutableRegionForWriting(void* aAddress, size_t aSize) {
+  if (!aAddress || !aSize) {
+    return;
+  }
+
+  ReportPrepareCountersIfDue();
+
+  if (!sHasTXMSupport) {
+    sPrepareNoTXM++;
+    return;
+  }
+
+  // Never trap without something to catch it. Deliberately uncached -
+  // the point is noticing when the debugger goes away, and this runs
+  // once per region rather than per write.
+  if (!ProcessHasDebuggerAttached()) {
+    sPrepareNoDebugger++;
+    return;
+  }
+
+  // CS_DEBUGGED stays set after the connection dies, so it says a
+  // debugger attached at some point rather than that one is listening
+  // now. This closes that gap - see fix_debugger_listening_guard.py.
+  if (!DebuggerIsListening()) {
+    sPrepareNotListening++;
+    return;
+  }
+
+  if (!sExecutableMemoryBase) {
+    sPrepareRequested++;
+    RequestDebuggerToPrepareRegion(aAddress, aSize);
+    return;
+  }
+
+  auto* address = static_cast<uint8_t*>(aAddress);
+  if (address < sExecutableMemoryBase) {
+    sPrepareRequested++;
+    RequestDebuggerToPrepareRegion(aAddress, aSize);
+    return;
+  }
+
+  size_t startOffset = static_cast<size_t>(address - sExecutableMemoryBase);
+  size_t endOffset = startOffset + aSize;
+
+  size_t firstChunk = startOffset / kPrepareChunkBytes;
+  size_t lastChunk = (endOffset - 1) / kPrepareChunkBytes;
+
+  if (lastChunk >= kMaxPrepareChunks) {
+    sPrepareRequested++;
+    RequestDebuggerToPrepareRegion(aAddress, aSize);
+    return;
+  }
+
+  for (size_t chunk = firstChunk; chunk <= lastChunk; chunk++) {
+    if (PreparedChunkIsSet(chunk)) {
+      sPrepareCachedChunk++;
+      continue;
+    }
+
+    // Re-checked per chunk. The check at the top of this function is
+    // hoisted above a loop that can trap several times, so a tunnel
+    // dying between chunks would leave the later ones trapping into
+    // nothing. notify_get_state is cheap. See
+    // fix_sigbus_and_chunk_mask.py.
+    if (!DebuggerIsListening()) {
+      sPrepareNotListening++;
+      return;
+    }
+
+    uint8_t* chunkStart = sExecutableMemoryBase + (chunk * kPrepareChunkBytes);
+    sPrepareRequested++;
+    RequestDebuggerToPrepareRegion(chunkStart, kPrepareChunkBytes);
+    // |= rather than a load, OR and store. mozilla::Atomic makes the
+    // compound form atomic; spelling it out defeats that, and two
+    // compile threads can lose one another's bit - costing an extra brk
+    // round trip later. See fix_sigbus_and_chunk_mask.py.
+    PreparedChunkSet(chunk);
+  }
+}
+
+static bool SetAliasProtection(void* executableAddress, void* writableAddress,
+                               size_t bytes, ProtectionSetting protection) {
+  if (!sHasTXMSupport) {
+    if (protection == ProtectionSetting::Writable) {
+      return vm_protect(mach_task_self(),
+                        reinterpret_cast<vm_address_t>(writableAddress), bytes,
+                        false, VM_PROT_READ | VM_PROT_WRITE) == KERN_SUCCESS;
+    }
+    sys_dcache_flush(writableAddress, bytes);
+    sys_icache_invalidate(executableAddress, bytes);
+    return true;
+  }
+
+  switch (protection) {
+    case ProtectionSetting::Writable:
+      if (vm_protect(mach_task_self(),
+                     reinterpret_cast<vm_address_t>(writableAddress), bytes,
+                     false, VM_PROT_READ | VM_PROT_WRITE) != KERN_SUCCESS) {
+        return false;
+      }
+      return mprotect(executableAddress, bytes, PROT_READ | PROT_EXEC) == 0;
+    case ProtectionSetting::Executable:
+      if (vm_protect(mach_task_self(),
+                     reinterpret_cast<vm_address_t>(writableAddress), bytes,
+                     false, VM_PROT_READ) != KERN_SUCCESS) {
+        return false;
+      }
+      return mprotect(executableAddress, bytes, PROT_READ | PROT_EXEC) == 0;
+  }
+  MOZ_CRASH();
+}
