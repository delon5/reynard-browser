+__attribute__((noinline, optnone, naked)) void* RequestDebuggerToPrepareRegion(
+    void* addr, size_t len) {
+  asm("mov x16, #1 \n"
+      "brk #0xf00d \n"
+      "ret");
+}
+
+static void* WritableAliasForExecutableAddress(void* addr, size_t bytes) {
+  if (!sWritableExecutableMemoryBase || !sExecutableMemoryBase) {
+    return addr;
+  }
+
+  auto* executable = static_cast<uint8_t*>(addr);
+  MOZ_RELEASE_ASSERT(executable >= sExecutableMemoryBase &&
+                     executable + bytes <=
+                         sExecutableMemoryBase + MaxCodeBytesPerProcess);
+  return sWritableExecutableMemoryBase + (executable - sExecutableMemoryBase);
+}
+
+static void PrepareExecutableRegionForExecution(void* aAddress, size_t aSize) {
+  if (!aAddress || !aSize) {
+    return;
+  }
+
+  sys_cache_control(kCacheFunctionPrepareForExecution, aAddress, aSize);
+}
+
+// Coalesces region preparation - see
+// fix_reduce_wx_mediation_cost.py's docstring. Device logs showed
+// regions being prepared 64KB at a time, one debugger round trip
+// each, continuing for the life of the process. The trap is initiated
+// here in the target, so the debugger cannot skip it; the only way to
+// reduce the cost is to stop asking. One 1MB chunk covers what
+// previously took sixteen traps, and once a process's working set is
+// covered the traps stop entirely.
+//
+// 1MB chunks across a reserved region of at most a few hundred MB fit
+// comfortably in a 64-bit mask. Addresses outside the reserved range
+// bypass the cache and prepare exactly what was asked for, and a chunk
+// is only marked prepared AFTER the debugger call returns.
+// 4MB chunks across 64 mask bits gives 256MB of coverage. At the
+// previous 1MB the ceiling was 64MB, which Ion blew straight past:
+// 917 of its 1031 region requests bypassed the cache entirely and
+// were prepared uncoalesced at 64KB, an 8.6% coalescing rate. Ion
+// with JIT off used 57MB and so coalesced 100%.
+//
+// That also explains why raising javascript.options.ion.threshold
+// appeared to help - it was not improving Ion's compilation, it was
+// reducing Ion's allocation count so it stayed inside an undersized
+// cache. See fix_chunk_coverage_and_dead_connection_detach.py.
+static constexpr size_t kPrepareChunkBytes = 4 * 1024 * 1024;
+static constexpr size_t kMaxPrepareChunks = 64;
+static mozilla::Atomic<uint64_t, mozilla::Relaxed> sPreparedChunkMask(0);
+
+// Saved so a foreign fault can be handed back to whoever was
+// installed before us instead of being forced to SIG_DFL.
+static struct sigaction sPreviousBusAction;
+static struct sigaction sPreviousTrapAction;
+
+// How many times a SIGBUS inside the JIT region was skipped. Non-zero
+// means generated code may have a hole in it - see the handler.
+static mozilla::Atomic<uint64_t, mozilla::Relaxed> sSkippedBusFaults(0);
+
+// ADDED - see fix_guard_brk_without_debugger.py's docstring.
+//
+// RequestDebuggerToPrepareRegion executes brk #0xf00d. With a debugger
+// attached that traps, is serviced, and execution resumes. With no
+// debugger it is an unhandled breakpoint and the process dies
+// instantly - confirmed by a Helper crash report:
+//
+//   EXC_BREAKPOINT (SIGTRAP), esr "(Breakpoint) brk 61453"
+//   RequestDebuggerToPrepareRegion <- ProcessExecutableMemory::allocate
+//   <- js::RunScript
+//
+// The debug session can die while the content process keeps running:
+// after the app is suspended the tunnel drops with Socket(BrokenPipe)
+// and the debug loops stay blocked. A process that then needs a new
+// JIT region traps into nothing.
+//
+// csops on SELF is permitted - only the cross-process form returns
+// EPERM - and this is the same call the Helper's own CS_DEBUGGED check
+// uses successfully.
+#define REYNARD_CS_OPS_STATUS 0
+#define REYNARD_CS_DEBUGGED 0x10000000
+
+#include <notify.h>
+
+extern "C" int csops(pid_t pid, unsigned int ops, void* useraddr,
+                     size_t usersize);
+
+// Whether a debugger is LISTENING, as opposed to CS_DEBUGGED merely
+// being set. See fix_debugger_listening_guard.py.
+//
+// The two diverge exactly when it matters: the tunnel dies during a
+// suspension, every debug loop fails together, the detaches fail with
+// it, and the process is left CS_DEBUGGED with nobody on the other end.
+// A trap then stops it forever, and because content processes are app
+// extensions, iOS's next synchronous lifecycle message goes unanswered
+// and the watchdog kills the whole app.
+//
+// notify_get_state reads a 64-bit value from a shared page - no IPC, no
+// filesystem - so this is cheap enough to do per region without
+// caching, which matters because the point is noticing a change.
+//
+// Chosen over an App Group file because this translation unit is plain
+// C++ with no Foundation, and the container path is UUID-based so it
+// cannot be derived without it. notify.h is plain C.
+static bool DebuggerIsListening() {
+  static int sToken = NOTIFY_TOKEN_INVALID;
+  static bool sRegistered = false;
+  static bool sReportedFailure = false;
+
+  if (!sRegistered) {
+    sRegistered = true;
+    if (notify_register_check("com.minh-ton.Reynard.JITDebuggerListening", &sToken) !=
+        NOTIFY_STATUS_OK) {
+      sToken = NOTIFY_TOKEN_INVALID;
+    }
+  }
+
+  if (sToken == NOTIFY_TOKEN_INVALID) {
+    // Registration failed. Do NOT trap - a process that skips the trap
+    // runs interpreted, which is slow but alive; one that traps with
+    // nobody listening freezes and takes the app with it.
+    //
+    // Announced once so the degradation is visible rather than silent.
+    if (!sReportedFailure) {
+      sReportedFailure = true;
+      notify_post("com.minh-ton.Reynard.JITNotifyRegisterFailed");
+    }
+    return false;
+  }
+
+  uint64_t state = 0;
+  if (notify_get_state(sToken, &state) != NOTIFY_STATUS_OK) {
+    return false;
+  }
+  return state != 0;
+}
+
+static bool ProcessHasDebuggerAttached() {
+  int flags = 0;
+  if (csops(getpid(), REYNARD_CS_OPS_STATUS, &flags, sizeof(flags)) != 0) {
+    return false;
+  }
+  return (flags & REYNARD_CS_DEBUGGED) != 0;
+}
