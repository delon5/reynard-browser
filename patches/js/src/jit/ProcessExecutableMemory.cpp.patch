+// Bytes actually reserved for the executable region.
+//
+// On every platform except iOS this is MaxCodeBytesPerProcess and nothing
+// ever writes it, so those platforms are bit-for-bit unaffected by the
+// ladder below. On iOS ReserveProcessExecutableMemory steps down a ladder
+// until the kernel accepts a size and records the winner here.
+//
+// MaxCodeBytesPerProcess itself cannot carry this: it is static_assert-ed
+// and it sizes PageBitSet<MaxCodePages>, so it has to stay a compile-time
+// constant. It therefore remains the ceiling - the largest reservation that
+// will ever be attempted and the size everything compile-time is dimensioned
+// for - while this is the amount actually mapped.
+// Atomic because the SIGBUS handler and the JS compile threads both read it.
+// It is written exactly once, inside ReserveProcessExecutableMemory, before
+// base_ is set and therefore before any of those readers can observe a live
+// region - so Relaxed is sufficient and no ordering is implied or needed.
+static mozilla::Atomic<size_t, mozilla::Relaxed> sReservedExecutableBytes(
+    MaxCodeBytesPerProcess);
+
+static size_t ReservedExecutableBytes() { return sReservedExecutableBytes; }
+
+#ifdef XP_IOS
+static uint8_t* sExecutableMemoryBase = nullptr;
+static uint8_t* sWritableExecutableMemoryBase = nullptr;
