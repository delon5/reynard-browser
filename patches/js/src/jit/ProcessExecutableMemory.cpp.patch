+__attribute__((noinline, optnone, naked)) void* RequestDebuggerToPrepareRegion(
+    void* addr, size_t len) {
+  asm("mov x16, #1 \n"
+      "brk #0xf00d \n"
+      "ret");
+}
+
+static void* WritableAliasForExecutableAddress(void* addr, size_t bytes) {
+  if (!sWritableExecutableMemoryBase || !sExecutableMemoryBase) {
+    return addr;
+  }
+
+  auto* executable = static_cast<uint8_t*>(addr);
+  MOZ_RELEASE_ASSERT(executable >= sExecutableMemoryBase &&
+                     executable + bytes <=
+                         sExecutableMemoryBase + MaxCodeBytesPerProcess);
+  return sWritableExecutableMemoryBase + (executable - sExecutableMemoryBase);
+}
+
+static void PrepareExecutableRegionForExecution(void* aAddress, size_t aSize) {
+  if (!aAddress || !aSize) {
+    return;
+  }
+
+  sys_cache_control(kCacheFunctionPrepareForExecution, aAddress, aSize);
+}
+
+// Coalesces region preparation - see
+// fix_reduce_wx_mediation_cost.py's docstring. Device logs showed
+// regions being prepared 64KB at a time, one debugger round trip
+// each, continuing for the life of the process. The trap is initiated
+// here in the target, so the debugger cannot skip it; the only way to
+// reduce the cost is to stop asking. One 1MB chunk covers what
+// previously took sixteen traps, and once a process's working set is
+// covered the traps stop entirely.
+//
+// 1MB chunks across a reserved region of at most a few hundred MB fit
+// comfortably in a 64-bit mask. Addresses outside the reserved range
+// bypass the cache and prepare exactly what was asked for, and a chunk
+// is only marked prepared AFTER the debugger call returns.
+// 4MB chunks across 64 mask bits gives 256MB of coverage. At the
+// previous 1MB the ceiling was 64MB, which Ion blew straight past:
+// 917 of its 1031 region requests bypassed the cache entirely and
+// were prepared uncoalesced at 64KB, an 8.6% coalescing rate. Ion
+// with JIT off used 57MB and so coalesced 100%.
+//
+// That also explains why raising javascript.options.ion.threshold
+// appeared to help - it was not improving Ion's compilation, it was
+// reducing Ion's allocation count so it stayed inside an undersized
+// cache. See fix_chunk_coverage_and_dead_connection_detach.py.
+static constexpr size_t kPrepareChunkBytes = 4 * 1024 * 1024;
+static constexpr size_t kMaxPrepareChunks = 64;
+static mozilla::Atomic<uint64_t, mozilla::Relaxed> sPreparedChunkMask(0);
+
+// ADDED - see fix_guard_brk_without_debugger.py's docstring.
+//
+// RequestDebuggerToPrepareRegion executes brk #0xf00d. With a debugger
+// attached that traps, is serviced, and execution resumes. With no
+// debugger it is an unhandled breakpoint and the process dies
+// instantly - confirmed by a Helper crash report:
+//
+//   EXC_BREAKPOINT (SIGTRAP), esr "(Breakpoint) brk 61453"
+//   RequestDebuggerToPrepareRegion <- ProcessExecutableMemory::allocate
+//   <- js::RunScript
+//
+// The debug session can die while the content process keeps running:
+// after the app is suspended the tunnel drops with Socket(BrokenPipe)
+// and the debug loops stay blocked. A process that then needs a new
+// JIT region traps into nothing.
+//
+// csops on SELF is permitted - only the cross-process form returns
+// EPERM - and this is the same call the Helper's own CS_DEBUGGED check
+// uses successfully.
+#define REYNARD_CS_OPS_STATUS 0
+#define REYNARD_CS_DEBUGGED 0x10000000
+
+#include <notify.h>
+
+extern "C" int csops(pid_t pid, unsigned int ops, void* useraddr,
+                     size_t usersize);
+
+// Whether a debugger is LISTENING, as opposed to CS_DEBUGGED merely
+// being set. See fix_debugger_listening_guard.py.
+//
+// The two diverge exactly when it matters: the tunnel dies during a
+// suspension, every debug loop fails together, the detaches fail with
+// it, and the process is left CS_DEBUGGED with nobody on the other end.
+// A trap then stops it forever, and because content processes are app
+// extensions, iOS's next synchronous lifecycle message goes unanswered
+// and the watchdog kills the whole app.
+//
+// notify_get_state reads a 64-bit value from a shared page - no IPC, no
+// filesystem - so this is cheap enough to do per region without
+// caching, which matters because the point is noticing a change.
+//
+// Chosen over an App Group file because this translation unit is plain
+// C++ with no Foundation, and the container path is UUID-based so it
+// cannot be derived without it. notify.h is plain C.
+static bool DebuggerIsListening() {
+  static int sToken = NOTIFY_TOKEN_INVALID;
+  static bool sRegistered = false;
+  static bool sReportedFailure = false;
+
+  if (!sRegistered) {
+    sRegistered = true;
+    if (notify_register_check("com.minh-ton.Reynard.JITDebuggerListening", &sToken) !=
+        NOTIFY_STATUS_OK) {
+      sToken = NOTIFY_TOKEN_INVALID;
+    }
+  }
+
+  if (sToken == NOTIFY_TOKEN_INVALID) {
+    // Registration failed. Do NOT trap - a process that skips the trap
+    // runs interpreted, which is slow but alive; one that traps with
+    // nobody listening freezes and takes the app with it.
+    //
+    // Announced once so the degradation is visible rather than silent.
+    if (!sReportedFailure) {
+      sReportedFailure = true;
+      notify_post("com.minh-ton.Reynard.JITNotifyRegisterFailed");
+    }
+    return false;
+  }
+
+  uint64_t state = 0;
+  if (notify_get_state(sToken, &state) != NOTIFY_STATUS_OK) {
+    return false;
+  }
+  return state != 0;
+}
+
+static bool ProcessHasDebuggerAttached() {
+  int flags = 0;
+  if (csops(getpid(), REYNARD_CS_OPS_STATUS, &flags, sizeof(flags)) != 0) {
+    return false;
+  }
+  return (flags & REYNARD_CS_DEBUGGED) != 0;
+}
+
+static void PrepareExecutableRegionForWriting(void* aAddress, size_t aSize) {
+  if (!aAddress || !aSize) {
+    return;
+  }
+
+  if (!sHasTXMSupport) {
+    return;
+  }
+
+  // Never trap without something to catch it. Deliberately uncached -
+  // the point is noticing when the debugger goes away, and this runs
+  // once per region rather than per write.
+  if (!ProcessHasDebuggerAttached()) {
+    return;
+  }
+
+  // CS_DEBUGGED stays set after the connection dies, so it says a
+  // debugger attached at some point rather than that one is listening
+  // now. This closes that gap - see fix_debugger_listening_guard.py.
+  if (!DebuggerIsListening()) {
+    return;
+  }
+
+  // EXPERIMENT, off by default. See fix_try_mprotect_before_trap.py.
+  //
+  // The whole debugger apparatus exists because TXM is assumed to stop
+  // a process making its own JIT pages writable. But CS_DEBUGGED exists
+  // to relax code-signing enforcement for debugging, and whether that
+  // relaxation covers self-mprotect has never been tested - the
+  // debugger route was built first and worked, so the cheaper one was
+  // never tried.
+  //
+  // If it works, the per-process debug loop becomes unnecessary: attach
+  // once to set CS_DEBUGGED, detach, and the process runs free. Which
+  // is the same mechanism that has been causing trouble all along -
+  // processes left flagged with no debugger - put to use.
+  //
+  // Falls through to the trap on failure, so the worst case is one
+  // wasted syscall per region.
+  // getenv rather than a pref: js/src builds outside libxul, so
+  // StaticPrefs_javascript.h pulls in Preferences.h and fails with
+  // "This header is only usable from within libxul". SpiderMonkey reads
+  // its own JIT options the same way. See fix_mprotect_use_getenv.py.
+  //
+  // An installed app has no shell to set this from, so the device test
+  // means flipping kDefaultTryMprotect below and rebuilding. Worse than
+  // a pref, and the only thing available here.
+  // ON deliberately: an installed app has no shell to set
+  // REYNARD_TRY_MPROTECT from, so a build with it off answers
+  // nothing. Set false and rebuild to turn the experiment off.
+  static const bool kDefaultTryMprotect = true;
+  static bool sTryMprotect = [] {
+    const char* env = getenv("REYNARD_TRY_MPROTECT");
+    if (env) {
+      return env[0] == '1';
+    }
+
+    // A file is the only toggle an installed app has: js/src cannot
+    // read prefs, and there is no shell to set an environment variable
+    // from. iOS sets HOME to the app container, so this lands in the
+    // Documents folder the Files app shows.
+    //
+    // Create no-mprotect there to turn the experiment off, delete it to
+    // turn it back on. No rebuild either way.
+    const char* home = getenv("HOME");
+    if (home) {
+      char path[1024];
+      snprintf(path, sizeof(path), "%s/Documents/no-mprotect", home);
+      if (access(path, F_OK) == 0) {
+        return false;
+      }
+    }
+
+    return kDefaultTryMprotect;
+  }();
+
+  if (sTryMprotect) {
+    uintptr_t pageSize = static_cast<uintptr_t>(getpagesize());
+    uintptr_t start = reinterpret_cast<uintptr_t>(aAddress) & ~(pageSize - 1);
+    uintptr_t end = (reinterpret_cast<uintptr_t>(aAddress) + aSize +
+                     pageSize - 1) & ~(pageSize - 1);
+
+    int rv = mprotect(reinterpret_cast<void*>(start), end - start,
+                      PROT_READ | PROT_WRITE | PROT_EXEC);
+
+    // Logged once. Every region would drown everything else, and the
+    // first answer is the only one that matters.
+    // To a file, because printf_stderr reaches nothing readable on
+    // device and js/src cannot use Reynard's own logger. See
+    // fix_mprotect_result_to_file.py.
+    //
+    // Appended, so each content process leaves its own line - one
+    // succeeding and others failing would itself be informative.
+    static bool sReported = false;
+    if (!sReported) {
+      sReported = true;
+      const char* reportHome = getenv("HOME");
+      if (reportHome) {
+        char reportPath[1024];
+        snprintf(reportPath, sizeof(reportPath),
+                 "%s/Documents/mprotect-result.txt", reportHome);
+        FILE* f = fopen(reportPath, "a");
+        if (f) {
+          if (rv == 0) {
+            fprintf(f, "pid %d: mprotect SUCCEEDED (addr %p len %zu)\n",
+                    getpid(), aAddress, aSize);
+          } else {
+            fprintf(f,
+                    "pid %d: mprotect FAILED errno=%d (addr %p len %zu)\n",
+                    getpid(), errno, aAddress, aSize);
+          }
+          fclose(f);
+        }
+      }
+    }
+
+    if (rv == 0) {
+      return;
+    }
+  }
+
+  if (!sExecutableMemoryBase) {
+    RequestDebuggerToPrepareRegion(aAddress, aSize);
+    return;
+  }
+
+  auto* address = static_cast<uint8_t*>(aAddress);
+  if (address < sExecutableMemoryBase) {
+    RequestDebuggerToPrepareRegion(aAddress, aSize);
+    return;
+  }
+
+  size_t startOffset = static_cast<size_t>(address - sExecutableMemoryBase);
+  size_t endOffset = startOffset + aSize;
+
+  size_t firstChunk = startOffset / kPrepareChunkBytes;
+  size_t lastChunk = (endOffset - 1) / kPrepareChunkBytes;
+
+  if (lastChunk >= kMaxPrepareChunks) {
+    RequestDebuggerToPrepareRegion(aAddress, aSize);
+    return;
+  }
+
+  for (size_t chunk = firstChunk; chunk <= lastChunk; chunk++) {
+    uint64_t bit = uint64_t(1) << chunk;
+    if (sPreparedChunkMask & bit) {
+      continue;
+    }
+
+    uint8_t* chunkStart = sExecutableMemoryBase + (chunk * kPrepareChunkBytes);
+    RequestDebuggerToPrepareRegion(chunkStart, kPrepareChunkBytes);
+    sPreparedChunkMask = sPreparedChunkMask | bit;
+  }
+}
+
+static bool SetAliasProtection(void* executableAddress, void* writableAddress,
+                               size_t bytes, ProtectionSetting protection) {
+  if (!sHasTXMSupport) {
+    if (protection == ProtectionSetting::Writable) {
+      return vm_protect(mach_task_self(),
+                        reinterpret_cast<vm_address_t>(writableAddress), bytes,
+                        false, VM_PROT_READ | VM_PROT_WRITE) == KERN_SUCCESS;
+    }
+    sys_dcache_flush(writableAddress, bytes);
+    sys_icache_invalidate(executableAddress, bytes);
+    return true;
+  }
+
+  switch (protection) {
+    case ProtectionSetting::Writable:
+      if (vm_protect(mach_task_self(),
+                     reinterpret_cast<vm_address_t>(writableAddress), bytes,
+                     false, VM_PROT_READ | VM_PROT_WRITE) != KERN_SUCCESS) {
+        return false;
+      }
+      return mprotect(executableAddress, bytes, PROT_READ | PROT_EXEC) == 0;
+    case ProtectionSetting::Executable:
+      if (vm_protect(mach_task_self(),
+                     reinterpret_cast<vm_address_t>(writableAddress), bytes,
+                     false, VM_PROT_READ) != KERN_SUCCESS) {
+        return false;
+      }
+      return mprotect(executableAddress, bytes, PROT_READ | PROT_EXEC) == 0;
+  }
+  MOZ_CRASH();
+}
