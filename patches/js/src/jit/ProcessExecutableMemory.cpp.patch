+  // presumably meant to achieve. On arm64 every instruction is four
+  // bytes, so pc+4 is exact. See fix_sigbus_and_chunk_mask.py.
+  static bool sInstalledBusHandler = false;
+  if (!sInstalledBusHandler) {
+    sInstalledBusHandler = true;
+    struct sigaction sa;
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_flags = SA_SIGINFO;
+    sa.sa_sigaction = [](int aSignal, siginfo_t* info, void* context) {
