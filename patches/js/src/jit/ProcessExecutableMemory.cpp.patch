+      // keep its default fatal behavior: skipping the instruction would
+      // silently corrupt state that a crash report would have caught.
+      // Same shape as the SIGTRAP backstop below: restore the default
+      // and return, so the instruction re-executes and terminates the
+      // way it would have without us.
+      auto* fault = info ? static_cast<uint8_t*>(info->si_addr) : nullptr;
+      const bool inExecutableRegion =
+          sExecutableMemoryBase && fault >= sExecutableMemoryBase &&
+          fault < sExecutableMemoryBase + MaxCodeBytesPerProcess;
+      const bool inWritableAlias =
+          sWritableExecutableMemoryBase &&
+          fault >= sWritableExecutableMemoryBase &&
+          fault < sWritableExecutableMemoryBase + MaxCodeBytesPerProcess;
